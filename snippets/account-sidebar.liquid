{%- liquid
  assign active_item = active | default: 'dashboard'
  assign level_value = customer_level | default: '2'
  assign nav_mode = mode | default: 'links'

  assign dash_url = dashboard_url | default: '/pages/dashboard'
  if pages.dashboard != blank and dashboard_url == blank
    assign dash_url = pages.dashboard.url
  endif

  assign wish_url = wishlist_url | default: '/pages/wishlist'
  if pages.wishlist != blank and wishlist_url == blank
    assign wish_url = pages.wishlist.url
  endif

  assign subs_url = subscriptions_url | default: 'https://shopify.com/69340233891/account/pages/6971b1a1-27f6-4c27-b8b0-3009fd3b921d'
-%}

<div class="sulalat-dashboard__sidebar">
  <nav aria-label="Account">
    <ul
      class="sulalat-dashboard__nav"
      {% if nav_mode == 'tabs' %}role="tablist" aria-orientation="vertical"{% endif %}
    >
      <li>
        {%- if nav_mode == 'tabs' -%}
          <button
            type="button"
            class="sulalat-dashboard__link{% if active_item == 'dashboard' %} is-active{% endif %}"
            role="tab"
            aria-selected="{% if active_item == 'dashboard' %}true{% else %}false{% endif %}"
            data-dashboard-tab="dashboard"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <rect x="3.5" y="3.5" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="1.6"/>
              <rect x="13.5" y="3.5" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="1.6"/>
              <rect x="3.5" y="13.5" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="1.6"/>
              <rect x="13.5" y="13.5" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="1.6"/>
            </svg>
            <span>Dashboard</span>
          </button>
        {%- else -%}
          <a
            class="sulalat-dashboard__link{% if active_item == 'dashboard' %} is-active{% endif %}"
            href="{{ dash_url }}"
            {% if active_item == 'dashboard' %}aria-current="page"{% endif %}
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <rect x="3.5" y="3.5" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="1.6"/>
              <rect x="13.5" y="3.5" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="1.6"/>
              <rect x="3.5" y="13.5" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="1.6"/>
              <rect x="13.5" y="13.5" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="1.6"/>
            </svg>
            <span>Dashboard</span>
          </a>
        {%- endif -%}
      </li>

      <li>
        {%- if nav_mode == 'tabs' -%}
          <button
            type="button"
            class="sulalat-dashboard__link{% if active_item == 'orders' %} is-active{% endif %}"
            role="tab"
            aria-selected="{% if active_item == 'orders' %}true{% else %}false{% endif %}"
            data-dashboard-tab="orders"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M8 4.5h8a1.5 1.5 0 011.5 1.5v13a1.5 1.5 0 01-1.5 1.5H8A1.5 1.5 0 016.5 19V6A1.5 1.5 0 018 4.5z" stroke="currentColor" stroke-width="1.6"/>
              <path d="M9.5 9h5M9.5 12.5h5M9.5 16h3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
            </svg>
            <span>My Orders</span>
          </button>
        {%- else -%}
          <a
            class="sulalat-dashboard__link{% if active_item == 'orders' %} is-active{% endif %}"
            href="{{ dash_url }}?tab=orders"
            {% if active_item == 'orders' %}aria-current="page"{% endif %}
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M8 4.5h8a1.5 1.5 0 011.5 1.5v13a1.5 1.5 0 01-1.5 1.5H8A1.5 1.5 0 016.5 19V6A1.5 1.5 0 018 4.5z" stroke="currentColor" stroke-width="1.6"/>
              <path d="M9.5 9h5M9.5 12.5h5M9.5 16h3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
            </svg>
            <span>My Orders</span>
          </a>
        {%- endif -%}
      </li>

      <li>
        {%- if nav_mode == 'tabs' -%}
          <button
            type="button"
            class="sulalat-dashboard__link{% if active_item == 'subscriptions' %} is-active{% endif %}"
            role="tab"
            aria-selected="{% if active_item == 'subscriptions' %}true{% else %}false{% endif %}"
            data-dashboard-tab="subscriptions"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <rect x="4" y="5" width="16" height="15" rx="2" stroke="currentColor" stroke-width="1.6"/>
              <path d="M8 3.5v3M16 3.5v3M4 9.5h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
              <path d="M8.5 14l2 2 4.5-4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span>Subscriptions</span>
          </button>
        {%- else -%}
          <a
            class="sulalat-dashboard__link{% if active_item == 'subscriptions' %} is-active{% endif %}"
            href="{{ subs_url }}"
            {% if active_item == 'subscriptions' %}aria-current="page"{% endif %}
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <rect x="4" y="5" width="16" height="15" rx="2" stroke="currentColor" stroke-width="1.6"/>
              <path d="M8 3.5v3M16 3.5v3M4 9.5h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
              <path d="M8.5 14l2 2 4.5-4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span>Subscriptions</span>
          </a>
        {%- endif -%}
      </li>

      <li>
        {%- if nav_mode == 'tabs' -%}
          <button
            type="button"
            class="sulalat-dashboard__link{% if active_item == 'wishlist' %} is-active{% endif %}"
            role="tab"
            aria-selected="{% if active_item == 'wishlist' %}true{% else %}false{% endif %}"
            data-dashboard-tab="wishlist"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M12 20.2s-6.8-4.3-8.8-8.4A5 5 0 0112 6.6a5 5 0 018.8 5.2c-2 4.1-8.8 8.4-8.8 8.4z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
            </svg>
            <span>My Wishlist</span>
          </button>
        {%- else -%}
          <a
            class="sulalat-dashboard__link{% if active_item == 'wishlist' %} is-active{% endif %}"
            href="{{ wish_url }}"
            {% if active_item == 'wishlist' %}aria-current="page"{% endif %}
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M12 20.2s-6.8-4.3-8.8-8.4A5 5 0 0112 6.6a5 5 0 018.8 5.2c-2 4.1-8.8 8.4-8.8 8.4z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
            </svg>
            <span>My Wishlist</span>
          </a>
        {%- endif -%}
      </li>

      <li>
        {%- if nav_mode == 'tabs' -%}
          <button
            type="button"
            class="sulalat-dashboard__link{% if active_item == 'payments' %} is-active{% endif %}"
            role="tab"
            aria-selected="{% if active_item == 'payments' %}true{% else %}false{% endif %}"
            data-dashboard-tab="payments"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <rect x="3" y="7" width="18" height="12" rx="2" stroke="currentColor" stroke-width="1.6"/>
              <path d="M3 11h18M7 15h3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
            </svg>
            <span>My Payments</span>
          </button>
        {%- else -%}
          <a
            class="sulalat-dashboard__link{% if active_item == 'payments' %} is-active{% endif %}"
            href="{{ dash_url }}?tab=payments"
            {% if active_item == 'payments' %}aria-current="page"{% endif %}
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <rect x="3" y="7" width="18" height="12" rx="2" stroke="currentColor" stroke-width="1.6"/>
              <path d="M3 11h18M7 15h3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
            </svg>
            <span>My Payments</span>
          </a>
        {%- endif -%}
      </li>

      <li>
        {%- if nav_mode == 'tabs' -%}
          <button
            type="button"
            class="sulalat-dashboard__link{% if active_item == 'addresses' %} is-active{% endif %}"
            role="tab"
            aria-selected="{% if active_item == 'addresses' %}true{% else %}false{% endif %}"
            data-dashboard-tab="addresses"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M7 4h10.5A1.5 1.5 0 0119 5.5V20H8.5A1.5 1.5 0 017 18.5V4z" stroke="currentColor" stroke-width="1.6"/>
              <path d="M7 6.5H5.2A1.2 1.2 0 004 7.7V19a2 2 0 002 2h11" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
              <path d="M10 9h5M10 12.5h5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
            </svg>
            <span>Address Book</span>
          </button>
        {%- else -%}
          <a
            class="sulalat-dashboard__link{% if active_item == 'addresses' %} is-active{% endif %}"
            href="{{ dash_url }}?tab=addresses"
            {% if active_item == 'addresses' %}aria-current="page"{% endif %}
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M7 4h10.5A1.5 1.5 0 0119 5.5V20H8.5A1.5 1.5 0 017 18.5V4z" stroke="currentColor" stroke-width="1.6"/>
              <path d="M7 6.5H5.2A1.2 1.2 0 004 7.7V19a2 2 0 002 2h11" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
              <path d="M10 9h5M10 12.5h5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
            </svg>
            <span>Address Book</span>
          </a>
        {%- endif -%}
      </li>

      <li>
        {%- if nav_mode == 'tabs' -%}
          <button
            type="button"
            class="sulalat-dashboard__link{% if active_item == 'profile' %} is-active{% endif %}"
            role="tab"
            aria-selected="{% if active_item == 'profile' %}true{% else %}false{% endif %}"
            data-dashboard-tab="profile"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <circle cx="12" cy="8" r="3.2" stroke="currentColor" stroke-width="1.6"/>
              <path d="M5.2 19.2c1.3-3.1 3.6-4.6 6.8-4.6s5.5 1.5 6.8 4.6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
            </svg>
            <span>Personal Info</span>
          </button>
        {%- else -%}
          <a
            class="sulalat-dashboard__link{% if active_item == 'profile' %} is-active{% endif %}"
            href="{{ dash_url }}?tab=profile"
            {% if active_item == 'profile' %}aria-current="page"{% endif %}
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <circle cx="12" cy="8" r="3.2" stroke="currentColor" stroke-width="1.6"/>
              <path d="M5.2 19.2c1.3-3.1 3.6-4.6 6.8-4.6s5.5 1.5 6.8 4.6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
            </svg>
            <span>Personal Info</span>
          </a>
        {%- endif -%}
      </li>
    </ul>
  </nav>

  <div class="sulalat-dashboard__level">
    <p class="sulalat-dashboard__level-label">My Level</p>
    <p class="sulalat-dashboard__level-value">{{ level_value | escape }}</p>
  </div>
</div>
