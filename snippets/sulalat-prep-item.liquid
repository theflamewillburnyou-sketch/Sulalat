{%- comment -%}
  Coffee Preparation item — only 2 modes:
  - image: image only
  - video: poster image + Shopify video OR video link

  Params:
  - mode: 'image' | 'video'
  - index: 1–4 (grid position)
  - image: poster / image
  - video: Shopify-hosted video (optional, video mode)
  - video_url: external video URL (optional, video mode)
  - heading: alt fallback
{%- endcomment -%}
{%- liquid
  assign pos_class = 'sulalat-prep__item--pos-n'
  if index == 1
    assign pos_class = 'sulalat-prep__item--pos-1'
  elsif index == 2
    assign pos_class = 'sulalat-prep__item--pos-2'
  elsif index == 3
    assign pos_class = 'sulalat-prep__item--pos-3'
  elsif index == 4
    assign pos_class = 'sulalat-prep__item--pos-4'
  endif
  assign item_class = 'sulalat-prep__item ' | append: pos_class

  assign is_video_mode = false
  if mode == 'video'
    assign is_video_mode = true
  endif

  assign item_image = image
  if item_image == blank and video != blank and video.preview_image != blank
    assign item_image = video.preview_image
  endif

  assign item_href = blank
  if is_video_mode and video_url != blank
    assign item_href = video_url
  endif

  assign prep_alt = item_image.alt | default: heading | default: 'Coffee preparation'
  assign has_content = false
  if item_image != blank or video != blank
    assign has_content = true
  endif
-%}

{%- if has_content or request.design_mode -%}
  {%- if item_href != blank -%}
    <a class="{{ item_class }}" href="{{ item_href }}" target="_blank" rel="noopener">
  {%- else -%}
    <div class="{{ item_class }}">
  {%- endif -%}

    {%- if item_image != blank -%}
      {{
        item_image
        | image_url: width: 1400
        | image_tag:
          loading: 'lazy',
          widths: '480, 720, 960, 1200, 1400',
          sizes: '(min-width: 992px) 40vw, 100vw',
          alt: prep_alt
      }}
    {%- elsif is_video_mode and video != blank -%}
      {{ video | video_tag: autoplay: false, loop: false, muted: true, controls: false, image_size: '1200x' }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}

    {%- if is_video_mode -%}
      <span class="sulalat-prep__play" aria-hidden="true">
        <span>
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M8 5v14l11-7L8 5z"/>
          </svg>
        </span>
      </span>
    {%- endif -%}

  {%- if item_href != blank -%}
    </a>
  {%- else -%}
    </div>
  {%- endif -%}
{%- endif -%}
