<section
  class="experience-sulalat-grid"
  data-section-id="{{ section.id }}"
  style="
    --exp-grid-bg: {{ section.settings.background_color }};
    --exp-grid-padding-top: {{ section.settings.padding_top }}px;
    --exp-grid-padding-bottom: {{ section.settings.padding_bottom }}px;
    --exp-grid-gap: {{ section.settings.card_gap }}px;
    --exp-grid-slides-desktop: {{ section.settings.slides_per_view_desktop }};
    --exp-grid-slides-tablet: {{ section.settings.slides_per_view_tablet }};
    --exp-grid-slides-mobile: {{ section.settings.slides_per_view_mobile }};
  "
>
  <style>
    .experience-sulalat-grid[data-section-id="{{ section.id }}"] {
      padding: var(--exp-grid-padding-top, 80px) 0 var(--exp-grid-padding-bottom, 100px);
      background: var(--exp-grid-bg, #ffffff);
      font-family: var(--body-font-family);
      overflow: hidden;
    }

    .experience-sulalat-grid[data-section-id="{{ section.id }}"] .container {
      max-width: var(--brand-container-max, 1440px);
      margin: 0 auto;
      padding: 0 var(--brand-container-padding-x, 20px);
    }

    .experience-sulalat-grid[data-section-id="{{ section.id }}"] .experience-sulalat-grid__slider-wrap {
      position: relative;
    }

    .experience-sulalat-grid[data-section-id="{{ section.id }}"] .experience-sulalat-grid__slider {
      overflow: visible;
    }

    .experience-sulalat-grid[data-section-id="{{ section.id }}"] .experience-sulalat-grid__slider .swiper-wrapper {
      align-items: stretch;
    }

    .experience-sulalat-grid[data-section-id="{{ section.id }}"] .experience-sulalat-grid__slider .swiper-slide {
      height: auto;
    }

    .experience-sulalat-grid[data-section-id="{{ section.id }}"] .experience-sulalat-card {
      display: flex;
      flex-direction: column;
      height: 100%;
      min-width: 0;
    }

    .experience-sulalat-grid[data-section-id="{{ section.id }}"] .experience-sulalat-card__media {
      display: block;
      border-radius: var(--brand-radius-lg, 20px);
      overflow: hidden;
      aspect-ratio: 1 / 1;
      margin-bottom: 20px;
      background: #f3f3f3;
    }

    .experience-sulalat-grid[data-section-id="{{ section.id }}"] .experience-sulalat-card__media img,
    .experience-sulalat-grid[data-section-id="{{ section.id }}"] .experience-sulalat-card__media svg.placeholder-svg {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .experience-sulalat-grid[data-section-id="{{ section.id }}"] .experience-sulalat-card__title {
      margin: 0 0 12px;
      font-size: 20px;
      line-height: 1.3;
      font-weight: 600;
      color: #000;
    }

    .experience-sulalat-grid[data-section-id="{{ section.id }}"] .experience-sulalat-card__text {
      margin: 0 0 24px;
      font-size: 14px;
      line-height: 1.5;
      color: var(--brand-body-text, #535353);
      flex: 1;
    }

    .experience-sulalat-grid[data-section-id="{{ section.id }}"] .experience-sulalat-card__text p {
      margin: 0;
    }

    .experience-sulalat-grid[data-section-id="{{ section.id }}"] .experience-sulalat-card__btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      align-self: flex-start;
      min-height: 44px;
      padding: 10px 28px;
      border-radius: var(--brand-radius-pill, 80px);
      background: var(--brand-primary, #53c295);
      border: 1px solid var(--brand-primary, #53c295);
      color: #fff;
      font-size: 14px;
      font-weight: 500;
      font-family: inherit;
      text-decoration: none;
      transition: 0.25s ease;
      margin-top: auto;
    }

    .experience-sulalat-grid[data-section-id="{{ section.id }}"] .experience-sulalat-card__btn:hover {
      background: var(--brand-primary-hover, #45ad82);
      border-color: var(--brand-primary-hover, #45ad82);
      color: #fff;
    }

    .experience-sulalat-grid[data-section-id="{{ section.id }}"] .experience-sulalat-grid__nav {
      display: flex;
      justify-content: flex-end;
      gap: 10px;
      margin-top: 28px;
    }

    .experience-sulalat-grid[data-section-id="{{ section.id }}"] .experience-sulalat-grid__nav-btn {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      border: 1px solid rgba(0, 0, 0, 0.12);
      background: #fff;
      color: #000;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: 0.25s ease;
      padding: 0;
    }

    .experience-sulalat-grid[data-section-id="{{ section.id }}"] .experience-sulalat-grid__nav-btn:hover:not(:disabled) {
      border-color: var(--brand-primary, #53c295);
      color: var(--brand-primary, #53c295);
    }

    .experience-sulalat-grid[data-section-id="{{ section.id }}"] .experience-sulalat-grid__nav-btn:disabled {
      opacity: 0.35;
      cursor: not-allowed;
    }

    .experience-sulalat-grid[data-section-id="{{ section.id }}"] .experience-sulalat-grid__nav-btn svg {
      width: 18px;
      height: 18px;
    }

    @media (max-width: 767px) {
      .experience-sulalat-grid[data-section-id="{{ section.id }}"] .experience-sulalat-card__title {
        font-size: 18px;
      }
    }
  </style>

  <div class="container">
    {% if section.blocks.size > 0 %}
      <div class="experience-sulalat-grid__slider-wrap">
        <div class="swiper experience-sulalat-grid__slider" data-experience-slider>
          <div class="swiper-wrapper">
            {% for block in section.blocks %}
              <div class="swiper-slide" {{ block.shopify_attributes }}>
                <article class="experience-sulalat-card">
                  {% if block.settings.image != blank %}
                    <a
                      class="experience-sulalat-card__media"
                      href="{{ block.settings.button_link | default: '#' }}"
                      aria-label="{{ block.settings.title | default: 'View experience' | escape }}"
                    >
                      {{
                        block.settings.image
                        | image_url: width: 800
                        | image_tag:
                          loading: 'lazy',
                          widths: '320, 480, 640, 800',
                          sizes: '(min-width: 1200px) 28vw, (min-width: 768px) 40vw, 85vw',
                          alt: block.settings.image.alt | default: block.settings.title | escape
                      }}
                    </a>
                  {% else %}
                    <div class="experience-sulalat-card__media">
                      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
                    </div>
                  {% endif %}

                  {% if block.settings.title != blank %}
                    <h3 class="experience-sulalat-card__title">{{ block.settings.title | escape }}</h3>
                  {% endif %}

                  {% if block.settings.text != blank %}
                    <div class="experience-sulalat-card__text">{{ block.settings.text }}</div>
                  {% endif %}

                  {% if block.settings.button_label != blank %}
                    <a class="experience-sulalat-card__btn" href="{{ block.settings.button_link | default: '#' }}">
                      {{ block.settings.button_label | escape }}
                    </a>
                  {% endif %}
                </article>
              </div>
            {% endfor %}
          </div>
        </div>

        {% if section.settings.show_navigation %}
          <div class="experience-sulalat-grid__nav">
            <button type="button" class="experience-sulalat-grid__nav-btn" data-experience-prev aria-label="Previous slide">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
                <path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
            <button type="button" class="experience-sulalat-grid__nav-btn" data-experience-next aria-label="Next slide">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
                <path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
          </div>
        {% endif %}
      </div>
    {% endif %}
  </div>

  <script>
    (function () {
      var sectionId = {{ section.id | json }};
      var cardGap = {{ section.settings.card_gap | default: 24 }};
      var slidesDesktop = {{ section.settings.slides_per_view_desktop | default: 3.2 }};
      var slidesTablet = {{ section.settings.slides_per_view_tablet | default: 2.2 }};
      var slidesMobile = {{ section.settings.slides_per_view_mobile | default: 1.2 }};
      var showNavigation = {{ section.settings.show_navigation | json }};

      function getSection() {
        return document.querySelector('.experience-sulalat-grid[data-section-id="' + sectionId + '"]');
      }

      function loadSwiper(callback) {
        if (window.Swiper) {
          callback();
          return;
        }

        if (!document.querySelector('link[href*="swiper-bundle.min.css"]')) {
          var link = document.createElement('link');
          link.rel = 'stylesheet';
          link.href = 'https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css';
          document.head.appendChild(link);
        }

        var existing = document.querySelector('script[data-experience-swiper]');
        if (existing) {
          existing.addEventListener('load', callback, { once: true });
          return;
        }

        var script = document.createElement('script');
        script.src = 'https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js';
        script.dataset.experienceSwiper = 'true';
        script.onload = callback;
        document.head.appendChild(script);
      }

      function updateNavState(swiper, section) {
        var prevBtn = section.querySelector('[data-experience-prev]');
        var nextBtn = section.querySelector('[data-experience-next]');
        if (!prevBtn || !nextBtn) return;

        prevBtn.disabled = swiper.isBeginning;
        nextBtn.disabled = swiper.isEnd;
      }

      function initSlider() {
        var section = getSection();
        if (!section || !window.Swiper) return;

        var sliderEl = section.querySelector('[data-experience-slider]');
        if (!sliderEl) return;

        if (sliderEl.swiper) {
          sliderEl.swiper.destroy(true, true);
        }

        var swiper = new window.Swiper(sliderEl, {
          slidesPerView: slidesMobile,
          spaceBetween: cardGap,
          speed: 600,
          grabCursor: true,
          watchOverflow: true,
          rtl: document.documentElement.dir === 'rtl',
          breakpoints: {
            768: {
              slidesPerView: slidesTablet,
              spaceBetween: cardGap
            },
            1200: {
              slidesPerView: slidesDesktop,
              spaceBetween: cardGap
            }
          },
          on: {
            init: function () {
              updateNavState(this, section);
            },
            slideChange: function () {
              updateNavState(this, section);
            },
            resize: function () {
              updateNavState(this, section);
            }
          }
        });

        if (showNavigation) {
          var prevBtn = section.querySelector('[data-experience-prev]');
          var nextBtn = section.querySelector('[data-experience-next]');
          if (prevBtn) {
            prevBtn.onclick = function () {
              swiper.slidePrev();
            };
          }
          if (nextBtn) {
            nextBtn.onclick = function () {
              swiper.slideNext();
            };
          }
        }
      }

      function init() {
        loadSwiper(initSlider);
      }

      init();

      document.addEventListener('shopify:section:load', function (event) {
        if (String(event.detail.sectionId) === String(sectionId)) {
          init();
        }
      });

      document.addEventListener('shopify:section:unload', function (event) {
        if (String(event.detail.sectionId) !== String(sectionId)) return;
        var section = getSection();
        var sliderEl = section && section.querySelector('[data-experience-slider]');
        if (sliderEl && sliderEl.swiper) {
          sliderEl.swiper.destroy(true, true);
        }
      });
    })();
  </script>
</section>

{% schema %}
{
  "name": "Experience Sulalat grid",
  "tag": "section",
  "class": "experience-sulalat-grid-section",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Card gap",
      "min": 12,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "slides_per_view_desktop",
      "label": "Slides visible on desktop (peek)",
      "min": 3,
      "max": 4,
      "step": 0.1,
      "default": 3.2,
      "info": "3.2 shows 3 full cards plus a peek of the 4th"
    },
    {
      "type": "range",
      "id": "slides_per_view_tablet",
      "label": "Slides visible on tablet",
      "min": 1,
      "max": 3,
      "step": 0.1,
      "default": 2.2
    },
    {
      "type": "range",
      "id": "slides_per_view_mobile",
      "label": "Slides visible on mobile",
      "min": 1,
      "max": 2,
      "step": 0.1,
      "default": 1.2
    },
    {
      "type": "checkbox",
      "id": "show_navigation",
      "label": "Show navigation arrows",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "experience",
      "name": "Experience card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Live Coffee Roasting"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Description",
          "default": "<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p>"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Book Now"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Experience Sulalat grid",
      "blocks": [
        {
          "type": "experience",
          "settings": {
            "title": "Live Coffee Roasting",
            "text": "<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p>",
            "button_label": "Book Now"
          }
        },
        {
