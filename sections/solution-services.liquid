{%- assign service_blocks = section.blocks | where: 'type', 'service_card' -%}

<section class="solution-services" data-section-id="{{ section.id }}">
  <style>
    .solution-services[data-section-id="{{ section.id }}"] {
      padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
      background: {{ section.settings.background_color }};
      font-family: var(--body-font-family);
    }

    .solution-services[data-section-id="{{ section.id }}"] .container {
      max-width: var(--brand-container-max, 1440px);
      margin: 0 auto;
      padding: 0 var(--brand-container-padding-x, 20px);
    }

    .solution-services[data-section-id="{{ section.id }}"] .solution-services-intro {
      text-align: center;
      max-width: 820px;
      margin: 0 auto 48px;
    }

    .solution-services[data-section-id="{{ section.id }}"] .solution-services-intro h2 {
      margin: 0 0 16px;
      color: #000;
      font-size: clamp(32px, 3.4vw, 48px);
      line-height: 1.15;
      font-weight: 600;
    }

    .solution-services[data-section-id="{{ section.id }}"] .solution-services-intro p {
      margin: 0;
      font-size: 16px;
      line-height: 26px;
      letter-spacing: -0.01em;
      color: var(--brand-body-text, #535353);
    }

    .solution-services[data-section-id="{{ section.id }}"] .solution-services-grid {
      display: grid;
      grid-template-columns: repeat({{ section.settings.columns }}, minmax(0, 1fr));
      gap: 28px;
    }

    .solution-services[data-section-id="{{ section.id }}"] .service-card {
      display: block;
      text-decoration: none;
      color: inherit;
    }

    .solution-services[data-section-id="{{ section.id }}"] .service-card-image {
      border-radius: 20px;
      overflow: hidden;
      background: #f3f3f3;
      aspect-ratio: 16 / 11;
      margin-bottom: 20px;
    }

    .solution-services[data-section-id="{{ section.id }}"] .service-card-image img,
    .solution-services[data-section-id="{{ section.id }}"] .service-card-image svg.placeholder-svg {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.5s ease;
    }

    .solution-services[data-section-id="{{ section.id }}"] .service-card:hover .service-card-image img {
      transform: scale(1.04);
    }

    .solution-services[data-section-id="{{ section.id }}"] .service-card h3 {
      margin: 0 0 10px;
      color: #000;
      font-size: clamp(22px, 2vw, 28px);
      line-height: 1.25;
      font-weight: 600;
    }

    .solution-services[data-section-id="{{ section.id }}"] .service-card p {
      margin: 0;
      font-size: 16px;
      line-height: 24px;
      letter-spacing: -0.01em;
      color: var(--brand-body-text, #535353);
      max-width: 520px;
    }

    @media (max-width: 991px) {
      .solution-services[data-section-id="{{ section.id }}"] .solution-services-grid {
        grid-template-columns: 1fr;
        gap: 32px;
      }

      .solution-services[data-section-id="{{ section.id }}"] .solution-services-intro {
        margin-bottom: 32px;
      }
    }

    @media (max-width: 767px) {
      .solution-services[data-section-id="{{ section.id }}"] {
        padding: {{ section.settings.padding_top_mobile }}px 0 {{ section.settings.padding_bottom_mobile }}px;
      }
    }
  </style>

  <div class="container">
    {% if section.settings.heading != blank or section.settings.subheading != blank %}
      <div class="solution-services-intro">
        {% if section.settings.heading != blank %}
          <h2>{{ section.settings.heading | escape }}</h2>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <p>{{ section.settings.subheading | escape | newline_to_br }}</p>
        {% endif %}
      </div>
    {% endif %}

    {% if service_blocks.size > 0 %}
      <div class="solution-services-grid">
        {% for block in service_blocks %}
          {%- capture card_inner -%}
            <div class="service-card-image">
              {% if block.settings.image != blank %}
                {{
                  block.settings.image
                  | image_url: width: 1200
                  | image_tag:
                    loading: 'lazy',
                    widths: '400, 600, 800, 1000, 1200',
                    sizes: '(min-width: 992px) 45vw, 100vw',
                    alt: block.settings.title
                }}
              {% else %}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {% endif %}
            </div>
            {% if block.settings.title != blank %}
              <h3>{{ block.settings.title | escape }}</h3>
            {% endif %}
            {% if block.settings.text != blank %}
              <p>{{ block.settings.text | escape | newline_to_br }}</p>
            {% endif %}
          {%- endcapture -%}

          {% if block.settings.link != blank %}
            <a class="service-card" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
              {{ card_inner }}
            </a>
          {% else %}
            <div class="service-card" {{ block.shopify_attributes }}>
              {{ card_inner }}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Solution services",
  "tag": "section",
  "class": "solution-services-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Maintenance & Installations"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Professional setup and calibration for all major brands, ensuring optimal performance."
    },
    {
      "type": "range",
      "id": "columns",
      "min": 1,
      "max": 3,
      "step": 1,
      "label": "Columns",
      "default": 2
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding top (mobile)",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom (mobile)",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "service_card",
      "name": "Service card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Routine Maintenance"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Preventive maintenance, repairs, and on-call troubleshooting by trained specialists."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Solution services",
      "blocks": [
        {
          "type": "service_card",
          "settings": {
            "title": "Routine Maintenance",
            "text": "Preventive maintenance, repairs, and on-call troubleshooting by trained specialists."
          }
        },
        {
          "type": "service_card",
          "settings": {
            "title": "Corrective Maintenance",
            "text": "Preventive maintenance, repairs, and on-call troubleshooting by trained specialists."
          }
        }
      ]
    }
  ]
}
{% endschema %}
