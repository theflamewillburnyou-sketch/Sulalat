<section
  class="about-section"
  data-section-id="{{ section.id }}"
  style="
    --about-padding-top: {{ section.settings.section_padding_top }}px;
    --about-padding-bottom: {{ section.settings.section_padding_bottom }}px;
    --about-container-max: {{ section.settings.container_max_width }}px;
    --about-grid-gap: {{ section.settings.grid_gap }}px;
    --about-heading-color: {{ section.settings.heading_color }};
    --about-text-color: {{ section.settings.text_color }};
    --about-overlay-color: {{ section.settings.overlay_color }};
    --about-overlay-opacity: {% if section.settings.overlay_enabled %}{{ section.settings.overlay_opacity }}{% else %}0{% endif %};
    --about-bg-color: {{ section.settings.section_bg_color }};
    --about-heading-size: {{ section.settings.heading_size }}px;
    --about-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --about-about-heading-size: {{ section.settings.about_heading_size }}px;
    --about-body-size: {{ section.settings.body_text_size }}px;
  "
>
  <style>
    .about-section[data-section-id="{{ section.id }}"] {
      padding: var(--about-padding-top) 0 var(--about-padding-bottom);
      background: var(--about-bg-color);
    }

    .about-section[data-section-id="{{ section.id }}"] .about-container {
      max-width: var(--about-container-max);
      margin: 0 auto;
      padding: 0 var(--brand-container-padding-x, 20px);
      overflow:hidden;
    }

    .about-section[data-section-id="{{ section.id }}"] .section-title {
      text-align: center;
      margin-bottom: 60px;
      max-width: 950px;
      margin-inline: auto;
    }

    .about-section[data-section-id="{{ section.id }}"] .section-title h2 {
      color: var(--about-heading-color);
      font-size: var(--about-heading-size);
      font-weight: 400;
      margin-bottom: 30px;
      line-height: 1.2;
    }

    .about-section[data-section-id="{{ section.id }}"] .section-title h2 span {
      display: block;
    }

    .about-section[data-section-id="{{ section.id }}"] .section-title p {
      color: var(--about-text-color);
      font-size: var(--about-body-size);
      line-height: 1.5;
      letter-spacing: -0.01em;
      margin-top: 14px;
    }

    .about-section[data-section-id="{{ section.id }}"] .about-grid {
      display: flex;
      flex-wrap: wrap;
      gap: var(--about-grid-gap);
    }

    .about-section[data-section-id="{{ section.id }}"] .about-left {
      width: calc(41.4% - (var(--about-grid-gap) / 2));
    }

    .about-section[data-section-id="{{ section.id }}"] .about-right {
      width: calc(58.6% - (var(--about-grid-gap) / 2));
    }

    .about-section[data-section-id="{{ section.id }}"] .about-slider {
      position: relative;
      overflow: hidden;
      border-radius: 12px;
      /* Keep slide transform math LTR so Arabic/RTL does not reverse the track */
      direction: ltr;
      min-height: 200px;
    }

    .about-section[data-section-id="{{ section.id }}"] .about-slider-track {
      display: flex;
      flex-direction: row;
      transition: transform 0.6s cubic-bezier(0.25, 0.8, 0.25, 1);
      will-change: transform;
    }

    .about-section[data-section-id="{{ section.id }}"] .about-slide {
      flex: 0 0 100%;
      position: relative;
      overflow: hidden;
      border-radius: var(--brand-radius-sm);
      min-height: 200px;
    }

    .about-section[data-section-id="{{ section.id }}"] .about-slide::before {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(
        180deg,
        rgba(0, 0, 0, 0) 75%,
        rgba(0, 0, 0, 1) 100%
      );
      opacity: var(--about-overlay-opacity);
      z-index: 2;
      pointer-events: none;
    }

    .about-section[data-section-id="{{ section.id }}"] .about-slide:hover .about-slide-image {
      transform: scale(1.2);
    }

    .about-section[data-section-id="{{ section.id }}"] .about-slide-image {
      transition: transform 1.8s ease-in-out;
      width: 100%;
      height: auto;
      display: block;
      border-radius: inherit;
      vertical-align: middle;
    }

    .about-section[data-section-id="{{ section.id }}"] .about-slide svg.placeholder-svg {
      width: 100%;
      height: auto;
      min-height: 240px;
      display: block;
    }

    .about-section[data-section-id="{{ section.id }}"] .about-pagination {
      position: absolute;
      bottom: 25px;
      left: 0;
      right: 0;
      display: flex;
      justify-content: center;
      gap: 10px;
      z-index: 3;
    }

    .about-section[data-section-id="{{ section.id }}"] .about-pagination button {
      width: 14px;
      height: 14px;
      border-radius: 50%;
      background: #ffffff;
      border: none;
      opacity: 0.3;
      cursor: pointer;
      padding: 0;
      transition: opacity 0.3s ease;
    }

    .about-section[data-section-id="{{ section.id }}"] .about-pagination button:hover,
    .about-section[data-section-id="{{ section.id }}"] .about-pagination button:focus {
      opacity: 0.7;
    }

    .about-section[data-section-id="{{ section.id }}"] .about-pagination button:focus-visible {
      outline: 2px solid #ffffff;
      outline-offset: 2px;
    }

    .about-section[data-section-id="{{ section.id }}"] .about-pagination button.active {
      opacity: 1;
    }

    .about-section[data-section-id="{{ section.id }}"] .about-content {
      margin-top: 42px;
    }

    .about-section[data-section-id="{{ section.id }}"] .about-content h3 {
      font-size: var(--about-about-heading-size);
      font-weight: 400;
      color: var(--about-heading-color);
      line-height: 1.2;
    }

    .about-section[data-section-id="{{ section.id }}"] .about-content h3 span {
      display: block;
    }

    .about-section[data-section-id="{{ section.id }}"] .about-text {
      display: grid;
      grid-template-columns: 1fr 1.4fr;
      gap: 35px;
      margin-top: 42px;
    }

    .about-section[data-section-id="{{ section.id }}"] .about-text p {
      color: var(--about-text-color);
      font-size: var(--about-body-size);
      line-height: 24px;
      margin: 0;
    }

    @media (max-width: 1440px){
      .about-section[data-section-id="{{ section.id }}"] .about-container {
        max-width: 1240px;
      }
      .about-section[data-section-id="{{ section.id }}"] .about-content h3 {
        font-size: clamp(26px, 2vw, 22px);
      }
    
    }

    @media (max-width: 1200px){
      .about-section[data-section-id="{{ section.id }}"] .about-container {
        max-width: 1150px;
      }
       .about-section[data-section-id="{{ section.id }}"] .about-content h3 {
        font-size: 22px;
      }
    
    }


    @media (max-width: 1024px){
    
    }

    @media (max-width: 991px) {
      .about-section[data-section-id="{{ section.id }}"] .about-text {
        grid-template-columns: 1fr;
        gap: 20px;
      }
    }

    @media (max-width: 767px) {
      .about-section[data-section-id="{{ section.id }}"] .about-left,
      .about-section[data-section-id="{{ section.id }}"] .about-right {
        width: 100%;
      }

      .about-section[data-section-id="{{ section.id }}"]{
        padding-top:70px;
        padding-bottom:70px;
      }
      .about-section[data-section-id="{{ section.id }}"] .section-title h2 {
        font-size: var(--about-heading-size-mobile);
      }
      .about-section[data-section-id="{{ section.id }}"] .about-content h3 {
        font-size: 24px;
      }
      .about-section[data-section-id="{{ section.id }}"] .section-title {
        margin-bottom: 40px;
      }
      .about-section[data-section-id="{{ section.id }}"] .about-content {
        margin-top: 30px;
      }
      .about-section[data-section-id="{{ section.id }}"] .about-text {
        margin-top: 40px;
      }
    }

    @media (max-width: 575px){
      .about-section[data-section-id="{{ section.id }}"] .about-right{
          display: flex;
          flex-direction: column-reverse;
          gap: 20px;
      }

      .about-section[data-section-id="{{ section.id }}"] .about-grid {
        gap:0;
      }

      .about-section[data-section-id="{{ section.id }}"] .about-text {
        gap:30px;
        margin-top:0;
      }

      .about-section[data-section-id="{{ section.id }}"] .about-text p {
        color:#141211;
        line-height:30px;
      }

      .about-section[data-section-id="{{ section.id }}"] .about-pagination {
       display:none;
      }
    
    }

  </style>

  <div class="about-container">
    <div class="section-title">
      <h2>
        {{ section.settings.heading_part_1 | escape }}
        {% if section.settings.heading_part_2 != blank %}
          <span>{{ section.settings.heading_part_2 | escape }}</span>
        {% endif %}
      </h2>
      {% if section.settings.subheading != blank %}
        <p>{{ section.settings.subheading | escape }}</p>
      {% endif %}
    </div>

    <div class="about-grid">
      <div class="about-left">
        {% assign left_slides = section.blocks | where: 'type', 'left_slide' %}
        {% if left_slides.size > 0 %}
          <div class="about-slider" data-about-slider>
            <div class="about-slider-track">
              {% for block in left_slides %}
                <div class="about-slide" {{ block.shopify_attributes }}>
                  {% if block.settings.image != blank %}
                    <img
                      src="{{ block.settings.image | image_url: width: 1200 }}"
                      alt="{{ block.settings.image.alt | escape }}"
                      class="about-slide-image"
                      width="{{ block.settings.image.width }}"
                      height="{{ block.settings.image.height }}"
                      {% if forloop.first or request.design_mode %}
                        loading="eager"
                        {% if forloop.first %}fetchpriority="high"{% endif %}
                      {% else %}
                        loading="lazy"
                      {% endif %}
                    >
                  {% else %}
                    {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                  {% endif %}
                </div>
              {% endfor %}
            </div>
            <div class="about-pagination"></div>
          </div>
        {% endif %}

        <div class="about-content">
          <h3>
            {{ section.settings.about_heading_part_1 | escape }}
            {% if section.settings.about_heading_part_2 != blank %}
              <span>{{ section.settings.about_heading_part_2 | escape }}</span>
            {% endif %}
          </h3>
        </div>
      </div>

      <div class="about-right">
        {% assign right_slides = section.blocks | where: 'type', 'right_slide' %}
        {% if right_slides.size > 0 %}
          <div class="about-slider" data-about-slider>
            <div class="about-slider-track">
              {% for block in right_slides %}
                <div class="about-slide" {{ block.shopify_attributes }}>
                  {% if block.settings.image != blank %}
                    <img
                      src="{{ block.settings.image | image_url: width: 1200 }}"
                      alt="{{ block.settings.image.alt | escape }}"
                      class="about-slide-image"
                      width="{{ block.settings.image.width }}"
                      height="{{ block.settings.image.height }}"
                      {% if forloop.first or request.design_mode %}
                        loading="eager"
                        {% if forloop.first %}fetchpriority="high"{% endif %}
                      {% else %}
                        loading="lazy"
                      {% endif %}
                    >
                  {% else %}
                    {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                  {% endif %}
                </div>
              {% endfor %}
            </div>
            <div class="about-pagination"></div>
          </div>
        {% endif %}

        <div class="about-text">
          {% if section.settings.text_left != blank %}
            <p>{{ section.settings.text_left | escape }}</p>
          {% endif %}
          {% if section.settings.text_right != blank %}
            <p>{{ section.settings.text_right | escape }}</p>
          {% endif %}
        </div>
      </div>
    </div>
  </div>

  <script>
    (function () {
      var SECTION_ID = {{ section.id | json }};

      function getSectionRoot(fromEl) {
        if (fromEl) {
          if (fromEl.matches && fromEl.matches('[data-section-id="' + SECTION_ID + '"]')) {
            return fromEl;
          }
          var nested = fromEl.querySelector && fromEl.querySelector('[data-section-id="' + SECTION_ID + '"]');
          if (nested) return nested;
        }
        return document.querySelector('[data-section-id="' + SECTION_ID + '"]');
      }

      function initSlider(slider) {
        if (!slider || slider.dataset.initialized === 'true') return;
        slider.dataset.initialized = 'true';

        var track = slider.querySelector('.about-slider-track');
        var slides = Array.prototype.slice.call(track ? track.children : []);
        var pagination = slider.querySelector('.about-pagination');
        var dots = [];
        var currentIndex = 0;
        var timer = null;
        var autoplay = {{ section.settings.autoplay_enabled | default: false | json }};
        var delay = {{ section.settings.autoplay_delay | default: 5 | json }} * 1000;
        var pauseOnHover = {{ section.settings.pause_on_hover | default: true | json }};

        if (slides.length === 0) {
          return;
        }

        slider.style.display = '';

        if (slides.length === 1 && pagination) {
          pagination.style.display = 'none';
        }

        function createDots() {
          if (!pagination) return;
          pagination.innerHTML = '';
          dots = [];
          for (var i = 0; i < slides.length; i++) {
            (function (index) {
              var btn = document.createElement('button');
              btn.type = 'button';
              btn.setAttribute('aria-label', 'Go to slide ' + (index + 1));
              btn.className = 'about-pagination-dot' + (index === currentIndex ? ' active' : '');
              btn.addEventListener('click', function () {
                goTo(index);
                restartAutoplay();
              });
              pagination.appendChild(btn);
              dots.push(btn);
            })(i);
          }
        }

        function updateDots() {
          dots.forEach(function (dot, i) {
            dot.classList.toggle('active', i === currentIndex);
          });
        }

        function goTo(index) {
          if (slides.length === 0) return;
          currentIndex = (index + slides.length) % slides.length;
          track.style.transform = 'translateX(' + (-currentIndex * 100) + '%)';
          updateDots();
        }

        function startAutoplay() {
          if (!autoplay || slides.length <= 1) return;
          stopAutoplay();
          timer = setInterval(function () {
            goTo(currentIndex + 1);
          }, delay);
        }

        function stopAutoplay() {
          if (timer) {
            clearInterval(timer);
            timer = null;
          }
        }

        function restartAutoplay() {
          if (!autoplay || slides.length <= 1) return;
          stopAutoplay();
          startAutoplay();
        }

        if (pauseOnHover && autoplay) {
          slider.addEventListener('mouseenter', stopAutoplay);
          slider.addEventListener('mouseleave', startAutoplay);
        }

        var startX = 0;
        var isDragging = false;

        slider.addEventListener(
          'touchstart',
          function (e) {
            if (e.target.closest('.about-pagination')) return;
            if (slides.length <= 1) return;
            startX = e.touches[0].clientX;
            isDragging = true;
            track.style.transition = 'none';
            if (pauseOnHover && autoplay) stopAutoplay();
          },
          { passive: true }
        );

        slider.addEventListener(
          'touchmove',
          function (e) {
            if (!isDragging) return;
            var diff = e.touches[0].clientX - startX;
            track.style.transform =
              'translateX(calc(' + -currentIndex * 100 + '% + ' + diff + 'px))';
          },
          { passive: true }
        );

        slider.addEventListener(
          'touchend',
          function (e) {
            if (!isDragging) return;
            isDragging = false;
            track.style.transition = '';
            var diff = e.changedTouches[0].clientX - startX;
            if (Math.abs(diff) > 50) {
              if (diff < 0) {
                goTo(currentIndex + 1);
              } else {
                goTo(currentIndex - 1);
              }
            } else {
              goTo(currentIndex);
            }
            if (pauseOnHover && autoplay) startAutoplay();
          },
          { passive: true }
        );

        createDots();
        goTo(0);
        startAutoplay();
      }

      function initAll(root) {
        if (!root) return;
        var sliders = root.querySelectorAll('[data-about-slider]');
        for (var i = 0; i < sliders.length; i++) {
          initSlider(sliders[i]);
        }
      }

      function boot(fromEl) {
        initAll(getSectionRoot(fromEl));
      }

      boot();

      // Theme editor: re-init when the section is re-rendered or a block is selected
      document.addEventListener('shopify:section:load', function (event) {
        if (String(event.detail.sectionId) !== String(SECTION_ID)) return;
        boot(event.target);
      });

      document.addEventListener('shopify:block:select', function (event) {
        if (String(event.detail.sectionId) !== String(SECTION_ID)) return;
        var slide = event.target.closest ? event.target.closest('.about-slide') : null;
        if (!slide && event.target.classList && event.target.classList.contains('about-slide')) {
          slide = event.target;
        }
        if (!slide) return;

        var slider = slide.closest('[data-about-slider]');
        if (!slider) return;

        initSlider(slider);

        var slides = slider.querySelectorAll('.about-slide');
        var track = slider.querySelector('.about-slider-track');
        var dots = slider.querySelectorAll('.about-pagination button');
        for (var i = 0; i < slides.length; i++) {
          if (slides[i] === slide) {
            if (track) track.style.transform = 'translateX(' + (-i * 100) + '%)';
            for (var d = 0; d < dots.length; d++) {
              dots[d].classList.toggle('active', d === i);
            }
            break;
          }
        }
      });
    })();
  </script>
</section>

{% schema %}
{
  "name": "About Section",
  "tag": "section",
  "class": "about-section-wrapper",
  "settings": [
    {
      "type": "header",
