<section class="about-section" id="shopify-section-{{ section.id }}">
  <div class="container">
    {%- if section.settings.heading != blank or section.settings.heading_highlight != blank -%}
      <div class="section-title">
        <h2>
          {{ section.settings.heading }}
          {%- if section.settings.heading_highlight != blank -%}
            <span>{{ section.settings.heading_highlight }}</span>
          {%- endif -%}
        </h2>
      </div>
    {%- endif -%}

    <div class="about-grid">
      <div class="about-left">
        <div class="swiper leftSwiper">
          <div class="swiper-wrapper">
            {%- for block in section.blocks -%}
              {%- if block.type == 'left_slide' -%}
                <div class="swiper-slide" {{ block.shopify_attributes }}>
                  {%- if block.settings.image != blank -%}
                    {{ block.settings.image | image_url: width: 900 | image_tag: alt: block.settings.image.alt | default: 'about image' }}
                  {%- endif -%}
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
          <div class="swiper-pagination"></div>
        </div>
        {%- if section.settings.content_heading != blank or section.settings.content_heading_highlight != blank -%}
          <div class="about-content">
            <h3>
              {{ section.settings.content_heading }}
              {%- if section.settings.content_heading_highlight != blank -%}
                <span>{{ section.settings.content_heading_highlight }}</span>
              {%- endif -%}
            </h3>
          </div>
        {%- endif -%}
      </div>

      <div class="about-right">
        <div class="swiper rightSwiper">
          <div class="swiper-wrapper">
            {%- for block in section.blocks -%}
              {%- if block.type == 'right_slide' -%}
                <div class="swiper-slide" {{ block.shopify_attributes }}>
                  {%- if block.settings.image != blank -%}
                    {{ block.settings.image | image_url: width: 1200 | image_tag: alt: block.settings.image.alt | default: 'about image' }}
                  {%- endif -%}
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
          <div class="swiper-pagination"></div>
        </div>
        {%- if section.settings.text_1 != blank or section.settings.text_2 != blank -%}
          <div class="about-text">
            {%- if section.settings.text_1 != blank -%}
              <p>{{ section.settings.text_1 }}</p>
            {%- endif -%}
            {%- if section.settings.text_2 != blank -%}
              <p>{{ section.settings.text_2 }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% style %}
  #shopify-section-{{ section.id }} .about-section {
    padding: 100px 0;
  }

  #shopify-section-{{ section.id }} .section-title {
    text-align: center;
    margin-bottom: 60px;
    max-width: 950px;
    margin-inline: auto;
  }

  #shopify-section-{{ section.id }} .section-title h2 {
    color: #000;
    font-size: clamp(24px, 3vw, 36px);
    font-weight: 400;
    margin-bottom: 30px;
  }

  #shopify-section-{{ section.id }} .section-title h2 span {
    display: block;
  }

  #shopify-section-{{ section.id }} .about-grid {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap, 25px);
  }

  #shopify-section-{{ section.id }} .about-left {
    width: calc(41.4% - (var(--gap, 25px) / 2));
  }

  #shopify-section-{{ section.id }} .about-right {
    width: calc(58.6% - (var(--gap, 25px) / 2));
  }

  #shopify-section-{{ section.id }} .about-grid .swiper-slide {
    position: relative;
    overflow: hidden;
    border-radius: 12px;
  }

  #shopify-section-{{ section.id }} .about-grid .swiper-slide:before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0) 75%, rgba(0, 0, 0, 1) 100%);
    opacity: 0.7;
    z-index: 2;
  }

  #shopify-section-{{ section.id }} .about-grid .swiper-slide:hover img {
    transform: scale(1.2);
  }

  #shopify-section-{{ section.id }} .about-grid img {
    transition: all 1.8s ease-in-out;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: inherit;
    display: block;
  }

  #shopify-section-{{ section.id }} .about-grid .swiper-pagination {
    bottom: 25px;
  }

  #shopify-section-{{ section.id }} .about-grid .swiper-pagination span {
    background: #ffffff;
    border-radius: 50%;
    opacity: 0.3;
    width: 14px;
    height: 14px;
    display: inline-block;
  }

  #shopify-section-{{ section.id }} .about-grid .swiper-pagination span.swiper-pagination-bullet-active {
    opacity: 1;
  }

  #shopify-section-{{ section.id }} .about-content {
    margin-top: 42px;
  }

  #shopify-section-{{ section.id }} .about-content h3 {
    font-size: 30px;
    font-weight: 400;
    color: #000;
  }

  #shopify-section-{{ section.id }} .about-content h3 span {
    display: block;
  }

  #shopify-section-{{ section.id }} .about-text {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 35px;
    margin-top: 42px;
  }

  #shopify-section-{{ section.id }} .about-text p {
    color: var(--light-text, #535353);
    font-size: 16px;
    line-height: 24px;
  }

  @media (max-width: 992px) {
    #shopify-section-{{ section.id }} .about-section {
      padding: 60px 0;
    }
    #shopify-section-{{ section.id }} .about-left,
    #shopify-section-{{ section.id }} .about-right {
      width: 100%;
    }
    #shopify-section-{{ section.id }} .about-text {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }
{% endstyle %}

<script>
  (function () {
    var root = document.getElementById('shopify-section-{{ section.id }}');
    if (!root || typeof Swiper === 'undefined' || root.dataset.swiperInit === 'true') return;
    root.dataset.swiperInit = 'true';

    new Swiper(root.querySelector('.leftSwiper'), {
      loop: true,
      speed: 800,
      pagination: {
        el: root.querySelector('.leftSwiper .swiper-pagination'),
        clickable: true
      }
    });

    new Swiper(root.querySelector('.rightSwiper'), {
      loop: true,
      speed: 800,
      pagination: {
        el: root.querySelector('.rightSwiper .swiper-pagination'),
        clickable: true
      }
    });
  })();
</script>

