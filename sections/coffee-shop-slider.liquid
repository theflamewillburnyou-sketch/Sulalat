<section
  class="coffee-shop"
  data-section-id="{{ section.id }}"
  style="
    --coffee-padding-top: {{ section.settings.section_padding_top }}px;
    --coffee-padding-bottom: {{ section.settings.section_padding_bottom }}px;
    --coffee-bg: {{ section.settings.section_bg_color }};
    --coffee-heading-color: {{ section.settings.heading_color }};
    --coffee-text-color: {{ section.settings.text_color }};
    --coffee-heading-size: {{ section.settings.heading_size }}px;
    --coffee-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --coffee-body-size: {{ section.settings.body_size }}px;
    --coffee-slide-width: {{ section.settings.slide_width }}%;
    --coffee-image-height: {{ section.settings.image_height }}px;
    --coffee-transition-speed: {{ section.settings.transition_speed }}ms;
    --coffee-primary-btn-bg: {{ section.settings.primary_btn_bg }};
    --coffee-primary-btn-text: {{ section.settings.primary_btn_text }};
    --coffee-primary-btn-hover-bg: {{ section.settings.primary_btn_hover_bg }};
    --coffee-primary-btn-hover-text: {{ section.settings.primary_btn_hover_text }};
    --coffee-secondary-btn-bg: {{ section.settings.secondary_btn_bg }};
    --coffee-secondary-btn-text: {{ section.settings.secondary_btn_text }};
    --coffee-secondary-btn-border: {{ section.settings.secondary_btn_border }};
    --coffee-secondary-btn-hover-bg: {{ section.settings.secondary_btn_hover_bg }};
    --coffee-secondary-btn-hover-text: {{ section.settings.secondary_btn_hover_text }};
  "
>
  <style>
    .coffee-shop[data-section-id="{{ section.id }}"] {
      overflow: hidden;
      padding-top: var(--coffee-padding-top);
      padding-bottom: var(--coffee-padding-bottom);
      background: var(--coffee-bg);
    }

    .coffee-shop[data-section-id="{{ section.id }}"] .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 24px;
    }

    .coffee-shop[data-section-id="{{ section.id }}"] .section-title {
      text-align: center;
      margin-bottom: 30px;
      max-width: 950px;
      margin-inline: auto;
    }

    .coffee-shop[data-section-id="{{ section.id }}"] .section-title h2 {
      color: var(--coffee-heading-color);
      font-size: var(--coffee-heading-size);
      font-weight: 400;
      line-height: 1.2;
      margin-bottom: 30px;
    }

    .coffee-shop[data-section-id="{{ section.id }}"] .section-title p {
      color: var(--coffee-text-color);
      font-size: var(--coffee-body-size);
      line-height: 1.5;
      letter-spacing: -0.01em;
      margin-top: 14px;
    }

    .coffee-shop[data-section-id="{{ section.id }}"] .shop-btns {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 45px;
      margin-bottom: 60px;
    }

    .coffee-shop[data-section-id="{{ section.id }}"] .primary-btn,
    .coffee-shop[data-section-id="{{ section.id }}"] .secondary-btn {
      display: inline-block;
      padding: 12px 28px;
      border-radius: 4px;
      font-size: var(--coffee-body-size);
      text-decoration: none;
      transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease;
      cursor: pointer;
    }

    .coffee-shop[data-section-id="{{ section.id }}"] .primary-btn {
      background-color: var(--coffee-primary-btn-bg);
      color: var(--coffee-primary-btn-text);
      border: 1px solid transparent;
    }

    .coffee-shop[data-section-id="{{ section.id }}"] .primary-btn:hover {
      background-color: var(--coffee-primary-btn-hover-bg);
      color: var(--coffee-primary-btn-hover-text);
    }

    .coffee-shop[data-section-id="{{ section.id }}"] .secondary-btn {
      background-color: var(--coffee-secondary-btn-bg);
      color: var(--coffee-secondary-btn-text);
      border: 1px solid var(--coffee-secondary-btn-border);
    }

    .coffee-shop[data-section-id="{{ section.id }}"] .secondary-btn:hover {
      background-color: var(--coffee-secondary-btn-hover-bg);
      color: var(--coffee-secondary-btn-hover-text);
    }

    .coffee-shop[data-section-id="{{ section.id }}"] .swiper.coffeeShopSlider {
      overflow: visible;
    }

    .coffee-shop[data-section-id="{{ section.id }}"] .coffeeShopSlider .swiper-slide {
      width: var(--coffee-slide-width);
      border-radius: 20px;
      overflow: hidden;
      transition: opacity var(--coffee-transition-speed) ease;
      opacity: 0.4;
    }

    .coffee-shop[data-section-id="{{ section.id }}"] .coffeeShopSlider .swiper-slide-active {
      opacity: 1;
    }

    .coffee-shop[data-section-id="{{ section.id }}"] .coffeeShopSlider img {
      width: 100%;
      height: var(--coffee-image-height);
      object-fit: cover;
      display: block;
    }

    .coffee-shop[data-section-id="{{ section.id }}"] .coffeeShopSlider svg.placeholder-svg {
      width: 100%;
      height: var(--coffee-image-height);
      display: block;
    }

    @media (max-width: 767px) {
      .coffee-shop[data-section-id="{{ section.id }}"] .section-title h2 {
        font-size: var(--coffee-heading-size-mobile);
      }
      .coffee-shop[data-section-id="{{ section.id }}"] .shop-btns {
        margin-top: 30px;
        margin-bottom: 40px;
      }
      .coffee-shop[data-section-id="{{ section.id }}"] .coffeeShopSlider .swiper-slide {
        width: 90%;
      }
      .coffee-shop[data-section-id="{{ section.id }}"] .coffeeShopSlider img,
      .coffee-shop[data-section-id="{{ section.id }}"] .coffeeShopSlider svg.placeholder-svg {
        height: 350px;
      }
    }
  </style>

  <div class="container">
    <div class="section-title">
      <h2>{{ section.settings.heading | escape }}</h2>
      {% if section.settings.paragraph_1 != blank %}
        <p>{{ section.settings.paragraph_1 | escape }}</p>
      {% endif %}
      {% if section.settings.paragraph_2 != blank %}
        <p>{{ section.settings.paragraph_2 | escape }}</p>
      {% endif %}
    </div>

    <div class="shop-btns">
      {% if section.settings.button_1_text != blank %}
        <a
          href="{% if section.settings.button_1_link != blank %}{{ section.settings.button_1_link }}{% else %}#{% endif %}"
          class="primary-btn"
        >
          {{ section.settings.button_1_text | escape }}
        </a>
      {% endif %}
      {% if section.settings.button_2_text != blank %}
        <a
          href="{% if section.settings.button_2_link != blank %}{{ section.settings.button_2_link }}{% else %}#{% endif %}"
          class="secondary-btn"
        >
          {{ section.settings.button_2_text | escape }}
        </a>
      {% endif %}
    </div>
  </div>

  <div class="swiper coffeeShopSlider" data-coffee-slider>
    <div class="swiper-wrapper">
      {% for block in section.blocks %}
        <div class="swiper-slide" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            <img
              src="{{ block.settings.image | image_url: width: 1200 }}"
              alt="{{ block.settings.image.alt | escape }}"
              loading="lazy"
            >
          {% else %}
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>

  <script>
    (function () {
      var section = document.querySelector('[data-section-id="{{ section.id }}"]');
      if (!section) return;

      var sliderContainer = section.querySelector('[data-coffee-slider]');
      if (!sliderContainer) return;

      function loadSwiper(callback) {
        if (window.Swiper) {
          callback();
          return;
        }

        if (!document.querySelector('link[href*="swiper-bundle.min.css"]')) {
          var link = document.createElement('link');
          link.rel = 'stylesheet';
          link.href = 'https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css';
          document.head.appendChild(link);
        }

        var script = document.createElement('script');
        script.src = 'https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js';
        script.onload = callback;
        script.onerror = function () {
          console.warn('Swiper failed to load. Coffee slider may not function.');
          sliderContainer.style.overflowX = 'auto';
          sliderContainer.style.webkitOverflowScrolling = 'touch';
        };
        document.head.appendChild(script);
      }

      function initSlider() {
        if (!window.Swiper) return;

        if (sliderContainer.swiper) {
          sliderContainer.swiper.destroy(true, true);
        }

        var autoplayEnabled = {{ section.settings.autoplay_enabled | default: false | json }};
        var autoplayDelay = {{ section.settings.autoplay_delay | default: 5000 | json }};

        sliderContainer.swiper = new window.Swiper(sliderContainer, {
          slidesPerView: 'auto',
          loop: true,
          centeredSlides: true,
          spaceBetween: 0,
          speed: parseInt('{{ section.settings.transition_speed }}', 10) || 600,
          grabCursor: true,
          autoplay: autoplayEnabled ? { delay: autoplayDelay, disableOnInteraction: false } : false,
          breakpoints: {
            768: {
              centeredSlides: true,
              slidesPerView: 'auto'
            },
            0: {
              slidesPerView: 1,
              centeredSlides: true,
              spaceBetween: 10
            }
          }
        });
      }

      loadSwiper(initSlider);

      document.addEventListener('shopify:section:load', function (e) {
        if (e.target && e.target.querySelector('[data-section-id="{{ section.id }}"]')) {
          section = document.querySelector('[data-section-id="{{ section.id }}"]');
          sliderContainer = section ? section.querySelector('[data-coffee-slider]') : null;
          if (sliderContainer) {
            loadSwiper(initSlider);
          }
        }
      });

      document.addEventListener('shopify:section:unload', function (e) {
        if (e.target && e.target.querySelector('[data-section-id="{{ section.id }}"]')) {
          if (sliderContainer && sliderContainer.swiper) {
            sliderContainer.swiper.destroy(true, true);
            sliderContainer.swiper = null;
          }
        }
      });
    })();
  </script>
</section>

{% schema %}
{
  "name": "Coffee Shop Slider",
  "tag": "section",
  "class": "coffee-shop-section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Visit Our Coffee Shop"
    },
    {
      "type": "textarea",
      "id": "paragraph_1",
      "label": "First paragraph",
      "default": "Step into our coffee shop and enjoy freshly brewed coffee crafted from premium beans. Whether you're stopping by for your morning espresso, meeting friends, or looking for a cozy place to relax, our baristas are ready to serve the perfect cup."
    },
    {
      "type": "textarea",
      "id": "paragraph_2",
      "label": "Second paragraph",
      "default": "Discover our signature drinks, freshly roasted beans, and a warm atmosphere made for every coffee enthusiast."
    },
    {
      "type": "text",
      "id": "button_1_text",
      "label": "Primary button text",
      "default": "Visit Our Coffee Shop"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "button_2_text",
      "label": "Secondary button text",
      "default": "Find Us on the Map"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Secondary button link"
    },
    {
      "type": "header",
      "content": "Slider"
    },
    {
      "type": "range",
      "id": "slide_width",
      "label": "Slide width",
      "min": 30,
      "max": 90,
      "step": 1,
      "unit": "%",
      "default": 58
    },
    {
      "type": "range",
      "id": "image_height",
      "label": "Image height",
      "min": 300,
      "max": 800,
      "step": 10,
      "unit": "px",
      "default": 600
    },
    {
      "type": "range",
      "id": "transition_speed",
      "label": "Transition speed",
      "min": 100,
      "max": 1000,
      "step": 50,
      "unit": "ms",
      "default": 600
    },
    {
      "type": "checkbox",
      "id": "autoplay_enabled",
      "label": "Enable autoplay",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_delay",
