<section class="coffee-shop" id="shopify-section-{{ section.id }}">
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <div class="section-title">
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.text_1 != blank -%}
          <p>{{ section.settings.text_1 }}</p>
        {%- endif -%}
        {%- if section.settings.text_2 != blank -%}
          <p>{{ section.settings.text_2 }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.settings.button_1_label != blank or section.settings.button_2_label != blank -%}
      <div class="shop-btns">
        {%- if section.settings.button_1_label != blank -%}
          <a href="{{ section.settings.button_1_link | default: '#' }}" class="primary-btn">
            {{ section.settings.button_1_label }}
          </a>
        {%- endif -%}
        {%- if section.settings.button_2_label != blank -%}
          <a href="{{ section.settings.button_2_link | default: '#' }}" class="secondary-btn">
            {{ section.settings.button_2_label }}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  {%- assign slide_blocks = section.blocks | where: 'type', 'slide' -%}
  {%- if slide_blocks.size > 0 -%}
    <div class="swiper coffeeShopSlider">
      <div class="swiper-wrapper">
        {%- for block in slide_blocks -%}
          <div class="swiper-slide" {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}">
            {%- endif -%}
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 1600 | image_tag: alt: block.settings.image.alt | default: section.settings.heading }}
            {%- endif -%}
            {%- if block.settings.link != blank -%}
              </a>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</section>

{% style %}
  #shopify-section-{{ section.id }} .coffee-shop {
    overflow: hidden;
    padding-bottom: 100px;
  }

  #shopify-section-{{ section.id }} .section-title {
    text-align: center;
    margin-bottom: 0;
    max-width: 950px;
    margin-inline: auto;
  }

  #shopify-section-{{ section.id }} .section-title h2 {
    color: #000;
    font-size: clamp(24px, 3vw, 36px);
    font-weight: 400;
    margin-bottom: 30px;
  }

  #shopify-section-{{ section.id }} .section-title p {
    color: var(--sub-title-clr, #141211);
    font-size: 16px;
    line-height: 24px;
    letter-spacing: -1%;
  }

  #shopify-section-{{ section.id }} .section-title p + p {
    margin-top: 10px;
  }

  #shopify-section-{{ section.id }} .shop-btns {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 45px;
    margin-bottom: 60px;
  }

  #shopify-section-{{ section.id }} .primary-btn,
  #shopify-section-{{ section.id }} .secondary-btn {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: 11px 60px;
    border-radius: 80px;
    font-size: 16px;
    font-family: var(--secondary-font);
    flex-shrink: 0;
    cursor: pointer;
    transition: all 0.5s ease-in-out;
    font-weight: 500;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .primary-btn {
    background: var(--theme-clr, #53C295);
    border: 1px solid var(--theme-clr, #53C295);
    color: #fff;
  }

  #shopify-section-{{ section.id }} .primary-btn:hover {
    color: var(--theme-clr, #53C295);
  }

  #shopify-section-{{ section.id }} .primary-btn::before {
    content: "";
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 0;
    height: 100%;
    background: #fff;
    transition: all 0.5s ease-in-out;
    z-index: -1;
  }

  #shopify-section-{{ section.id }} .primary-btn:hover::before {
    right: auto;
    left: 0;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .secondary-btn {
    background: transparent;
    border: 1px solid var(--theme-clr, #53C295);
    color: var(--theme-clr, #53C295);
  }

  #shopify-section-{{ section.id }} .secondary-btn:hover {
    color: #fff;
  }

  #shopify-section-{{ section.id }} .secondary-btn::before {
    content: "";
    position: absolute;
    top: 0;
    right: 0;
    width: 0;
    height: 100%;
    background: var(--theme-clr, #53C295);
    transition: all 0.5s ease-in-out;
    z-index: -1;
  }

  #shopify-section-{{ section.id }} .secondary-btn:hover::before {
    right: auto;
    left: 0;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .coffeeShopSlider {
    overflow: visible;
  }

  #shopify-section-{{ section.id }} .coffeeShopSlider .swiper-slide {
    width: 58%;
    border-radius: 20px;
    overflow: hidden;
    transition: .6s;
  }

  #shopify-section-{{ section.id }} .coffeeShopSlider img {
    width: 100%;
    height: 600px;
    object-fit: cover;
    display: block;
  }

  #shopify-section-{{ section.id }} .coffeeShopSlider .swiper-slide:not(.swiper-slide-active) {
    opacity: .4;
  }

  #shopify-section-{{ section.id }} .coffeeShopSlider .swiper-slide-active {
    opacity: 1;
  }

  @media (max-width: 992px) {
    #shopify-section-{{ section.id }} .coffeeShopSlider .swiper-slide {
      width: 85%;
    }
    #shopify-section-{{ section.id }} .coffeeShopSlider img {
      height: 400px;
    }
  }
{% endstyle %}

<script>
  (function () {
    var root = document.getElementById('shopify-section-{{ section.id }}');
    if (!root || typeof Swiper === 'undefined' || root.dataset.swiperInit === 'true') return;
    root.dataset.swiperInit = 'true';

    new Swiper(root.querySelector('.coffeeShopSlider'), {
      slidesPerView: 'auto',
      centeredSlides: true,
      spaceBetween: 40,
      loop: false,
      speed: 1000,
      grabCursor: true,
      watchSlidesProgress: true,
      autoplay: {
        delay: 3000,
        disableOnInteraction: false,
        pauseOnMouseEnter: true
      },
      breakpoints: {
        0: { spaceBetween: 15 },
        768: { spaceBetween: 25 },
        1200: { spaceBetween: 40 }
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Coffee shop slider",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Visit Our Coffee Shop"
    },
    {
      "type": "textarea",
      "id": "text_1",
      "label": "Paragraph 1",
      "default": "Step into our coffee shop and enjoy freshly brewed coffee crafted from premium beans. Whether you're stopping by for your morning espresso, meeting friends, or looking for a cozy place to relax, our baristas are ready to serve the perfect cup."
    },
    {
      "type": "textarea",
      "id": "text_2",
      "label": "Paragraph 2",
      "default": "Discover our signature drinks, freshly roasted beans, and a warm atmosphere made for every coffee enthusiast."
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "button_1_label",
      "label": "Primary button text",
      "default": "Visit Our Coffee Shop"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Secondary button text",
      "default": "Find Us on the Map"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Secondary button link"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Coffee shop slider",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
