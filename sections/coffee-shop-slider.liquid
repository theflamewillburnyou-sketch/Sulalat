      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#666666"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "color",
      "id": "primary_btn_bg",
      "label": "Primary button background",
      "default": "#c7a17a"
    },
    {
      "type": "color",
      "id": "primary_btn_text",
      "label": "Primary button text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "primary_btn_hover_bg",
      "label": "Primary button hover background",
      "default": "#b08d5f"
    },
    {
      "type": "color",
      "id": "primary_btn_hover_text",
      "label": "Primary button hover text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "secondary_btn_bg",
      "label": "Secondary button background",
      "default": "transparent"
    },
    {
      "type": "color",
      "id": "secondary_btn_text",
      "label": "Secondary button text",
      "default": "#c7a17a"
    },
    {
      "type": "color",
      "id": "secondary_btn_border",
      "label": "Secondary button border",
      "default": "#c7a17a"
    },
    {
      "type": "color",
      "id": "secondary_btn_hover_bg",
      "label": "Secondary button hover background",
      "default": "#c7a17a"
    },
    {
      "type": "color",
      "id": "secondary_btn_hover_text",
      "label": "Secondary button hover text",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "label": "Bottom padding",
      "min": 0,
