{%- liquid
  assign media_position = section.settings.media_position | default: 'right'
-%}

<section
  class="solution-feature solution-feature--media-{{ media_position }}"
  data-section-id="{{ section.id }}"
>
  <style>
    .solution-feature[data-section-id="{{ section.id }}"] {
      padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
      background: {{ section.settings.background_color }};
      font-family: var(--body-font-family);
    }

    .solution-feature[data-section-id="{{ section.id }}"] .container {
      max-width: var(--brand-container-max, 1440px);
      margin: 0 auto;
      padding: 0 var(--brand-container-padding-x, 20px);
    }

    .solution-feature[data-section-id="{{ section.id }}"] .solution-feature-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
      align-items: stretch;
    }

    .solution-feature[data-section-id="{{ section.id }}"].solution-feature--media-left .solution-feature-media {
      order: 1;
    }

    .solution-feature[data-section-id="{{ section.id }}"].solution-feature--media-left .solution-feature-content {
      order: 2;
    }

    .solution-feature[data-section-id="{{ section.id }}"] .solution-feature-content {
      background: {{ section.settings.card_background }};
      border-radius: 24px;
      padding: 56px 48px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      min-height: 420px;
    }

    .solution-feature[data-section-id="{{ section.id }}"] .solution-feature-tag {
      display: inline-block;
      margin-bottom: 12px;
      color: var(--brand-primary, #53c295);
      font-size: 15px;
      line-height: 1.3;
      font-weight: 500;
    }

    .solution-feature[data-section-id="{{ section.id }}"] .solution-feature-content h2 {
      margin: 0 0 18px;
      color: #000;
      font-size: clamp(22px, 2.5vw, 35px);
      line-height: 1.2;
      font-weight: 400;
    }

    .solution-feature[data-section-id="{{ section.id }}"] .solution-feature-rule {
      width: 100%;
      height: 1px;
      border: 0;
      margin: 0 0 22px;
      background: rgba(0, 0, 0, 0.1);
    }

    .solution-feature[data-section-id="{{ section.id }}"] .solution-feature-content p {
      margin: 0 0 28px;
      max-width: 480px;
      font-size: 16px;
      line-height: 26px;
      letter-spacing: -0.01em;
      color: var(--brand-body-text, #535353);
    }

    .solution-feature[data-section-id="{{ section.id }}"] .solution-feature-content .primary-btn {
      align-self: flex-start;
    }

    .solution-feature[data-section-id="{{ section.id }}"] .solution-feature-media {
      border-radius: 24px;
      overflow: hidden;
      background: #f3f3f3;
      min-height: 420px;
    }

    .solution-feature[data-section-id="{{ section.id }}"] .solution-feature-media img,
    .solution-feature[data-section-id="{{ section.id }}"] .solution-feature-media svg.placeholder-svg {
      width: 100%;
      height: 100%;
      min-height: inherit;
      object-fit: cover;
      display: block;
    }

    @media (max-width: 991px) {
      .solution-feature[data-section-id="{{ section.id }}"] .solution-feature-grid {
        grid-template-columns: 1fr;
        gap: 16px;
      }

      .solution-feature[data-section-id="{{ section.id }}"].solution-feature--media-left .solution-feature-media,
      .solution-feature[data-section-id="{{ section.id }}"].solution-feature--media-left .solution-feature-content {
        order: unset;
      }

      .solution-feature[data-section-id="{{ section.id }}"] .solution-feature-content {
        padding: 36px 28px;
        min-height: 0;
      }

      .solution-feature[data-section-id="{{ section.id }}"] .solution-feature-media {
        min-height: 280px;
      }
    }

    @media (max-width: 767px) {
      .solution-feature[data-section-id="{{ section.id }}"] {
        padding: {{ section.settings.padding_top_mobile }}px 0 {{ section.settings.padding_bottom_mobile }}px;
      }
    }
  </style>

  <div class="container">
    <div class="solution-feature-grid">
      <div class="solution-feature-content">
        {% if section.settings.tag != blank %}
          <span class="solution-feature-tag">{{ section.settings.tag | escape }}</span>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2>{{ section.settings.heading | escape }}</h2>
        {% endif %}
        <hr class="solution-feature-rule">
        {% if section.settings.text != blank %}
          <p>{{ section.settings.text | escape | newline_to_br }}</p>
        {% endif %}
        {% if section.settings.button_label != blank %}
          <a
            class="primary-btn"
            href="{{ section.settings.button_link | default: '#' }}"
            {% if section.settings.button_link == blank %}aria-disabled="true"{% endif %}
          >
            {{ section.settings.button_label | escape }}
          </a>
        {% endif %}
      </div>
      <div class="solution-feature-media">
        {% if section.settings.image != blank %}
          {{
            section.settings.image
            | image_url: width: 1400
            | image_tag:
              loading: 'lazy',
              widths: '400, 600, 800, 1000, 1200, 1400',
              sizes: '(min-width: 992px) 50vw, 100vw',
              alt: section.settings.heading
          }}
        {% else %}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Solution feature",
  "tag": "section",
  "class": "solution-feature-section",
  "settings": [
    {
      "type": "text",
      "id": "tag",
      "label": "Tag",
      "default": "Bean-to-Bar Perfection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Chocolate"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Sulalat chocolate is crafted from carefully selected cacao, transformed in-house from bean to finished product. Our chocolate serves both professionals and everyday connoisseurs."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "Image position",
      "options": [
        { "value": "right", "label": "Image right" },
        { "value": "left", "label": "Image left" }
      ],
      "default": "right"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#eaf8f1"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Content background",
      "default": "#eaf8f1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding top (mobile)",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom (mobile)",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "Solution feature"
    }
  ]
}
{% endschema %}
