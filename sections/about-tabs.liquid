        <div class="tab-placeholder">
          {% if section.settings.partners_content != blank %}
            {{ section.settings.partners_content }}
          {% else %}
            <h2>{{ section.settings.tab_partners_label | escape }}</h2>
            <p>{{ section.settings.placeholder_text | escape }}</p>
          {% endif %}
        </div>
      </div>
    </div>

    <!-- Careers -->
    <div class="tab-panel" id="careers-{{ section.id }}" role="tabpanel">
      <div class="container">
        <div class="tab-placeholder">
          {% if section.settings.careers_content != blank %}
            {{ section.settings.careers_content }}
          {% else %}
            <h2>{{ section.settings.tab_careers_label | escape }}</h2>
            <p>{{ section.settings.placeholder_text | escape }}</p>
          {% endif %}
        </div>
      </div>
    </div>
  </div>

  <script>
    (function () {
      var sectionId = '{{ section.id }}';
      var section = document.querySelector('.about-tabs[data-section-id="' + sectionId + '"]');
      if (!section) return;

      var imageSliderEl = section.querySelector('[data-timeline-image-slider]');
      var contentSliderEl = section.querySelector('[data-timeline-content-slider]');
      var progressBar = section.querySelector('[data-timeline-progress-bar]');
      var yearBtns = section.querySelectorAll('.year-btn');
      var prevBtn = section.querySelector('.timeline-prev');
      var nextBtn = section.querySelector('.timeline-next');
      var timelineImage = null;
      var timelineContent = null;

      function initTabs() {
        if (section.dataset.tabsBound === 'true') return;
        section.dataset.tabsBound = 'true';

        section.addEventListener('click', function (event) {
          var btn = event.target.closest('.tab-btn[data-section-id="' + sectionId + '"]');
          if (!btn || !section.contains(btn)) return;

          var tab = btn.getAttribute('data-tab');
          section.querySelectorAll('.tab-btn[data-section-id="' + sectionId + '"]').forEach(function (b) {
            b.classList.remove('active');
            b.setAttribute('aria-selected', 'false');
          });
          btn.classList.add('active');
          btn.setAttribute('aria-selected', 'true');

          section.querySelectorAll('.tab-panel').forEach(function (panel) {
            panel.classList.remove('active');
          });

          var target = section.querySelector('#' + tab + '-' + sectionId);
          if (target) target.classList.add('active');
        });
      }

      function updateTimeline(index) {
        if (!yearBtns.length) return;

        yearBtns.forEach(function (btn) {
          btn.classList.remove('active');
        });

        if (yearBtns[index]) {
          yearBtns[index].classList.add('active');
        }

        if (progressBar) {
          var total = yearBtns.length - 1;
          var percentage = total > 0 ? (index / total) * 100 : 0;
          progressBar.style.width = percentage + '%';
        }
      }

      function loadSwiper(callback) {
        if (window.Swiper) {
          callback();
          return;
        }

        if (!document.querySelector('link[href*="swiper-bundle.min.css"]')) {
          var link = document.createElement('link');
          link.rel = 'stylesheet';
          link.href = 'https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css';
          document.head.appendChild(link);
        }

        var script = document.createElement('script');
        script.src = 'https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js';
        script.onload = callback;
        script.onerror = function () {
          console.warn('Swiper failed to load. Timeline slider may not function.');
        };
        document.head.appendChild(script);
      }

      function initTimeline() {
        if (!imageSliderEl || !contentSliderEl || !window.Swiper) return;

        if (imageSliderEl.swiper) {
          imageSliderEl.swiper.destroy(true, true);
        }
        if (contentSliderEl.swiper) {
          contentSliderEl.swiper.destroy(true, true);
        }

        timelineImage = new window.Swiper(imageSliderEl, {
          slidesPerView: 1,
          speed: 800,
          allowTouchMove: false
        });

        timelineContent = new window.Swiper(contentSliderEl, {
          slidesPerView: 1,
          speed: 800,
          allowTouchMove: false
        });

        timelineImage.controller.control = timelineContent;
        timelineContent.controller.control = timelineImage;

        timelineImage.on('slideChange', function () {
          updateTimeline(this.activeIndex);
        });

        updateTimeline(0);

        if (prevBtn) {
          prevBtn.onclick = function () {
            timelineImage.slidePrev();
          };
        }

        if (nextBtn) {
          nextBtn.onclick = function () {
            timelineImage.slideNext();
          };
        }

        yearBtns.forEach(function (btn, index) {
          btn.onclick = function () {
            timelineImage.slideTo(index);
          };
        });
      }

      initTabs();
      loadSwiper(initTimeline);

      document.addEventListener('shopify:section:load', function (e) {
        if (e.target && e.target.querySelector('.about-tabs[data-section-id="' + sectionId + '"]')) {
          section = document.querySelector('.about-tabs[data-section-id="' + sectionId + '"]');
          imageSliderEl = section.querySelector('[data-timeline-image-slider]');
          contentSliderEl = section.querySelector('[data-timeline-content-slider]');
          progressBar = section.querySelector('[data-timeline-progress-bar]');
          yearBtns = section.querySelectorAll('.year-btn');
          prevBtn = section.querySelector('.timeline-prev');
          nextBtn = section.querySelector('.timeline-next');
          initTabs();
          loadSwiper(initTimeline);
        }
      });

      document.addEventListener('shopify:section:unload', function (e) {
        if (e.target && e.target.querySelector('.about-tabs[data-section-id="' + sectionId + '"]')) {
          if (imageSliderEl && imageSliderEl.swiper) {
            imageSliderEl.swiper.destroy(true, true);
          }
          if (contentSliderEl && contentSliderEl.swiper) {
            contentSliderEl.swiper.destroy(true, true);
          }
        }
      });
    })();
  </script>
</section>

