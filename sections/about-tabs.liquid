{%- liquid
  assign timeline_blocks = section.blocks | where: 'type', 'timeline_item'
  assign culture_blocks = section.blocks | where: 'type', 'culture_value'
  assign certificate_blocks = section.blocks | where: 'type', 'certificate'
  assign social_blocks = section.blocks | where: 'type', 'social_farm'
  assign executive_blocks = section.blocks | where: 'type', 'executive_member'
  assign team_blocks = section.blocks | where: 'type', 'team_member'
  assign partner_blocks = section.blocks | where: 'type', 'partner_logo'
  assign career_blocks = section.blocks | where: 'type', 'career_position'
-%}

<section class="about-tabs" data-section-id="{{ section.id }}">
  <style>
    .about-tabs[data-section-id="{{ section.id }}"] {
      font-family: var(--body-font-family);
    }

    .about-tabs[data-section-id="{{ section.id }}"] .container {
      max-width: var(--brand-container-max, 1440px);
      margin: 0 auto;
      padding: 0 var(--brand-container-padding-x, 20px);
    }

    .about-tabs[data-section-id="{{ section.id }}"] .tabs-wrapper {
      position: sticky;
      top: 0;
      z-index: 5;
      background: #eefaf5;
      padding: 20px 0;
    }

    .about-tabs[data-section-id="{{ section.id }}"] .tabs-nav {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 15px;
      width: 100%;
      max-width: var(--brand-container-max, 1440px);
      margin: 0 auto;
      padding: 0 var(--brand-container-padding-x, 20px);
    }

    .about-tabs[data-section-id="{{ section.id }}"] .tab-btn {
      border: none;
      background: transparent;
      cursor: pointer;
      transition: 0.3s;
      font-size: 17px;
      line-height: 18px;
      letter-spacing: 0.03em;
      font-weight: 400;
      opacity: 0.8;
      color: #000000;
      font-family: var(--body-font-family);
      border-radius: 12px;
      padding: 25px 35px;
    }

    .about-tabs[data-section-id="{{ section.id }}"] .tab-btn.active {
      background: var(--brand-primary, #53c295);
      color: #fff;
      opacity: 1;
    }

    .about-tabs[data-section-id="{{ section.id }}"] .tab-panel {
      display: none;
    }

    .about-tabs[data-section-id="{{ section.id }}"] .tab-panel.active {
      display: block;
      animation: about-tab-fade-{{ section.id }} 0.4s ease;
    }

    @keyframes about-tab-fade-{{ section.id }} {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .about-tabs[data-section-id="{{ section.id }}"] .tab-placeholder {
      padding: 100px 0;
      text-align: center;
      color: var(--brand-body-text, #535353);
      font-size: 16px;
      line-height: 1.6;
    }

    .about-tabs[data-section-id="{{ section.id }}"] .tab-placeholder h2 {
      font-size: clamp(28px, 3vw, 45px);
      font-weight: 400;
      color: #000;
      margin-bottom: 20px;
    }

    /* Who We Are */
    .about-tabs[data-section-id="{{ section.id }}"] .who-we-are {
      padding: 100px 0;
    }

    .about-tabs[data-section-id="{{ section.id }}"] .who-grid {
      display: grid;
      grid-template-columns: 1.1fr 1fr;
      align-items: center;
      gap: 80px;
      max-width: 1311px;
      margin: 0 auto;
    }

    .about-tabs[data-section-id="{{ section.id }}"] .who-image img,
    .about-tabs[data-section-id="{{ section.id }}"] .who-image svg.placeholder-svg {
      width: 100%;
      display: block;
      border-radius: 20px;
    }

    .about-tabs[data-section-id="{{ section.id }}"] .section-tag {
      display: inline-block;
      margin-bottom: 20px;
      color: var(--brand-primary, #53c295);
      text-transform: capitalize;
      font-size: 16px;
      line-height: 24px;
      letter-spacing: -0.01em;
      font-weight: 400;
    }

    .about-tabs[data-section-id="{{ section.id }}"] .who-content h2 {
      color: #000;
      font-size: clamp(32px, 3vw, 45px);
      font-weight: 400;
      margin-bottom: 30px;
      line-height: 1.15;
    }

    .about-tabs[data-section-id="{{ section.id }}"] .who-content p {
      font-size: 16px;
      line-height: 24px;
      letter-spacing: -0.01em;
      font-weight: 400;
      color: var(--brand-body-text, #535353);
      margin-bottom: 24px;
      max-width: 557px;
    }

    .about-tabs[data-section-id="{{ section.id }}"] .who-content p:last-child {
      margin-bottom: 0;
    }

    /* Timeline */
    .about-tabs[data-section-id="{{ section.id }}"] .timeline-section {
      padding: 0 0 100px;
    }

    .about-tabs[data-section-id="{{ section.id }}"] .section-title {
      text-align: center;
      margin-bottom: 60px;
      max-width: 950px;
      margin-inline: auto;
    }

    .about-tabs[data-section-id="{{ section.id }}"] .section-title h2 {
      color: #000;
      font-size: clamp(32px, 3vw, 45px);
      font-weight: 400;
      line-height: 1.2;
      margin-bottom: 15px;
    }

    .about-tabs[data-section-id="{{ section.id }}"] .section-title p {
      color: var(--brand-body-text, #535353);
      font-size: 16px;
      line-height: 1.5;
      letter-spacing: -0.01em;
      margin: 0;
    }

    .about-tabs[data-section-id="{{ section.id }}"] .timeline-wrapper {
      display: flex;
      gap: 30px;
      margin-top: 60px;
      margin-bottom: 25px;
    }

    .about-tabs[data-section-id="{{ section.id }}"] .timeline-image-slider {
      width: 60%;
    }

    .about-tabs[data-section-id="{{ section.id }}"] .timeline-content-slider {
      width: 40%;
      background: #edf8f3;
      border-radius: 12px;
    }

    .about-tabs[data-section-id="{{ section.id }}"] .timeline-content-slider .swiper-slide {
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 40px;
      height: auto;
    }

    .about-tabs[data-section-id="{{ section.id }}"] .timeline-year {
      color: var(--brand-primary, #53c295);
      font-size: 60px;
      line-height: 0.8;
      letter-spacing: -0.01em;
      font-weight: 400;
      border-bottom: 1px solid hsl(0deg 0% 0% / 14%);
      display: block;
      margin-bottom: 30px;
      padding-bottom: 30px;
    }

    .about-tabs[data-section-id="{{ section.id }}"] .timeline-card h3 {
      color: #000000;
      font-size: 35px;
      font-weight: 400;
      margin-bottom: 20px;
      line-height: 1.15;
    }

    .about-tabs[data-section-id="{{ section.id }}"] .timeline-card p {
      color: #535353;
      text-align: left;
      font-size: 16px;
      line-height: 24px;
      letter-spacing: -0.01em;
      font-weight: 400;
      margin: 0;
    }

    .about-tabs[data-section-id="{{ section.id }}"] .timeline-image-slider img,
    .about-tabs[data-section-id="{{ section.id }}"] .timeline-image-slider svg.placeholder-svg {
      width: 100%;
      height: 495px;
      object-fit: cover;
      border-radius: 20px;
      display: block;
    }

    .about-tabs[data-section-id="{{ section.id }}"] .timeline-footer {
      display: flex;
      justify-content: center;
      align-items: center;
      flex-wrap: wrap;
      gap: 30px;
    }

    .about-tabs[data-section-id="{{ section.id }}"] .timeline-progress {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex: 1;
      max-width: 700px;
      min-width: 200px;
    }

    .about-tabs[data-section-id="{{ section.id }}"] .timeline-progress::before {
      content: "";
      position: absolute;
      left: 0;
      right: 0;
      top: 50%;
      height: 2px;
      background: #d7d7d7;
      transform: translateY(-50%);
      z-index: 0;
    }

    .about-tabs[data-section-id="{{ section.id }}"] .progress-bar {
      position: absolute;
      left: 0;
      top: 50%;
      height: 2px;
      width: 0;
      background: var(--brand-primary, #53c295);
      transform: translateY(-50%);
      transition: 0.5s;
      z-index: 1;
      pointer-events: none;
    }

    .about-tabs[data-section-id="{{ section.id }}"] .year-btn {
      position: relative;
      z-index: 2;
      background: #fff;
      border: none;
      cursor: pointer;
      padding: 0 8px;
      font-size: 24px;
      color: var(--brand-muted-text, #535353);
      transition: 0.3s;
      font-family: var(--body-font-family);
    }

    .about-tabs[data-section-id="{{ section.id }}"] .year-btn.active {
      color: var(--brand-primary, #53c295);
    }

    .about-tabs[data-section-id="{{ section.id }}"] .year-btn:has(~ .year-btn.active) {
      color: var(--brand-primary, #53c295);
    }

    .about-tabs[data-section-id="{{ section.id }}"] .timeline-buttons {
      display: flex;
      gap: 15px;
    }

    .about-tabs[data-section-id="{{ section.id }}"] .timeline-buttons button {
      border-radius: 50%;
      width: 59px;
      height: 59px;
      border: 1px solid var(--brand-primary, #53c295);
      background: transparent;
      color: var(--brand-primary, #53c295);
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0;
      transition: 0.3s;
    }

    .about-tabs[data-section-id="{{ section.id }}"] .timeline-buttons button:hover {
      background: var(--brand-primary, #53c295);
      color: #fff;
    }

    .about-tabs[data-section-id="{{ section.id }}"] .timeline-buttons button svg {
      display: block;
    }

    /* Vision & Mission */
    .about-tabs[data-section-id="{{ section.id }}"] .vision-mission {
      padding: 100px 0;
    }

    .about-tabs[data-section-id="{{ section.id }}"] .vision-grid {
      display: flex;
      flex-wrap: wrap;
      --gap: 20px;
      gap: var(--gap);
    }

    .about-tabs[data-section-id="{{ section.id }}"] .vision-image {
      width: calc(60% - (var(--gap) / 2));
      overflow: hidden;
      border-radius: 20px;
    }

    .about-tabs[data-section-id="{{ section.id }}"] .vision-card {
      width: calc(40% - (var(--gap) / 2));
      background: #edf8f4;
      border-radius: 20px;
      display: flex;
      align-items: center;
      padding: 60px 40px;
    }

    .about-tabs[data-section-id="{{ section.id }}"] .vision-content {
      max-width: 420px;
    }

    .about-tabs[data-section-id="{{ section.id }}"] .vision-content h2 {
      line-height: 1.15;
      margin-bottom: 18px;
      color: #000000;
      font-size: clamp(36px, 4vw, 55px);
      font-weight: 400;
    }

    .about-tabs[data-section-id="{{ section.id }}"] .vision-content p {
      font-size: 16px;
      line-height: 24px;
      letter-spacing: -0.01em;
      font-weight: 400;
      color: var(--brand-body-text, #535353);
      margin: 0;
    }

    .about-tabs[data-section-id="{{ section.id }}"] .vision-image img,
    .about-tabs[data-section-id="{{ section.id }}"] .vision-image svg.placeholder-svg {
      width: 100%;
      height: 430px;
      object-fit: cover;
      display: block;
      transition: 0.6s ease;
    }

    .about-tabs[data-section-id="{{ section.id }}"] .vision-image:hover img {
      transform: scale(1.08);
    }

    /* Culture & Values */
    .about-tabs[data-section-id="{{ section.id }}"] .culture-values {
      padding: 0 0 100px;
    }

    .about-tabs[data-section-id="{{ section.id }}"] .culture-wrapper {
      display: flex;
      flex-wrap: wrap;
      overflow: hidden;
      border-radius: 24px;
    }

    .about-tabs[data-section-id="{{ section.id }}"] .culture-content,
    .about-tabs[data-section-id="{{ section.id }}"] .culture-image {
      width: 50%;
    }

    .about-tabs[data-section-id="{{ section.id }}"] .culture-content {
      background: #edf8f4;
      padding: 70px 48px;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .about-tabs[data-section-id="{{ section.id }}"] .culture-content h2 {
      line-height: 1.15;
      margin-bottom: 35px;
      color: #000000;
      font-size: clamp(36px, 4vw, 55px);
      font-weight: 400;
    }

    .about-tabs[data-section-id="{{ section.id }}"] .culture-content p {
      line-height: 1.7;
      margin-bottom: 20px;
      color: var(--brand-muted-text, #535353);
      text-align: left;
      font-size: 16px;
    }

    .about-tabs[data-section-id="{{ section.id }}"] .culture-content p:last-of-type {
      margin-bottom: 0;
    }

    .about-tabs[data-section-id="{{ section.id }}"] .culture-image {
      overflow: hidden;
    }

    .about-tabs[data-section-id="{{ section.id }}"] .culture-image img,
    .about-tabs[data-section-id="{{ section.id }}"] .culture-image svg.placeholder-svg {
      width: 100%;
      height: 100%;
      min-height: 620px;
      object-fit: cover;
      display: block;
      transition: 0.6s;
    }

    .about-tabs[data-section-id="{{ section.id }}"] .culture-image:hover img {
      transform: scale(1.08);
    }

    .about-tabs[data-section-id="{{ section.id }}"] .culture-list {
      margin: 15px 0 0;
      padding: 0;
      list-style: none;
    }

    .about-tabs[data-section-id="{{ section.id }}"] .culture-list li {
      display: flex;
      align-items: center;
      gap: 12px;
      font-weight: 400;
      line-height: 1.7;
      margin-bottom: 15px;
      color: var(--brand-muted-text, #535353);
      text-align: left;
      font-size: 16px;
    }

    .about-tabs[data-section-id="{{ section.id }}"] .culture-list li::before {
      content: "✓";
      width: 20px;
      height: 20px;
      border-radius: 50%;
      background: var(--brand-primary, #53c295);
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 12px;
      font-weight: 700;
      flex-shrink: 0;
    }

    /* Certificates */
    .about-tabs[data-section-id="{{ section.id }}"] .certificates {
      padding: 100px 0;
    }

    .about-tabs[data-section-id="{{ section.id }}"] .certificate-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 40px;
    }

    .about-tabs[data-section-id="{{ section.id }}"] .certificate-card {
      width: 100%;
      border: 1px solid #e6e6e6;
      border-radius: 12px;
      padding: 45px 25px;
      text-align: center;
      background: #fff;
      transition: 0.35s ease;
    }

    .about-tabs[data-section-id="{{ section.id }}"] .certificate-card img,
    .about-tabs[data-section-id="{{ section.id }}"] .certificate-card svg.placeholder-svg {
      width: auto;
      max-width: 100%;
      height: auto;
      max-height: 120px;
      aspect-ratio: 1;
      object-fit: contain;
      margin: 0 auto 20px;
      display: block;
      transition: 0.35s;
    }

    .about-tabs[data-section-id="{{ section.id }}"] .certificate-card h4 {
      text-align: center;
      font-size: 25px;
      font-weight: 400;
      color: var(--brand-muted-text, #535353);
      margin: 0;
    }

    .about-tabs[data-section-id="{{ section.id }}"] .certificate-card:hover {
      border-color: var(--brand-primary, #53c295);
      box-shadow: 0 18px 40px rgba(0, 0, 0, 0.08);
    }

    /* Social Responsibility */
    .about-tabs[data-section-id="{{ section.id }}"] .social-responsibility {
      padding: 100px 0;
    }

    .about-tabs[data-section-id="{{ section.id }}"] .social-farm-list {
      display: flex;
      flex-direction: column;
      gap: 80px;
      max-width: 1311px;
      margin: 0 auto;
    }

    .about-tabs[data-section-id="{{ section.id }}"] .social-farm-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-items: center;
      gap: 60px;
    }

    .about-tabs[data-section-id="{{ section.id }}"] .social-farm-row--image-right .social-farm-image {
      order: 2;
    }

    .about-tabs[data-section-id="{{ section.id }}"] .social-farm-row--image-right .social-farm-content {
      order: 1;
    }

    .about-tabs[data-section-id="{{ section.id }}"] .social-farm-image {
      width: 100%;
      overflow: hidden;
      border-radius: 20px;
    }

    .about-tabs[data-section-id="{{ section.id }}"] .social-farm-image img,
    .about-tabs[data-section-id="{{ section.id }}"] .social-farm-image svg.placeholder-svg {
      width: 100%;
      height: 480px;
      object-fit: cover;
      display: block;
      border-radius: 20px;
    }

    .about-tabs[data-section-id="{{ section.id }}"] .social-farm-content {
      max-width: 480px;
    }

    .about-tabs[data-section-id="{{ section.id }}"] .social-farm-row--image-right .social-farm-content {
      margin-left: auto;
      margin-right: 0;
    }

    .about-tabs[data-section-id="{{ section.id }}"] .social-farm-content h3 {
      margin: 0 0 20px;
      color: #000;
      font-size: clamp(28px, 2.8vw, 40px);
      line-height: 1.2;
      font-weight: 600;
    }

    .about-tabs[data-section-id="{{ section.id }}"] .social-farm-content p {
      margin: 0 0 28px;
      font-size: 16px;
      line-height: 24px;
      letter-spacing: -0.01em;
      font-weight: 400;
      color: var(--brand-body-text, #535353);
    }

    .about-tabs[data-section-id="{{ section.id }}"] .social-farm-content .primary-btn {
      display: inline-flex;
    }

    /* Leadership & Team */
    .about-tabs[data-section-id="{{ section.id }}"] .leadership-team {
      padding: 100px 0 80px;
    }

    .about-tabs[data-section-id="{{ section.id }}"] .leadership-block + .leadership-block {
      margin-top: 100px;
    }

    .about-tabs[data-section-id="{{ section.id }}"] .leadership-intro {
      text-align: center;
      max-width: 720px;
      margin: 0 auto 50px;
    }

    .about-tabs[data-section-id="{{ section.id }}"] .leadership-intro h2 {
      margin: 0 0 16px;
      color: #000;
      font-size: clamp(32px, 3.2vw, 48px);
      line-height: 1.2;
      font-weight: 600;
    }

    .about-tabs[data-section-id="{{ section.id }}"] .leadership-intro p {
      margin: 0;
      font-size: 16px;
      line-height: 24px;
      letter-spacing: -0.01em;
      color: var(--brand-body-text, #535353);
    }

    .about-tabs[data-section-id="{{ section.id }}"] .leadership-slider {
      overflow: visible;
      margin: 0 auto;
    }

    .about-tabs[data-section-id="{{ section.id }}"] .leadership-slider .swiper-wrapper {
      align-items: stretch;
    }

    .about-tabs[data-section-id="{{ section.id }}"] .leadership-slider .swiper-slide {
      height: auto;
      transition: transform 0.45s ease, opacity 0.45s ease;
      opacity: 0.55;
    }

    .about-tabs[data-section-id="{{ section.id }}"] .leadership-slider .swiper-slide-active {
      opacity: 1;
      z-index: 2;
    }

    .about-tabs[data-section-id="{{ section.id }}"] .executive-slider .swiper-slide {
      width: min(520px, 72vw);
    }

    .about-tabs[data-section-id="{{ section.id }}"] .people-slider .swiper-slide {
      width: min(220px, 42vw);
    }

    .about-tabs[data-section-id="{{ section.id }}"] .leadership-card-image {
      position: relative;
      overflow: hidden;
      border-radius: 20px;
      background: #f3f3f3;
    }

    .about-tabs[data-section-id="{{ section.id }}"] .executive-slider .leadership-card-image {
      aspect-ratio: 4 / 5;
    }

    .about-tabs[data-section-id="{{ section.id }}"] .people-slider .leadership-card-image {
      aspect-ratio: 3 / 4;
    }

    .about-tabs[data-section-id="{{ section.id }}"] .leadership-card-image img,
    .about-tabs[data-section-id="{{ section.id }}"] .leadership-card-image svg.placeholder-svg {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .about-tabs[data-section-id="{{ section.id }}"] .leadership-linkedin {
      position: absolute;
      top: 18px;
      left: 18px;
      width: 42px;
      height: 42px;
      border-radius: 50%;
      background: var(--brand-primary, #53c295);
      color: #fff;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      text-decoration: none;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s ease;
      z-index: 2;
    }

    .about-tabs[data-section-id="{{ section.id }}"] .swiper-slide-active .leadership-linkedin {
      opacity: 1;
      pointer-events: auto;
    }

    .about-tabs[data-section-id="{{ section.id }}"] .leadership-linkedin svg {
      width: 18px;
      height: 18px;
      display: block;
    }

    .about-tabs[data-section-id="{{ section.id }}"] .executive-meta {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      max-width: 520px;
      margin: 28px auto 0;
      min-height: 72px;
    }

    .about-tabs[data-section-id="{{ section.id }}"] .executive-meta-text h3 {
      margin: 0 0 6px;
      color: #000;
      font-size: 28px;
      line-height: 1.2;
      font-weight: 600;
    }

    .about-tabs[data-section-id="{{ section.id }}"] .executive-meta-text p {
      margin: 0;
      color: var(--brand-body-text, #535353);
      font-size: 16px;
      line-height: 1.4;
    }

    .about-tabs[data-section-id="{{ section.id }}"] .executive-meta .primary-btn {
      flex-shrink: 0;
      padding: 12px 28px;
      white-space: nowrap;
    }

    .about-tabs[data-section-id="{{ section.id }}"] .executive-meta .primary-btn.is-hidden {
      display: none;
    }

    .about-tabs[data-section-id="{{ section.id }}"] .people-meta {
      text-align: center;
      max-width: 320px;
      margin: 28px auto 0;
      min-height: 72px;
    }

    .about-tabs[data-section-id="{{ section.id }}"] .people-meta h3 {
      margin: 0 0 8px;
      color: #000;
      font-size: 22px;
      line-height: 1.2;
      font-weight: 600;
    }

    .about-tabs[data-section-id="{{ section.id }}"] .people-meta p {
      margin: 0;
      color: var(--brand-body-text, #535353);
      font-size: 15px;
      line-height: 1.4;
    }

    .about-tabs[data-section-id="{{ section.id }}"] .people-meta-line {
      width: 48px;
      height: 2px;
      background: #d7d7d7;
