      }

      .about-tabs[data-section-id="{{ section.id }}"] .career-card-text {
        grid-column: 1 / -1;
      }

      .about-tabs[data-section-id="{{ section.id }}"] .partners-filter {
        gap: 24px;
        margin-bottom: 32px;
      }

      .about-tabs[data-section-id="{{ section.id }}"] .partners-grid {
        grid-template-columns: 1fr 1fr;
      }

      .about-tabs[data-section-id="{{ section.id }}"] .executive-meta-text h3 {
        font-size: 22px;
      }

      .about-tabs[data-section-id="{{ section.id }}"] .team-nav-buttons button {
        width: 44px;
        height: 44px;
      }

      .about-tabs[data-section-id="{{ section.id }}"] .social-farm-list {
        gap: 48px;
      }

      .about-tabs[data-section-id="{{ section.id }}"] .social-farm-image img,
      .about-tabs[data-section-id="{{ section.id }}"] .social-farm-image svg.placeholder-svg {
        height: 280px;
      }

      .about-tabs[data-section-id="{{ section.id }}"] .timeline-section,
      .about-tabs[data-section-id="{{ section.id }}"] .culture-values {
        padding-bottom: 60px;
      }

      .about-tabs[data-section-id="{{ section.id }}"] .certificate-grid {
        grid-template-columns: 1fr;
      }

      .about-tabs[data-section-id="{{ section.id }}"] .timeline-year {
        font-size: 42px;
      }

      .about-tabs[data-section-id="{{ section.id }}"] .timeline-card h3 {
        font-size: 28px;
      }

      .about-tabs[data-section-id="{{ section.id }}"] .culture-content {
        padding: 40px 24px;
      }

      .about-tabs[data-section-id="{{ section.id }}"] .vision-card {
        padding: 40px 24px;
      }

      .about-tabs[data-section-id="{{ section.id }}"] .timeline-footer {
        flex-direction: column;
      }

      .about-tabs[data-section-id="{{ section.id }}"] .timeline-progress {
        width: 100%;
        max-width: none;
      }
    }
  </style>

  <div class="tabs-wrapper">
    <div class="tabs-nav" role="tablist" aria-label="{{ section.settings.tabs_aria_label | escape }}">
      <button type="button" class="tab-btn active" role="tab" aria-selected="true" data-tab="who" data-section-id="{{ section.id }}">
        {{ section.settings.tab_who_label | escape }}
      </button>
      <button type="button" class="tab-btn" role="tab" aria-selected="false" data-tab="vision" data-section-id="{{ section.id }}">
        {{ section.settings.tab_vision_label | escape }}
      </button>
      <button type="button" class="tab-btn" role="tab" aria-selected="false" data-tab="certifications" data-section-id="{{ section.id }}">
        {{ section.settings.tab_certifications_label | escape }}
      </button>
      <button type="button" class="tab-btn" role="tab" aria-selected="false" data-tab="social" data-section-id="{{ section.id }}">
        {{ section.settings.tab_social_label | escape }}
      </button>
      <button type="button" class="tab-btn" role="tab" aria-selected="false" data-tab="leadership" data-section-id="{{ section.id }}">
        {{ section.settings.tab_leadership_label | escape }}
      </button>
      <button type="button" class="tab-btn" role="tab" aria-selected="false" data-tab="partners" data-section-id="{{ section.id }}">
        {{ section.settings.tab_partners_label | escape }}
      </button>
      <button type="button" class="tab-btn" role="tab" aria-selected="false" data-tab="careers" data-section-id="{{ section.id }}">
        {{ section.settings.tab_careers_label | escape }}
      </button>
    </div>
  </div>

  <div class="about-tab-content">
    <!-- Who We Are -->
    <div class="tab-panel active" id="who-{{ section.id }}" role="tabpanel">
      <section class="who-we-are">
        <div class="container">
          <div class="who-grid">
            <div class="who-image">
              {% if section.settings.who_image != blank %}
                <img
                  src="{{ section.settings.who_image | image_url: width: 900 }}"
                  alt="{{ section.settings.who_image.alt | default: section.settings.who_tag | escape }}"
                  loading="lazy"
                  width="{{ section.settings.who_image.width }}"
                  height="{{ section.settings.who_image.height }}"
                >
              {% else %}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              {% endif %}
            </div>
            <div class="who-content">
              {% if section.settings.who_tag != blank %}
                <span class="section-tag">{{ section.settings.who_tag | escape }}</span>
              {% endif %}
              {% if section.settings.who_heading != blank %}
                <h2>{{ section.settings.who_heading }}</h2>
              {% endif %}
              {% if section.settings.who_paragraph_1 != blank %}
                <p>{{ section.settings.who_paragraph_1 | escape }}</p>
              {% endif %}
              {% if section.settings.who_paragraph_2 != blank %}
                <p>{{ section.settings.who_paragraph_2 | escape }}</p>
              {% endif %}
            </div>
          </div>
        </div>
      </section>

      {% if timeline_blocks.size > 0 %}
        <section class="timeline-section">
          <div class="container">
            <div class="section-title">
              {% if section.settings.timeline_heading != blank %}
                <h2>{{ section.settings.timeline_heading | escape }}</h2>
              {% endif %}
              {% if section.settings.timeline_subheading != blank %}
                <p>{{ section.settings.timeline_subheading | escape }}</p>
              {% endif %}
            </div>

            <div class="timeline-wrapper">
              <div class="timeline-image-slider swiper" data-timeline-image-slider>
                <div class="swiper-wrapper">
                  {% for block in timeline_blocks %}
                    <div class="swiper-slide" {{ block.shopify_attributes }}>
                      {% if block.settings.image != blank %}
                        <img
                          src="{{ block.settings.image | image_url: width: 1000 }}"
                          alt="{{ block.settings.image.alt | default: block.settings.heading | escape }}"
                          loading="lazy"
                        >
                      {% else %}
                        {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                      {% endif %}
                    </div>
                  {% endfor %}
                </div>
              </div>

              <div class="timeline-content-slider swiper" data-timeline-content-slider>
                <div class="swiper-wrapper">
                  {% for block in timeline_blocks %}
                    <div class="swiper-slide" {{ block.shopify_attributes }}>
                      <div class="timeline-card">
                        {% if block.settings.year != blank %}
                          <span class="timeline-year">{{ block.settings.year | escape }}</span>
                        {% endif %}
                        {% if block.settings.heading != blank %}
                          <h3>{{ block.settings.heading | escape }}</h3>
                        {% endif %}
                        {% if block.settings.text != blank %}
                          <p>{{ block.settings.text | escape }}</p>
                        {% endif %}
                      </div>
                    </div>
                  {% endfor %}
                </div>
              </div>
            </div>

            <div class="timeline-footer">
              <div class="timeline-progress" data-timeline-progress>
                {% for block in timeline_blocks %}
                  <button
                    type="button"
                    class="year-btn{% if forloop.first %} active{% endif %}"
                    data-timeline-index="{{ forloop.index0 }}"
                  >
                    {{ block.settings.year | escape }}
                  </button>
                {% endfor %}
                <span class="progress-bar" data-timeline-progress-bar></span>
              </div>
              <div class="timeline-buttons">
                <button type="button" class="timeline-prev" aria-label="Previous timeline slide">
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
                    <path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </button>
                <button type="button" class="timeline-next" aria-label="Next timeline slide">
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
                    <path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </button>
              </div>
            </div>
          </div>
        </section>
      {% endif %}
    </div>

    <!-- Vision & Mission -->
    <div class="tab-panel" id="vision-{{ section.id }}" role="tabpanel">
      <section class="vision-mission">
        <div class="container">
          <div class="vision-grid">
            <div class="vision-card">
              <div class="vision-content">
                {% if section.settings.vision_heading != blank %}
                  <h2>{{ section.settings.vision_heading | escape }}</h2>
                {% endif %}
                {% if section.settings.vision_text != blank %}
                  <p>{{ section.settings.vision_text | escape }}</p>
                {% endif %}
              </div>
            </div>
            <div class="vision-image">
              {% if section.settings.vision_image != blank %}
                <img
                  src="{{ section.settings.vision_image | image_url: width: 1000 }}"
                  alt="{{ section.settings.vision_image.alt | default: section.settings.vision_heading | escape }}"
                  loading="lazy"
                >
              {% else %}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              {% endif %}
            </div>
            <div class="vision-image">
              {% if section.settings.mission_image != blank %}
                <img
                  src="{{ section.settings.mission_image | image_url: width: 1000 }}"
                  alt="{{ section.settings.mission_image.alt | default: section.settings.mission_heading | escape }}"
                  loading="lazy"
                >
              {% else %}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              {% endif %}
            </div>
            <div class="vision-card">
              <div class="vision-content">
                {% if section.settings.mission_heading != blank %}
                  <h2>{{ section.settings.mission_heading | escape }}</h2>
                {% endif %}
                {% if section.settings.mission_text != blank %}
                  <p>{{ section.settings.mission_text | escape }}</p>
                {% endif %}
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="culture-values">
        <div class="container">
          <div class="culture-wrapper">
            <div class="culture-content">
              {% if section.settings.culture_heading != blank %}
                <h2>{{ section.settings.culture_heading | escape }}</h2>
              {% endif %}
              {% if section.settings.culture_paragraph_1 != blank %}
                <p>{{ section.settings.culture_paragraph_1 | escape }}</p>
              {% endif %}
              {% if section.settings.culture_paragraph_2 != blank %}
                <p>{{ section.settings.culture_paragraph_2 | escape }}</p>
              {% endif %}
              {% if culture_blocks.size > 0 %}
                <ul class="culture-list">
                  {% for block in culture_blocks %}
                    <li {{ block.shopify_attributes }}>{{ block.settings.value | escape }}</li>
                  {% endfor %}
                </ul>
              {% endif %}
            </div>
            <div class="culture-image">
              {% if section.settings.culture_image != blank %}
                <img
                  src="{{ section.settings.culture_image | image_url: width: 1200 }}"
                  alt="{{ section.settings.culture_image.alt | default: section.settings.culture_heading | escape }}"
                  loading="lazy"
                >
              {% else %}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              {% endif %}
            </div>
          </div>
        </div>
      </section>
    </div>

    <!-- Certifications -->
    <div class="tab-panel" id="certifications-{{ section.id }}" role="tabpanel">
      <section class="certificates">
        <div class="container">
          <div class="section-title">
            {% if section.settings.certificates_heading != blank %}
              <h2>{{ section.settings.certificates_heading | escape }}</h2>
            {% endif %}
            {% if section.settings.certificates_subheading != blank %}
              {{ section.settings.certificates_subheading }}
            {% endif %}
          </div>

          {% if certificate_blocks.size > 0 %}
            <div class="certificate-grid">
              {% for block in certificate_blocks %}
                <div class="certificate-card" {{ block.shopify_attributes }}>
                  {% if block.settings.image != blank %}
                    <img
                      src="{{ block.settings.image | image_url: width: 300 }}"
                      alt="{{ block.settings.image.alt | default: block.settings.title | escape }}"
                      loading="lazy"
                    >
                  {% else %}
                    {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                  {% endif %}
                  {% if block.settings.title != blank %}
                    <h4>{{ block.settings.title | escape }}</h4>
                  {% endif %}
                </div>
              {% endfor %}
            </div>
          {% endif %}
        </div>
      </section>
    </div>

    <!-- Social Responsibility -->
    <div class="tab-panel" id="social-{{ section.id }}" role="tabpanel">
      <section class="social-responsibility">
        <div class="container">
          {% if social_blocks.size > 0 %}
            <div class="social-farm-list">
              {% for block in social_blocks %}
                {%- liquid
                  assign image_position = block.settings.image_position | default: 'left'
                  if image_position == 'auto'
                    assign row_mod = forloop.index0 | modulo: 2
                    if row_mod == 0
                      assign image_position = 'left'
                    else
                      assign image_position = 'right'
                    endif
                  endif
                -%}
                <article
                  class="social-farm-row{% if image_position == 'right' %} social-farm-row--image-right{% endif %}"
                  {{ block.shopify_attributes }}
                >
                  <div class="social-farm-image">
                    {% if block.settings.image != blank %}
                      {{
                        block.settings.image
                        | image_url: width: 1200
                        | image_tag:
                          loading: 'lazy',
                          widths: '400, 600, 800, 1000, 1200',
                          sizes: '(min-width: 992px) 50vw, 100vw',
                          alt: block.settings.heading
                      }}
                    {% else %}
                      {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                    {% endif %}
                  </div>
                  <div class="social-farm-content">
                    {% if block.settings.heading != blank %}
                      <h3>{{ block.settings.heading | escape }}</h3>
                    {% endif %}
                    {% if block.settings.text != blank %}
                      <p>{{ block.settings.text | escape | newline_to_br }}</p>
                    {% endif %}
                    {% if block.settings.button_label != blank %}
                      <a
                        class="primary-btn"
                        href="{{ block.settings.button_link | default: '#' }}"
                        {% if block.settings.button_link == blank %}
                          aria-disabled="true"
                        {% endif %}
                      >
                        {{ block.settings.button_label | escape }}
                      </a>
                    {% endif %}
                  </div>
                </article>
              {% endfor %}
            </div>
          {% else %}
            <div class="tab-placeholder">
              <h2>{{ section.settings.tab_social_label | escape }}</h2>
              <p>{{ section.settings.placeholder_text | escape }}</p>
            </div>
          {% endif %}
        </div>
      </section>
    </div>

    <!-- Leadership & Team -->
    <div class="tab-panel" id="leadership-{{ section.id }}" role="tabpanel">
      <section class="leadership-team">
        <div class="container">
          {% if executive_blocks.size > 0 %}
            <div class="leadership-block executive-team">
              <div class="leadership-intro">
                {% if section.settings.executive_heading != blank %}
                  <h2>{{ section.settings.executive_heading | escape }}</h2>
                {% endif %}
                {% if section.settings.executive_subheading != blank %}
                  <p>{{ section.settings.executive_subheading | escape }}</p>
                {% endif %}
              </div>

              <div class="swiper leadership-slider executive-slider" data-executive-slider>
                <div class="swiper-wrapper">
                  {% for block in executive_blocks %}
                    <div
                      class="swiper-slide"
                      data-name="{{ block.settings.name | escape }}"
                      data-role="{{ block.settings.role | escape }}"
                      data-button-label="{{ block.settings.button_label | escape }}"
                      data-button-link="{{ block.settings.button_link | escape }}"
                      {{ block.shopify_attributes }}
                    >
                      <div class="leadership-card-image">
                        {% if block.settings.image != blank %}
                          {{
                            block.settings.image
                            | image_url: width: 1000
                            | image_tag:
                              loading: 'lazy',
                              widths: '320, 480, 640, 800, 1000',
                              sizes: '(min-width: 992px) 520px, 72vw',
                              alt: block.settings.name
                          }}
                        {% else %}
                          {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                        {% endif %}
                        {% if block.settings.linkedin_url != blank %}
                          <a
                            class="leadership-linkedin"
                            href="{{ block.settings.linkedin_url }}"
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label="{{ block.settings.name | escape }} on LinkedIn"
                          >
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                            </svg>
                          </a>
                        {% endif %}
                      </div>
                    </div>
                  {% endfor %}
                </div>
              </div>

              <div class="executive-meta" data-executive-meta>
                <div class="executive-meta-text">
                  <h3 data-executive-name></h3>
                  <p data-executive-role></p>
                </div>
                <a class="primary-btn is-hidden" data-executive-button href="#">Explore More</a>
              </div>

              <div class="team-slider-footer">
                <div class="team-progress" aria-hidden="true">
                  <span class="team-progress-bar" data-executive-progress></span>
                </div>
                <div class="team-nav-buttons">
                  <button type="button" class="executive-prev" aria-label="Previous executive">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
                      <path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </button>
                  <button type="button" class="executive-next" aria-label="Next executive">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
                      <path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </button>
                </div>
              </div>
            </div>
          {% endif %}

          {% if team_blocks.size > 0 %}
            <div class="leadership-block people-team">
              <div class="leadership-intro">
                {% if section.settings.people_heading != blank %}
                  <h2>{{ section.settings.people_heading | escape }}</h2>
                {% endif %}
                {% if section.settings.people_subheading != blank %}
                  <p>{{ section.settings.people_subheading | escape }}</p>
                {% endif %}
              </div>

              <div class="swiper leadership-slider people-slider" data-people-slider>
                <div class="swiper-wrapper">
                  {% for block in team_blocks %}
                    <div
                      class="swiper-slide"
                      data-name="{{ block.settings.name | escape }}"
                      data-role="{{ block.settings.role | escape }}"
                      {{ block.shopify_attributes }}
                    >
                      <div class="leadership-card-image">
                        {% if block.settings.image != blank %}
                          {{
                            block.settings.image
                            | image_url: width: 600
                            | image_tag:
                              loading: 'lazy',
                              widths: '200, 320, 400, 600',
                              sizes: '(min-width: 992px) 220px, 42vw',
                              alt: block.settings.name
                          }}
                        {% else %}
                          {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                        {% endif %}
                      </div>
                    </div>
                  {% endfor %}
                </div>
              </div>

              <div class="people-meta" data-people-meta>
                <h3 data-people-name></h3>
                <p data-people-role></p>
                <div class="people-meta-line" aria-hidden="true"></div>
              </div>

              <div class="team-slider-footer">
                <div class="team-progress" aria-hidden="true">
                  <span class="team-progress-bar" data-people-progress></span>
                </div>
                <div class="team-nav-buttons">
                  <button type="button" class="people-prev" aria-label="Previous team member">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
                      <path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </button>
                  <button type="button" class="people-next" aria-label="Next team member">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
                      <path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </button>
                </div>
              </div>
            </div>
          {% endif %}

          {% if executive_blocks.size == 0 and team_blocks.size == 0 %}
            <div class="tab-placeholder">
              <h2>{{ section.settings.tab_leadership_label | escape }}</h2>
              <p>{{ section.settings.placeholder_text | escape }}</p>
            </div>
          {% endif %}
        </div>
      </section>
    </div>

    <!-- Partners -->
    <div class="tab-panel" id="partners-{{ section.id }}" role="tabpanel">
      <section class="partners-section" data-partners>
        <div class="container">
          {% if partner_blocks.size > 0 %}
            <div class="partners-intro">
              {% if section.settings.partners_heading != blank %}
                <h2>{{ section.settings.partners_heading | escape }}</h2>
              {% endif %}
              {% if section.settings.partners_subheading != blank %}
                <p>{{ section.settings.partners_subheading | escape }}</p>
              {% endif %}
            </div>

            <div class="partners-filter" role="tablist" aria-label="Partner categories">
              <button
                type="button"
                class="partners-filter-btn active"
                role="tab"
                aria-selected="true"
                data-partner-category="distributor"
              >
                {{ section.settings.partners_distributor_label | default: 'Distributor' | escape }}
              </button>
              <button
                type="button"
                class="partners-filter-btn"
                role="tab"
                aria-selected="false"
                data-partner-category="supplier"
              >
                {{ section.settings.partners_supplier_label | default: 'Supplier' | escape }}
              </button>
            </div>

            <div class="partners-grid" data-partners-grid>
              {% for block in partner_blocks %}
                {%- assign partner_category = block.settings.category | default: 'distributor' -%}
                {%- capture partner_inner -%}
                  {% if block.settings.image != blank %}
                    {{
                      block.settings.image
                      | image_url: width: 400
                      | image_tag:
                        loading: 'lazy',
                        widths: '160, 240, 320, 400',
                        sizes: '(min-width: 992px) 240px, 45vw',
                        alt: block.settings.title
                    }}
                  {% else %}
                    {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                  {% endif %}
                {%- endcapture -%}

                {% if block.settings.link != blank %}
                  <a
                    class="partner-card{% unless partner_category == 'distributor' %} is-hidden{% endunless %}"
                    href="{{ block.settings.link }}"
                    data-partner-item
                    data-category="{{ partner_category | escape }}"
                    {{ block.shopify_attributes }}
                  >
                    {{ partner_inner }}
                  </a>
                {% else %}
                  <div
                    class="partner-card{% unless partner_category == 'distributor' %} is-hidden{% endunless %}"
                    data-partner-item
                    data-category="{{ partner_category | escape }}"
                    {{ block.shopify_attributes }}
                  >
                    {{ partner_inner }}
                  </div>
                {% endif %}
              {% endfor %}
            </div>

            <p class="partners-empty" data-partners-empty>
              {{ section.settings.placeholder_text | default: 'Coming soon' | escape }}
            </p>
          {% else %}
            <div class="tab-placeholder">
              <h2>{{ section.settings.tab_partners_label | escape }}</h2>
              <p>{{ section.settings.placeholder_text | escape }}</p>
            </div>
          {% endif %}
        </div>
      </section>
    </div>

    <!-- Careers -->
    <div class="tab-panel" id="careers-{{ section.id }}" role="tabpanel">
      <section class="careers-section" data-careers>
        <div class="container">
          <div class="careers-overview" data-careers-overview>
            <div class="careers-why">
              {% if section.settings.careers_why_heading != blank %}
                <h2>{{ section.settings.careers_why_heading | escape }}</h2>
              {% endif %}
              {% if section.settings.careers_why_text != blank %}
                <p>{{ section.settings.careers_why_text | escape | newline_to_br }}</p>
              {% endif %}
              {% if section.settings.careers_image != blank or section.settings.careers_why_heading != blank %}
                <div class="careers-hero-image">
                  {% if section.settings.careers_image != blank %}
                    {{
                      section.settings.careers_image
                      | image_url: width: 1600
                      | image_tag:
                        loading: 'lazy',
                        widths: '600, 900, 1200, 1600',
                        sizes: '(min-width: 992px) 900px, 92vw',
                        alt: section.settings.careers_why_heading
                    }}
                  {% else %}
                    {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  {% endif %}
                </div>
              {% endif %}
            </div>

            <div class="careers-positions">
              <div class="careers-positions-intro">
                {% if section.settings.careers_positions_heading != blank %}
                  <h2>{{ section.settings.careers_positions_heading | escape }}</h2>
                {% endif %}
                {% if section.settings.careers_positions_subheading != blank %}
                  <p>{{ section.settings.careers_positions_subheading | escape }}</p>
                {% endif %}
              </div>

              {% if career_blocks.size > 0 %}
                <div class="careers-list">
                  {% for block in career_blocks %}
                    <button
                      type="button"
                      class="career-card"
                      data-open-career="{{ block.id }}"
                      {{ block.shopify_attributes }}
                    >
                      <span class="career-card-icon" aria-hidden="true">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" focusable="false">
                          <path d="M9 6V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                          <rect x="3.5" y="6.5" width="17" height="13" rx="2.5" stroke="currentColor" stroke-width="1.8"/>
                          <path d="M3.5 11.5h17" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                        </svg>
                      </span>
                      <div class="career-card-meta">
                        {% if block.settings.location != blank %}
                          <span class="career-card-location">{{ block.settings.location | escape }}</span>
                        {% endif %}
                        {% if block.settings.title != blank %}
                          <span class="career-card-title">{{ block.settings.title | escape }}</span>
                        {% endif %}
                      </div>
                      {% if block.settings.description != blank %}
                        <span class="career-card-text">{{ block.settings.description | escape }}</span>
                      {% else %}
                        <span class="career-card-text"></span>
                      {% endif %}
                      <span class="career-card-arrow" aria-hidden="true">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" focusable="false">
                          <path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      </span>
                    </button>
                  {% endfor %}
                </div>
              {% elsif section.settings.careers_why_heading == blank and section.settings.careers_positions_heading == blank %}
                <div class="tab-placeholder">
                  <h2>{{ section.settings.tab_careers_label | escape }}</h2>
                  <p>{{ section.settings.placeholder_text | escape }}</p>
                </div>
              {% endif %}
            </div>
          </div>

          {% if career_blocks.size > 0 %}
            <div class="careers-detail" data-careers-detail>
              <nav class="careers-breadcrumb" aria-label="Breadcrumb">
                <a class="careers-breadcrumb-home" href="{{ routes.root_url }}" aria-label="Home">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
                    <path d="M3 10.5L12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1v-9.5z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
                  </svg>
                </a>
                <span class="careers-breadcrumb-sep" aria-hidden="true"></span>
                <button type="button" data-careers-back>
                  {{ section.settings.tab_careers_label | default: 'Careers' | escape }}
                </button>
                <span class="careers-breadcrumb-sep" aria-hidden="true"></span>
                <span class="careers-breadcrumb-current">
                  {{ section.settings.careers_detail_label | default: 'Job Detail' | escape }}
                </span>
              </nav>

              <div class="careers-detail-layout">
                <div class="careers-detail-main">
                  {% for block in career_blocks %}
                    {%- liquid
                      assign role_lines = block.settings.roles | newline_to_br | split: '<br />'
                      assign qualification_lines = block.settings.qualifications | newline_to_br | split: '<br />'
                      assign skill_lines = block.settings.skills | newline_to_br | split: '<br />'
                    -%}
                    <article
                      class="career-detail-panel"
                      data-career-panel="{{ block.id }}"
                      data-career-title="{{ block.settings.title | escape }}"
                    >
                      {% if block.settings.title != blank %}
                        <h2>{{ block.settings.title | escape }}</h2>
                      {% endif %}
                      {% if block.settings.posted_label != blank %}
                        <p class="career-detail-posted">{{ block.settings.posted_label | escape }}</p>
                      {% endif %}

                      {% if block.settings.roles_heading != blank or block.settings.roles != blank %}
                        <div class="career-detail-block">
                          {% if block.settings.roles_heading != blank %}
                            <h3>{{ block.settings.roles_heading | escape }}</h3>
                          {% endif %}
                          {% if block.settings.roles != blank %}
                            <ul class="career-check-list">
                              {% for line in role_lines %}
                                {% assign clean_line = line | strip_html | strip %}
                                {% if clean_line != blank %}
                                  <li>{{ clean_line | escape }}</li>
                                {% endif %}
                              {% endfor %}
                            </ul>
                          {% endif %}
                        </div>
                      {% endif %}

                      {% if block.settings.qualifications_heading != blank or block.settings.qualifications != blank %}
                        <div class="career-detail-block">
                          {% if block.settings.qualifications_heading != blank %}
                            <h3>{{ block.settings.qualifications_heading | escape }}</h3>
                          {% endif %}
                          {% if block.settings.qualifications != blank %}
                            <ul class="career-check-list">
                              {% for line in qualification_lines %}
                                {% assign clean_line = line | strip_html | strip %}
                                {% if clean_line != blank %}
                                  <li>{{ clean_line | escape }}</li>
                                {% endif %}
                              {% endfor %}
                            </ul>
                          {% endif %}
                        </div>
                      {% endif %}

                      {% if block.settings.skills_heading != blank or block.settings.skills != blank %}
                        <div class="career-detail-block">
                          {% if block.settings.skills_heading != blank %}
                            <h3>{{ block.settings.skills_heading | escape }}</h3>
                          {% endif %}
                          {% if block.settings.skills != blank %}
                            <ul class="career-check-list">
                              {% for line in skill_lines %}
                                {% assign clean_line = line | strip_html | strip %}
                                {% if clean_line != blank %}
                                  <li>{{ clean_line | escape }}</li>
                                {% endif %}
                              {% endfor %}
                            </ul>
                          {% endif %}
                        </div>
                      {% endif %}
                    </article>
                  {% endfor %}
                </div>

                <div class="careers-apply">
                  <h2>{{ section.settings.careers_apply_heading | default: 'Apply Online' | escape }}</h2>

                  {%- assign careers_form_id = 'CareersApply-' | append: section.id -%}
                  {% form 'contact', id: careers_form_id, class: 'careers-apply-form' %}
                    {% if form.posted_successfully? %}
                      <p class="careers-form-status careers-form-status--success" data-careers-submitted>
                        {{ section.settings.careers_success_message | default: 'Thanks — your application has been submitted.' | escape }}
                      </p>
                    {% elsif form.errors %}
                      <p class="careers-form-status careers-form-status--error" data-careers-submitted>
                        {{ form.errors | default_errors }}
                      </p>
                    {% endif %}

                    <input type="hidden" name="contact[Job title]" value="" data-career-job-field>
                    <input
                      class="input"
                      type="text"
                      name="contact[First name]"
                      placeholder="First Name *"
                      required
                      autocomplete="given-name"
                    >
                    <input
                      class="input"
                      type="text"
                      name="contact[Last name]"
                      placeholder="Last Name *"
                      required
                      autocomplete="family-name"
                    >
                    <input
                      class="input"
                      type="email"
                      name="contact[email]"
                      placeholder="Email Address *"
                      required
                      autocomplete="email"
                    >
                    <input
                      class="input"
                      type="tel"
                      name="contact[Contact number]"
                      placeholder="Contact Number *"
                      required
                      autocomplete="tel"
                    >
                    <input
                      class="input"
                      type="text"
                      name="contact[City]"
                      placeholder="City *"
                      required
                      autocomplete="address-level2"
                    >
                    <input
                      class="input"
                      type="url"
                      name="contact[LinkedIn URL]"
                      placeholder="LinkedIn URL"
                      autocomplete="url"
                    >
                    <div class="careers-file-field">
                      <input
                        class="input"
                        type="text"
                        name="contact[Resume filename]"
                        placeholder="Attach Resume *"
                        readonly
                        required
                        data-resume-filename
                        tabindex="-1"
                      >
                      <label class="careers-browse">
                        {{ section.settings.careers_browse_label | default: 'Browse' | escape }}
                        <input type="file" accept=".pdf,.doc,.docx" data-resume-input aria-label="Attach resume">
                      </label>
                    </div>
                    <button type="submit" class="primary-btn">
                      {{ section.settings.careers_submit_label | default: 'Submit' | escape }}
                    </button>
                  {% endform %}
                </div>
              </div>
            </div>
          {% endif %}
        </div>
      </section>
    </div>
  </div>

  <script>
    (function () {
      var sectionId = '{{ section.id }}';
      var section = document.querySelector('.about-tabs[data-section-id="' + sectionId + '"]');
      if (!section) return;

      var imageSliderEl = section.querySelector('[data-timeline-image-slider]');
      var contentSliderEl = section.querySelector('[data-timeline-content-slider]');
      var progressBar = section.querySelector('[data-timeline-progress-bar]');
      var yearBtns = section.querySelectorAll('.year-btn');
      var prevBtn = section.querySelector('.timeline-prev');
      var nextBtn = section.querySelector('.timeline-next');
      var timelineImage = null;
      var timelineContent = null;
      var executiveSwiper = null;
      var peopleSwiper = null;

      function refreshLeadershipSliders() {
        if (executiveSwiper) executiveSwiper.update();
        if (peopleSwiper) peopleSwiper.update();
      }

      function initTabs() {
        if (section.dataset.tabsBound === 'true') return;
        section.dataset.tabsBound = 'true';

        section.addEventListener('click', function (event) {
          var btn = event.target.closest('.tab-btn[data-section-id="' + sectionId + '"]');
          if (!btn || !section.contains(btn)) return;

          var tab = btn.getAttribute('data-tab');
          section.querySelectorAll('.tab-btn[data-section-id="' + sectionId + '"]').forEach(function (b) {
            b.classList.remove('active');
            b.setAttribute('aria-selected', 'false');
          });
          btn.classList.add('active');
          btn.setAttribute('aria-selected', 'true');

          section.querySelectorAll('.tab-panel').forEach(function (panel) {
            panel.classList.remove('active');
          });

          var target = section.querySelector('#' + tab + '-' + sectionId);
          if (target) target.classList.add('active');

          if (tab === 'leadership') {
            window.requestAnimationFrame(refreshLeadershipSliders);
          }

          if (tab !== 'careers') {
            closeCareerDetail();
          }
        });
      }

      function openCareerDetail(careerId) {
        var careersRoot = section.querySelector('[data-careers]');
        if (!careersRoot) return;

        careersRoot.classList.add('is-detail');
        careersRoot.querySelectorAll('[data-career-panel]').forEach(function (panel) {
          panel.classList.toggle('is-active', panel.getAttribute('data-career-panel') === careerId);
        });

        var activePanel = careersRoot.querySelector('[data-career-panel].is-active');
        var jobField = careersRoot.querySelector('[data-career-job-field]');
        if (activePanel && jobField) {
          jobField.value = activePanel.getAttribute('data-career-title') || '';
        }

        var tabsWrapper = section.querySelector('.tabs-wrapper');
        if (tabsWrapper) {
          tabsWrapper.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }

      function closeCareerDetail() {
        var careersRoot = section.querySelector('[data-careers]');
        if (!careersRoot) return;
        careersRoot.classList.remove('is-detail');
        careersRoot.querySelectorAll('[data-career-panel]').forEach(function (panel) {
          panel.classList.remove('is-active');
        });
      }

      function initCareersDetail() {
        var careersRoot = section.querySelector('[data-careers]');
        if (!careersRoot || careersRoot.dataset.bound === 'true') return;
        careersRoot.dataset.bound = 'true';

        careersRoot.addEventListener('click', function (event) {
          var openBtn = event.target.closest('[data-open-career]');
          if (openBtn && careersRoot.contains(openBtn)) {
            openCareerDetail(openBtn.getAttribute('data-open-career'));
            return;
          }

          if (event.target.closest('[data-careers-back]')) {
            closeCareerDetail();
          }
        });

        var resumeInput = careersRoot.querySelector('[data-resume-input]');
        var resumeFilename = careersRoot.querySelector('[data-resume-filename]');
        if (resumeInput && resumeFilename) {
          resumeInput.addEventListener('change', function () {
            var file = resumeInput.files && resumeInput.files[0];
            resumeFilename.value = file ? file.name : '';
          });
        }

        if (careersRoot.querySelector('[data-careers-submitted]')) {
          var firstCard = careersRoot.querySelector('[data-open-career]');
          if (firstCard) {
            openCareerDetail(firstCard.getAttribute('data-open-career'));
          }
        }
      }

      function filterPartners(category) {
        var partnersRoot = section.querySelector('[data-partners]');
        if (!partnersRoot) return;

        var visibleCount = 0;
        partnersRoot.querySelectorAll('[data-partner-item]').forEach(function (item) {
          var match = item.getAttribute('data-category') === category;
          item.classList.toggle('is-hidden', !match);
          if (match) visibleCount += 1;
        });

        var emptyEl = partnersRoot.querySelector('[data-partners-empty]');
        if (emptyEl) {
          emptyEl.classList.toggle('is-visible', visibleCount === 0);
        }
      }

      function initPartnersFilter() {
        var partnersRoot = section.querySelector('[data-partners]');
        if (!partnersRoot || partnersRoot.dataset.bound === 'true') return;
        partnersRoot.dataset.bound = 'true';

        partnersRoot.addEventListener('click', function (event) {
          var btn = event.target.closest('[data-partner-category]');
          if (!btn || !partnersRoot.contains(btn)) return;

          var category = btn.getAttribute('data-partner-category');
          partnersRoot.querySelectorAll('[data-partner-category]').forEach(function (filterBtn) {
            var isActive = filterBtn === btn;
            filterBtn.classList.toggle('active', isActive);
            filterBtn.setAttribute('aria-selected', isActive ? 'true' : 'false');
          });

          filterPartners(category);
        });

        filterPartners('distributor');
      }

      function updateTimeline(index) {
        if (!yearBtns.length) return;

        yearBtns.forEach(function (btn) {
          btn.classList.remove('active');
        });

        if (yearBtns[index]) {
          yearBtns[index].classList.add('active');
        }

        if (progressBar) {
          var total = yearBtns.length - 1;
          var percentage = total > 0 ? (index / total) * 100 : 0;
          progressBar.style.width = percentage + '%';
        }
      }

      function loadSwiper(callback) {
        if (window.Swiper) {
          callback();
          return;
        }

        if (!document.querySelector('link[href*="swiper-bundle.min.css"]')) {
          var link = document.createElement('link');
          link.rel = 'stylesheet';
          link.href = 'https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css';
          document.head.appendChild(link);
        }

        var script = document.createElement('script');
        script.src = 'https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js';
        script.onload = callback;
        script.onerror = function () {
          console.warn('Swiper failed to load. Timeline slider may not function.');
        };
        document.head.appendChild(script);
      }

      function setProgress(bar, index, total) {
        if (!bar || !total) return;
        bar.style.width = (((index + 1) / total) * 100) + '%';
      }

      function syncExecutiveMeta(slide) {
        if (!slide) return;
        var nameEl = section.querySelector('[data-executive-name]');
        var roleEl = section.querySelector('[data-executive-role]');
        var buttonEl = section.querySelector('[data-executive-button]');
        if (nameEl) nameEl.textContent = slide.getAttribute('data-name') || '';
        if (roleEl) roleEl.textContent = slide.getAttribute('data-role') || '';
        if (buttonEl) {
          var label = slide.getAttribute('data-button-label') || '';
          var link = slide.getAttribute('data-button-link') || '';
          if (label) {
            buttonEl.textContent = label;
            buttonEl.href = link || '#';
            buttonEl.classList.remove('is-hidden');
          } else {
            buttonEl.classList.add('is-hidden');
          }
        }
      }

      function syncPeopleMeta(slide) {
        if (!slide) return;
        var nameEl = section.querySelector('[data-people-name]');
        var roleEl = section.querySelector('[data-people-role]');
        if (nameEl) nameEl.textContent = slide.getAttribute('data-name') || '';
        if (roleEl) roleEl.textContent = slide.getAttribute('data-role') || '';
      }

      function initTimeline() {
        if (!imageSliderEl || !contentSliderEl || !window.Swiper) return;

        if (imageSliderEl.swiper) {
          imageSliderEl.swiper.destroy(true, true);
        }
        if (contentSliderEl.swiper) {
          contentSliderEl.swiper.destroy(true, true);
        }

        timelineImage = new window.Swiper(imageSliderEl, {
          slidesPerView: 1,
          speed: 800,
          allowTouchMove: false
        });

        timelineContent = new window.Swiper(contentSliderEl, {
          slidesPerView: 1,
          speed: 800,
          allowTouchMove: false
        });

        timelineImage.controller.control = timelineContent;
        timelineContent.controller.control = timelineImage;

        timelineImage.on('slideChange', function () {
          updateTimeline(this.activeIndex);
        });

        updateTimeline(0);

        if (prevBtn) {
          prevBtn.onclick = function () {
            timelineImage.slidePrev();
          };
        }

        if (nextBtn) {
          nextBtn.onclick = function () {
            timelineImage.slideNext();
          };
        }

        yearBtns.forEach(function (btn, index) {
          btn.onclick = function () {
            timelineImage.slideTo(index);
          };
        });
      }

      function initLeadershipSliders() {
        if (!window.Swiper) return;

        var executiveEl = section.querySelector('[data-executive-slider]');
        var peopleEl = section.querySelector('[data-people-slider]');
        var executiveProgress = section.querySelector('[data-executive-progress]');
        var peopleProgress = section.querySelector('[data-people-progress]');
        var executivePrev = section.querySelector('.executive-prev');
        var executiveNext = section.querySelector('.executive-next');
        var peoplePrev = section.querySelector('.people-prev');
        var peopleNext = section.querySelector('.people-next');

        if (executiveEl) {
          if (executiveEl.swiper) executiveEl.swiper.destroy(true, true);

          executiveSwiper = new window.Swiper(executiveEl, {
            slidesPerView: 'auto',
            centeredSlides: true,
            spaceBetween: 28,
            speed: 700,
            grabCursor: true,
            breakpoints: {
              0: { spaceBetween: 16 },
              768: { spaceBetween: 24 },
              1200: { spaceBetween: 32 }
            },
            on: {
              init: function () {
                syncExecutiveMeta(this.slides[this.activeIndex]);
                setProgress(executiveProgress, this.activeIndex, this.slides.length);
              },
              slideChange: function () {
                syncExecutiveMeta(this.slides[this.activeIndex]);
                setProgress(executiveProgress, this.activeIndex, this.slides.length);
              }
            }
          });

          if (executivePrev) {
            executivePrev.onclick = function () {
              executiveSwiper.slidePrev();
            };
          }
          if (executiveNext) {
            executiveNext.onclick = function () {
              executiveSwiper.slideNext();
            };
          }
        }

        if (peopleEl) {
          if (peopleEl.swiper) peopleEl.swiper.destroy(true, true);

          peopleSwiper = new window.Swiper(peopleEl, {
            slidesPerView: 'auto',
            centeredSlides: true,
            spaceBetween: 20,
            speed: 650,
            grabCursor: true,
            breakpoints: {
              0: { spaceBetween: 12 },
              768: { spaceBetween: 16 },
              1200: { spaceBetween: 22 }
            },
            on: {
              init: function () {
                syncPeopleMeta(this.slides[this.activeIndex]);
                setProgress(peopleProgress, this.activeIndex, this.slides.length);
              },
              slideChange: function () {
                syncPeopleMeta(this.slides[this.activeIndex]);
                setProgress(peopleProgress, this.activeIndex, this.slides.length);
              }
            }
          });

          if (peoplePrev) {
            peoplePrev.onclick = function () {
              peopleSwiper.slidePrev();
            };
          }
          if (peopleNext) {
            peopleNext.onclick = function () {
              peopleSwiper.slideNext();
            };
          }
        }
      }

      function initAllSliders() {
        initTimeline();
        initLeadershipSliders();
      }

      initTabs();
      initPartnersFilter();
      initCareersDetail();
      loadSwiper(initAllSliders);

      document.addEventListener('shopify:section:load', function (e) {
        if (e.target && e.target.querySelector('.about-tabs[data-section-id="' + sectionId + '"]')) {
          section = document.querySelector('.about-tabs[data-section-id="' + sectionId + '"]');
          imageSliderEl = section.querySelector('[data-timeline-image-slider]');
          contentSliderEl = section.querySelector('[data-timeline-content-slider]');
          progressBar = section.querySelector('[data-timeline-progress-bar]');
          yearBtns = section.querySelectorAll('.year-btn');
          prevBtn = section.querySelector('.timeline-prev');
          nextBtn = section.querySelector('.timeline-next');
          section.dataset.tabsBound = 'false';
          var partnersRoot = section.querySelector('[data-partners]');
          if (partnersRoot) partnersRoot.dataset.bound = 'false';
          var careersRoot = section.querySelector('[data-careers]');
          if (careersRoot) careersRoot.dataset.bound = 'false';
          initTabs();
          initPartnersFilter();
          initCareersDetail();
          loadSwiper(initAllSliders);
        }
      });

      document.addEventListener('shopify:section:unload', function (e) {
        if (e.target && e.target.querySelector('.about-tabs[data-section-id="' + sectionId + '"]')) {
          if (imageSliderEl && imageSliderEl.swiper) {
            imageSliderEl.swiper.destroy(true, true);
          }
          if (contentSliderEl && contentSliderEl.swiper) {
            contentSliderEl.swiper.destroy(true, true);
          }
          if (executiveSwiper) {
            executiveSwiper.destroy(true, true);
            executiveSwiper = null;
          }
          if (peopleSwiper) {
            peopleSwiper.destroy(true, true);
            peopleSwiper = null;
          }
        }
      });
    })();
  </script>
</section>

{% schema %}
{
  "name": "About Tabs",
  "tag": "section",
  "class": "about-tabs-section",
  "settings": [
    {
      "type": "header",
      "content": "Tab labels"
    },
    {
      "type": "text",
      "id": "tabs_aria_label",
      "label": "Tabs navigation label",
      "default": "About page sections"
    },
    {
      "type": "text",
      "id": "tab_who_label",
      "label": "Who We Are tab",
      "default": "Who We Are"
    },
    {
