{%- liquid
  assign terms_url = section.settings.terms_link | default: shop.terms_of_service.url
  assign privacy_url = section.settings.privacy_link | default: shop.privacy_policy.url
  assign accent = section.settings.accent_color | default: '#53c295'
-%}

<section
  class="sulalat-b2b-register"
  data-section-id="{{ section.id }}"
  style="
    --b2b-pad-top: {{ section.settings.padding_top }}px;
    --b2b-pad-bottom: {{ section.settings.padding_bottom }}px;
    --b2b-bg: {{ section.settings.background_color }};
    --b2b-card-bg: {{ section.settings.card_background }};
    --b2b-accent: {{ accent }};
  "
>
  <style>
    .sulalat-b2b-register[data-section-id="{{ section.id }}"] {
      padding: var(--b2b-pad-top) 0 var(--b2b-pad-bottom);
      background: var(--b2b-bg);
      font-family: var(--body-font-family);
      color: #1a1a1a;
    }

    .sulalat-b2b-register[data-section-id="{{ section.id }}"] .container {
      max-width: var(--brand-container-max, 1440px);
      margin: 0 auto;
      padding: 0 var(--brand-container-padding-x, 20px);
    }

    .sulalat-b2b-register[data-section-id="{{ section.id }}"] .sulalat-b2b-register__card {
      max-width: 920px;
      margin: 0 auto;
      background: var(--b2b-card-bg);
      border-radius: 16px;
      box-shadow: 0 8px 32px rgba(17, 24, 39, 0.06);
      padding: clamp(28px, 4vw, 48px);
    }

    .sulalat-b2b-register[data-section-id="{{ section.id }}"] .sulalat-b2b-register__title {
      margin: 0 0 6px;
      font-size: clamp(28px, 3vw, 40px);
      line-height: 1.2;
      font-weight: 700;
      color: #111;
    }

    .sulalat-b2b-register[data-section-id="{{ section.id }}"] .sulalat-b2b-register__subtitle {
      margin: 0 0 22px;
      font-size: 15px;
      line-height: 1.4;
      color: #8a8a8a;
      font-weight: 400;
    }

    .sulalat-b2b-register[data-section-id="{{ section.id }}"] .sulalat-b2b-register__types {
      display: flex;
      flex-wrap: wrap;
      gap: 28px;
      margin: 0 0 28px;
    }

    .sulalat-b2b-register[data-section-id="{{ section.id }}"] .sulalat-b2b-register__type {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      cursor: pointer;
      font-size: 15px;
      font-weight: 500;
      color: #1a1a1a;
      user-select: none;
    }

    .sulalat-b2b-register[data-section-id="{{ section.id }}"] .sulalat-b2b-register__type input {
      position: absolute;
      opacity: 0;
      pointer-events: none;
    }

    .sulalat-b2b-register[data-section-id="{{ section.id }}"] .sulalat-b2b-register__check {
      width: 22px;
      height: 22px;
      border: 1.5px solid #cfcfcf;
      border-radius: 4px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      background: #fff;
      transition: border-color 0.2s ease, background 0.2s ease;
    }

    .sulalat-b2b-register[data-section-id="{{ section.id }}"] .sulalat-b2b-register__check svg {
      width: 14px;
      height: 14px;
      opacity: 0;
      color: var(--b2b-accent);
    }

    .sulalat-b2b-register[data-section-id="{{ section.id }}"] .sulalat-b2b-register__type input:checked + .sulalat-b2b-register__check {
      border-color: var(--b2b-accent);
    }

    .sulalat-b2b-register[data-section-id="{{ section.id }}"] .sulalat-b2b-register__type input:checked + .sulalat-b2b-register__check svg {
      opacity: 1;
    }

    .sulalat-b2b-register[data-section-id="{{ section.id }}"] .sulalat-b2b-register__type input:focus-visible + .sulalat-b2b-register__check {
      outline: 2px solid color-mix(in srgb, var(--b2b-accent) 45%, white);
      outline-offset: 2px;
    }

    .sulalat-b2b-register[data-section-id="{{ section.id }}"] .sulalat-b2b-register__alert {
      margin: 0 0 20px;
      padding: 14px 16px;
      border-radius: 10px;
      background: #fdecec;
      color: #8a1f1f;
      font-size: 14px;
    }

    .sulalat-b2b-register[data-section-id="{{ section.id }}"] .sulalat-b2b-register__alert ul {
      margin: 8px 0 0;
      padding-inline-start: 18px;
    }

    .sulalat-b2b-register[data-section-id="{{ section.id }}"] .sulalat-b2b-register__grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px 20px;
    }

    .sulalat-b2b-register[data-section-id="{{ section.id }}"] .sulalat-b2b-register__field--password {
      grid-column: 1 / 2;
    }

    .sulalat-b2b-register[data-section-id="{{ section.id }}"] .sulalat-b2b-register__input,
    .sulalat-b2b-register[data-section-id="{{ section.id }}"] .sulalat-b2b-register__select {
      width: 100%;
      height: 52px;
      padding: 0 20px;
      border: 1px solid #d8d8d8;
      border-radius: 999px;
      background: #fff;
      color: #1a1a1a;
      font-size: 15px;
      font-family: inherit;
      outline: none;
      appearance: none;
      -webkit-appearance: none;
      transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .sulalat-b2b-register[data-section-id="{{ section.id }}"] .sulalat-b2b-register__input::placeholder {
      color: #9a9a9a;
    }

    .sulalat-b2b-register[data-section-id="{{ section.id }}"] .sulalat-b2b-register__input:focus,
    .sulalat-b2b-register[data-section-id="{{ section.id }}"] .sulalat-b2b-register__select:focus {
      border-color: var(--b2b-accent);
      box-shadow: 0 0 0 3px color-mix(in srgb, var(--b2b-accent) 18%, white);
    }

    .sulalat-b2b-register[data-section-id="{{ section.id }}"] .sulalat-b2b-register__password-wrap {
      position: relative;
    }

    .sulalat-b2b-register[data-section-id="{{ section.id }}"] .sulalat-b2b-register__password-wrap .sulalat-b2b-register__input {
      padding-inline-end: 48px;
    }

    .sulalat-b2b-register[data-section-id="{{ section.id }}"] .sulalat-b2b-register__toggle-pass {
      position: absolute;
      top: 50%;
      right: 16px;
      transform: translateY(-50%);
      width: 28px;
      height: 28px;
      border: 0;
      background: transparent;
      color: #8a8a8a;
      cursor: pointer;
      padding: 0;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }

    .sulalat-b2b-register[data-section-id="{{ section.id }}"] .sulalat-b2b-register__toggle-pass svg {
      width: 20px;
      height: 20px;
    }

    .sulalat-b2b-register[data-section-id="{{ section.id }}"] .sulalat-b2b-register__toggle-pass .icon-hide {
      display: none;
    }

    .sulalat-b2b-register[data-section-id="{{ section.id }}"] .sulalat-b2b-register__toggle-pass.is-visible .icon-show {
      display: none;
    }

    .sulalat-b2b-register[data-section-id="{{ section.id }}"] .sulalat-b2b-register__toggle-pass.is-visible .icon-hide {
      display: block;
    }

    .sulalat-b2b-register[data-section-id="{{ section.id }}"] .sulalat-b2b-register__agree {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      margin: 22px 0 24px;
      font-size: 14px;
      line-height: 1.5;
      color: #4a4a4a;
    }

    .sulalat-b2b-register[data-section-id="{{ section.id }}"] .sulalat-b2b-register__agree input {
      margin-top: 3px;
      width: 18px;
      height: 18px;
      flex-shrink: 0;
      accent-color: var(--b2b-accent);
      cursor: pointer;
    }

    .sulalat-b2b-register[data-section-id="{{ section.id }}"] .sulalat-b2b-register__agree a {
      color: var(--b2b-accent);
      text-decoration: none;
      font-weight: 500;
    }

    .sulalat-b2b-register[data-section-id="{{ section.id }}"] .sulalat-b2b-register__agree a:hover {
      text-decoration: underline;
    }

    .sulalat-b2b-register[data-section-id="{{ section.id }}"] .sulalat-b2b-register__submit {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 168px;
      height: 52px;
      padding: 0 36px;
      border: 0;
      border-radius: 999px;
      background: var(--b2b-accent);
      color: #fff;
      font-size: 16px;
      font-weight: 600;
      font-family: inherit;
      cursor: pointer;
      transition: filter 0.2s ease, transform 0.15s ease;
    }

    .sulalat-b2b-register[data-section-id="{{ section.id }}"] .sulalat-b2b-register__submit:hover {
      filter: brightness(0.96);
    }

    .sulalat-b2b-register[data-section-id="{{ section.id }}"] .sulalat-b2b-register__login {
      margin: 20px 0 0;
      font-size: 14px;
      color: #6b6b6b;
    }

    .sulalat-b2b-register[data-section-id="{{ section.id }}"] .sulalat-b2b-register__login a {
      color: var(--b2b-accent);
      text-decoration: none;
      font-weight: 500;
    }

    .sulalat-b2b-register[data-section-id="{{ section.id }}"] [data-account-panel][hidden] {
      display: none !important;
    }

    .sulalat-b2b-register[data-section-id="{{ section.id }}"] .visually-hidden {
      position: absolute !important;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    @media screen and (max-width: 749px) {
      .sulalat-b2b-register[data-section-id="{{ section.id }}"] {
        padding-top: {{ section.settings.padding_top_mobile }}px;
        padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
      }

      .sulalat-b2b-register[data-section-id="{{ section.id }}"] .sulalat-b2b-register__card {
        padding: 24px 18px;
        border-radius: 14px;
      }

      .sulalat-b2b-register[data-section-id="{{ section.id }}"] .sulalat-b2b-register__grid {
        grid-template-columns: 1fr;
      }

      .sulalat-b2b-register[data-section-id="{{ section.id }}"] .sulalat-b2b-register__field--password {
        grid-column: 1;
      }

      .sulalat-b2b-register[data-section-id="{{ section.id }}"] .sulalat-b2b-register__submit {
        width: 100%;
      }
    }
  </style>

  <div class="container">
    <div class="sulalat-b2b-register__card">
      {%- if section.settings.heading != blank -%}
        <h1 class="sulalat-b2b-register__title">{{ section.settings.heading | escape }}</h1>
      {%- endif -%}
      {%- if section.settings.subtitle != blank -%}
        <p class="sulalat-b2b-register__subtitle">{{ section.settings.subtitle | escape }}</p>
      {%- endif -%}

      {%- form 'create_customer', class: 'sulalat-b2b-register__form', id: 'B2BRegisterForm' -%}
        {%- if form.errors -%}
          <div class="sulalat-b2b-register__alert" tabindex="-1" autofocus>
            <strong>{{ 'contact.form.error_heading' | t }}</strong>
            <ul>
              {%- for field in form.errors -%}
                <li>
                  {%- if field == 'form' -%}
                    {{ form.errors.messages[field] }}
                  {%- else -%}
                    {{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        {%- comment -%} Shopify only accepts these customer fields on register {%- endcomment -%}
        <input type="hidden" name="customer[first_name]" value="" data-submit-first>
        <input type="hidden" name="customer[last_name]" value="" data-submit-last>
        <input type="hidden" name="customer[note]" value="" data-customer-note>
        <input type="hidden" name="customer[tags]" value="{{ section.settings.company_tag | default: 'b2b' | escape }}" data-customer-tags>

        <div class="sulalat-b2b-register__types" role="radiogroup" aria-label="Account type">
          <label class="sulalat-b2b-register__type">
            <input type="radio" value="company" data-account-type checked>
            <span class="sulalat-b2b-register__check" aria-hidden="true">
              <svg viewBox="0 0 16 16" fill="none"><path d="M3.5 8.2l3 3 6-6.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            <span>{{ section.settings.company_label | escape }}</span>
          </label>
          <label class="sulalat-b2b-register__type">
            <input type="radio" value="personal" data-account-type>
            <span class="sulalat-b2b-register__check" aria-hidden="true">
              <svg viewBox="0 0 16 16" fill="none"><path d="M3.5 8.2l3 3 6-6.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            <span>{{ section.settings.personal_label | escape }}</span>
          </label>
        </div>

        <div class="sulalat-b2b-register__grid" data-account-panel="company">
          <div>
            <label class="visually-hidden" for="b2b-company-name">{{ section.settings.placeholder_company | escape }}</label>
            <input
              class="sulalat-b2b-register__input"
              type="text"
              id="b2b-company-name"
              placeholder="{{ section.settings.placeholder_company | escape }}"
              autocomplete="organization"
              data-field="company_name"
            >
          </div>
          <div>
            <label class="visually-hidden" for="b2b-brand-name">{{ section.settings.placeholder_brand | escape }}</label>
            <input
              class="sulalat-b2b-register__input"
              type="text"
              id="b2b-brand-name"
              placeholder="{{ section.settings.placeholder_brand | escape }}"
              autocomplete="organization-title"
              data-field="brand_name"
            >
          </div>
          <div>
            <label class="visually-hidden" for="b2b-cr">{{ section.settings.placeholder_cr | escape }}</label>
            <input
              class="sulalat-b2b-register__input"
              type="text"
              id="b2b-cr"
              placeholder="{{ section.settings.placeholder_cr | escape }}"
              data-field="cr_number"
            >
          </div>
          <div>
            <label class="visually-hidden" for="b2b-vat">{{ section.settings.placeholder_vat | escape }}</label>
            <input
              class="sulalat-b2b-register__input"
              type="text"
              id="b2b-vat"
              placeholder="{{ section.settings.placeholder_vat | escape }}"
              data-field="vat_number"
            >
          </div>
          <div>
            <label class="visually-hidden" for="b2b-region">{{ section.settings.placeholder_region | escape }}</label>
            <input
              class="sulalat-b2b-register__input"
              type="text"
              id="b2b-region"
              placeholder="{{ section.settings.placeholder_region | escape }}"
              data-field="region"
            >
          </div>
          <div>
            <label class="visually-hidden" for="b2b-city">{{ section.settings.placeholder_city | escape }}</label>
            <input
              class="sulalat-b2b-register__input"
              type="text"
              id="b2b-city"
              placeholder="{{ section.settings.placeholder_city | escape }}"
              data-field="city"
            >
          </div>
        </div>

        <div class="sulalat-b2b-register__grid" data-account-panel="personal" hidden>
          <div>
            <label class="visually-hidden" for="b2b-first-name">{{ section.settings.placeholder_first_name | escape }}</label>
            <input
              class="sulalat-b2b-register__input"
              type="text"
              id="b2b-first-name"
              placeholder="{{ section.settings.placeholder_first_name | escape }}"
              autocomplete="given-name"
              data-field="first_name"
            >
          </div>
          <div>
            <label class="visually-hidden" for="b2b-last-name">{{ section.settings.placeholder_last_name | escape }}</label>
            <input
              class="sulalat-b2b-register__input"
              type="text"
              id="b2b-last-name"
              placeholder="{{ section.settings.placeholder_last_name | escape }}"
              autocomplete="family-name"
              data-field="last_name"
            >
          </div>
        </div>

        <div class="sulalat-b2b-register__grid" style="margin-top: 16px;">
          <div>
            <label class="visually-hidden" for="b2b-email">{{ section.settings.placeholder_email | escape }}</label>
            <input
              class="sulalat-b2b-register__input"
              type="email"
              id="b2b-email"
              name="customer[email]"
              placeholder="{{ section.settings.placeholder_email | escape }}"
              autocomplete="email"
              required
              {%- if form.email %}value="{{ form.email }}"{% endif %}
            >
          </div>
          <div>
            <label class="visually-hidden" for="b2b-phone">{{ section.settings.placeholder_phone | escape }}</label>
            <input
              class="sulalat-b2b-register__input"
              type="tel"
              id="b2b-phone"
              placeholder="{{ section.settings.placeholder_phone | escape }}"
              autocomplete="tel"
              data-field="phone"
            >
          </div>

          <div class="sulalat-b2b-register__field--password">
            <label class="visually-hidden" for="b2b-password">{{ section.settings.placeholder_password | escape }}</label>
            <div class="sulalat-b2b-register__password-wrap">
              <input
                class="sulalat-b2b-register__input"
                type="password"
                id="b2b-password"
                name="customer[password]"
                placeholder="{{ section.settings.placeholder_password | escape }}"
                autocomplete="new-password"
                required
                minlength="5"
              >
              <button type="button" class="sulalat-b2b-register__toggle-pass" data-toggle-password aria-label="Show password">
                <svg class="icon-show" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z" stroke="currentColor" stroke-width="1.6"/>
                  <circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.6"/>
                </svg>
                <svg class="icon-hide" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M3 3l18 18M10.6 10.6A3 3 0 0012 15a3 3 0 002.4-4.8M9.9 5.1A10.4 10.4 0 0112 5c6.5 0 10 7 10 7a17.6 17.6 0 01-3.1 3.9M6.1 6.1A17.4 17.4 0 002 12s3.5 7 10 7c1.2 0 2.3-.2 3.4-.6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                </svg>
              </button>
            </div>
          </div>
        </div>

        <label class="sulalat-b2b-register__agree">
          <input type="checkbox" data-agree required>
          <span>
            {{ section.settings.agree_prefix | escape }}
            {%- if terms_url != blank -%}
              <a href="{{ terms_url }}" target="_blank" rel="noopener">{{ section.settings.terms_label | escape }}</a>
            {%- else -%}
              {{ section.settings.terms_label | escape }}
            {%- endif -%}
            {{ section.settings.agree_middle | escape }}
            {%- if privacy_url != blank -%}
              <a href="{{ privacy_url }}" target="_blank" rel="noopener">{{ section.settings.privacy_label | escape }}</a>
            {%- else -%}
              {{ section.settings.privacy_label | escape }}
            {%- endif -%}
          </span>
        </label>

        <button type="submit" class="sulalat-b2b-register__submit">
          {{ section.settings.submit_label | escape }}
        </button>

        {%- if section.settings.show_login_link -%}
          <p class="sulalat-b2b-register__login">
            {{ section.settings.login_text | escape }}
            <a href="{{ routes.account_login_url }}">{{ section.settings.login_link_label | escape }}</a>
          </p>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>

  <script>
    (function () {
      var root = document.querySelector('.sulalat-b2b-register[data-section-id="{{ section.id }}"]');
      if (!root) return;

      var form = root.querySelector('form');
      var typeInputs = Array.prototype.slice.call(root.querySelectorAll('[data-account-type]'));
      var companyPanel = root.querySelector('[data-account-panel="company"]');
      var personalPanel = root.querySelector('[data-account-panel="personal"]');
      var submitFirst = root.querySelector('[data-submit-first]');
      var submitLast = root.querySelector('[data-submit-last]');
      var noteField = root.querySelector('[data-customer-note]');
      var tagsField = root.querySelector('[data-customer-tags]');
      var companyTag = {{ section.settings.company_tag | default: 'b2b' | json }};
      var personalTag = {{ section.settings.personal_tag | default: 'personal' | json }};
      var passwordInput = root.querySelector('#b2b-password');
      var togglePass = root.querySelector('[data-toggle-password]');

      function val(id) {
        var el = root.querySelector(id);
        return el ? (el.value || '').trim() : '';
      }

      function selectedType() {
        var selected = root.querySelector('[data-account-type]:checked');
        return selected ? selected.value : 'company';
      }

      function syncAccountType() {
        var isCompany = selectedType() === 'company';
        if (companyPanel) companyPanel.hidden = !isCompany;
        if (personalPanel) personalPanel.hidden = isCompany;
        if (tagsField) tagsField.value = isCompany ? companyTag : personalTag;
      }

      function prepareSubmit() {
        var isCompany = selectedType() === 'company';
        var first = '';
        var last = '';
        var lines = [];

        lines.push('SOURCE: b2b-register');
        lines.push('Account Type: ' + (isCompany ? 'Company Account' : 'Personal Account'));

        if (isCompany) {
          first = val('#b2b-company-name');
          last = val('#b2b-brand-name');
          if (first) lines.push('Company Name: ' + first);
          if (last) lines.push('Brand Name: ' + last);
          if (val('#b2b-cr')) lines.push('CR Number: ' + val('#b2b-cr'));
          if (val('#b2b-vat')) lines.push('VAT Number: ' + val('#b2b-vat'));
          if (val('#b2b-region')) lines.push('Region: ' + val('#b2b-region'));
          if (val('#b2b-city')) lines.push('City: ' + val('#b2b-city'));
        } else {
          first = val('#b2b-first-name');
          last = val('#b2b-last-name');
          if (first) lines.push('First Name: ' + first);
          if (last) lines.push('Last Name: ' + last);
        }

        if (val('#b2b-phone')) lines.push('Phone: ' + val('#b2b-phone'));
        lines.push('Tag: ' + (isCompany ? companyTag : personalTag));

        if (submitFirst) submitFirst.value = first || 'B2B';
        if (submitLast) submitLast.value = last || (isCompany ? 'Company' : 'Customer');
        if (noteField) noteField.value = lines.join('\n');
        if (tagsField) tagsField.value = isCompany ? companyTag : personalTag;
      }

      typeInputs.forEach(function (input) {
        input.addEventListener('change', function () {
          typeInputs.forEach(function (other) {
            if (other !== input) other.checked = false;
          });
          input.checked = true;
          syncAccountType();
        });
      });
      syncAccountType();

      if (form) {
        form.addEventListener('submit', function (event) {
          var isCompany = selectedType() === 'company';
          var nameValue = isCompany ? val('#b2b-company-name') : val('#b2b-first-name');
          var agree = root.querySelector('[data-agree]');

          if (agree && !agree.checked) {
            event.preventDefault();
            agree.focus();
            return;
          }

          if (!nameValue) {
            event.preventDefault();
            var focusEl = root.querySelector(isCompany ? '#b2b-company-name' : '#b2b-first-name');
            if (focusEl) focusEl.focus();
            return;
          }

          prepareSubmit();
        });
      }

      if (togglePass && passwordInput) {
        togglePass.addEventListener('click', function () {
          var show = passwordInput.type === 'password';
          passwordInput.type = show ? 'text' : 'password';
          togglePass.classList.toggle('is-visible', show);
          togglePass.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
        });
      }
    })();
  </script>
</section>

