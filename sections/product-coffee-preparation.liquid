{%- liquid
  assign prep_heading_mf = product.metafields.custom.coffee_preparation_heading.value
  assign prep_heading = prep_heading_mf | default: section.settings.heading

  assign prep_mf = product.metafields.custom.coffee_preparation
  assign prep_items = prep_mf.value
  assign prep_is_list = false
  if prep_mf.type contains 'list.'
    assign prep_is_list = true
  endif

  assign use_metafields = false
  if prep_items != blank
    assign use_metafields = true
  endif
-%}

{%- if use_metafields or request.design_mode or section.settings.image_1 != blank or section.settings.image_2 != blank or section.settings.video_1_poster != blank or section.settings.video_2_poster != blank or section.settings.video_1 != blank or section.settings.video_2 != blank or section.settings.video_1_url != blank or section.settings.video_2_url != blank -%}
<section
  class="sulalat-prep"
  data-section-id="{{ section.id }}"
  style="
    --prep-pad-top: {{ section.settings.padding_top }}px;
    --prep-pad-bottom: {{ section.settings.padding_bottom }}px;
    --prep-bg: {{ section.settings.background_color }};
    --prep-accent: {{ section.settings.accent_color }};
  "
>
<style>
  /* =========================================
     SECTION
     ========================================= */

  .sulalat-prep[data-section-id="{{ section.id }}"] {
    padding: var(--prep-pad-top) 0 var(--prep-pad-bottom);
    background: var(--prep-bg);
    font-family: var(--body-font-family);
    color: #1a1a1a;
  }

  .sulalat-prep[data-section-id="{{ section.id }}"] .container {
    max-width: var(--brand-container-max, 1440px);
    margin: 0 auto;
    padding: 0 var(--brand-container-padding-x, 20px);
  }

  .sulalat-prep[data-section-id="{{ section.id }}"] .sulalat-prep__heading {
    text-align: center;
  }


  /* =========================================
     GRID
     
     ROW 1:
     Portrait Left + Landscape Right
     Landscape bottom aligned

     ROW 2:
     Landscape Left + Portrait Right
     Both top aligned
     ========================================= */

  .sulalat-prep[data-section-id="{{ section.id }}"] .sulalat-prep__grid {
    display: grid;

    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: auto auto;

    column-gap: 30px;
    row-gap: 30px;

    align-items: start;
  }


  /* =========================================
     COMMON CARD
     ========================================= */

  .sulalat-prep[data-section-id="{{ section.id }}"] .sulalat-prep__item {
    position: relative;
    display: block;

    width: 100%;
    min-width: 0;
    min-height: 0;

    border-radius: 14px;
    overflow: hidden;

    background: #f3f3f3;

    text-decoration: none;
    color: inherit;
  }


  /* =========================================
     CARD 1
     TOP LEFT
     PORTRAIT
     ========================================= */

  .sulalat-prep[data-section-id="{{ section.id }}"]
  .sulalat-prep__item--pos-1 {
    grid-column: 1 / 5;
    grid-row: 1;

    /* Portrait proportion */
    aspect-ratio: 0.87 / 1;

    /* Start from top */
    align-self: start;
  }


  /* =========================================
     CARD 2
     TOP RIGHT
     LANDSCAPE

     Bottom aligned with Card 1
     ========================================= */

  .sulalat-prep[data-section-id="{{ section.id }}"]
  .sulalat-prep__item--pos-2 {
    grid-column: 5 / 13;
    grid-row: 1;

    /* Landscape proportion */
    aspect-ratio: 2 / 1;

    /* IMPORTANT:
       Bottom matches portrait card */
    align-self: end;
  }


  /* =========================================
     CARD 3
     BOTTOM LEFT
     LANDSCAPE

     Top aligned with Card 4
     ========================================= */

  .sulalat-prep[data-section-id="{{ section.id }}"]
  .sulalat-prep__item--pos-3 {
    grid-column: 1 / 9;
    grid-row: 2;

    /* Landscape proportion */
    aspect-ratio: 2 / 1;

    /* Top aligned */
    align-self: start;
  }


  /* =========================================
     CARD 4
     BOTTOM RIGHT
     PORTRAIT

     Top aligned with Card 3
     ========================================= */

  .sulalat-prep[data-section-id="{{ section.id }}"]
  .sulalat-prep__item--pos-4 {
    grid-column: 9 / 13;
    grid-row: 2;

    /* Portrait proportion */
    aspect-ratio: 0.87 / 1;

    /* Top aligned */
    align-self: start;
  }


  /* =========================================
     EXTRA ITEMS
     ========================================= */

  .sulalat-prep[data-section-id="{{ section.id }}"]
  .sulalat-prep__item--pos-n {
    grid-column: span 6;

    aspect-ratio: 16 / 9;

    align-self: start;
  }


  /* =========================================
     IMAGE / VIDEO
     ========================================= */

  .sulalat-prep[data-section-id="{{ section.id }}"] .sulalat-prep__item img,
  .sulalat-prep[data-section-id="{{ section.id }}"] .sulalat-prep__item video,
  .sulalat-prep[data-section-id="{{ section.id }}"] .sulalat-prep__item svg.placeholder-svg {
    position: absolute;
    inset: 0;

    display: block;

    width: 100%;
    height: 100%;

    object-fit: cover;
  }


  /* =========================================
     PLAY OVERLAY
     ========================================= */

  .sulalat-prep[data-section-id="{{ section.id }}"] .sulalat-prep__play {
    position: absolute;
    inset: 0;

    display: flex;
    align-items: center;
    justify-content: center;

    background: rgba(0, 0, 0, 0.22);

    pointer-events: none;
  }


  /* =========================================
     PLAY BUTTON
     ========================================= */

  .sulalat-prep[data-section-id="{{ section.id }}"] .sulalat-prep__play span {
    width: 72px;
    height: 72px;

    border-radius: 50%;

    background: rgba(255, 255, 255, 0.92);

    display: inline-flex;
    align-items: center;
    justify-content: center;

    color: #1a1a1a;

    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.2);
  }

  .sulalat-prep[data-section-id="{{ section.id }}"] .sulalat-prep__play svg {
    width: 26px;
    height: 26px;

    margin-left: 3px;
  }


  /* =========================================
     EMPTY STATE
     ========================================= */

  .sulalat-prep[data-section-id="{{ section.id }}"] .sulalat-prep__empty {
    margin: 0;

    text-align: center;

    color: #888;

    font-size: 14px;
  }


  /* =========================================
     LARGE TABLET
     ========================================= */

  @media screen and (max-width: 1199px) {

    .sulalat-prep[data-section-id="{{ section.id }}"]
    .sulalat-prep__grid {
      column-gap: 20px;
      row-gap: 20px;
    }

    .sulalat-prep[data-section-id="{{ section.id }}"]
    .sulalat-prep__play span {
      width: 62px;
      height: 62px;
    }

    .sulalat-prep[data-section-id="{{ section.id }}"]
    .sulalat-prep__play svg {
      width: 23px;
      height: 23px;
    }
  }


  /* =========================================
     TABLET
     Keep same Figma composition
     ========================================= */

  @media screen and (max-width: 991px) {

    .sulalat-prep[data-section-id="{{ section.id }}"]
    .sulalat-prep__grid {
      column-gap: 14px;
      row-gap: 14px;
    }

    .sulalat-prep[data-section-id="{{ section.id }}"]
    .sulalat-prep__item {
      border-radius: 10px;
    }

    .sulalat-prep[data-section-id="{{ section.id }}"]
    .sulalat-prep__play span {
      width: 56px;
      height: 56px;
    }

    .sulalat-prep[data-section-id="{{ section.id }}"]
    .sulalat-prep__play svg {
      width: 20px;
      height: 20px;
    }
  }


  /* =========================================
     MOBILE
     Stack cards
     ========================================= */

  @media screen and (max-width: 749px) {

    .sulalat-prep[data-section-id="{{ section.id }}"] {
      padding:
        {{ section.settings.padding_top_mobile }}px
        0
        {{ section.settings.padding_bottom_mobile }}px;
    }

    .sulalat-prep[data-section-id="{{ section.id }}"]
    .sulalat-prep__heading {
      margin-bottom: 24px;
    }


    /* One column */
    .sulalat-prep[data-section-id="{{ section.id }}"]
    .sulalat-prep__grid {
      grid-template-columns: 1fr;
      grid-template-rows: none;
      gap: 14px;
    }

     .sulalat-prep[data-section-id="{{ section.id }}"]
    .sulalat-prep__item {
      border-radius: 10px;
      aspect-ratio: 16 / 9 !important;
    }


    /* Reset all desktop positions */
    .sulalat-prep[data-section-id="{{ section.id }}"]
    .sulalat-prep__item--pos-1,

    .sulalat-prep[data-section-id="{{ section.id }}"]
    .sulalat-prep__item--pos-2,

    .sulalat-prep[data-section-id="{{ section.id }}"]
    .sulalat-prep__item--pos-3,

    .sulalat-prep[data-section-id="{{ section.id }}"]
    .sulalat-prep__item--pos-4,

    .sulalat-prep[data-section-id="{{ section.id }}"]
    .sulalat-prep__item--pos-n {
      grid-column: 1;
      grid-row: auto;

      width: 100%;
      height: auto;

      min-height: 0;

      align-self: auto;
    }


    /* Portrait cards */
    .sulalat-prep[data-section-id="{{ section.id }}"]
    .sulalat-prep__item--pos-1,

    .sulalat-prep[data-section-id="{{ section.id }}"]
    .sulalat-prep__item--pos-4 {
      aspect-ratio: 4 / 5;
    }


    /* Landscape cards */
    .sulalat-prep[data-section-id="{{ section.id }}"]
    .sulalat-prep__item--pos-2,

    .sulalat-prep[data-section-id="{{ section.id }}"]
    .sulalat-prep__item--pos-3,

    .sulalat-prep[data-section-id="{{ section.id }}"]
    .sulalat-prep__item--pos-n {
      aspect-ratio: 16 / 9;
    }


    /* Mobile play button */
    .sulalat-prep[data-section-id="{{ section.id }}"]
    .sulalat-prep__play span {
      width: 52px;
      height: 52px;
    }

    .sulalat-prep[data-section-id="{{ section.id }}"]
    .sulalat-prep__play svg {
      width: 19px;
      height: 19px;
    }
  }


  /* =========================================
     SMALL MOBILE
     ========================================= */

  @media screen and (max-width: 480px) {

    .sulalat-prep[data-section-id="{{ section.id }}"]
    .sulalat-prep__grid {
      gap: 12px;
    }

    .sulalat-prep[data-section-id="{{ section.id }}"]
    .sulalat-prep__item {
      border-radius: 8px;
    }

    .sulalat-prep[data-section-id="{{ section.id }}"]
    .sulalat-prep__play span {
      width: 46px;
      height: 46px;
    }

    .sulalat-prep[data-section-id="{{ section.id }}"]
    .sulalat-prep__play svg {
      width: 17px;
      height: 17px;
    }
  }

</style>

  <div class="container">
    {%- if prep_heading != blank -%}
      <div class="section-title">
        <h2 class="sulalat-prep__heading">{{ prep_heading | escape }}</h2>
      </div>
    {%- endif -%}

    {%- liquid
      # Exactly 4 slots: image, video, video, image
      assign slot_1_image = section.settings.image_1
      assign slot_2_image = section.settings.video_1_poster
      assign slot_2_video = section.settings.video_1
      assign slot_2_url = section.settings.video_1_url
      assign slot_3_image = section.settings.video_2_poster
      assign slot_3_video = section.settings.video_2
      assign slot_3_url = section.settings.video_2_url
      assign slot_4_image = section.settings.image_2

      if use_metafields
        if prep_is_list
          for item in prep_items
            assign mo_image = item.image.value | default: item.image
            assign mo_video = item.video.value | default: item.video
            assign mo_url = item.video_url.value | default: item.video_url
            if forloop.index == 1
              assign slot_1_image = mo_image
            elsif forloop.index == 2
              assign slot_2_image = mo_image
              assign slot_2_video = mo_video
              assign slot_2_url = mo_url
            elsif forloop.index == 3
              assign slot_3_image = mo_image
              assign slot_3_video = mo_video
              assign slot_3_url = mo_url
            elsif forloop.index == 4
              assign slot_4_image = mo_image
            endif
          endfor
        else
          assign slot_1_image = prep_items.image.value | default: prep_items.image | default: slot_1_image
        endif
      endif

      assign has_slots = false
      if slot_1_image != blank or slot_2_image != blank or slot_2_video != blank or slot_2_url != blank or slot_3_image != blank or slot_3_video != blank or slot_3_url != blank or slot_4_image != blank
        assign has_slots = true
      endif
    -%}

    {%- if has_slots or request.design_mode -%}
      <div class="sulalat-prep__grid">
        {% render 'sulalat-prep-item', mode: 'image', index: 1, image: slot_1_image, heading: prep_heading %}
        {% render 'sulalat-prep-item', mode: 'video', index: 2, image: slot_2_image, video: slot_2_video, video_url: slot_2_url, heading: prep_heading %}
        {% render 'sulalat-prep-item', mode: 'video', index: 3, image: slot_3_image, video: slot_3_video, video_url: slot_3_url, heading: prep_heading %}
        {% render 'sulalat-prep-item', mode: 'image', index: 4, image: slot_4_image, heading: prep_heading %}
      </div>
    {%- elsif request.design_mode -%}
      <p class="sulalat-prep__empty">
        Add product metafield <strong>custom.coffee_preparation</strong> (4 items: image, video, video, image), or set the 4 slots below.
      </p>
    {%- endif -%}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Coffee preparation",
  "tag": "section",
  "class": "sulalat-prep-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Exactly 4 slots: Image 1, Video 1, Video 2, Image 2. Product metafield custom.coffee_preparation (list of coffee_preparation_item) overrides these when set. Video slots need a poster image plus a Shopify video or video link."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Coffee Preparation",
      "info": "Used when custom.coffee_preparation_heading is empty."
    },
    {
      "type": "header",
      "content": "Image 1 (top left)"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image"
    },
    {
      "type": "header",
      "content": "Video 1 (top right)"
    },
    {
      "type": "image_picker",
      "id": "video_1_poster",
      "label": "Poster image"
    },
    {
      "type": "video",
      "id": "video_1",
      "label": "Shopify video"
    },
    {
      "type": "url",
      "id": "video_1_url",
      "label": "Video link",
      "info": "Use this if you are not using a Shopify-hosted video."
    },
    {
      "type": "header",
      "content": "Video 2 (bottom left)"
    },
    {
      "type": "image_picker",
      "id": "video_2_poster",
      "label": "Poster image"
    },
    {
      "type": "video",
      "id": "video_2",
      "label": "Shopify video"
    },
    {
      "type": "url",
      "id": "video_2_url",
      "label": "Video link",
      "info": "Use this if you are not using a Shopify-hosted video."
    },
    {
      "type": "header",
      "content": "Image 2 (bottom right)"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Play button color",
      "default": "#53c295"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding top (mobile)",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom (mobile)",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Coffee preparation"
    }
  ]
}
{% endschema %}
