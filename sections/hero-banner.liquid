<section
  class="site-banner"
  data-section-id="{{ section.id }}"
  style="
    --banner-h: {{ section.settings.banner_height | default: 900 }}px;
    {% if section.settings.banner_height_mobile != blank %}--banner-h-mobile: {{ section.settings.banner_height_mobile }}px;{% endif %}
    --banner-mobile-bp: {{ section.settings.mobile_image_breakpoint | default: 749 }}px;
  "
>
  {%- liquid
    assign mobile_bp = section.settings.mobile_image_breakpoint | default: 749
    assign desktop_image = section.settings.banner_image
    assign mobile_image = section.settings.banner_image_mobile
    assign desktop_alt = desktop_image.alt | default: section.settings.banner_image_alt
    assign mobile_alt = mobile_image.alt | default: section.settings.banner_image_mobile_alt | default: desktop_alt
  -%}
  <div class="banner-bg-img">
    {% if desktop_image != blank or mobile_image != blank %}
      <picture>
        {% if mobile_image != blank %}
          <source
            media="(max-width: {{ mobile_bp }}px)"
            srcset="
              {{ mobile_image | image_url: width: 600 }} 600w,
              {{ mobile_image | image_url: width: 900 }} 900w,
              {{ mobile_image | image_url: width: 1200 }} 1200w
            "
            sizes="100vw"
          >
        {% endif %}
        {% if desktop_image != blank %}
          <img
            class="banner-bg-img__desktop"
            src="{{ desktop_image | image_url: width: 2000 }}"
            srcset="
              {{ desktop_image | image_url: width: 800 }} 800w,
              {{ desktop_image | image_url: width: 1200 }} 1200w,
              {{ desktop_image | image_url: width: 1600 }} 1600w,
              {{ desktop_image | image_url: width: 2000 }} 2000w
            "
            sizes="100vw"
            alt="{{ desktop_alt | escape }}"
            width="{{ desktop_image.width }}"
            height="{{ desktop_image.height }}"
            loading="eager"
            fetchpriority="high"
          >
        {% else %}
          <img
            class="banner-bg-img__mobile-only"
            src="{{ mobile_image | image_url: width: 1200 }}"
            srcset="
              {{ mobile_image | image_url: width: 600 }} 600w,
              {{ mobile_image | image_url: width: 900 }} 900w,
              {{ mobile_image | image_url: width: 1200 }} 1200w
            "
            sizes="100vw"
            alt="{{ mobile_alt | escape }}"
            width="{{ mobile_image.width }}"
            height="{{ mobile_image.height }}"
            loading="eager"
            fetchpriority="high"
          >
        {% endif %}
      </picture>
    {% else %}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'banner-placeholder-svg' }}
    {% endif %}
  </div>

  <div class="banner-warp">
    <div class="container">
      {% if section.settings.heading != blank %}
        <h1 style="color: {{ section.settings.heading_color }};">{{ section.settings.heading }}</h1>
      {% endif %}

      <div
        class="banner-btm"
        style="border-top-color: {{ section.settings.divider_color }};"
      >
        {% if section.blocks.size > 0 %}
          <div class="banner-cards" style="--card-columns: {{ section.settings.cards_per_row }};">
            {% for block in section.blocks %}
              {% if block.type == 'card' %}
                <div class="banner-card" {{ block.shopify_attributes }}>
                  {% if block.settings.heading != blank %}
                    <h4 style="color: {{ block.settings.text_color }};">{{ block.settings.heading }}</h4>
                  {% endif %}
                  {% if block.settings.text != blank %}
                    <div class="banner-card-text" style="color: {{ block.settings.text_color }};">
                      {{ block.settings.text }}
                    </div>
                  {% endif %}

                  <div class="banner-card-img">
                    <a
                      href="{{ block.settings.link | default: '#' }}"
                      aria-label="{{ block.settings.heading | strip_html | default: 'View more' | escape }}"
                    >
                      {% if block.settings.image != blank %}
                        <img
                          src="{{ block.settings.image | image_url: width: 800 }}"
                          srcset="{{ block.settings.image | image_url: width: 400 }} 400w,
                                  {{ block.settings.image | image_url: width: 800 }} 800w"
                          sizes="(max-width: {{ mobile_bp }}px) 100vw, 40vw"
                          alt="{{ block.settings.image.alt | default: block.settings.image_alt | escape }}"
                          width="{{ block.settings.image.width }}"
                          height="{{ block.settings.image.height }}"
                          loading="eager"
                          fetchpriority="high"
                        >
                      {% else %}
                        {{ 'product-1' | placeholder_svg_tag: 'banner-card-placeholder-svg' }}
                      {% endif %}
                      <div class="navi" style="color: {{ block.settings.button_color | default: '#ffffff' }};">
                        
                        <svg xmlns="http://www.w3.org/2000/svg" width="44" height="24" viewBox="0 0 44 24" fill="none" aria-hidden="true" focusable="false">
                          <rect x="0.5" y="0.5" width="43" height="23" rx="11.5" stroke="currentColor" />
                          <g clip-path="url(#clip0_2101_653_{{ block.id }})">
                            <path d="M22 7.28589L26.714 11.9999L22 16.714" stroke="currentColor" stroke-width="1.33333" stroke-linecap="round" stroke-linejoin="round" />
                            <path d="M17.286 11.9999H26.714" stroke="currentColor" stroke-width="1.33333" stroke-linecap="round" stroke-linejoin="round" />
                          </g>
                          <defs>
                            <clipPath id="clip0_2101_653_{{ block.id }}">
                              <rect x="22" y="0.686279" width="16" height="16" rx="8" transform="rotate(45 22 0.686279)" fill="white" />
                            </clipPath>
                          </defs>
                        </svg>
                       <span>{{ block.settings.button_text | default: 'Shop Now' }}</span>
                      </div>
                    </a>
                  </div>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}

        {% if section.settings.show_scroll_link %}
          <div class="scroll-btm">
            <a
              href="#"
              data-hero-scroll-next
              style="color: {{ section.settings.scroll_icon_color }};"
              aria-label="{{ section.settings.scroll_text | default: 'Scroll' | escape }}"
            >
              <span>{{ section.settings.scroll_text | default: 'Scroll' }}</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 36 36" fill="none" aria-hidden="true" focusable="false">
                <path d="M24.0352 18.1421L18.1426 24.0346L12.25 18.1421" stroke="currentColor" stroke-opacity="0.6" stroke-width="1.70708" stroke-linecap="round" stroke-linejoin="round" />
                <path d="M18.1426 12.2495V24.0346" stroke="currentColor" stroke-opacity="0.6" stroke-width="1.70708" stroke-linecap="round" stroke-linejoin="round" />
                <circle cx="18" cy="18" r="17.55" stroke="currentColor" stroke-opacity="0.6" stroke-width="0.900003" />
              </svg>
            </a>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

<style>
  /* Matched to sulalat-main reference hero */
  .site-banner[data-section-id="{{ section.id }}"] {
    position: relative;
    isolation: isolate;
  }

  .site-banner[data-section-id="{{ section.id }}"]::before {
    content: "";
    background: {{ section.settings.overlay_color }};
    inset: 0;
    position: absolute;
    z-index: 1;
    pointer-events: none;
  }

  .site-banner[data-section-id="{{ section.id }}"] .banner-bg-img {
    height: var(--banner-h, 900px);
    overflow:hidden;
  }

  .site-banner[data-section-id="{{ section.id }}"] .banner-bg-img img,
  .site-banner[data-section-id="{{ section.id }}"] .banner-bg-img svg.banner-placeholder-svg {
    width: 100%;
    display: block;
    height: 100%;
    object-fit: cover;
  }

  .site-banner[data-section-id="{{ section.id }}"] .banner-warp {
    position: absolute;
    inset: 0;
    display: flex;
    justify-content: {{ section.settings.content_alignment | default: 'flex-start' }};
    align-items: end;
    padding-bottom: {{ section.settings.content_padding_bottom | default: 50 }}px;
    z-index: 2;
  }

  .site-banner[data-section-id="{{ section.id }}"] .container {
    width: 100%;
    max-width: {{ section.settings.container_max_width | default: 1400 }}px;
    margin: 0 auto;
    padding-left: 20px;
    padding-right: 20px;
  }

  .site-banner[data-section-id="{{ section.id }}"] .banner-warp h1 {
    color: #fff;
    font-weight: 400;
    font-size: clamp(32px, 3.2vw, {{ section.settings.heading_max_size | default: 60 }}px);
    line-height: 1.33;
    margin: 0;
  }

  .site-banner[data-section-id="{{ section.id }}"] .banner-warp h1 p {
    margin: 0;
    font: inherit;
    color: inherit;
  }

  .site-banner[data-section-id="{{ section.id }}"] .banner-btm {
    border-top: 1px solid;
    margin-top: 30px;
    padding-top: 20px;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 20px;
  }

  .site-banner[data-section-id="{{ section.id }}"] .banner-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .site-banner[data-section-id="{{ section.id }}"] .banner-cards {
    display: grid;
    grid-template-columns: repeat(var(--card-columns, 2), 1fr);
    gap: 30px;
    width: 100%;
    max-width: {{ section.settings.cards_max_width | default: 572 }}px;
  }

  .site-banner[data-section-id="{{ section.id }}"] .banner-card-img {
    position: relative;
    margin-top: 26px;
    min-height:110px;
  }

  .site-banner[data-section-id="{{ section.id }}"] .banner-card-img img,
  .site-banner[data-section-id="{{ section.id }}"] .banner-card-img svg.banner-card-placeholder-svg {
    width: 100%;
    display: block;
    border-radius: {{ section.settings.card_image_radius | default: 20 }}px;
    height:100%;
    object-fit: cover;
  }

  .site-banner[data-section-id="{{ section.id }}"] .banner-card-img a {
    position: relative;
    display: block;
    text-decoration: none;
    height:100%;
  }

  .site-banner[data-section-id="{{ section.id }}"] .banner-card-img .navi {
    display: flex;
    gap: 15px;
    align-items: center;
    justify-content: center;
    position: absolute;
    inset: 0;
    color: #fff;
    font-size: 16px;
  }

  .site-banner[data-section-id="{{ section.id }}"] .banner-card-img .navi span {
    max-width: 125px;
    width: max-content;
  }

  .site-banner[data-section-id="{{ section.id }}"] .banner-card h4 {
    color: #fff;
    font-size: 22px;
    font-weight: 500;
    margin: 0 0 12px;
  }

  .site-banner[data-section-id="{{ section.id }}"] .banner-card-text,
  .site-banner[data-section-id="{{ section.id }}"] .banner-card-text p,
  .site-banner[data-section-id="{{ section.id }}"] .banner-card p {
    color: #fff;
    font-size: 16px;
    letter-spacing: -0.01em;
    line-height: 24px;
    font-weight: 300;
    margin: 0 0 auto;
  }

  .site-banner[data-section-id="{{ section.id }}"] .scroll-btm a {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 18px;
    color: #ffffffcc;
    font-weight: 300;
    text-decoration: none;
  }

  @media screen and (max-width: 1440px){
    .site-banner[data-section-id="{{ section.id }}"] .banner-card h4 {
        font-size: 20px;
    }
  }

  @media screen and (max-width: 989px) {
    {% comment %} .site-banner[data-section-id="{{ section.id }}"] .banner-cards {
      max-width: 100%;
    } {% endcomment %}
  }

  @media screen and (max-width: 749px) {
    .site-banner[data-section-id="{{ section.id }}"] .banner-bg-img {
      height: var(--banner-h-mobile, 500px);
    }

    .site-banner[data-section-id="{{ section.id }}"] .banner-cards {
      max-width: 100%;
    }

    .site-banner[data-section-id="{{ section.id }}"] .banner-warp {
      align-items: end;
      padding-bottom: 30px;
    }

    .site-banner[data-section-id="{{ section.id }}"] .banner-cards {
      grid-template-columns: 1fr 1fr;
    }

    .site-banner[data-section-id="{{ section.id }}"] .banner-btm {
      justify-content: flex-start;
    }

    .site-banner[data-section-id="{{ section.id }}"] .banner-warp h1 br {
      display: none;
    }
  }

  @media screen and (max-width: 575px){
    .site-banner[data-section-id="{{ section.id }}"] .banner-warp h1 {
        font-size: 30px;
        margin-bottom: 160px;
        max-width: 230px;
    }
    .site-banner[data-section-id="{{ section.id }}"] .banner-card h4 {
      color: #fff;
      font-size: 18px;
      font-weight: 400;
    }

    .site-banner[data-section-id="{{ section.id }}"] .banner-card-img .navi {
      gap: 10px;
      padding: 12px;
      font-size: 15px;
    }
  }

  @media screen and (max-width: 480px){
    .site-banner[data-section-id="{{ section.id }}"] .banner-cards {
        gap: 20px;
    }
    .site-banner[data-section-id="{{ section.id }}"] .banner-card-img .navi span {
      font-size:13px;
    } 

    {% comment %} .site-banner[data-section-id="{{ section.id }}"] .banner-cards {
      grid-template-columns: 100%;
    } {% endcomment %}

    {% comment %} .site-banner[data-section-id="{{ section.id }}"] .banner-card-img {
      min-height:0;
      height: 120px;
    }
    .site-banner[data-section-id="{{ section.id }}"] .banner-warp h1 {
        margin-bottom: 20px;
    } {% endcomment %}
  }
</style>

<script>
  (function () {
    var banner = document.querySelector('.site-banner[data-section-id="{{ section.id }}"]');
    if (!banner || banner.dataset.scrollNextBound === 'true') return;
    banner.dataset.scrollNextBound = 'true';

    var link = banner.querySelector('[data-hero-scroll-next]');
    if (!link) return;

    link.addEventListener('click', function (event) {
      event.preventDefault();

      var sectionWrap = banner.closest('.shopify-section');
      if (!sectionWrap) return;

      var nextSection = sectionWrap.nextElementSibling;
      while (nextSection && !nextSection.classList.contains('shopify-section')) {
        nextSection = nextSection.nextElementSibling;
      }

      if (!nextSection) return;

      var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var headerOffset = parseFloat(
        getComputedStyle(document.documentElement).getPropertyValue('--header-end-padded')
      ) || 0;
      var top = nextSection.getBoundingClientRect().top + window.scrollY - headerOffset;

      window.scrollTo({
        top: Math.max(0, top),
        behavior: reduceMotion ? 'auto' : 'smooth'
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Site Banner",
  "tag": "section",
  "class": "site-banner-section",
  "settings": [
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Background image (desktop)"
    },
    {
      "type": "text",
      "id": "banner_image_alt",
      "label": "Desktop image alt text (used if image has none)",
      "default": "Banner background image"
    },
    {
      "type": "image_picker",
      "id": "banner_image_mobile",
      "label": "Background image (mobile)",
      "info": "Optional. Falls back to the desktop image if empty."
    },
    {
      "type": "text",
      "id": "banner_image_mobile_alt",
      "label": "Mobile image alt text (used if image has none)"
    },
    {
      "type": "range",
      "id": "mobile_image_breakpoint",
      "min": 480,
      "max": 1200,
      "step": 10,
      "unit": "px",
      "label": "Mobile breakpoint",
      "info": "Viewport width at and below which the mobile image and mobile banner height are used.",
      "default": 750
    },
    {
      "type": "range",
      "id": "banner_height",
      "min": 400,
      "max": 1200,
      "step": 50,
      "unit": "px",
      "label": "Banner height (desktop)",
      "default": 900
    },
    {
      "type": "range",
      "id": "banner_height_mobile",
      "min": 300,
      "max": 900,
      "step": 25,
      "unit": "px",
      "label": "Banner height (mobile)",
      "default": 500
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#00000080"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>The Art of<br>Saudi Specialty Coffee</p>"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "heading_max_size",
      "min": 32,
      "max": 90,
      "step": 2,
      "unit": "px",
      "label": "Heading max font size",
      "default": 60
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content alignment",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" }
      ],
      "default": "flex-start"
    },
    {
      "type": "range",
      "id": "container_max_width",
      "min": 1000,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "label": "Content container max width",
      "default": 1440
    },
    {
      "type": "header",
      "content": "Cards"
    },
    {
      "type": "range",
      "id": "cards_per_row",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Cards per row (desktop)",
      "default": 2
    },
    {
      "type": "range",
      "id": "cards_max_width",
      "min": 300,
      "max": 900,
      "step": 10,
      "unit": "px",
      "label": "Cards block max width",
      "default": 570
    },
    {
      "type": "range",
      "id": "card_image_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Card image border radius",
      "default": 20
    },
    {
      "type": "range",
      "id": "content_padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Banner content bottom padding",
      "default": 50
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider line color",
      "default": "#C4F6E233"
    },
    {
      "type": "header",
      "content": "Scroll link"
    },
    {
      "type": "checkbox",
      "id": "show_scroll_link",
      "label": "Show scroll link",
      "default": true
    },
    {
      "type": "paragraph",
      "content": "Scrolls smoothly to the next section on the page."
    },
    {
      "type": "text",
      "id": "scroll_text",
      "label": "Scroll link text",
      "default": "Scroll"
    },
    {
      "type": "color",
      "id": "scroll_icon_color",
      "label": "Scroll icon/text color",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Banner Card",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Card heading",
          "default": "For Coffee Enthusiasts"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Card text",
          "default": "<p>As a Saudi pioneer, Sulalat sources, roasts, and delivers world-class coffee, chocolate, and cafe solutions with uncompromising quality and safety.</p>"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Card text color",
          "default": "#ffffff"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card image"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Card image alt text (used if image has none)",
          "default": "Banner card image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Card link"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button/overlay text",
          "default": "Shop Now"
        },
        {
          "type": "color",
          "id": "button_color",
          "label": "Button/overlay icon and text color",
          "default": "#ffffff"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Site Banner",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "heading": "For Coffee Enthusiasts",
            "text": "<p>As a Saudi pioneer, Sulalat sources, roasts, and delivers world-class coffee, chocolate, and cafe solutions with uncompromising quality and safety.</p>",
            "button_text": "Shop Now"
          }
        },
        {
          "type": "card",
          "settings": {
            "heading": "For Business Partners",
            "text": "<p>Running a cafe, hotel, or distribution business? Partner with Sulalat for scalable wholesale solutions and trusted supply.</p>",
            "button_text": "Shop Now"
          }
        }
      ]
    }
  ]
}
{% endschema %}
