<section
  id="experience-sulalat-gallery"
  class="experience-sulalat-gallery"
  data-section-id="{{ section.id }}"
  style="
    --exp-gallery-bg: {{ section.settings.background_color }};
    --exp-gallery-padding-top: {{ section.settings.padding_top }}px;
    --exp-gallery-padding-bottom: {{ section.settings.padding_bottom }}px;
    --exp-gallery-gap: {{ section.settings.slide_gap }}px;
    --exp-gallery-slide-width: {{ section.settings.slide_width }}%;
  "
>
  <style>
    .experience-sulalat-gallery[data-section-id="{{ section.id }}"] {
      padding: var(--exp-gallery-padding-top, 80px) 0 var(--exp-gallery-padding-bottom, 100px);
      background: var(--exp-gallery-bg, #ffffff);
      font-family: var(--body-font-family);
      overflow: hidden;
      scroll-margin-top: 100px;
    }

    .experience-sulalat-gallery[data-section-id="{{ section.id }}"] .experience-sulalat-gallery__track {
      position: relative;
      width: 100%;
    }

    .experience-sulalat-gallery[data-section-id="{{ section.id }}"] .experience-sulalat-gallery__slider.swiper {
      overflow: visible;
    }

    .experience-sulalat-gallery[data-section-id="{{ section.id }}"] .experience-sulalat-gallery__slider .swiper-wrapper {
      align-items: stretch;
    }

    .experience-sulalat-gallery[data-section-id="{{ section.id }}"] .experience-sulalat-gallery__slider .swiper-slide {
      height: auto;
    }

    .experience-sulalat-gallery[data-section-id="{{ section.id }}"] .experience-sulalat-gallery__slider .swiper-slide:not(.swiper-slide-active) .experience-sulalat-gallery__media {
      opacity: 0.55;
      transition: opacity 0.45s ease;
    }

    .experience-sulalat-gallery[data-section-id="{{ section.id }}"] .experience-sulalat-gallery__slider .swiper-slide-active .experience-sulalat-gallery__media {
      opacity: 1;
      transition: opacity 0.45s ease;
    }

    .experience-sulalat-gallery[data-section-id="{{ section.id }}"] .experience-sulalat-gallery__track::before,
    .experience-sulalat-gallery[data-section-id="{{ section.id }}"] .experience-sulalat-gallery__track::after {
      content: '';
      position: absolute;
      top: 0;
      bottom: 0;
      width: min(120px, 12vw);
      z-index: 2;
      pointer-events: none;
      opacity:0;
      visibility:hidden;
    }

    .experience-sulalat-gallery[data-section-id="{{ section.id }}"] .experience-sulalat-gallery__track::before {
      left: 0;
      background: linear-gradient(to right, var(--exp-gallery-bg, #ffffff), transparent);
    }

    .experience-sulalat-gallery[data-section-id="{{ section.id }}"] .experience-sulalat-gallery__track::after {
      right: 0;
      background: linear-gradient(to left, var(--exp-gallery-bg, #ffffff), transparent);
    }

    .experience-sulalat-gallery[data-section-id="{{ section.id }}"] .container {
      max-width: var(--brand-container-max, 1440px);
      margin: 0 auto;
      padding: 0 var(--brand-container-padding-x, 20px);
    }

    .experience-sulalat-gallery[data-section-id="{{ section.id }}"] .experience-sulalat-gallery__heading {
      margin: 0 0 48px;
      text-align: center;
      color: #141211;
      font-size: clamp(24px, 3vw, 36px);
      line-height: 1.15;
      font-weight: 400;
      letter-spacing: -0.02em;
    }

    .experience-sulalat-gallery[data-section-id="{{ section.id }}"] .experience-sulalat-gallery__media {
      display: block;
      border-radius: 12px;
      overflow: hidden;
      aspect-ratio: 16 / 7;
      background: #f3f3f3;
    }

    .experience-sulalat-gallery[data-section-id="{{ section.id }}"] .experience-sulalat-gallery__media img,
    .experience-sulalat-gallery[data-section-id="{{ section.id }}"] .experience-sulalat-gallery__media svg.placeholder-svg {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .experience-sulalat-gallery[data-section-id="{{ section.id }}"] .experience-sulalat-gallery__footer {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 28px;
      margin-top: 36px;
      max-width: 640px;
      margin-left: auto;
      margin-right: auto;
    }

    .experience-sulalat-gallery[data-section-id="{{ section.id }}"] .experience-sulalat-gallery__progress {
      position: relative;
      flex: 1;
      height: 2px;
      background: #e5e5e5;
      border-radius: 999px;
      overflow: hidden;
      max-width: 552px;
    }

    .experience-sulalat-gallery[data-section-id="{{ section.id }}"] .experience-sulalat-gallery__progress-bar {
      position: absolute;
      left: 0;
      top: 0;
      bottom: 0;
      width: 0;
      background: var(--brand-primary, #53c295);
      border-radius: inherit;
      transition: width 0.45s ease;
    }

    .experience-sulalat-gallery[data-section-id="{{ section.id }}"] .experience-sulalat-gallery__nav {
      display: flex;
      gap: 12px;
      flex-shrink: 0;
    }
    [dir="rtl"] .experience-sulalat-gallery[data-section-id="{{ section.id }}"] .experience-sulalat-gallery__nav {
      flex-direction:row-reverse;
    }

    .experience-sulalat-gallery[data-section-id="{{ section.id }}"] .experience-sulalat-gallery__nav-btn {
      border-radius: 50%;
      width: 52px;
      height: 52px;
      border: 1px solid var(--brand-primary, #53c295);
      background: transparent;
      color: var(--brand-primary, #53c295);
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0;
      transition: 0.3s ease;
    }

    .experience-sulalat-gallery[data-section-id="{{ section.id }}"] .experience-sulalat-gallery__nav-btn svg {
      width:16px;
      height:16px;
    }

    .experience-sulalat-gallery[data-section-id="{{ section.id }}"] .experience-sulalat-gallery__nav-btn svg path {
      transition: 0.3s ease;
    }


    .experience-sulalat-gallery[data-section-id="{{ section.id }}"] .experience-sulalat-gallery__nav-btn:hover svg path {
      fill:#fff;
      color:#fff;
    }

    .experience-sulalat-gallery[data-section-id="{{ section.id }}"] .experience-sulalat-gallery__nav-btn:hover:not(:disabled) {
      background: var(--brand-primary, #53c295);
      color: #fff;
    }

    .experience-sulalat-gallery[data-section-id="{{ section.id }}"] .experience-sulalat-gallery__nav-btn:disabled {
      opacity: 0.35;
      cursor: not-allowed;
    }

    .experience-sulalat-gallery[data-section-id="{{ section.id }}"] .experience-sulalat-gallery__nav-btn svg {
      display: block;
    }

    @media (max-width: 767px) {
      .experience-sulalat-gallery[data-section-id="{{ section.id }}"] {
        --exp-gallery-padding-bottom: 70px;
        padding-bottom:70px;
      }
      .experience-sulalat-gallery[data-section-id="{{ section.id }}"] .experience-sulalat-gallery__heading {
        margin-bottom: 32px;
      }

      .experience-sulalat-gallery[data-section-id="{{ section.id }}"] .experience-sulalat-gallery__footer {
        gap: 18px;
        margin-top: 28px;
      }

      .experience-sulalat-gallery[data-section-id="{{ section.id }}"] .experience-sulalat-gallery__nav-btn {
        width: 44px;
        height: 44px;
      }
    }

    @media (max-width: 575px){
      .experience-sulalat-gallery[data-section-id="{{ section.id }}"] .experience-sulalat-gallery__heading {
        text-align:left;
      }
    
    }




  </style>

  <div class="container">
    {% if section.settings.heading != blank %}
      <h2 class="experience-sulalat-gallery__heading">{{ section.settings.heading | escape }}</h2>
    {% endif %}
  </div>

  {% if section.blocks.size > 0 %}
    <div class="experience-sulalat-gallery__track">
      <div class="swiper experience-sulalat-gallery__slider" data-experience-gallery-slider>
        <div class="swiper-wrapper">
          {% for block in section.blocks %}
            <div class="swiper-slide" {{ block.shopify_attributes }}>
              {% if block.settings.image != blank %}
                {% if block.settings.link != blank %}
                  <a class="experience-sulalat-gallery__media" href="{{ block.settings.link }}">
                {% else %}
                  <div class="experience-sulalat-gallery__media">
                {% endif %}
                  {{
                    block.settings.image
                    | image_url: width: 1400
                    | image_tag:
                      loading: 'lazy',
                      widths: '480, 720, 960, 1200, 1400',
                      sizes: '(min-width: 1200px) 78vw, 88vw',
                      alt: block.settings.image.alt | default: section.settings.heading | escape
                  }}
                {% if block.settings.link != blank %}
                  </a>
                {% else %}
                  </div>
                {% endif %}
              {% else %}
                <div class="experience-sulalat-gallery__media">
                  {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      </div>
    </div>

    <div class="container">
      <div class="experience-sulalat-gallery__footer">
        <div class="experience-sulalat-gallery__progress" aria-hidden="true">
          <span class="experience-sulalat-gallery__progress-bar" data-gallery-progress></span>
        </div>
        <div class="experience-sulalat-gallery__nav">
          <button type="button" class="experience-sulalat-gallery__nav-btn" data-gallery-prev aria-label="Previous slide">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 18 18" fill="none">
                <path d="M0.338923 9.33707C-0.11286 8.88529 -0.11286 8.1528 0.338923 7.70102L7.70115 0.338787C8.15294 -0.112996 8.88542 -0.112996 9.3372 0.338787C9.78899 0.79057 9.78899 1.52306 9.3372 1.97484L2.793 8.51904L9.3372 15.0632C9.78899 15.515 9.78899 16.2475 9.3372 16.6993C8.88542 17.1511 8.15294 17.1511 7.70115 16.6993L0.338923 9.33707ZM17.353 8.51904V9.67591H1.15695V8.51904V7.36218H17.353V8.51904Z" fill="#53C295"></path>
            </svg>
          </button>
          <button type="button" class="experience-sulalat-gallery__nav-btn" data-gallery-next aria-label="Next slide">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 18 18" fill="none">
              <path d="M17.0141 9.33707C17.4659 8.88529 17.4659 8.1528 17.0141 7.70102L9.65187 0.338787C9.20009 -0.112996 8.46761 -0.112996 8.01582 0.338787C7.56404 0.79057 7.56404 1.52306 8.01582 1.97484L14.56 8.51904L8.01582 15.0632C7.56404 15.515 7.56404 16.2475 8.01582 16.6993C8.46761 17.1511 9.20009 17.1511 9.65187 16.6993L17.0141 9.33707ZM0 8.51904V9.67591H16.1961V8.51904V7.36218H0V8.51904Z" fill="#53C295"></path>
            </svg>
          </button>
        </div>
      </div>
    </div>
  {% endif %}

  <script>
    (function () {
      var sectionId = {{ section.id | json }};
      var slideGap = {{ section.settings.slide_gap | default: 24 }};
      var slideWidthPercent = {{ section.settings.slide_width | default: 78 }};
      var mobileSlidePercent = Math.max(slideWidthPercent, 88);
      var mobileSlidesPerView = 100 / mobileSlidePercent;
      var desktopSlidesPerView = 100 / slideWidthPercent;

      function getSection() {
        return document.querySelector('.experience-sulalat-gallery[data-section-id="' + sectionId + '"]');
      }

      function loadSwiper(callback) {
        if (window.Swiper) {
          callback();
          return;
        }

        if (!document.querySelector('link[href*="swiper-bundle.min.css"]')) {
          var link = document.createElement('link');
          link.rel = 'stylesheet';
          link.href = 'https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css';
          document.head.appendChild(link);
        }

        var existing = document.querySelector('script[data-experience-swiper]');
        if (existing) {
          existing.addEventListener('load', callback, { once: true });
          return;
        }

        var script = document.createElement('script');
        script.src = 'https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js';
        script.dataset.experienceSwiper = 'true';
        script.onload = callback;
        document.head.appendChild(script);
      }

      function setProgress(bar, index, total) {
        if (!bar || !total) return;
        bar.style.width = (((index + 1) / total) * 100) + '%';
      }

      function updateNavState(swiper, section) {
        var prevBtn = section.querySelector('[data-gallery-prev]');
        var nextBtn = section.querySelector('[data-gallery-next]');
        if (!prevBtn || !nextBtn) return;

        if (swiper.params.loop) {
          prevBtn.disabled = false;
          nextBtn.disabled = false;
          return;
        }

        prevBtn.disabled = swiper.isBeginning;
        nextBtn.disabled = swiper.isEnd;
      }

      function prepareLoopSlides(sliderEl) {
        var wrapper = sliderEl.querySelector('.swiper-wrapper');
        if (!wrapper) return { count: 0, initialSlide: 0 };

        if (!sliderEl.dataset.originalSlidesHtml) {
          var initialSlides = Array.from(wrapper.children).filter(function (node) {
            return node.classList && node.classList.contains('swiper-slide');
          });
          sliderEl.dataset.originalSlideCount = String(initialSlides.length);
          sliderEl.dataset.originalSlidesHtml = initialSlides
            .map(function (slide) {
              return slide.outerHTML;
            })
            .join('');
        }

        var originalCount = parseInt(sliderEl.dataset.originalSlideCount, 10) || 0;
        if (!originalCount) return { count: 0, initialSlide: 0 };

        var originalHtml = sliderEl.dataset.originalSlidesHtml;

        // Build [copies][originals][copies]... so the first logical slide
        // already has a left neighbor for the centered peek on init.
        var minNeeded = Math.ceil(Math.max(desktopSlidesPerView, mobileSlidesPerView) * 4) + 4;
        var sets = Math.max(4, Math.ceil(minNeeded / originalCount));
        if (sets % 2 === 1) sets += 1;
        wrapper.innerHTML = new Array(sets + 1).join(originalHtml);

        return {
          count: originalCount,
          initialSlide: originalCount
        };
      }

      function initSlider() {
        var section = getSection();
        if (!section || !window.Swiper) return;

        var sliderEl = section.querySelector('[data-experience-gallery-slider]');
        var progressBar = section.querySelector('[data-gallery-progress]');
        if (!sliderEl) return;

        if (sliderEl.swiper) {
          sliderEl.swiper.destroy(true, true);
        }

        var prepared = prepareLoopSlides(sliderEl);
        var slideCount = prepared.count;
        var canLoop = slideCount > 1;
        var loopedSlidesCount = canLoop
          ? Math.max(slideCount * 2, Math.ceil(desktopSlidesPerView) + 2)
          : undefined;

        var swiper = new window.Swiper(sliderEl, {
          slidesPerView: mobileSlidesPerView,
          centeredSlides: true,
          spaceBetween: slideGap,
          speed: 650,
          grabCursor: true,
          watchSlidesProgress: true,
          watchOverflow: false,
          initialSlide: canLoop ? prepared.initialSlide : 0,
          loop: canLoop,
          loopAdditionalSlides: canLoop ? Math.max(4, slideCount * 2) : 0,
          loopedSlides: loopedSlidesCount,
          loopPreventsSliding: false,
          rtl: document.documentElement.dir === 'rtl',
          breakpoints: {
            768: {
              slidesPerView: desktopSlidesPerView,
              spaceBetween: slideGap
            }
          },
          autoplay: canLoop ? {
            delay: 5000,
            disableOnInteraction: false,
            pauseOnMouseEnter: true
          } : false,
          on: {
            init: function () {
              if (canLoop && typeof this.loopFix === 'function') {
                this.loopFix();
              }
              // Start on the middle copy set so a left neighbor exists for the peek.
              if (canLoop && this.activeIndex !== prepared.initialSlide) {
                this.slideTo(prepared.initialSlide, 0);
              }
              this.update();
              setProgress(progressBar, 0, slideCount);
              updateNavState(this, section);
            },
            slideChange: function () {
              setProgress(progressBar, this.realIndex % slideCount, slideCount);
              updateNavState(this, section);
            },
            resize: function () {
              if (canLoop && typeof this.loopFix === 'function') {
                this.loopFix();
              }
              updateNavState(this, section);
            }
          }
        });

        var prevBtn = section.querySelector('[data-gallery-prev]');
        var nextBtn = section.querySelector('[data-gallery-next]');

        if (prevBtn) {
          prevBtn.onclick = function () {
            // centeredSlides + fractional slidesPerView can break native loop on one side
            if (swiper.isBeginning) {
              if (canLoop && typeof swiper.slideToLoop === 'function') {
                swiper.slideToLoop(slideCount - 1);
              } else {
                swiper.slideTo(Math.max(0, swiper.slides.length - 1));
              }
              return;
            }
            swiper.slidePrev();
          };
        }

        if (nextBtn) {
          nextBtn.onclick = function () {
            // Native loop often fails on slideNext with centeredSlides; force wrap.
            if (swiper.isEnd) {
              if (canLoop && typeof swiper.slideToLoop === 'function') {
                swiper.slideToLoop(0);
              } else {
                swiper.slideTo(0);
              }
              return;
            }
            swiper.slideNext();
          };
        }
      }

      function init() {
        loadSwiper(initSlider);
      }

      init();

      document.addEventListener('shopify:section:load', function (event) {
        if (String(event.detail.sectionId) === String(sectionId)) {
          init();
        }
      });

      document.addEventListener('shopify:section:unload', function (event) {
        if (String(event.detail.sectionId) !== String(sectionId)) return;
        var section = getSection();
        var sliderEl = section && section.querySelector('[data-experience-gallery-slider]');
        if (sliderEl && sliderEl.swiper) {
          sliderEl.swiper.destroy(true, true);
        }
      });
    })();
  </script>
</section>

{% schema %}
{
  "name": "Experience gallery",
  "tag": "section",
  "class": "experience-sulalat-gallery-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Gallery"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "slide_gap",
      "label": "Gap between slides",
      "min": 8,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "slide_width",
      "label": "Active slide width",
      "min": 60,
      "max": 90,
      "step": 1,
      "unit": "%",
      "default": 78,
      "info": "Lower values show more of the previous and next slides"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Gallery image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Optional link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Experience gallery",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
