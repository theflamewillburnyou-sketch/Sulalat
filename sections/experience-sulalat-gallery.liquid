<section
  class="experience-sulalat-gallery"
  data-section-id="{{ section.id }}"
  style="
    --exp-gallery-bg: {{ section.settings.background_color }};
    --exp-gallery-padding-top: {{ section.settings.padding_top }}px;
    --exp-gallery-padding-bottom: {{ section.settings.padding_bottom }}px;
    --exp-gallery-gap: {{ section.settings.slide_gap }}px;
    --exp-gallery-slide-width: {{ section.settings.slide_width }}%;
  "
>
  <style>
    .experience-sulalat-gallery[data-section-id="{{ section.id }}"] {
      padding: var(--exp-gallery-padding-top, 80px) 0 var(--exp-gallery-padding-bottom, 100px);
      background: var(--exp-gallery-bg, #ffffff);
      font-family: var(--body-font-family);
      overflow: hidden;
    }

    .experience-sulalat-gallery[data-section-id="{{ section.id }}"] .experience-sulalat-gallery__track {
      position: relative;
      width: 100%;
    }

    .experience-sulalat-gallery[data-section-id="{{ section.id }}"] .experience-sulalat-gallery__slider.swiper {
      overflow: visible;
    }

    .experience-sulalat-gallery[data-section-id="{{ section.id }}"] .experience-sulalat-gallery__slider .swiper-wrapper {
      align-items: stretch;
    }

    .experience-sulalat-gallery[data-section-id="{{ section.id }}"] .experience-sulalat-gallery__slider .swiper-slide {
      height: auto;
    }

    .experience-sulalat-gallery[data-section-id="{{ section.id }}"] .experience-sulalat-gallery__slider .swiper-slide:not(.swiper-slide-active) .experience-sulalat-gallery__media {
      opacity: 0.55;
      transition: opacity 0.45s ease;
    }

    .experience-sulalat-gallery[data-section-id="{{ section.id }}"] .experience-sulalat-gallery__slider .swiper-slide-active .experience-sulalat-gallery__media {
      opacity: 1;
      transition: opacity 0.45s ease;
    }

    .experience-sulalat-gallery[data-section-id="{{ section.id }}"] .experience-sulalat-gallery__track::before,
    .experience-sulalat-gallery[data-section-id="{{ section.id }}"] .experience-sulalat-gallery__track::after {
      content: '';
      position: absolute;
      top: 0;
      bottom: 0;
      width: min(120px, 12vw);
      z-index: 2;
      pointer-events: none;
    }

    .experience-sulalat-gallery[data-section-id="{{ section.id }}"] .experience-sulalat-gallery__track::before {
      left: 0;
      background: linear-gradient(to right, var(--exp-gallery-bg, #ffffff), transparent);
    }

    .experience-sulalat-gallery[data-section-id="{{ section.id }}"] .experience-sulalat-gallery__track::after {
      right: 0;
      background: linear-gradient(to left, var(--exp-gallery-bg, #ffffff), transparent);
    }

    .experience-sulalat-gallery[data-section-id="{{ section.id }}"] .container {
      max-width: var(--brand-container-max, 1440px);
      margin: 0 auto;
      padding: 0 var(--brand-container-padding-x, 20px);
    }

    .experience-sulalat-gallery[data-section-id="{{ section.id }}"] .experience-sulalat-gallery__heading {
      margin: 0 0 48px;
      text-align: center;
      color: #000;
      font-size: clamp(36px, 4vw, 56px);
      line-height: 1.15;
      font-weight: 400;
      letter-spacing: -0.02em;
    }

    .experience-sulalat-gallery[data-section-id="{{ section.id }}"] .experience-sulalat-gallery__media {
      display: block;
      border-radius: var(--brand-radius-lg, 20px);
      overflow: hidden;
      aspect-ratio: 16 / 10;
      background: #f3f3f3;
    }

    .experience-sulalat-gallery[data-section-id="{{ section.id }}"] .experience-sulalat-gallery__media img,
    .experience-sulalat-gallery[data-section-id="{{ section.id }}"] .experience-sulalat-gallery__media svg.placeholder-svg {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .experience-sulalat-gallery[data-section-id="{{ section.id }}"] .experience-sulalat-gallery__footer {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 28px;
      margin-top: 36px;
      max-width: 640px;
      margin-left: auto;
      margin-right: auto;
    }

    .experience-sulalat-gallery[data-section-id="{{ section.id }}"] .experience-sulalat-gallery__progress {
      position: relative;
      flex: 1;
      height: 3px;
      background: #e5e5e5;
      border-radius: 999px;
      overflow: hidden;
      max-width: 420px;
    }

    .experience-sulalat-gallery[data-section-id="{{ section.id }}"] .experience-sulalat-gallery__progress-bar {
      position: absolute;
      left: 0;
      top: 0;
      bottom: 0;
      width: 0;
      background: var(--brand-primary, #53c295);
      border-radius: inherit;
      transition: width 0.45s ease;
    }

    .experience-sulalat-gallery[data-section-id="{{ section.id }}"] .experience-sulalat-gallery__nav {
      display: flex;
      gap: 12px;
      flex-shrink: 0;
    }

    .experience-sulalat-gallery[data-section-id="{{ section.id }}"] .experience-sulalat-gallery__nav-btn {
      border-radius: 50%;
      width: 52px;
      height: 52px;
      border: 1px solid var(--brand-primary, #53c295);
      background: transparent;
      color: var(--brand-primary, #53c295);
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0;
      transition: 0.3s ease;
    }

    .experience-sulalat-gallery[data-section-id="{{ section.id }}"] .experience-sulalat-gallery__nav-btn:hover:not(:disabled) {
      background: var(--brand-primary, #53c295);
      color: #fff;
    }

    .experience-sulalat-gallery[data-section-id="{{ section.id }}"] .experience-sulalat-gallery__nav-btn:disabled {
      opacity: 0.35;
      cursor: not-allowed;
    }

    .experience-sulalat-gallery[data-section-id="{{ section.id }}"] .experience-sulalat-gallery__nav-btn svg {
      display: block;
    }

    @media (max-width: 767px) {
      .experience-sulalat-gallery[data-section-id="{{ section.id }}"] .experience-sulalat-gallery__heading {
        margin-bottom: 32px;
      }

      .experience-sulalat-gallery[data-section-id="{{ section.id }}"] .experience-sulalat-gallery__footer {
        gap: 18px;
        margin-top: 28px;
      }

      .experience-sulalat-gallery[data-section-id="{{ section.id }}"] .experience-sulalat-gallery__nav-btn {
        width: 44px;
        height: 44px;
      }
    }
  </style>

  <div class="container">
    {% if section.settings.heading != blank %}
      <h2 class="experience-sulalat-gallery__heading">{{ section.settings.heading | escape }}</h2>
    {% endif %}
  </div>

  {% if section.blocks.size > 0 %}
    <div class="experience-sulalat-gallery__track">
      <div class="swiper experience-sulalat-gallery__slider" data-experience-gallery-slider>
        <div class="swiper-wrapper">
          {% for block in section.blocks %}
            <div class="swiper-slide" {{ block.shopify_attributes }}>
              {% if block.settings.image != blank %}
                {% if block.settings.link != blank %}
                  <a class="experience-sulalat-gallery__media" href="{{ block.settings.link }}">
                {% else %}
                  <div class="experience-sulalat-gallery__media">
                {% endif %}
                  {{
                    block.settings.image
                    | image_url: width: 1400
                    | image_tag:
                      loading: 'lazy',
                      widths: '480, 720, 960, 1200, 1400',
                      sizes: '(min-width: 1200px) 78vw, 88vw',
                      alt: block.settings.image.alt | default: section.settings.heading | escape
                  }}
                {% if block.settings.link != blank %}
                  </a>
                {% else %}
                  </div>
                {% endif %}
              {% else %}
                <div class="experience-sulalat-gallery__media">
                  {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      </div>
    </div>

    <div class="container">
      <div class="experience-sulalat-gallery__footer">
        <div class="experience-sulalat-gallery__progress" aria-hidden="true">
          <span class="experience-sulalat-gallery__progress-bar" data-gallery-progress></span>
        </div>
        <div class="experience-sulalat-gallery__nav">
          <button type="button" class="experience-sulalat-gallery__nav-btn" data-gallery-prev aria-label="Previous slide">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
              <path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <button type="button" class="experience-sulalat-gallery__nav-btn" data-gallery-next aria-label="Next slide">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
              <path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>
      </div>
    </div>
  {% endif %}

  <script>
    (function () {
      var sectionId = {{ section.id | json }};
      var slideGap = {{ section.settings.slide_gap | default: 24 }};
      var slideWidthPercent = {{ section.settings.slide_width | default: 78 }};
      var mobileSlidePercent = Math.max(slideWidthPercent, 88);
      var mobileSlidesPerView = 100 / mobileSlidePercent;
      var desktopSlidesPerView = 100 / slideWidthPercent;

      function getSection() {
        return document.querySelector('.experience-sulalat-gallery[data-section-id="' + sectionId + '"]');
      }

      function loadSwiper(callback) {
        if (window.Swiper) {
          callback();
          return;
        }

        if (!document.querySelector('link[href*="swiper-bundle.min.css"]')) {
          var link = document.createElement('link');
          link.rel = 'stylesheet';
          link.href = 'https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css';
          document.head.appendChild(link);
        }

        var existing = document.querySelector('script[data-experience-swiper]');
        if (existing) {
          existing.addEventListener('load', callback, { once: true });
          return;
        }

        var script = document.createElement('script');
        script.src = 'https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js';
        script.dataset.experienceSwiper = 'true';
        script.onload = callback;
        document.head.appendChild(script);
      }

      function setProgress(bar, index, total) {
        if (!bar || !total) return;
        bar.style.width = (((index + 1) / total) * 100) + '%';
      }

      function updateNavState(swiper, section) {
        var prevBtn = section.querySelector('[data-gallery-prev]');
        var nextBtn = section.querySelector('[data-gallery-next]');
        if (!prevBtn || !nextBtn) return;

        if (swiper.params.loop) {
          prevBtn.disabled = false;
          nextBtn.disabled = false;
          return;
        }

        prevBtn.disabled = swiper.isBeginning;
        nextBtn.disabled = swiper.isEnd;
      }

      function initSlider() {
        var section = getSection();
        if (!section || !window.Swiper) return;

        var sliderEl = section.querySelector('[data-experience-gallery-slider]');
        var progressBar = section.querySelector('[data-gallery-progress]');
        if (!sliderEl) return;

        if (sliderEl.swiper) {
          sliderEl.swiper.destroy(true, true);
        }

        var slideCount = sliderEl.querySelectorAll('.swiper-slide:not(.swiper-slide-duplicate)').length;
        if (!slideCount) {
          slideCount = sliderEl.querySelectorAll('.swiper-slide').length;
        }

        var swiper = new window.Swiper(sliderEl, {
          slidesPerView: mobileSlidesPerView,
          centeredSlides: true,
          spaceBetween: slideGap,
          speed: 650,
          grabCursor: true,
          watchSlidesProgress: true,
          loop: slideCount > 1,
          loopAdditionalSlides: slideCount,
          loopPreventsSliding: false,
          rtl: document.documentElement.dir === 'rtl',
          breakpoints: {
            768: {
              slidesPerView: desktopSlidesPerView,
              spaceBetween: slideGap
            }
          },
          autoplay: slideCount > 1 ? {
            delay: 5000,
            disableOnInteraction: false,
            pauseOnMouseEnter: true
          } : false,
          on: {
            init: function () {
              setProgress(progressBar, this.realIndex, slideCount);
              updateNavState(this, section);
            },
            slideChange: function () {
              setProgress(progressBar, this.realIndex, slideCount);
              updateNavState(this, section);
            },
            resize: function () {
              updateNavState(this, section);
            }
          }
        });

        var prevBtn = section.querySelector('[data-gallery-prev]');
        var nextBtn = section.querySelector('[data-gallery-next]');
        if (prevBtn) prevBtn.onclick = function () { swiper.slidePrev(); };
        if (nextBtn) nextBtn.onclick = function () { swiper.slideNext(); };
      }

      function init() {
        loadSwiper(initSlider);
      }

      init();

      document.addEventListener('shopify:section:load', function (event) {
        if (String(event.detail.sectionId) === String(sectionId)) {
          init();
        }
      });

      document.addEventListener('shopify:section:unload', function (event) {
        if (String(event.detail.sectionId) !== String(sectionId)) return;
        var section = getSection();
        var sliderEl = section && section.querySelector('[data-experience-gallery-slider]');
        if (sliderEl && sliderEl.swiper) {
          sliderEl.swiper.destroy(true, true);
        }
      });
    })();
  </script>
</section>

{% schema %}
{
  "name": "Experience gallery",
  "tag": "section",
  "class": "experience-sulalat-gallery-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Gallery"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "slide_gap",
      "label": "Gap between slides",
      "min": 8,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "slide_width",
      "label": "Active slide width",
      "min": 60,
      "max": 90,
      "step": 1,
      "unit": "%",
      "default": 78,
      "info": "Lower values show more of the previous and next slides"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Gallery image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Optional link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Experience gallery",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
