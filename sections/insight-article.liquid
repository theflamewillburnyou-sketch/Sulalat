{%- liquid
  assign share_url = request.origin | append: article.url
  assign share_title = article.title | escape
  assign views_count = article.metafields.custom.views.value | default: article.metafields.custom.views | default: section.settings.default_views
  assign likes_count = article.metafields.custom.likes.value | default: article.metafields.custom.likes | default: section.settings.default_likes
  assign related_limit = section.settings.related_count | default: 3
-%}

<section class="insight-article" data-section-id="{{ section.id }}">
  <style>
    .insight-article[data-section-id="{{ section.id }}"] {
      padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
      background: {{ section.settings.background_color }};
      font-family: var(--body-font-family);
      color: #141211;
      padding:100px 0;
    }

    .insight-article[data-section-id="{{ section.id }}"] .container {
      max-width: var(--brand-container-max, 1440px);
      margin: 0 auto;
      padding: 0 var(--brand-container-padding-x, 20px);
    }

    .insight-article[data-section-id="{{ section.id }}"] .insight-article__inner {
      width: 100%;
    }

    .insight-article[data-section-id="{{ section.id }}"] .insight-article__header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 24px;
      margin-bottom: 60px;
    }

    .insight-article[data-section-id="{{ section.id }}"] .insight-article__title {
      margin: 0;
      flex: 1 1 auto;
      min-width: 0;
      font-size: clamp(28px, 3.2vw, 50px);
      font-weight: 400;
      line-height: 1.2;
      color: #141211;
    }

    .insight-article[data-section-id="{{ section.id }}"] .insight-article__share {
      display: flex;
      align-items: center;
      gap: 12px;
      flex-shrink: 0;
      padding-top: 8px;
    }

    .insight-article[data-section-id="{{ section.id }}"] .insight-article__share-label {
      margin: 0;
      font-size: 18px;
      font-weight: 400;
      color: #141211;
    }

    .insight-article[data-section-id="{{ section.id }}"] .insight-article__share-list {
      display: flex;
      align-items: center;
      gap: 15px;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .insight-article[data-section-id="{{ section.id }}"] .insight-article__share-link {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
      border-radius: 50%;
      border: 1.5px solid var(--brand-primary, #53c295);
      color: var(--brand-primary, #53c295);
      text-decoration: none;
      transition: 0.25s ease;
    }

    .insight-article[data-section-id="{{ section.id }}"] .insight-article__share-link:hover {
      background: var(--brand-primary, #53c295);
      color: #fff;
    }

    .insight-article[data-section-id="{{ section.id }}"] .insight-article__share-link svg {
      width: auto;
      height: auto;
      display: block;
      transition: 0.25s ease;
    }

    .insight-article[data-section-id="{{ section.id }}"] .insight-article__share-link svg path{
      transition: 0.25s ease;
    }

    .insight-article[data-section-id="{{ section.id }}"] .insight-article__share-link:hover svg path{
      fill:#fff;
    }

    .insight-article[data-section-id="{{ section.id }}"] .insight-article__content {
      margin: 0 0 60px;
      font-size: 16px;
      line-height: 1.7;
      color: var(--brand-body-text, #535353);
    }

    .insight-article[data-section-id="{{ section.id }}"] .insight-article__content > *:first-child {
      margin-top: 0;
    }

    .insight-article[data-section-id="{{ section.id }}"] .insight-article__content > *:last-child {
      margin-bottom: 0;
    }

    .insight-article[data-section-id="{{ section.id }}"] .insight-article__content p {
      margin: 0 0 1.15em;
    }

    .insight-article[data-section-id="{{ section.id }}"] .insight-article__content p:has(img) {
      margin: 60px 0;
    }

    .insight-article[data-section-id="{{ section.id }}"] .insight-article__content img,
    .insight-article[data-section-id="{{ section.id }}"] .insight-article__featured img {
      display: block;
      width: 100%;
      height: auto;
      border-radius: 12px;
      aspect-ratio: 16 / 7.8;
      object-fit: cover;
    }

    .insight-article[data-section-id="{{ section.id }}"] .insight-article__featured {
      margin: 0 0 28px;
      border-radius: 20px;
      overflow: hidden;
    }

    .insight-article[data-section-id="{{ section.id }}"] .insight-article__meta {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 28px;
      margin: 0 0 100px;
      padding: 4px 0;
      color: var(--brand-primary, #53c295);
      font-size: 15px;
      line-height: 1.4;
    }

    .insight-article[data-section-id="{{ section.id }}"] .insight-article__meta-item {
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }

    .insight-article[data-section-id="{{ section.id }}"] .insight-article__meta-item svg {
      width: 22px;
      height: 22px;
      flex-shrink: 0;
    }

    .insight-article[data-section-id="{{ section.id }}"] .insight-article__meta-item span{
      color:#141211;
      font-size:18px;
    }

    .insight-article[data-section-id="{{ section.id }}"] .insight-article__related-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      margin-bottom: 60px;
    }

    .insight-article[data-section-id="{{ section.id }}"] .insight-article__related-header h2 {
      margin: 0;
      font-size: clamp(24px, 3vw, 36px);
      font-weight: 400;
      line-height: 1.2;
      color: #141211;
    }

    .insight-article[data-section-id="{{ section.id }}"] .insight-article__related-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 36px 28px;
    }

    .insight-article[data-section-id="{{ section.id }}"] .insight-related-card {
      display: flex;
      flex-direction: column;
      color: inherit;
      text-decoration: none;
      min-width: 0;
    }

    .insight-article[data-section-id="{{ section.id }}"] .insight-related-card__image {
      overflow: hidden;
      border-radius: 12px;
      aspect-ratio: 4 / 3;
      background: #f3f3f3;
    }

    .insight-article[data-section-id="{{ section.id }}"] .insight-related-card__image img,
    .insight-article[data-section-id="{{ section.id }}"] .insight-related-card__image svg {
      width: 100%;
      height: 100%;
      display: block;
      object-fit: cover;
      transition: transform 0.45s ease;
    }

    .insight-article[data-section-id="{{ section.id }}"] .insight-related-card:hover .insight-related-card__image img {
      transform: scale(1.05);
    }

    .insight-article[data-section-id="{{ section.id }}"] .insight-related-card__meta {
      display: flex;
      align-items: center;
      gap: 12px;
      margin: 18px 0 14px;
    }

    .insight-article[data-section-id="{{ section.id }}"] .insight-related-card__accent {
      width: 25px;
      height: 2px;
      background: var(--brand-primary, #53c295);
      border-radius: 999px;
      flex-shrink: 0;
    }

    .insight-article[data-section-id="{{ section.id }}"] .insight-related-card__date {
      margin: 0;
      color: var(--brand-primary, #53c295);
      line-height: 1.4;
      font-family: var(--secondary-font);
      font-size: 17px;
    }

    .insight-article[data-section-id="{{ section.id }}"] .insight-related-card__title {
      margin: 0 0 12px;
      color: #141211;
      font-size: clamp(18px, 1.6vw, 22px);
      font-weight: 600;
      line-height: 1.3;
    }

    .insight-article[data-section-id="{{ section.id }}"] .insight-related-card__text {
      margin: 0;
      color: #4B4B4B;
      font-size: 16px;
      line-height: 1.55;
    }

    @media (max-width: 1440px){
      .insight-article[data-section-id="{{ section.id }}"] {
        padding:80px 0;
      }
      .insight-article[data-section-id="{{ section.id }}"] .insight-article__meta {
        margin-bottom: 80px;
      }
    }

    @media (max-width: 991px) {
      .insight-article[data-section-id="{{ section.id }}"] .insight-article__header {
        flex-direction: column;
        gap: 18px;
      }

      .insight-article[data-section-id="{{ section.id }}"] .insight-article__related-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 28px 20px;
      }
    }

    @media (max-width: 767px){
      .insight-article[data-section-id="{{ section.id }}"] .insight-article__header {
        margin-bottom: 30px;
      }
      .insight-article[data-section-id="{{ section.id }}"] {
        padding:70px 0;
      }
      .insight-article[data-section-id="{{ section.id }}"] .insight-article__meta {
        margin-bottom: 70px;
      }

      .insight-article[data-section-id="{{ section.id }}"] .insight-article__content p:has(img) {
        margin: 30px 0;
      }

      .insight-article[data-section-id="{{ section.id }}"] .insight-article__related-header {
        margin-bottom: 30px;
      }
    }

    @media (max-width: 749px) {
      .insight-article[data-section-id="{{ section.id }}"] .insight-article__meta {
        gap: 16px 20px;
      }

      .insight-article[data-section-id="{{ section.id }}"] .insight-article__related-header {
        flex-direction: column;
        align-items: flex-start;
      }

      .insight-article[data-section-id="{{ section.id }}"] .insight-article__related-grid {
        grid-template-columns: 1fr;
        gap: 28px;
      }
    }

    @media (max-width: 575px){
      .insight-article[data-section-id="{{ section.id }}"] .insight-article__meta-item span{
        font-size:16px;
      }
      .insight-article[data-section-id="{{ section.id }}"] .insight-article__meta {
        flex-direction: column;
        align-items: start;
      }
    }

  </style>

  <div class="container">
    <div class="insight-article__inner">
    <div class="insight-article__header">
      <h1 class="insight-article__title">{{ article.title | escape }}</h1>

      {% if section.settings.show_share %}
        <div class="insight-article__share">
          <p class="insight-article__share-label">{{ section.settings.share_label | default: 'Share:' | escape }}</p>
          <ul class="insight-article__share-list">
            <li>
              <a
                class="insight-article__share-link"
                href="https://wa.me/?text={{ share_title | url_param_escape }}%20{{ share_url | url_encode }}"
                target="_blank"
                rel="noopener"
                aria-label="Share on WhatsApp"
              >
               <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="none">
                <path d="M17 2.91006C16.0832 1.98399 14.9912 1.24973 13.7876 0.750111C12.5841 0.250494 11.2931 -0.00448012 9.99 5.95696e-05C4.53 5.95696e-05 0.0800002 4.45006 0.0800002 9.91006C0.0800002 11.6601 0.54 13.3601 1.4 14.8601L0 20.0001L5.25 18.6201C6.7 19.4101 8.33 19.8301 9.99 19.8301C15.45 19.8301 19.9 15.3801 19.9 9.92006C19.9 7.27006 18.87 4.78006 17 2.91006ZM9.99 18.1501C8.51 18.1501 7.06 17.7501 5.79 17.0001L5.49 16.8201L2.37 17.6401L3.2 14.6001L3 14.2901C2.17775 12.977 1.74114 11.4593 1.74 9.91006C1.74 5.37006 5.44 1.67006 9.98 1.67006C12.18 1.67006 14.25 2.53006 15.8 4.09006C16.5675 4.85402 17.1757 5.76272 17.5894 6.76348C18.0031 7.76425 18.214 8.83717 18.21 9.92006C18.23 14.4601 14.53 18.1501 9.99 18.1501ZM14.51 11.9901C14.26 11.8701 13.04 11.2701 12.82 11.1801C12.59 11.1001 12.43 11.0601 12.26 11.3001C12.09 11.5501 11.62 12.1101 11.48 12.2701C11.34 12.4401 11.19 12.4601 10.94 12.3301C10.69 12.2101 9.89 11.9401 8.95 11.1001C8.21 10.4401 7.72 9.63006 7.57 9.38006C7.43 9.13006 7.55 9.00006 7.68 8.87006C7.79 8.76006 7.93 8.58006 8.05 8.44006C8.17 8.30006 8.22 8.19006 8.3 8.03006C8.38 7.86006 8.34 7.72006 8.28 7.60006C8.22 7.48006 7.72 6.26006 7.52 5.76006C7.32 5.28006 7.11 5.34006 6.96 5.33006H6.48C6.31 5.33006 6.05 5.39006 5.82 5.64006C5.6 5.89006 4.96 6.49006 4.96 7.71006C4.96 8.93006 5.85 10.1101 5.97 10.2701C6.09 10.4401 7.72 12.9401 10.2 14.0101C10.79 14.2701 11.25 14.4201 11.61 14.5301C12.2 14.7201 12.74 14.6901 13.17 14.6301C13.65 14.5601 14.64 14.0301 14.84 13.4501C15.05 12.8701 15.05 12.3801 14.98 12.2701C14.91 12.1601 14.76 12.1101 14.51 11.9901Z" fill="#53C295"/>
              </svg>
              </a>
            </li>
            <li>
              <a
                class="insight-article__share-link"
                href="https://twitter.com/intent/tweet?text={{ share_title | url_param_escape }}&url={{ share_url | url_encode }}"
                target="_blank"
                rel="noopener"
                aria-label="Share on X"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="17" height="18" viewBox="0 0 17 18" fill="none">
                  <path d="M10.1175 7.41L16.4463 0H14.9463L9.4525 6.43375L5.0625 0H0L6.6375 9.73L0 17.5H1.5L7.3025 10.705L11.9388 17.5H17.0013L10.1175 7.41ZM8.06375 9.815L7.39125 8.84625L2.04 1.1375H4.34375L8.66125 7.35875L9.33375 8.3275L14.9475 16.415H12.6438L8.06375 9.815Z" fill="#53C295"/>
                </svg>
              </a>
            </li>
            {% if settings.social_instagram_url != blank %}
              <li>
                <a
                  class="insight-article__share-link"
                  href="{{ settings.social_instagram_url }}"
                  target="_blank"
                  rel="noopener"
                  aria-label="Instagram"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="21" height="21" viewBox="0 0 21 21" fill="none">
                    <path d="M15.93 3.59308C15.6835 3.59308 15.4426 3.66616 15.2377 3.80309C15.0327 3.94002 14.873 4.13464 14.7787 4.36235C14.6844 4.59005 14.6597 4.84061 14.7078 5.08234C14.7559 5.32407 14.8746 5.54612 15.0488 5.72039C15.2231 5.89467 15.4452 6.01336 15.6869 6.06144C15.9286 6.10952 16.1792 6.08484 16.4069 5.99053C16.6346 5.89621 16.8292 5.73649 16.9661 5.53156C17.1031 5.32663 17.1762 5.0857 17.1762 4.83923C17.1762 4.50873 17.0449 4.19177 16.8112 3.95807C16.5775 3.72437 16.2605 3.59308 15.93 3.59308V3.59308ZM20.7069 6.10615C20.6867 5.24454 20.5254 4.39207 20.2292 3.58269C19.9652 2.89018 19.5542 2.2631 19.0246 1.74462C18.5104 1.21233 17.8818 0.803952 17.1865 0.550385C16.3793 0.245244 15.5259 0.0801796 14.6631 0.0623076C13.5623 -5.80286e-08 13.2092 0 10.3846 0C7.56 0 7.20692 -5.80286e-08 6.10615 0.0623076C5.24335 0.0801796 4.38993 0.245244 3.58269 0.550385C2.88866 0.80652 2.26066 1.21454 1.74462 1.74462C1.21233 2.25884 0.803952 2.88738 0.550385 3.58269C0.245244 4.38993 0.0801796 5.24335 0.0623076 6.10615C-5.80286e-08 7.20692 0 7.56 0 10.3846C0 13.2092 -5.80286e-08 13.5623 0.0623076 14.6631C0.0801796 15.5259 0.245244 16.3793 0.550385 17.1865C0.803952 17.8818 1.21233 18.5104 1.74462 19.0246C2.26066 19.5547 2.88866 19.9627 3.58269 20.2188C4.38993 20.524 5.24335 20.6891 6.10615 20.7069C7.20692 20.7692 7.56 20.7692 10.3846 20.7692C13.2092 20.7692 13.5623 20.7692 14.6631 20.7069C15.5259 20.6891 16.3793 20.524 17.1865 20.2188C17.8818 19.9653 18.5104 19.5569 19.0246 19.0246C19.5566 18.5081 19.9679 17.8804 20.2292 17.1865C20.5254 16.3772 20.6867 15.5247 20.7069 14.6631C20.7069 13.5623 20.7692 13.2092 20.7692 10.3846C20.7692 7.56 20.7692 7.20692 20.7069 6.10615V6.10615ZM18.8377 14.5385C18.8301 15.1976 18.7107 15.8508 18.4846 16.47C18.3188 16.9219 18.0525 17.3303 17.7058 17.6642C17.3689 18.0074 16.9614 18.2732 16.5115 18.4431C15.8923 18.6692 15.2392 18.7886 14.58 18.7962C13.5415 18.8481 13.1573 18.8585 10.4262 18.8585C7.695 18.8585 7.31077 18.8585 6.27231 18.7962C