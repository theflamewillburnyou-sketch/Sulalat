{%- liquid
  assign wishlist_vendor = shop.name | default: 'Sulalat'
  assign wishlist_money_format = shop.money_format
  assign wishlist_page = pages.wishlist
-%}

<section
  class="sulalat-wishlist"
  data-section-id="{{ section.id }}"
  style="
    --wl-pad-top: {{ section.settings.padding_top }}px;
    --wl-pad-bottom: {{ section.settings.padding_bottom }}px;
    --wl-pad-top-m: {{ section.settings.padding_top_mobile }}px;
    --wl-pad-bottom-m: {{ section.settings.padding_bottom_mobile }}px;
  "
>
  <div class="sulalat-wishlist__inner">
    <div class="sulalat-wishlist__header">
      <h1 class="sulalat-wishlist__title">{{ section.settings.heading | default: 'My Wishlist' | escape }}</h1>
      <div class="sulalat-wishlist__actions">
        <button type="button" class="sulalat-wishlist__btn sulalat-wishlist__btn--outline" data-wishlist-remove-all disabled>
          {{ section.settings.remove_all_label | default: 'Remove All' | escape }}
        </button>
        <button type="button" class="sulalat-wishlist__btn sulalat-wishlist__btn--solid" data-wishlist-add-all disabled>
          {{ section.settings.add_all_label | default: 'Add All To Cart' | escape }}
        </button>
      </div>
    </div>

    <p class="sulalat-wishlist__status" data-wishlist-status hidden></p>
    <div class="sulalat-wishlist__grid" data-wishlist-grid hidden></div>
    <p class="sulalat-wishlist__empty" data-wishlist-empty>
      {{ section.settings.empty_text | default: 'Your wishlist is empty. Tap the heart icon on a product to save it here.' | escape }}
    </p>
  </div>

  <script type="application/json" data-wishlist-config>
    {
      "vendor": {{ wishlist_vendor | json }},
      "moneyFormat": {{ wishlist_money_format | json }},
      "addToCartLabel": {{ section.settings.add_to_cart_label | default: 'Add to Cart' | json }},
      "removeConfirm": {{ section.settings.remove_confirm | default: 'Remove this item from your wishlist?' | json }},
      "removeAllConfirm": {{ section.settings.remove_all_confirm | default: 'Remove all items from your wishlist?' | json }},
      "addedLabel": {{ section.settings.added_label | default: 'Added to cart' | json }},
      "errorLabel": {{ section.settings.error_label | default: 'Something went wrong. Please try again.' | json }},
      "customerId": {% if customer %}{{ customer.id | json }}{% else %}null{% endif %}
    }
  </script>

  <script type="application/json" data-wishlist-catalog>
    [
      {%- paginate collections.all.products by 250 -%}
        {%- for product in collections.all.products -%}
          {%- liquid
            assign wl_variant = product.selected_or_first_available_variant
            assign wl_desc = product.metafields.descriptors.subtitle | default: product.metafields.custom.short_description
            if wl_desc == blank and product.description != blank
              assign wl_desc = product.description | strip_html | truncate: 110
            endif
            assign wl_title_ar = product.metafields.custom.title_ar | default: product.metafields.custom.arabic_title
            assign wl_image = ''
            if product.featured_media
              assign wl_image = product.featured_media | image_url: width: 800
            endif
          -%}
          {
            "id": {{ product.id | json }},
            "handle": {{ product.handle | json }},
            "title": {{ product.title | json }},
            "title_ar": {{ wl_title_ar | json }},
            "vendor": {{ product.vendor | default: wishlist_vendor | json }},
            "url": {{ product.url | json }},
            "description": {{ wl_desc | json }},
            "price": {{ wl_variant.price | json }},
            "available": {{ wl_variant.available | json }},
            "variant_id": {{ wl_variant.id | json }},
            "image": {{ wl_image | json }}
          }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      {%- endpaginate -%}
    ]
  </script>

  <style>
    .sulalat-wishlist[data-section-id="{{ section.id }}"] {
      padding: var(--wl-pad-top) 0 var(--wl-pad-bottom);
      background: #fff;
    }

    .sulalat-wishlist[data-section-id="{{ section.id }}"] .sulalat-wishlist__inner {
      width: min(1200px, calc(100% - 40px));
      margin: 0 auto;
    }

    .sulalat-wishlist[data-section-id="{{ section.id }}"] .sulalat-wishlist__header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      flex-wrap: wrap;
      margin-bottom: 28px;
    }

    .sulalat-wishlist[data-section-id="{{ section.id }}"] .sulalat-wishlist__title {
      margin: 0;
      color: #1a1a1a;
      font-size: clamp(28px, 3vw, 36px);
      font-weight: 700;
      line-height: 1.2;
    }

    .sulalat-wishlist[data-section-id="{{ section.id }}"] .sulalat-wishlist__actions {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }

    .sulalat-wishlist[data-section-id="{{ section.id }}"] .sulalat-wishlist__btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 44px;
      padding: 10px 22px;
      border-radius: 999px;
      font-size: 14px;
      font-weight: 600;
      font-family: inherit;
      cursor: pointer;
      transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
    }

    .sulalat-wishlist[data-section-id="{{ section.id }}"] .sulalat-wishlist__btn--outline {
      border: 1.5px solid var(--brand-primary, #53c295);
      background: #fff;
      color: var(--brand-primary, #53c295);
    }

    .sulalat-wishlist[data-section-id="{{ section.id }}"] .sulalat-wishlist__btn--outline:hover {
      background: #f3fbf7;
    }

    .sulalat-wishlist[data-section-id="{{ section.id }}"] .sulalat-wishlist__btn--solid {
      border: 1.5px solid var(--brand-primary, #53c295);
      background: var(--brand-primary, #53c295);
      color: #fff;
    }

    .sulalat-wishlist[data-section-id="{{ section.id }}"] .sulalat-wishlist__btn--solid:hover {
      background: #45ad82;
      border-color: #45ad82;
    }

    .sulalat-wishlist[data-section-id="{{ section.id }}"] .sulalat-wishlist__btn:disabled {
      opacity: 0.55;
      cursor: not-allowed;
    }

    .sulalat-wishlist[data-section-id="{{ section.id }}"] .sulalat-wishlist__grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 24px;
    }

    .sulalat-wishlist[data-section-id="{{ section.id }}"] .sulalat-wishlist__card {
      display: flex;
      flex-direction: column;
      min-width: 0;
      background: #fff;
    }

    .sulalat-wishlist[data-section-id="{{ section.id }}"] .sulalat-wishlist__media {
      position: relative;
      display: block;
      aspect-ratio: 1 / 1;
      border-radius: 14px;
      overflow: hidden;
      background: #f3f3f3;
    }

    .sulalat-wishlist[data-section-id="{{ section.id }}"] .sulalat-wishlist__media img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .sulalat-wishlist[data-section-id="{{ section.id }}"] .sulalat-wishlist__price {
      position: absolute;
      top: 12px;
      left: 12px;
      z-index: 1;
      padding: 6px 12px;
      border-radius: 8px;
      background: var(--brand-primary, #53c295);
      color: #fff;
      font-size: 13px;
      font-weight: 700;
      line-height: 1.2;
    }

    .sulalat-wishlist[data-section-id="{{ section.id }}"] .sulalat-wishlist__remove {
      position: absolute;
      top: 12px;
      right: 12px;
      z-index: 1;
      width: 30px;
      height: 30px;
      border: 0;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.95);
      color: #666;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      box-shadow: 0 1px 4px rgba(0, 0, 0, 0.08);
    }

    .sulalat-wishlist[data-section-id="{{ section.id }}"] .sulalat-wishlist__remove:hover {
      color: #1a1a1a;
      background: #fff;
    }

    .sulalat-wishlist[data-section-id="{{ section.id }}"] .sulalat-wishlist__body {
      display: flex;
      flex-direction: column;
      flex: 1;
      padding: 14px 2px 0;
    }

    .sulalat-wishlist[data-section-id="{{ section.id }}"] .sulalat-wishlist__vendor {
      margin: 0 0 4px;
      color: #9a9a9a;
      font-size: 13px;
    }

    .sulalat-wishlist[data-section-id="{{ section.id }}"] .sulalat-wishlist__name {
      margin: 0 0 8px;
      color: #1a1a1a;
      font-size: 16px;
      font-weight: 700;
      line-height: 1.35;
    }

    .sulalat-wishlist[data-section-id="{{ section.id }}"] .sulalat-wishlist__name a {
      color: inherit;
      text-decoration: none;
    }

    .sulalat-wishlist[data-section-id="{{ section.id }}"] .sulalat-wishlist__desc {
      margin: 0 0 16px;
      color: #8a8a8a;
      font-size: 13px;
      line-height: 1.5;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      min-height: 2.9em;
    }

    .sulalat-wishlist[data-section-id="{{ section.id }}"] .sulalat-wishlist__atc {
      margin-top: auto;
      width: 100%;
    }

    .sulalat-wishlist[data-section-id="{{ section.id }}"] .sulalat-wishlist__empty {
      margin: 0;
      padding: 48px 24px;
      border: 1px solid #ececec;
      border-radius: 16px;
      background: #fff;
      color: #666;
      font-size: 14px;
      line-height: 1.55;
      text-align: center;
    }

    .sulalat-wishlist[data-section-id="{{ section.id }}"] .sulalat-wishlist__status {
      margin: 0 0 14px;
      color: #666;
      font-size: 13px;
    }

    .sulalat-wishlist[data-section-id="{{ section.id }}"] .sulalat-wishlist__status[hidden],
    .sulalat-wishlist[data-section-id="{{ section.id }}"] .sulalat-wishlist__grid[hidden],
    .sulalat-wishlist[data-section-id="{{ section.id }}"] .sulalat-wishlist__empty[hidden] {
      display: none !important;
    }

    @media (max-width: 989px) {
      .sulalat-wishlist[data-section-id="{{ section.id }}"] .sulalat-wishlist__grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 749px) {
      .sulalat-wishlist[data-section-id="{{ section.id }}"] {
        padding: var(--wl-pad-top-m) 0 var(--wl-pad-bottom-m);
      }

      .sulalat-wishlist[data-section-id="{{ section.id }}"] .sulalat-wishlist__grid {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <script>
    (function () {
      var root = document.querySelector('.sulalat-wishlist[data-section-id="{{ section.id }}"]');
      if (!root) return;

      var configEl = root.querySelector('[data-wishlist-config]');
      var catalogEl = root.querySelector('[data-wishlist-catalog]');
      var grid = root.querySelector('[data-wishlist-grid]');
      var emptyEl = root.querySelector('[data-wishlist-empty]');
      var statusEl = root.querySelector('[data-wishlist-status]');
      var removeAllBtn = root.querySelector('[data-wishlist-remove-all]');
      var addAllBtn = root.querySelector('[data-wishlist-add-all]');

      var config = {};
      var catalog = [];
      try { config = configEl ? JSON.parse(configEl.textContent) : {}; } catch (e) {}
      try { catalog = catalogEl ? JSON.parse(catalogEl.textContent) : []; } catch (e) {}

      var storageKey = 'sulalat_wishlist_v2_' + (config.customerId != null ? String(config.customerId) : 'guest');
      var catalogById = {};
      var catalogByHandle = {};
      var stateIds = [];

      catalog.forEach(function (item) {
        if (!item || item.id == null) return;
        catalogById[String(item.id)] = item;
        if (item.handle) catalogByHandle[String(item.handle)] = item;
      });

      function uniqueIds(ids) {
        var seen = {};
        var out = [];
        (ids || []).forEach(function (id) {
          var key = String(id);
          if (!key || seen[key]) return;
          seen[key] = true;
          out.push(key);
        });
        return out;
      }

      function readMirror() {
        try {
          var raw = window.localStorage.getItem(storageKey);
          if (!raw) return [];
          var parsed = JSON.parse(raw);
          return Array.isArray(parsed) ? uniqueIds(parsed) : [];
        } catch (e) {
          return [];
        }
      }

      function writeMirror(ids) {
        try {
          window.localStorage.setItem(storageKey, JSON.stringify(uniqueIds(ids)));
        } catch (e) {}
      }

      function setStatus(message) {
        if (!statusEl) return;
        if (message) {
          statusEl.textContent = message;
          statusEl.hidden = false;
        } else {
          statusEl.textContent = '';
          statusEl.hidden = true;
        }
      }

      function formatMoney(cents) {
        var value = (Number(cents) || 0) / 100;
        var format = config.moneyFormat || '{{amount}}';
        if (window.theme && typeof theme.formatMoney === 'function') {
          return theme.formatMoney(cents, format);
        }
        var amount = value.toFixed(2);
        return format
          .replace(/\{\{\s*amount_with_comma_separator\s*\}\}/g, amount.replace('.', ','))
          .replace(/\{\{\s*amount_no_decimals\s*\}\}/g, String(Math.round(value)))
          .replace(/\{\{\s*amount\s*\}\}/g, amount);
      }

      function escapeHtml(str) {
        return String(str == null ? '' : str)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;');
      }

      function ensureCatalogLoaded() {
        if (Object.keys(catalogById).length > 0) return Promise.resolve();
        return fetch('/products.json?limit=250', {
          credentials: 'same-origin',
          headers: { Accept: 'application/json' }
        })
          .then(function (res) { return res.ok ? res.json() : null; })
          .then(function (data) {
            ((data && data.products) || []).forEach(function (product) {
              if (!product || !product.id) return;
              var variant = (product.variants && product.variants[0]) || {};
              var image = '';
              if (product.featured_image) {
                image = typeof product.featured_image === 'string' ? product.featured_image : product.featured_image.src || '';
              } else if (product.images && product.images[0]) {
                image = typeof product.images[0] === 'string' ? product.images[0] : product.images[0].src || '';
              }
              catalogById[String(product.id)] = {
                id: product.id,
                handle: product.handle,
                title: product.title,
                title_ar: '',
                vendor: product.vendor || config.vendor || 'Sulalat',
                url: '/products/' + product.handle,
                description: (product.body_html || '').replace(/<[^>]+>/g, '').slice(0, 110),
                price: variant.price != null ? Math.round(parseFloat(variant.price) * 100) : 0,
                available: variant.available,
                variant_id: variant.id,
                image: image
              };
              catalogByHandle[String(product.handle)] = catalogById[String(product.id)];
            });
          })
          .catch(function () {});
      }

      function resolveProducts(ids) {
        return uniqueIds(ids)
          .map(function (id) { return catalogById[String(id)]; })
          .filter(Boolean);
      }

      function render() {
        var products = resolveProducts(stateIds);
        writeMirror(uniqueIds(stateIds));
        if (removeAllBtn) removeAllBtn.disabled = products.length === 0;
        if (addAllBtn) addAllBtn.disabled = products.length === 0;

        if (!products.length) {
          if (grid) { grid.innerHTML = ''; grid.hidden = true; }
          if (emptyEl) emptyEl.hidden = false;
          return;
        }

        if (emptyEl) emptyEl.hidden = true;
        if (!grid) return;
        grid.hidden = false;
        grid.innerHTML = products.map(function (product) {
          var title = product.title || '';
          if (product.title_ar) title = product.title_ar + ' ' + title;
          var image = product.image
            ? '<img src="' + escapeHtml(product.image) + '" alt="' + escapeHtml(product.title || '') + '" loading="lazy" width="800" height="800">'
            : '';
          var atcDisabled = product.available === false ? ' disabled' : '';
          return (
            '<article class="sulalat-wishlist__card" data-wishlist-item="' + escapeHtml(product.id) + '">' +
              '<div class="sulalat-wishlist__media">' +
                '<a href="' + escapeHtml(product.url) + '">' + image + '</a>' +
                '<span class="sulalat-wishlist__price">' + escapeHtml(formatMoney(product.price)) + '</span>' +
                '<button type="button" class="sulalat-wishlist__remove" data-wishlist-remove="' + escapeHtml(product.id) + '" aria-label="Remove">' +
                  '<svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2.5 2.5l7 7M9.5 2.5l-7 7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>' +
                '</button>' +
              '</div>' +
              '<div class="sulalat-wishlist__body">' +
                '<p class="sulalat-wishlist__vendor">' + escapeHtml(product.vendor || config.vendor || 'Sulalat') + '</p>' +
                '<h3 class="sulalat-wishlist__name"><a href="' + escapeHtml(product.url) + '">' + escapeHtml(title) + '</a></h3>' +
                '<p class="sulalat-wishlist__desc">' + escapeHtml(product.description || '') + '</p>' +
                '<button type="button" class="sulalat-wishlist__btn sulalat-wishlist__btn--outline sulalat-wishlist__atc" data-wishlist-atc="' + escapeHtml(product.variant_id) + '"' + atcDisabled + '>' +
                  escapeHtml(config.addToCartLabel || 'Add to Cart') +
                '</button>' +
              '</div>' +
            '</article>'
          );
        }).join('');
      }

      function addToCart(variantIds) {
        var items = uniqueIds(variantIds).filter(Boolean).map(function (id) {
          return { id: Number(id), quantity: 1 };
        });
        if (!items.length) return Promise.resolve();
        return fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ items: items })
        }).then(function (res) {
          if (!res.ok) throw new Error('cart');
          return res.json();
        });
      }

      function removeIds(idsToRemove) {
        var removeSet = {};
        uniqueIds(idsToRemove).forEach(function (id) { removeSet[String(id)] = true; });
        stateIds = stateIds.filter(function (id) { return !removeSet[String(id)]; });
        writeMirror(stateIds);
        render();
      }

      if (grid) {
        grid.addEventListener('click', function (event) {
          var removeBtn = event.target.closest('[data-wishlist-remove]');
          if (removeBtn) {
            var removeId = removeBtn.getAttribute('data-wishlist-remove');
            if (!removeId) return;
            if (!window.confirm(config.removeConfirm || 'Remove this item from your wishlist?')) return;
            removeIds([removeId]);
            setStatus('');
            return;
          }

          var atcBtn = event.target.closest('[data-wishlist-atc]');
          if (atcBtn) {
            var variantId = atcBtn.getAttribute('data-wishlist-atc');
            if (!variantId || atcBtn.disabled) return;
            atcBtn.disabled = true;
            addToCart([variantId])
              .then(function () {
                setStatus(config.addedLabel || 'Added to cart');
                document.dispatchEvent(new CustomEvent('cart:updated'));
              })
              .catch(function () {
                setStatus(config.errorLabel || 'Something went wrong. Please try again.');
              })
              .finally(function () {
                atcBtn.disabled = false;
              });
          }
        });
      }

      if (removeAllBtn) {
        removeAllBtn.addEventListener('click', function () {
          if (!stateIds.length) return;
          if (!window.confirm(config.removeAllConfirm || 'Remove all items from your wishlist?')) return;
          removeIds(stateIds.slice());
          setStatus('');
        });
      }

      if (addAllBtn) {
        addAllBtn.addEventListener('click', function () {
          var products = resolveProducts(stateIds).filter(function (p) {
            return p.available !== false && p.variant_id;
          });
          if (!products.length) return;
          addAllBtn.disabled = true;
          addToCart(products.map(function (p) { return p.variant_id; }))
            .then(function () {
              setStatus(config.addedLabel || 'Added to cart');
              document.dispatchEvent(new CustomEvent('cart:updated'));
            })
            .catch(function () {
              setStatus(config.errorLabel || 'Something went wrong. Please try again.');
            })
            .finally(function () {
              addAllBtn.disabled = stateIds.length === 0;
            });
        });
      }

      function refresh() {
        return ensureCatalogLoaded().then(function () {
          stateIds = readMirror();
          render();
        });
      }

      refresh();
      document.addEventListener('sulalat:wishlist:updated', function (event) {
        if (event.detail && Array.isArray(event.detail.ids)) {
          stateIds = uniqueIds(event.detail.ids);
          render();
        } else {
          refresh();
        }
      });
      document.addEventListener('visibilitychange', function () {
        if (document.visibilityState === 'visible') refresh();
      });
    })();
  </script>
</section>

{% schema %}
{
  "name": "Sulalat wishlist",
  "tag": "section",
  "class": "sulalat-wishlist-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "My Wishlist"
    },
    {
      "type": "text",
      "id": "remove_all_label",
      "label": "Remove All label",
      "default": "Remove All"
    },
    {
      "type": "text",
      "id": "add_all_label",
      "label": "Add All To Cart label",
      "default": "Add All To Cart"
    },
    {
      "type": "text",
      "id": "add_to_cart_label",
      "label": "Add to Cart label",
      "default": "Add to Cart"
    },
    {
      "type": "textarea",
      "id": "empty_text",
      "label": "Empty message",
      "default": "Your wishlist is empty. Tap the Wish Keeper heart icon on a product to save it here."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding top (mobile)",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom (mobile)",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Sulalat wishlist"
    }
  ]
}
{% endschema %}
