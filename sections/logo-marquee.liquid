<section
  class="certifications"
  data-section-id="{{ section.id }}"
  style="
    --certifications-padding-top: {{ section.settings.section_padding_top }}px;
    --certifications-padding-bottom: {{ section.settings.section_padding_bottom }}px;
    --certifications-bg: {{ section.settings.section_bg_color }};
    --certifications-heading-color: {{ section.settings.heading_color }};
    --certifications-text-color: {{ section.settings.text_color }};
    --certifications-heading-size: {{ section.settings.heading_size }}px;
    --certifications-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --certifications-body-size: {{ section.settings.body_size }}px;
    --certifications-logo-width: {{ section.settings.logo_width }}px;
    --certifications-logo-gap: {{ section.settings.logo_gap }}px;
    --certifications-animation-duration: {{ section.settings.animation_duration }}s;
  "
>
  <style>
    .certifications[data-section-id="{{ section.id }}"] {
      padding-top: var(--certifications-padding-top);
      padding-bottom: var(--certifications-padding-bottom);
      background: var(--certifications-bg);
      overflow: hidden;
    }

    .certifications[data-section-id="{{ section.id }}"] .container {
      max-width: var(--brand-container-max, 1440px);
      margin: 0 auto;
      padding: 0 var(--brand-container-padding-x, 20px);
    }

    .certifications[data-section-id="{{ section.id }}"] .section-title {
      text-align: center;
      margin-bottom: 60px;
      max-width: 950px;
      margin-inline: auto;
    }

    .certifications[data-section-id="{{ section.id }}"] .section-title h2 {
      color: var(--certifications-heading-color);
      font-size: var(--certifications-heading-size);
      font-weight: 400;
      margin-bottom: 30px;
      line-height: 1.2;
    }

    .certifications[data-section-id="{{ section.id }}"] .section-title p {
      color: var(--certifications-text-color);
      font-size: var(--certifications-body-size);
      line-height: 1.5;
      letter-spacing: -0.01em;
      margin-top: 14px;
    }

    .certifications[data-section-id="{{ section.id }}"] .logo-slider {
      overflow: hidden;
      width: 100%;
      /* Keep marquee math LTR so Arabic/RTL does not reverse the track and break the loop */
      direction: ltr;
    }

    .certifications[data-section-id="{{ section.id }}"] .logo-track {
      display: flex;
      flex-direction: row;
      width: max-content;
      gap: var(--certifications-logo-gap);
      animation: marquee-{{ section.id }} var(--certifications-animation-duration) linear infinite;
      will-change: transform;
    }

    {% if section.settings.pause_on_hover %}
      .certifications[data-section-id="{{ section.id }}"] .logo-track.pause-on-hover:hover {
        animation-play-state: paused;
      }
    {% endif %}

    .certifications[data-section-id="{{ section.id }}"] .logo-item {
      flex: 0 0 auto;
      width: var(--certifications-logo-width);
      min-height: 60px;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .certifications[data-section-id="{{ section.id }}"] .logo-item a {
      display: block;
      width: 100%;
      text-decoration: none;
    }

    .certifications[data-section-id="{{ section.id }}"] .logo-item img {
      width: 100%;
      height: auto;
      display: block;
      object-fit: contain;
    }

    .certifications[data-section-id="{{ section.id }}"] .logo-item svg.placeholder-svg {
      width: 100%;
      height: auto;
      min-height: 60px;
      display: block;
    }

    @keyframes marquee-{{ section.id }} {
      from {
        transform: translateX(0);
      }
      to {
        transform: translateX(-50%);
      }
    }

    @media (max-width: 767px) {
      .certifications[data-section-id="{{ section.id }}"] .section-title h2 {
        font-size: var(--certifications-heading-size-mobile);
      }
      .certifications[data-section-id="{{ section.id }}"] .section-title {
        margin-bottom: 40px;
      }
      .certifications[data-section-id="{{ section.id }}"] .logo-item {
        width: calc(var(--certifications-logo-width) * 0.7);
      }
    }

    @media (max-width: 575px){
      .certifications[data-section-id="{{ section.id }}"] .logo-item {
        width: 110px;
      }
    }
  </style>

  <div class="container">
    {% if section.settings.heading != blank or section.settings.subheading != blank %}
      <div class="section-title">
        {% if section.settings.heading != blank %}
          <h2>{{ section.settings.heading | escape }}</h2>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <p>{{ section.settings.subheading | escape }}</p>
        {% endif %}
      </div>
    {% endif %}
  </div>

  <div class="logo-slider">
    <div class="logo-track{% if section.settings.pause_on_hover %} pause-on-hover{% endif %}">
      {% comment %}
        Repeat logos enough times so each half of the track is wider than the viewport.
        Animation moves -50%, so both halves must be identical and fill the screen.
      {% endcomment %}
      {% if section.blocks.size > 0 %}
        {% for copy in (1..4) %}
          {% for block in section.blocks %}
            <div class="logo-item"{% if copy == 1 %} {{ block.shopify_attributes }}{% endif %}>
              {% if block.settings.link != blank %}
                <a href="{{ block.settings.link }}">
              {% endif %}
                {% if block.settings.image != blank %}
                  <img
                    src="{{ block.settings.image | image_url: width: 400 }}"
                    alt="{% if copy == 1 %}{{ block.settings.image.alt | escape }}{% endif %}"
                    width="{{ block.settings.image.width }}"
                    height="{{ block.settings.image.height }}"
                    {% if copy == 1 or request.design_mode %}loading="eager"{% else %}loading="lazy"{% endif %}
                  >
                {% else %}
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                {% endif %}
              {% if block.settings.link != blank %}
                </a>
              {% endif %}
            </div>
          {% endfor %}
        {% endfor %}

        {% for copy in (1..4) %}
          {% for block in section.blocks %}
            <div class="logo-item" aria-hidden="true">
              {% if block.settings.link != blank %}
                <a href="{{ block.settings.link }}" tabindex="-1">
              {% endif %}
                {% if block.settings.image != blank %}
                  <img
                    src="{{ block.settings.image | image_url: width: 400 }}"
                    alt=""
                    width="{{ block.settings.image.width }}"
                    height="{{ block.settings.image.height }}"
                    {% if request.design_mode %}loading="eager"{% else %}loading="lazy"{% endif %}
                  >
                {% else %}
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                {% endif %}
              {% if block.settings.link != blank %}
                </a>
              {% endif %}
            </div>
          {% endfor %}
        {% endfor %}
      {% else %}
        {% for copy in (1..8) %}
          {% for i in (1..6) %}
            <div class="logo-item"{% if copy > 1 %} aria-hidden="true"{% endif %}>
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          {% endfor %}
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Logo Marquee",
  "tag": "section",
  "class": "certifications-section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Quality You Can Trust"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Our ISO-certified processes and global accolades reflect our commitment to excellence at every stage."
    },
    {
      "type": "header",
      "content": "Styling"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "section_bg_color",
      "label": "Section background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 100
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading font size",
      "min": 20,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading mobile font size",
      "min": 18,
      "max": 36,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "Body text size",
      "min": 13,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Logo Slider"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 80,
      "max": 280,
      "step": 2,
      "unit": "px",
      "default": 156
    },
    {
      "type": "range",
      "id": "logo_gap",
      "label": "Gap between logos",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "animation_duration",
      "label": "Animation duration",
      "min": 5,
      "max": 60,
      "step": 1,
      "unit": "s",
      "default": 30
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on hover",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Logo Marquee",
      "blocks": [
        {
          "type": "logo"
        },
        {
          "type": "logo"
        },
        {
          "type": "logo"
        },
        {
          "type": "logo"
        },
        {
          "type": "logo"
        },
        {
          "type": "logo"
        }
      ]
    }
  ]
}
{% endschema %}