<section class="initiatives-intro" data-section-id="{{ section.id }}">
  <style>
    .initiatives-intro[data-section-id="{{ section.id }}"] {
      padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
      background: {{ section.settings.background_color }};
      font-family: var(--body-font-family);
      color: #1a1a1a;
    }

    .initiatives-intro[data-section-id="{{ section.id }}"] .container {
      max-width: var(--brand-container-max, 1440px);
      margin: 0 auto;
      padding: 0 var(--brand-container-padding-x, 20px);
    }

    .initiatives-intro[data-section-id="{{ section.id }}"] .initiatives-intro__layout {
      display: grid;
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      gap: clamp(32px, 5vw, 72px);
      align-items: center;
    }

    .initiatives-intro[data-section-id="{{ section.id }}"] .initiatives-intro__media {
      border-radius: 16px;
      overflow: hidden;
      background: #f3f3f3;
      aspect-ratio: 1 / 1;
    }

    .initiatives-intro[data-section-id="{{ section.id }}"] .initiatives-intro__media img,
    .initiatives-intro[data-section-id="{{ section.id }}"] .initiatives-intro__media svg.placeholder-svg {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .initiatives-intro[data-section-id="{{ section.id }}"] .initiatives-intro__content {
      max-width: 520px;
    }

    .initiatives-intro[data-section-id="{{ section.id }}"] .initiatives-intro__heading {
      margin: 0 0 18px;
      color: #1a1a1a;
      font-size: clamp(36px, 4vw, 55px);
      line-height: 1.15;
      font-weight: 400;
    }

    .initiatives-intro[data-section-id="{{ section.id }}"] .initiatives-intro__subheading {
      margin: 0 0 14px;
      color: #1a1a1a;
      font-size: clamp(18px, 1.6vw, 22px);
      line-height: 1.35;
      font-weight: 600;
    }

    .initiatives-intro[data-section-id="{{ section.id }}"] .initiatives-intro__text {
      margin: 0;
      color: var(--brand-body-text, #535353);
      font-size: 16px;
      line-height: 26px;
      letter-spacing: -0.01em;
    }

    .initiatives-intro[data-section-id="{{ section.id }}"] .initiatives-intro__text p {
      margin: 0 0 12px;
    }

    .initiatives-intro[data-section-id="{{ section.id }}"] .initiatives-intro__text p:last-child {
      margin-bottom: 0;
    }

    @media (max-width: 991px) {
      .initiatives-intro[data-section-id="{{ section.id }}"] .initiatives-intro__layout {
        grid-template-columns: 1fr;
        gap: 28px;
      }

      .initiatives-intro[data-section-id="{{ section.id }}"] .initiatives-intro__content {
        max-width: none;
      }
    }

    @media (max-width: 749px) {
      .initiatives-intro[data-section-id="{{ section.id }}"] {
        padding: {{ section.settings.padding_top_mobile }}px 0 {{ section.settings.padding_bottom_mobile }}px;
      }

      .initiatives-intro[data-section-id="{{ section.id }}"] .initiatives-intro__media {
        border-radius: 12px;
      }
    }
  </style>

  <div class="container">
    <div class="initiatives-intro__layout">
      <div class="initiatives-intro__media">
        {%- if section.settings.image != blank -%}
          {%- assign intro_alt = section.settings.image.alt | default: section.settings.heading -%}
          {{
            section.settings.image
            | image_url: width: 1400
            | image_tag:
              loading: 'lazy',
              widths: '400, 700, 1000, 1400',
              sizes: '(min-width: 992px) 45vw, 100vw',
              alt: intro_alt
          }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>

      <div class="initiatives-intro__content">
        {%- if section.settings.heading != blank -%}
          <h2 class="initiatives-intro__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}

        {%- if section.settings.subheading != blank -%}
          <h3 class="initiatives-intro__subheading">{{ section.settings.subheading | escape }}</h3>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="initiatives-intro__text">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Initiatives intro",
  "tag": "section",
  "class": "initiatives-intro-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Introduction"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Bean-to-Bar Perfection"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>We craft chocolate with the same dedication we bring to coffee. From carefully selected cacao beans to handcrafted bars, every step reflects our commitment to quality and craftsmanship.</p>"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top (mobile)",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom (mobile)",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "Initiatives intro"
    }
  ]
}
{% endschema %}
