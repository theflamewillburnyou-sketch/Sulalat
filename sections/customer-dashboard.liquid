            assign payments_seen = '|'
            assign payments_count = 0
            assign account_methods_count = 0
            if customer and customer.payment_methods.size > 0
              assign account_methods_count = customer.payment_methods.size
            endif
          -%}

          <div class="sulalat-dashboard__payments-header">
            <div>
              <h1 class="sulalat-dashboard__title">{{ section.settings.payments_heading | default: 'My Payments' | escape }}</h1>
              <p class="sulalat-dashboard__payments-subtitle">{{ section.settings.payments_subtitle | default: 'Cards used for your orders' | escape }}</p>
            </div>
            <div class="sulalat-dashboard__payments-brands" aria-hidden="true">
              <span class="sulalat-dashboard__payments-brand sulalat-dashboard__payments-brand--visa">VISA</span>
              <span class="sulalat-dashboard__payments-brand sulalat-dashboard__payments-brand--mc">
                <span></span>
                <span></span>
              </span>
            </div>
          </div>

          {%- if account_methods_count > 0 -%}
            <p class="sulalat-dashboard__payments-account-methods">
              {{ account_methods_count }} saved payment method{% if account_methods_count > 1 %}s{% endif %} on your Shopify account.
            </p>
          {%- endif -%}

          {%- if customer -%}
            <div class="sulalat-dashboard__payments-list">
              {%- paginate customer.orders by 50 -%}
                {%- for order in customer.orders -%}
                  {%- for transaction in order.transactions -%}
                    {%- liquid
                      assign show_card = false
                      if transaction.payment_details.credit_card_last_four_digits != blank
                        if transaction.status == 'success' or transaction.status == 'pending'
                          if transaction.kind == 'sale' or transaction.kind == 'capture' or transaction.kind == 'authorization'
                            assign show_card = true
                          endif
                        endif
                      endif
                    -%}
                    {%- if show_card -%}
                      {%- liquid
                        assign card_company = transaction.payment_details.credit_card_company | default: 'Card'
                        assign card_last4 = transaction.payment_details.credit_card_last_four_digits
                        assign card_number = transaction.payment_details.credit_card_number
                        if card_number == blank
                          assign card_number = '•••• •••• •••• ' | append: card_last4
                        endif
                        assign card_key = '|' | append: card_company | append: '-' | append: card_last4 | append: '|'
                        assign company_down = card_company | downcase
                      -%}
                      {%- unless payments_seen contains card_key -%}
                        {%- assign payments_seen = payments_seen | append: card_company | append: '-' | append: card_last4 | append: '|' -%}
                        {%- assign payments_count = payments_count | plus: 1 -%}
                        <article class="sulalat-dashboard__payments-item">
                          <div class="sulalat-dashboard__payments-item-main">
                            {%- if company_down contains 'visa' -%}
                              <span class="sulalat-dashboard__payments-brand sulalat-dashboard__payments-brand--visa">VISA</span>
                            {%- elsif company_down contains 'master' -%}
                              <span class="sulalat-dashboard__payments-brand sulalat-dashboard__payments-brand--mc" aria-hidden="true">
                                <span></span>
                                <span></span>
                              </span>
                            {%- else -%}
                              <span class="sulalat-dashboard__payments-brand sulalat-dashboard__payments-brand--visa">{{ card_company | upcase | truncate: 8, '' | escape }}</span>
                            {%- endif -%}
                            <div class="sulalat-dashboard__payments-item-meta">
                              <p class="sulalat-dashboard__payments-item-brand">{{ card_company | escape }}</p>
                              <p class="sulalat-dashboard__payments-item-number">{{ card_number | escape }}</p>
                              <p class="sulalat-dashboard__payments-item-note">Used on order {{ order.name | escape }} · {{ order.created_at | date: '%b %d, %Y' }}</p>
                            </div>
                          </div>
                        </article>
                      {%- endunless -%}
                    {%- endif -%}
                  {%- endfor -%}
                {%- endfor -%}
              {%- endpaginate -%}
            </div>

            {%- if payments_count == 0 -%}
              <p class="sulalat-dashboard__payments-empty">
                {{ section.settings.payments_empty | default: 'No card payments found yet. When you pay with a card at checkout, the masked card details will appear here.' | escape }}
              </p>
            {%- endif -%}
          {%- else -%}
            <p class="sulalat-dashboard__payments-empty">Please log in to view your payment methods.</p>
          {%- endif -%}
        </div>

        <div class="sulalat-dashboard__panel" data-dashboard-panel="addresses" role="tabpanel" hidden>
          {%- liquid
            assign has_real_addresses = false
            if customer and customer.addresses_count > 0
              assign has_real_addresses = true
            endif

            assign address_return = request.path
            if address_return == blank
              assign address_return = canonical_url | remove: request.origin
            endif
            if address_return == blank and pages.dashboard != blank
              assign address_return = pages.dashboard.url
            endif
            if address_return == blank
              assign address_return = '/pages/dashboard'
            endif
            assign address_return = address_return | append: '?tab=addresses'
          -%}

          <div class="sulalat-dashboard__addresses-view" data-addresses-view="list">
            <div class="sulalat-dashboard__addresses-header">
              <h1 class="sulalat-dashboard__title">{{ section.settings.addresses_heading | default: 'Address Book' | escape }}</h1>
              <button type="button" class="sulalat-dashboard__add-address primary-btn" data-address-add>
                {{ section.settings.add_address_label | default: 'Add Address' | escape }}
              </button>
            </div>

            <div class="sulalat-dashboard__addresses-grid">
              {%- if has_real_addresses -%}
                {%- for address in customer.addresses -%}
                  <article class="sulalat-dashboard__address-card">
                    <h2 class="sulalat-dashboard__address-card-title">
                      {%- if address == customer.default_address -%}
                        Default Address
                      {%- else -%}
                        Address {{ forloop.index }}
                      {%- endif -%}
                    </h2>
                    <p class="sulalat-dashboard__address-card-name">
                      {{ address.first_name }} {{ address.last_name }}
                    </p>
                    <address class="sulalat-dashboard__address-card-lines">
                      {%- if address.address1 != blank -%}
                        <p>{{ address.address1 | escape }}</p>
                      {%- endif -%}
                      {%- if address.address2 != blank -%}
                        <p>{{ address.address2 | escape }}</p>
                      {%- endif -%}
                      {%- assign city_line = address.city -%}
                      {%- if address.zip != blank -%}
                        {%- if city_line != blank -%}
                          {%- assign city_line = city_line | append: ' ' | append: address.zip -%}
                        {%- else -%}
                          {%- assign city_line = address.zip -%}
                        {%- endif -%}
                      {%- endif -%}
                      {%- if city_line != blank -%}
                        <p>{{ city_line | escape }}</p>
                      {%- endif -%}
                      {%- if address.country != blank -%}
                        <p>{{ address.country | escape }}</p>
                      {%- endif -%}
                    </address>
                    {%- if address.phone != blank -%}
                      <p class="sulalat-dashboard__address-card-phone">T: {{ address.phone | escape }}</p>
                    {%- endif -%}
                    <div class="sulalat-dashboard__address-card-actions">
                      <button
                        type="button"
                        class="sulalat-dashboard__address-btn sulalat-dashboard__address-btn--primary"
                        data-address-edit="{{ address.id }}"
                      >
                        Update
                      </button>
                      <button
                        type="button"
                        class="sulalat-dashboard__address-btn sulalat-dashboard__address-btn--outline"
                        data-delete-address
                        data-target="/account/addresses/{{ address.id }}"
                        data-confirm-message="Are you sure you wish to delete this address?"
                      >
                        Remove
                      </button>
                    </div>
                  </article>
                {%- endfor -%}
              {%- else -%}
                <article class="sulalat-dashboard__address-card">
                  <h2 class="sulalat-dashboard__address-card-title">Address 1</h2>
                  <p class="sulalat-dashboard__address-card-name">John Doe</p>
                  <address class="sulalat-dashboard__address-card-lines">
                    <p>2329 Makkah Al Mukarramah Branch Road Store #2</p>
                    <p>Ground Floor, Najm Al Qurais Building, Riyadh 12821</p>
                  </address>
                  <p class="sulalat-dashboard__address-card-phone">T: +971 50 2252222</p>
                  <div class="sulalat-dashboard__address-card-actions">
                    <button type="button" class="sulalat-dashboard__address-btn sulalat-dashboard__address-btn--primary" data-address-add>Update</button>
                    <button type="button" class="sulalat-dashboard__address-btn sulalat-dashboard__address-btn--outline">Remove</button>
                  </div>
                </article>
                <article class="sulalat-dashboard__address-card">
                  <h2 class="sulalat-dashboard__address-card-title">Address 2</h2>
                  <p class="sulalat-dashboard__address-card-name">John Doe</p>
                  <address class="sulalat-dashboard__address-card-lines">
                    <p>2329 Makkah Al Mukarramah Branch Road Store #2</p>
                    <p>Ground Floor, Najm Al Qurais Building, Riyadh 12821</p>
                  </address>
                  <p class="sulalat-dashboard__address-card-phone">T: +971 50 2252222</p>
                  <div class="sulalat-dashboard__address-card-actions">
                    <button type="button" class="sulalat-dashboard__address-btn sulalat-dashboard__address-btn--primary" data-address-add>Update</button>
                    <button type="button" class="sulalat-dashboard__address-btn sulalat-dashboard__address-btn--outline">Remove</button>
                  </div>
                </article>
              {%- endif -%}
            </div>
          </div>

          <div class="sulalat-dashboard__addresses-view" data-addresses-view="form" hidden>
            <div class="sulalat-dashboard__detail-header">
              <button type="button" class="sulalat-dashboard__back sulalat-dashboard__back--address" data-addresses-back aria-label="Back to address book">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
              <h1 class="sulalat-dashboard__title" data-address-form-title>Add New Address</h1>
            </div>

            {%- if customer -%}
              <div class="sulalat-dashboard__address-form-wrap" data-address-form="new">
                <div class="sulalat-dashboard__address-form-card">
                  {%- form 'customer_address', customer.new_address, return_to: address_return, class: 'sulalat-dashboard__address-form' -%}
                    <input type="hidden" name="return_to" value="{{ address_return | escape }}">
                    <div class="sulalat-dashboard__address-form-row sulalat-dashboard__address-form-row--2">
                      <div class="sulalat-dashboard__address-field">
                        <label for="dashboard-add-first-name">First Name</label>
                        <input type="text" id="dashboard-add-first-name" name="address[first_name]" value="{{ form.first_name }}" autocomplete="given-name" placeholder="First Name">
                      </div>
                      <div class="sulalat-dashboard__address-field">
                        <label for="dashboard-add-last-name">Last Name</label>
                        <input type="text" id="dashboard-add-last-name" name="address[last_name]" value="{{ form.last_name }}" autocomplete="family-name" placeholder="Last Name">
                      </div>
                    </div>

                    <div class="sulalat-dashboard__address-form-row">
                      <div class="sulalat-dashboard__address-field">
                        <label for="dashboard-add-address1">Address</label>
                        <input type="text" id="dashboard-add-address1" name="address[address1]" value="{{ form.address1 }}" autocomplete="address-line1" placeholder="Address">
                      </div>
                    </div>

                    <div class="sulalat-dashboard__address-form-row">
                      <div class="sulalat-dashboard__address-field">
                        <label for="dashboard-add-address2">Apartment, suite, etc (optional)</label>
                        <input type="text" id="dashboard-add-address2" name="address[address2]" value="{{ form.address2 }}" autocomplete="address-line2" placeholder="Apartment, suite, etc (optional)">
                      </div>
                    </div>

                    <div class="sulalat-dashboard__address-form-row sulalat-dashboard__address-form-row--3">
                      <country-province-selector>
                        <div class="sulalat-dashboard__address-field">
                          <label for="dashboard-add-country">Country</label>
                          <select class="js-country-select" id="dashboard-add-country" name="address[country]" data-default="{{ form.country | default: 'Saudi Arabia' }}" autocomplete="country">
                            {{ all_country_option_tags }}
                          </select>
                        </div>
                        <div class="sulalat-dashboard__address-field js-province-container" id="dashboard-add-province-container" hidden>
                          <label for="dashboard-add-province">Region</label>
                          <select class="js-province-select" id="dashboard-add-province" name="address[province]" data-default="{{ form.province }}" autocomplete="address-level1">
                          </select>
                        </div>
                      </country-province-selector>
                      <div class="sulalat-dashboard__address-field">
                        <label for="dashboard-add-city">City</label>
                        <input type="text" id="dashboard-add-city" name="address[city]" value="{{ form.city }}" autocomplete="address-level2" placeholder="City">
                      </div>
                      <div class="sulalat-dashboard__address-field">
                        <label for="dashboard-add-zip">Zip Code</label>
                        <input type="text" id="dashboard-add-zip" name="address[zip]" value="{{ form.zip }}" autocapitalize="characters" autocomplete="postal-code" placeholder="Zip Code">
                      </div>
                    </div>

                    <div class="sulalat-dashboard__address-form-row">
                      <div class="sulalat-dashboard__address-field">
                        <label for="dashboard-add-phone">Phone number</label>
                        <input type="tel" id="dashboard-add-phone" name="address[phone]" value="{{ form.phone }}" autocomplete="tel" placeholder="Phone number">
                      </div>
                    </div>

                    <button type="submit" class="sulalat-dashboard__address-submit">Update</button>
                  {%- endform -%}
                </div>
              </div>

              {%- for address in customer.addresses -%}
                <div class="sulalat-dashboard__address-form-wrap" data-address-form="{{ address.id }}" hidden>
                  <div class="sulalat-dashboard__address-form-card">
                    {%- form 'customer_address', address, return_to: address_return, class: 'sulalat-dashboard__address-form' -%}
                      <input type="hidden" name="return_to" value="{{ address_return | escape }}">
                      <div class="sulalat-dashboard__address-form-row sulalat-dashboard__address-form-row--2">
                        <div class="sulalat-dashboard__address-field">
                          <label for="dashboard-edit-{{ address.id }}-first-name">First Name</label>
                          <input type="text" id="dashboard-edit-{{ address.id }}-first-name" name="address[first_name]" value="{{ form.first_name }}" autocomplete="given-name" placeholder="First Name">
                        </div>
                        <div class="sulalat-dashboard__address-field">
                          <label for="dashboard-edit-{{ address.id }}-last-name">Last Name</label>
                          <input type="text" id="dashboard-edit-{{ address.id }}-last-name" name="address[last_name]" value="{{ form.last_name }}" autocomplete="family-name" placeholder="Last Name">
                        </div>
                      </div>

                      <div class="sulalat-dashboard__address-form-row">
                        <div class="sulalat-dashboard__address-field">
                          <label for="dashboard-edit-{{ address.id }}-address1">Address</label>
                          <input type="text" id="dashboard-edit-{{ address.id }}-address1" name="address[address1]" value="{{ form.address1 }}" autocomplete="address-line1" placeholder="Address">
                        </div>
                      </div>

                      <div class="sulalat-dashboard__address-form-row">
                        <div class="sulalat-dashboard__address-field">
                          <label for="dashboard-edit-{{ address.id }}-address2">Apartment, suite, etc (optional)</label>
                          <input type="text" id="dashboard-edit-{{ address.id }}-address2" name="address[address2]" value="{{ form.address2 }}" autocomplete="address-line2" placeholder="Apartment, suite, etc (optional)">
                        </div>
                      </div>

                      <div class="sulalat-dashboard__address-form-row sulalat-dashboard__address-form-row--3">
                        <country-province-selector>
                          <div class="sulalat-dashboard__address-field">
                            <label for="dashboard-edit-{{ address.id }}-country">Country</label>
                            <select class="js-country-select" id="dashboard-edit-{{ address.id }}-country" name="address[country]" data-default="{{ form.country }}" autocomplete="country">
                              {{ all_country_option_tags }}
                            </select>
                          </div>
                          <div class="sulalat-dashboard__address-field js-province-container" id="dashboard-edit-{{ address.id }}-province-container" hidden>
                            <label for="dashboard-edit-{{ address.id }}-province">Region</label>
                            <select class="js-province-select" id="dashboard-edit-{{ address.id }}-province" name="address[province]" data-default="{{ form.province }}" autocomplete="address-level1">
                            </select>
                          </div>
                        </country-province-selector>
                        <div class="sulalat-dashboard__address-field">
                          <label for="dashboard-edit-{{ address.id }}-city">City</label>
                          <input type="text" id="dashboard-edit-{{ address.id }}-city" name="address[city]" value="{{ form.city }}" autocomplete="address-level2" placeholder="City">
                        </div>
                        <div class="sulalat-dashboard__address-field">
                          <label for="dashboard-edit-{{ address.id }}-zip">Zip Code</label>
                          <input type="text" id="dashboard-edit-{{ address.id }}-zip" name="address[zip]" value="{{ form.zip }}" autocapitalize="characters" autocomplete="postal-code" placeholder="Zip Code">
                        </div>
                      </div>

                      <div class="sulalat-dashboard__address-form-row">
                        <div class="sulalat-dashboard__address-field">
                          <label for="dashboard-edit-{{ address.id }}-phone">Phone number</label>
                          <input type="tel" id="dashboard-edit-{{ address.id }}-phone" name="address[phone]" value="{{ form.phone }}" autocomplete="tel" placeholder="Phone number">
                        </div>
                      </div>

                      <button type="submit" class="sulalat-dashboard__address-submit">Update</button>
                    {%- endform -%}
                  </div>
                </div>
              {%- endfor -%}
            {%- endif -%}
          </div>
        </div>

        <div class="sulalat-dashboard__panel" data-dashboard-panel="profile" role="tabpanel" hidden>
          {%- liquid
            assign profile_return = request.path
            if profile_return == blank
              assign profile_return = canonical_url | remove: request.origin
            endif
            if profile_return == blank and pages.dashboard != blank
              assign profile_return = pages.dashboard.url
            endif
            if profile_return == blank
              assign profile_return = '/pages/dashboard'
            endif
            assign profile_return = profile_return | append: '?tab=profile&updated=1'
          -%}

          <h1 class="sulalat-dashboard__title">{{ section.settings.profile_heading | default: 'Personal Information' | escape }}</h1>

          <p class="sulalat-dashboard__profile-success" data-profile-success hidden>
            Your personal information has been updated.
          </p>

          {%- if customer -%}
            {%- if customer.default_address != blank -%}
              {%- form 'customer_address', customer.default_address, return_to: profile_return, class: 'sulalat-dashboard__profile-form' -%}
                <input type="hidden" name="return_to" value="{{ profile_return | escape }}">
                <input type="hidden" name="address[address1]" value="{{ customer.default_address.address1 | escape }}">
                <input type="hidden" name="address[address2]" value="{{ customer.default_address.address2 | escape }}">
                <input type="hidden" name="address[city]" value="{{ customer.default_address.city | escape }}">
                <input type="hidden" name="address[company]" value="{{ customer.default_address.company | escape }}">
                <input type="hidden" name="address[country]" value="{{ customer.default_address.country | escape }}">
                <input type="hidden" name="address[province]" value="{{ customer.default_address.province | escape }}">
                <input type="hidden" name="address[zip]" value="{{ customer.default_address.zip | escape }}">
                <input type="hidden" name="address[default]" value="1">

                <div class="sulalat-dashboard__profile-card">
                  <div class="sulalat-dashboard__profile-row sulalat-dashboard__profile-row--2">
                    <div class="sulalat-dashboard__profile-field">
                      <label for="dashboard-profile-first-name">First Name</label>
                      <input
                        type="text"
                        id="dashboard-profile-first-name"
                        name="address[first_name]"
                        value="{{ profile_first | escape }}"
                        autocomplete="given-name"
                        placeholder="First Name"
                        required
                      >
                    </div>
                    <div class="sulalat-dashboard__profile-field">
                      <label for="dashboard-profile-last-name">Last Name</label>
                      <input
                        type="text"
                        id="dashboard-profile-last-name"
                        name="address[last_name]"
                        value="{{ profile_last | escape }}"
                        autocomplete="family-name"
                        placeholder="Last Name"
                        required
                      >
                    </div>
                  </div>

                  <div class="sulalat-dashboard__profile-row">
                    <div class="sulalat-dashboard__profile-field">
                      <label for="dashboard-profile-email">Email Address</label>
                      <input
                        type="email"
                        id="dashboard-profile-email"
                        value="{{ profile_email | escape }}"
                        autocomplete="email"
                        placeholder="Email Address"
                        readonly
                      >
                    </div>
                  </div>

                  <div class="sulalat-dashboard__profile-row">
                    <div class="sulalat-dashboard__profile-field">
                      <label for="dashboard-profile-phone">Phone number</label>
                      <input
                        type="tel"
                        id="dashboard-profile-phone"
                        name="address[phone]"
                        value="{{ profile_phone | escape }}"
                        autocomplete="tel"
                        placeholder="Phone number"
                      >
                    </div>
                  </div>
                </div>

                <button type="submit" class="sulalat-dashboard__profile-submit primary-btn">Update</button>
              {%- endform -%}
            {%- else -%}
              {%- form 'customer_address', customer.new_address, return_to: profile_return, class: 'sulalat-dashboard__profile-form' -%}
                <input type="hidden" name="return_to" value="{{ profile_return | escape }}">
                <input type="hidden" name="address[address1]" value="Primary address">
                <input type="hidden" name="address[city]" value="Riyadh">
                <input type="hidden" name="address[country]" value="Saudi Arabia">
                <input type="hidden" name="address[default]" value="1">

                <div class="sulalat-dashboard__profile-card">
                  <div class="sulalat-dashboard__profile-row sulalat-dashboard__profile-row--2">
                    <div class="sulalat-dashboard__profile-field">
                      <label for="dashboard-profile-first-name">First Name</label>
                      <input
                        type="text"
                        id="dashboard-profile-first-name"
                        name="address[first_name]"
                        value="{{ profile_first | escape }}"
                        autocomplete="given-name"
                        placeholder="First Name"
                        required
                      >
                    </div>
                    <div class="sulalat-dashboard__profile-field">
                      <label for="dashboard-profile-last-name">Last Name</label>
                      <input
                        type="text"
                        id="dashboard-profile-last-name"
                        name="address[last_name]"
                        value="{{ profile_last | escape }}"
                        autocomplete="family-name"
                        placeholder="Last Name"
                        required
                      >
                    </div>
                  </div>

                  <div class="sulalat-dashboard__profile-row">
                    <div class="sulalat-dashboard__profile-field">
                      <label for="dashboard-profile-email">Email Address</label>
                      <input
                        type="email"
                        id="dashboard-profile-email"
                        value="{{ profile_email | escape }}"
                        autocomplete="email"
                        placeholder="Email Address"
                        readonly
                      >
                    </div>
                  </div>

                  <div class="sulalat-dashboard__profile-row">
                    <div class="sulalat-dashboard__profile-field">
                      <label for="dashboard-profile-phone">Phone number</label>
                      <input
                        type="tel"
                        id="dashboard-profile-phone"
                        name="address[phone]"
                        value="{{ profile_phone | escape }}"
                        autocomplete="tel"
                        placeholder="Phone number"
                      >
                    </div>
                  </div>
                </div>

                <button type="submit" class="sulalat-dashboard__profile-submit primary-btn">Update</button>
              {%- endform -%}
            {%- endif -%}
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>

  <script>
    (function () {
      var root = document.querySelector('.sulalat-dashboard[data-section-id="{{ section.id }}"]');
      if (!root) return;

      var tabs = root.querySelectorAll('[data-dashboard-tab]');
      var panels = root.querySelectorAll('[data-dashboard-panel]');
      var listView = root.querySelector('[data-orders-view="list"]');
      var detailView = root.querySelector('[data-orders-view="detail"]');
      var orderDetails = root.querySelectorAll('[data-order-detail]');
      var backBtn = root.querySelector('[data-orders-back]');
      var addressesList = root.querySelector('[data-addresses-view="list"]');
      var addressesForm = root.querySelector('[data-addresses-view="form"]');
      var addressForms = root.querySelectorAll('[data-address-form]');
      var addressFormTitle = root.querySelector('[data-address-form-title]');
      var addressesBack = root.querySelector('[data-addresses-back]');

      function showOrdersList() {
        if (listView) listView.hidden = false;
        if (detailView) detailView.hidden = true;
        orderDetails.forEach(function (detail) {
          detail.hidden = true;
        });
      }

      function showOrderDetail(id) {
        if (!detailView) return;
        if (listView) listView.hidden = true;
        detailView.hidden = false;
        orderDetails.forEach(function (detail) {
          detail.hidden = detail.getAttribute('data-order-detail') !== String(id);
        });
      }

      function showAddressesList() {
        if (addressesList) addressesList.hidden = false;
        if (addressesForm) addressesForm.hidden = true;
        addressForms.forEach(function (formWrap) {
          formWrap.hidden = true;
        });
      }

      function showAddressForm(id) {
        if (!addressesForm) return;
        if (addressesList) addressesList.hidden = true;
        addressesForm.hidden = false;
        addressForms.forEach(function (formWrap) {
          formWrap.hidden = formWrap.getAttribute('data-address-form') !== String(id);
        });
        if (addressFormTitle) {
          addressFormTitle.textContent = id === 'new' ? 'Add New Address' : 'Update Address';
        }
      }

      function getWishlistSuiteUrl() {
        var panel = root.querySelector('[data-dashboard-panel="wishlist"]');
        return (
          (panel && panel.getAttribute('data-wishlist-suite-url')) ||
          '/pages/wishlist'
        );
      }

      function getSubscriptionsPortalUrl() {
        var panel = root.querySelector('[data-dashboard-panel="subscriptions"]');
        var link = root.querySelector('[data-subscriptions-portal-link]');
        return (
          (panel && panel.getAttribute('data-subscriptions-portal-url')) ||
          (link && link.getAttribute('href')) ||
          'https://shopify.com/69340233891/account/pages/6971b1a1-27f6-4c27-b8b0-3009fd3b921d'
        );
      }

      function setTab(name) {
        if (name === 'wishlist') {
          window.location.href = getWishlistSuiteUrl();
          return;
        }
        if (name === 'subscriptions') {
          window.location.href = getSubscriptionsPortalUrl();
          return;
        }
        tabs.forEach(function (tab) {
          var active = tab.getAttribute('data-dashboard-tab') === name;
          tab.classList.toggle('is-active', active);
          tab.setAttribute('aria-selected', active ? 'true' : 'false');
        });
        panels.forEach(function (panel) {
          panel.hidden = panel.getAttribute('data-dashboard-panel') !== name;
        });
        if (name === 'orders') showOrdersList();
        if (name === 'addresses') showAddressesList();
      }

      tabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
          setTab(tab.getAttribute('data-dashboard-tab'));
        });
      });

      root.querySelectorAll('[data-view-order]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          showOrderDetail(btn.getAttribute('data-view-order'));
        });
      });

      if (backBtn) {
        backBtn.addEventListener('click', showOrdersList);
      }

      root.querySelectorAll('[data-address-add]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          showAddressForm('new');
        });
      });

      root.querySelectorAll('[data-address-edit]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          showAddressForm(btn.getAttribute('data-address-edit'));
        });
      });

      if (addressesBack) {
        addressesBack.addEventListener('click', showAddressesList);
      }

      root.querySelectorAll('[data-delete-address]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var message = btn.getAttribute('data-confirm-message') || 'Are you sure you wish to delete this address?';
          if (!window.confirm(message)) return;

          var target = btn.getAttribute('data-target');
          var returnUrl = (window.location.pathname || '/pages/dashboard') + '?tab=addresses';
          var tokenEl = root.querySelector('input[name="authenticity_token"]');

          btn.disabled = true;

          var iframeName = 'dashboard-address-delete';
          var existing = document.querySelector('iframe[name="' + iframeName + '"]');
          if (existing) existing.remove();

          var iframe = document.createElement('iframe');
          iframe.name = iframeName;
          iframe.setAttribute('aria-hidden', 'true');
          iframe.style.cssText = 'position:absolute;width:0;height:0;border:0;visibility:hidden;';
          document.body.appendChild(iframe);

          var form = document.createElement('form');
          form.method = 'post';
          form.action = target;
          form.target = iframeName;

          function addHidden(name, value) {
            var input = document.createElement('input');
            input.type = 'hidden';
            input.name = name;
            input.value = value;
            form.appendChild(input);
          }

          addHidden('_method', 'delete');
          addHidden('form_type', 'customer_address');
          addHidden('return_to', returnUrl);
          if (tokenEl && tokenEl.value) {
            addHidden('authenticity_token', tokenEl.value);
          }

          var finished = false;
          function finish() {
            if (finished) return;
            finished = true;
            window.location.replace(returnUrl);
          }

          iframe.addEventListener('load', function () {
            setTimeout(finish, 300);
          });
          setTimeout(finish, 2000);

          document.body.appendChild(form);
          form.submit();
          form.remove();
        });
      });

      var params = new URLSearchParams(window.location.search);
      var activeTab = params.get('tab');
      if (
        activeTab === 'addresses' ||
        activeTab === 'profile' ||
        activeTab === 'orders' ||
        activeTab === 'payments' ||
        activeTab === 'wishlist' ||
        activeTab === 'subscriptions'
      ) {
        setTab(activeTab);
      }
      if (activeTab === 'profile' && params.get('updated') === '1') {
        var success = root.querySelector('[data-profile-success]');
        if (success) success.hidden = false;
      }

      var input = root.querySelector('[data-orders-search]');
      var rows = root.querySelectorAll('[data-order-row]');
      var empty = root.querySelector('[data-orders-empty]');
      if (input && rows.length) {
        input.addEventListener('input', function () {
          var query = (input.value || '').trim().toLowerCase();
          var visible = 0;
          rows.forEach(function (row) {
            var match = !query || (row.getAttribute('data-search') || '').indexOf(query) !== -1;
            row.classList.toggle('is-hidden', !match);
            if (match) visible += 1;
          });
          if (empty) empty.hidden = visible > 0;
        });
      }
    })();
  </script>
</section>

