{%- liquid
  assign dashboard_url = '/pages/dashboard'
  if pages.dashboard != blank
    assign dashboard_url = pages.dashboard.url
  endif

  assign customer_name = ''
  assign profile_first = ''
  assign profile_last = ''
  assign profile_phone = ''
  assign profile_email = ''

  if customer != blank
    assign profile_email = customer.email

    if customer.default_address != blank
      assign profile_first = customer.default_address.first_name
      assign profile_last = customer.default_address.last_name
      assign profile_phone = customer.default_address.phone
    endif

    if profile_first == blank
      assign profile_first = customer.first_name
    endif
    if profile_last == blank
      assign profile_last = customer.last_name
    endif
    if profile_phone == blank
      assign profile_phone = customer.phone
    endif

    if profile_first != blank
      assign customer_name = profile_first
      if profile_last != blank
        assign customer_name = profile_first | append: ' ' | append: profile_last
      endif
    elsif customer.name != blank
      assign customer_name = customer.name
    elsif customer.email != blank
      assign customer_name = customer.email | split: '@' | first
    endif
  endif

  assign customer_level = customer.metafields.custom.level.value | default: customer.metafields.custom.level | default: section.settings.default_level
-%}

{%- unless customer -%}
  <script>
    window.location.replace('/customer_authentication/login?return_to=' + encodeURIComponent({{ dashboard_url | json }}));
  </script>
{%- endunless -%}

<section class="sulalat-dashboard" data-section-id="{{ section.id }}" data-dashboard-root>
  <script src="{{ 'country-province-selector.js' | asset_url }}" defer></script>
  <style>
    .sulalat-dashboard[data-section-id="{{ section.id }}"] {
      padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
      background: {{ section.settings.background_color }};
      font-family: var(--body-font-family);
      color: #1a1a1a;
    }

    .sulalat-dashboard[data-section-id="{{ section.id }}"] .container {
      max-width: var(--brand-container-max, 1440px);
      margin: 0 auto;
      padding: 0 var(--brand-container-padding-x, 20px);
    }

    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__layout {
      display: grid;
      grid-template-columns: 313px minmax(0, 1fr);
      gap: 50px;
      align-items: start;
    }

    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__sidebar {
      background: #fff;
      border: 1px solid #E6E6E6;
      border-radius: 0 12px 12px 0;
      display: flex;
      flex-direction: column;
      overflow:hidden;
    }

    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__nav {
      display: flex;
      flex-direction: column;
      gap: 2px;
      margin: 0;
      padding: 0;
      list-style: none;
      flex: 1 1 auto;
    }

    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__link {
      position: relative;
      display: flex;
      align-items: center;
      gap: 12px;
      width: 100%;
      min-height: 48px;
      padding:16px 15px;
      border: 0;
      background: transparent;
      color: #808080;
      text-decoration: none;
      font-size: 17px;
      font-weight: 400;
      line-height: 1.3;
      font-family: inherit;
      text-align: start;
      cursor: pointer;
      letter-spacing:3%;
      transition: background 0.2s ease, color 0.2s ease;
    }

    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__link svg {
      width: 20px;
      height: 20px;
      flex-shrink: 0;
    }

    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__link.is-active {
      background: #e8f6ef;
      color: var(--brand-primary, #53c295);
    }

    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__link.is-active::before {
      content: '';
      position: absolute;
      left: 0;
      top: 0;
      bottom:0;
      width: 2.5px;
      border-radius: 0 3px 3px 0;
      background: var(--brand-primary, #53c295);
    }

    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__link:hover {
      color: var(--brand-primary, #53c295);
    }

    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__level {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin: 20px 10px 10px;
      padding: 14px 20px;
      border: 1px solid #E6E6E6;
      border-radius: 12px;
      background: #fff;
      box-shadow: 0px 1px 4px 0px rgba(25, 33, 61, 0.08);
    }

    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__level-label {
      margin: 0;
      color: #000;
      font-size: 17px;
      font-weight: 500;
      letter-spacing:3%;
    }

    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__level-value {
      margin: 0;
      color: #1a1a1a;
      font-size: 25px;
      font-weight: 700;
      line-height: 1;
      letter-spacing:3%;
    }

    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__main {
      padding-top: 4px;
      min-width: 0;
    }

    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__panel[hidden] {
      display: none !important;
    }

    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__title {
      margin: 0 0 35px;
      font-size: clamp(22px, 3vw, 30px);
      font-weight: 400;
      line-height: 1.1;
      color: #000;
      letter-spacing: -0.02em;
    }

    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__welcome {
      margin: 0 0 25px;
      font-size: 18px;
      font-weight: 400;
      line-height: 1.35;
      color: #1a1a1a;
    }

    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__intro {
      margin: 0;
      max-width: 520px;
      color: #535353;
      font-size: 16px;
      line-height: 1.55;
    }

    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__orders-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      margin-bottom: 40px;
    }

    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__orders-header .sulalat-dashboard__title {
      margin: 0;
    }

    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__search {
      position: relative;
      flex: 0 1 380px;
      max-width: 100%;
    }

    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__search-input {
      width: 100%;
      padding: 10px 30px;
      border: 1px solid #e6e6e6;
      border-radius: 999px;
      background: #fff;
      color: hsl(20deg 8.11% 7.25% / 50%);
      font-size: 16px;
      font-family: inherit;
      outline: none;
      height: 58px;
    }

    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__search-input::placeholder {
      color: hsl(20deg 8.11% 7.25% / 50%);
    }

    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__search-input:focus {
      border-color: var(--brand-primary, #53c295);
    }

    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__search-icon {
      position: absolute;
      right: 30px;
      top: 50%;
      transform: translateY(-50%);
      width: 18px;
      height: 18px;
      color: #b0b0b0;
      pointer-events: none;
    }

    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__orders-card {
      {% comment %} border: 1px solid #ececec;
      border-radius: 16px;
      background: #fff;
      overflow: hidden; {% endcomment %}
    }

    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__orders-scroll {
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      border: 1px solid #E6E6E6;
      border-radius: 12px;
      min-height: 426px;
    }

    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__orders-table {
      width: 100%;
      min-width: 860px;
      border-collapse: collapse;
      table-layout: fixed;
    }

    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__orders-table tbody tr {
      position: relative;
    }

    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__orders-table tbody td::before {
      content: "";
      position: absolute;
      background: #E6E6E6;
      height: 1px;
      bottom: 0;
      left: 0;
      right: 0;
      width: calc(100% - 50px);
      margin: 0 auto;
    }

    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__orders-table th,
    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__orders-table td {
      padding: 16px 24px;
      text-align: start;
      vertical-align: middle;
      font-size: 16px;
      line-height: 1.4;
      border:0;
    }

    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__orders-table thead th {
      background: #F6F6F6;
      color: rgba(0 0 0/ 60%);
      font-weight: 400;
      border-bottom: 1px solid #E6E6E6;
      white-space: nowrap;
    }

    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__orders-table tbody td {
      color: #2a2a2a;
    }

    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__orders-table tbody tr:last-child td {
      border-bottom: none;
    }

    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__orders-table tbody tr.is-hidden {
      display: none;
    }

    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__view-order {
      display: inline;
      padding: 0;
      border: 0;
      background: none;
      color: var(--brand-primary, #53c295);
      text-decoration: underline 2px #53c29582;
      font: inherit;
      font-weight: 600;
      white-space: nowrap;
      cursor: pointer;
      font-family: var(--secondary-font);
    }

    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__view-order:hover {
      text-decoration: underline;
    }

    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__orders-empty {
      margin: 0;
      padding: 36px 24px;
      text-align: center;
      color: #8a8a8a;
      font-size: 15px;
    }

    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__orders-view[hidden] {
      display: none !important;
    }

    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__detail-header {
      display: flex;
      align-items: center;
      gap: 14px;
      margin-bottom: 22px;
    }

    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__detail-header .sulalat-dashboard__title {
      margin: 0;
    }

    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__back {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 42px;
      height: 42px;
      border: 1px solid #e6e6e6;
      border-radius: 50%;
      background: #fff;
      color: #1a1a1a;
      cursor: pointer;
      flex-shrink: 0;
    }

    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__back:hover {
      border-color: var(--brand-primary, #53c295);
      color: var(--brand-primary, #53c295);
    }

    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__back svg {
      width: 18px;
      height: 18px;
    }

    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__detail-card {
      border: 1px solid #ececec;
      border-radius: 16px;
      background: #fff;
      overflow: hidden;
    }

    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__detail-summary {
      display: grid;
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: 12px;
      padding: 18px 20px;
      background: #e8f6ef;
    }

    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__detail-summary-item {
      min-width: 0;
    }

    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__detail-summary-label {
      margin: 0 0 6px;
      color: #6f6f6f;
      font-size: 12px;
      font-weight: 500;
    }

    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__detail-summary-value {
      margin: 0;
      color: #1a1a1a;
      font-size: 14px;
      font-weight: 600;
      line-height: 1.3;
      word-break: break-word;
    }

    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__detail-body {
      padding: 24px 22px 26px;
    }

    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__detail-section-title {
      margin: 0 0 16px;
      font-size: 18px;
      font-weight: 700;
      color: #1a1a1a;
    }

    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__detail-items {
      margin: 0 0 28px;
      padding: 0;
      list-style: none;
    }

    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__detail-item {
      display: grid;
      grid-template-columns: 64px minmax(0, 1fr) auto;
      gap: 16px;
      align-items: center;
      padding: 16px 0;
      border-bottom: 1px solid #efefef;
    }

    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__detail-item:first-child {
      padding-top: 0;
    }

    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__detail-item:last-child {
      border-bottom: none;
      padding-bottom: 0;
    }

    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__detail-item-image {
      width: 64px;
      height: 64px;
      border-radius: 10px;
      overflow: hidden;
      background: #f3f3f3;
    }

    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__detail-item-image img,
    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__detail-item-image svg {
      width: 100%;
      height: 100%;
      display: block;
      object-fit: cover;
    }

    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__detail-item-sku {
      margin: 0 0 4px;
      color: #8a8a8a;
      font-size: 12px;
      line-height: 1.4;
      word-break: break-word;
    }

    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__detail-item-title {
      margin: 0;
      color: #1a1a1a;
      font-size: 15px;
      font-weight: 600;
      line-height: 1.35;
    }

    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__detail-item-qty {
      margin: 0;
      color: #6f6f6f;
      font-size: 14px;
      font-weight: 500;
      white-space: nowrap;
    }

    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__detail-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 18px;
      align-items: start;
    }

    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__detail-box {
      border: 1px solid #ececec;
      border-radius: 14px;
      padding: 18px 18px 16px;
      background: #fff;
    }

    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__detail-box h3 {
      margin: 0 0 14px;
      font-size: 16px;
      font-weight: 700;
      color: #1a1a1a;
    }

    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__detail-payment {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }

    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__detail-payment-label {
      margin: 0;
      color: #1a1a1a;
      font-size: 14px;
      font-weight: 500;
    }

    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__detail-visa {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 52px;
      height: 28px;
      padding: 0 8px;
      border-radius: 4px;
      background: #1a1f71;
      color: #fff;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.04em;
    }

    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__detail-box-label {
      margin: 0 0 8px;
      color: #8a8a8a;
      font-size: 13px;
      font-weight: 500;
    }

    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__detail-address {
      margin: 0;
      color: #1a1a1a;
      font-size: 14px;
      line-height: 1.55;
    }

    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__detail-totals {
      margin-top: 18px;
    }

    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__detail-totals-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin: 0 0 10px;
      color: #6f6f6f;
      font-size: 14px;
    }

    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__detail-totals-row strong {
      color: #1a1a1a;
      font-weight: 500;
    }

    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__detail-totals-row.is-total {
      margin-top: 14px;
      padding-top: 12px;
      border-top: 1px solid #efefef;
      color: #1a1a1a;
      font-size: 15px;
      font-weight: 700;
    }

    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__detail-totals-row.is-total strong {
      font-weight: 700;
    }

    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__order-detail[hidden] {
      display: none !important;
    }

    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__addresses-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 28px;
    }

    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__addresses-header .sulalat-dashboard__title {
      margin: 0;
    }

    {% comment %} .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__add-address {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 46px;
      padding: 10px 26px;
      border: 0;
      border-radius: 999px;
      background: var(--brand-primary, #53c295);
      color: #fff;
      text-decoration: none;
      font-size: 15px;
      font-weight: 600;
      font-family: inherit;
      white-space: nowrap;
      cursor: pointer;
      transition: background 0.2s ease;
    }

    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__add-address:hover {
      background: #45ad82;
      color: #fff;
    } {% endcomment %}

    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__add-address.primary-btn{
      width:100%;
      max-width:143px;
      padding:11px 20px;
    }

    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__addresses-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 24px;
    }

    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__address-card {
      display: flex;
      flex-direction: column;
      min-height: 100%;
      padding: 24px 24px 22px;
      border: 1px solid #ececec;
      border-radius: 14px;
      background: #fff;
    }

    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__address-card-title {
      margin: 0 0 14px;
      color: #1a1a1a;
      font-size: 18px;
      font-weight: 700;
      line-height: 1.3;
    }

    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__address-card-name {
      margin: 0 0 8px;
      color: #1a1a1a;
      font-size: 15px;
      font-weight: 500;
      line-height: 1.4;
    }

    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__address-card-lines {
      margin: 0;
      color: #1a1a1a;
      font-size: 14px;
      line-height: 1.55;
      font-style: normal;
    }

    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__address-card-lines p {
      margin: 0 0 2px;
    }

    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__address-card-phone {
      margin: 10px 0 0;
      color: #1a1a1a;
      font-size: 14px;
      line-height: 1.4;
    }

    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__address-card-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: auto;
      padding-top: 22px;
    }

    .sulalat-dashboard[data-section-id="{{ section.id }}"] .sulalat-dashboard__address-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 40px;
      padding: 8px 22px;
