          </ul>
        </nav>

        <div class="sulalat-dashboard__level">
          <p class="sulalat-dashboard__level-label">My Level</p>
          <p class="sulalat-dashboard__level-value">{{ customer_level | escape }}</p>
        </div>
      </aside>

      <div class="sulalat-dashboard__main">
        <div class="sulalat-dashboard__panel" data-dashboard-panel="dashboard" role="tabpanel">
          <h1 class="sulalat-dashboard__title">{{ section.settings.heading | default: 'Dashboard' | escape }}</h1>
          <p class="sulalat-dashboard__welcome">
            Welcome Back, {% if customer_name != blank %}{{ customer_name | escape }}{% else %}{{ section.settings.fallback_name | default: 'Guest' | escape }}{% endif %}!
          </p>
          <p class="sulalat-dashboard__intro">{{ section.settings.intro | default: "Here's an overview of your coffee business performance and rewards." | escape }}</p>
        </div>

        <div class="sulalat-dashboard__panel" data-dashboard-panel="orders" role="tabpanel" hidden>
          {%- assign has_real_orders = false -%}
          {%- if customer and customer.orders_count > 0 -%}
            {%- assign has_real_orders = true -%}
          {%- endif -%}

          <div class="sulalat-dashboard__orders-view" data-orders-view="list">
            <div class="sulalat-dashboard__orders-header">
              <h1 class="sulalat-dashboard__title">{{ section.settings.orders_heading | default: 'My Orders' | escape }}</h1>
              <div class="sulalat-dashboard__search">
                <input
                  type="search"
                  class="sulalat-dashboard__search-input"
                  data-orders-search
                  placeholder="{{ section.settings.orders_search_placeholder | default: 'Search order...' | escape }}"
                  aria-label="{{ section.settings.orders_search_placeholder | default: 'Search order...' | escape }}"
                >
                <svg class="sulalat-dashboard__search-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="none">
                  <path d="M18.9582 18.9583L14.5277 14.5278M16.9213 8.77315C16.9213 13.2733 13.2733 16.9213 8.77315 16.9213C4.27305 16.9213 0.625 13.2733 0.625 8.77315C0.625 4.27305 4.27305 0.625 8.77315 0.625C13.2733 0.625 16.9213 4.27305 16.9213 8.77315Z" stroke="#0D0D0D" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
            </div>

            <div class="sulalat-dashboard__orders-card">
              <div class="sulalat-dashboard__orders-scroll">
                <table class="sulalat-dashboard__orders-table">
                  <thead>
                    <tr>
                      <th scope="col">Order ID</th>
                      <th scope="col">Date</th>
                      <th scope="col">Total</th>
                      <th scope="col">Status</th>
                      <th scope="col">Tracking ID</th>
                      <th scope="col">Action</th>
                    </tr>
                  </thead>
                  <tbody data-orders-body>
                    {%- if has_real_orders -%}
                      {%- paginate customer.orders by 50 -%}
                        {%- for order in customer.orders -%}
                          {%- liquid
                            assign order_status = order.fulfillment_status_label | default: order.financial_status_label
                            if order_status == blank
                              assign order_status = order.financial_status | replace: '_', ' ' | capitalize
                            endif

                            assign tracking_id = ''
                            for line_item in order.line_items
                              if line_item.fulfillment and line_item.fulfillment.tracking_number != blank
                                assign tracking_id = line_item.fulfillment.tracking_number
                                break
                              endif
                            endfor
                            if tracking_id == blank
                              assign tracking_id = '—'
                            endif

                            assign search_blob = order.name | append: ' ' | append: order_status | append: ' ' | append: tracking_id
                          -%}
                          <tr data-order-row data-search="{{ search_blob | downcase | escape }}">
                            <td>{{ order.name }}</td>
                            <td>{{ order.created_at | date: '%b %d, %Y' }}</td>
                            <td>{{ order.total_price | money }}</td>
                            <td>{{ order_status }}</td>
                            <td>{{ tracking_id }}</td>
                            <td>
                              <button type="button" class="sulalat-dashboard__view-order" data-view-order="{{ order.id }}">View Order</button>
                            </td>
                          </tr>
                        {%- endfor -%}
                      {%- endpaginate -%}
                    {%- else -%}
                      <tr data-order-row data-search="#0005155 pending st123456 aug 29, 2025 sar 6,000">
                        <td>#0005155</td>
                        <td>Aug 29, 2025</td>
                        <td>SAR 6,000</td>
                        <td>Pending</td>
                        <td>ST123456</td>
                        <td>
                          <button type="button" class="sulalat-dashboard__view-order" data-view-order="dummy">View Order</button>
                        </td>
                      </tr>
                      <tr data-order-row data-search="#0005155 pending st123456 aug 29, 2025 sar 6,000">
                        <td>#0005155</td>
                        <td>Aug 29, 2025</td>
                        <td>SAR 6,000</td>
                        <td>Pending</td>
                        <td>ST123456</td>
                        <td>
                          <button type="button" class="sulalat-dashboard__view-order" data-view-order="dummy">View Order</button>
                        </td>
                      </tr>
                    {%- endif -%}
                  </tbody>
                </table>
              </div>
              <p class="sulalat-dashboard__orders-empty" data-orders-empty hidden>No orders match your search.</p>
            </div>
          </div>

          <div class="sulalat-dashboard__orders-view" data-orders-view="detail" hidden>
            <div class="sulalat-dashboard__detail-header">
              <button type="button" class="sulalat-dashboard__back" data-orders-back aria-label="Back to orders">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
              <h1 class="sulalat-dashboard__title">{{ section.settings.order_detail_heading | default: 'Orders Details' | escape }}</h1>
            </div>

            {%- if has_real_orders -%}
              {%- for order in customer.orders limit: 50 -%}
                  {%- liquid
                    assign order_status = order.fulfillment_status_label | default: order.financial_status_label
                    if order_status == blank
                      assign order_status = order.financial_status | replace: '_', ' ' | capitalize
                    endif

                    assign tracking_id = ''
                    for line_item in order.line_items
                      if line_item.fulfillment and line_item.fulfillment.tracking_number != blank
                        assign tracking_id = line_item.fulfillment.tracking_number
                        break
                      endif
                    endfor
                    if tracking_id == blank
                      assign tracking_id = order.name | remove: '#'
                    endif

                    assign payment_type = order.gateway | default: 'Credit Card' | replace: '_', ' ' | capitalize
                    assign shipping_label = 'Free'
                    if order.shipping_price > 0
                      assign shipping_label = order.shipping_price | money
                    endif
                  -%}
                  <div class="sulalat-dashboard__order-detail" data-order-detail="{{ order.id }}" hidden>
                    <div class="sulalat-dashboard__detail-card">
                      <div class="sulalat-dashboard__detail-summary">
                        <div class="sulalat-dashboard__detail-summary-item">
                          <p class="sulalat-dashboard__detail-summary-label">Order ID</p>
                          <p class="sulalat-dashboard__detail-summary-value">{{ order.name | remove: '#' }}</p>
                        </div>
                        <div class="sulalat-dashboard__detail-summary-item">
                          <p class="sulalat-dashboard__detail-summary-label">Total Amount</p>
                          <p class="sulalat-dashboard__detail-summary-value">{{ order.total_price | money }}</p>
                        </div>
                        <div class="sulalat-dashboard__detail-summary-item">
                          <p class="sulalat-dashboard__detail-summary-label">Tracking ID</p>
                          <p class="sulalat-dashboard__detail-summary-value">{{ tracking_id }}</p>
                        </div>
                        <div class="sulalat-dashboard__detail-summary-item">
                          <p class="sulalat-dashboard__detail-summary-label">Date</p>
                          <p class="sulalat-dashboard__detail-summary-value">{{ order.created_at | date: '%b %d, %Y' }}</p>
                        </div>
                        <div class="sulalat-dashboard__detail-summary-item">
                          <p class="sulalat-dashboard__detail-summary-label">Payment Type</p>
                          <p class="sulalat-dashboard__detail-summary-value">{{ payment_type }}</p>
                        </div>
                        <div class="sulalat-dashboard__detail-summary-item">
                          <p class="sulalat-dashboard__detail-summary-label">Status</p>
                          <p class="sulalat-dashboard__detail-summary-value">{{ order_status }}</p>
                        </div>
                      </div>

                      <div class="sulalat-dashboard__detail-body">
                        <h2 class="sulalat-dashboard__detail-section-title">Items</h2>
                        <ul class="sulalat-dashboard__detail-items">
                          {%- for line_item in order.line_items -%}
                            <li class="sulalat-dashboard__detail-item">
                              <div class="sulalat-dashboard__detail-item-image">
                                {%- if line_item.image != blank -%}
                                  {{
                                    line_item.image
                                    | image_url: width: 160
                                    | image_tag: loading: 'lazy', widths: '80, 120, 160', sizes: '64px', alt: line_item.title
                                  }}
                                {%- else -%}
                                  {{ 'product-1' | placeholder_svg_tag }}
                                {%- endif -%}
                              </div>
                              <div>
                                {%- if line_item.sku != blank -%}
                                  <p class="sulalat-dashboard__detail-item-sku">{{ line_item.sku | escape }}</p>
                                {%- endif -%}
                                <p class="sulalat-dashboard__detail-item-title">{{ line_item.title | escape }}</p>
                              </div>
                              <p class="sulalat-dashboard__detail-item-qty">QTY: {{ line_item.quantity }}</p>
                            </li>
                          {%- endfor -%}
                        </ul>

                        <div class="sulalat-dashboard__detail-grid">
                          <div class="sulalat-dashboard__detail-box">
                            <h3>Payment</h3>
                            <div class="sulalat-dashboard__detail-payment">
                              <p class="sulalat-dashboard__detail-payment-label">{{ payment_type }}</p>
                              <span class="sulalat-dashboard__detail-visa" aria-hidden="true">VISA</span>
                            </div>
                          </div>

                          <div>
                            <div class="sulalat-dashboard__detail-box">
                              <h3>Delivery</h3>
                              <p class="sulalat-dashboard__detail-box-label">Address</p>
                              <div class="sulalat-dashboard__detail-address">
                                {%- if order.shipping_address -%}
                                  {{ order.shipping_address | format_address }}
                                {%- else -%}
                                  <p>No shipping address on this order.</p>
                                {%- endif -%}
                              </div>
                            </div>

                            <div class="sulalat-dashboard__detail-box sulalat-dashboard__detail-totals">
                              <div class="sulalat-dashboard__detail-totals-row">
                                <span>Subtotal</span>
                                <strong>{{ order.line_items_subtotal_price | money }}</strong>
                              </div>
                              <div class="sulalat-dashboard__detail-totals-row">
                                <span>Shipping</span>
                                <strong>{{ shipping_label }}</strong>
                              </div>
                              <div class="sulalat-dashboard__detail-totals-row">
                                <span>Estimated Taxes</span>
                                <strong>{{ order.tax_price | money }}</strong>
                              </div>
                              <div class="sulalat-dashboard__detail-totals-row is-total">
                                <span>Total</span>
                                <strong>{{ order.total_price | money }}</strong>
                              </div>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
              {%- endfor -%}
            {%- else -%}
              <div class="sulalat-dashboard__order-detail" data-order-detail="dummy" hidden>
                <div class="sulalat-dashboard__detail-card">
                  <div class="sulalat-dashboard__detail-summary">
                    <div class="sulalat-dashboard__detail-summary-item">
                      <p class="sulalat-dashboard__detail-summary-label">Order ID</p>
                      <p class="sulalat-dashboard__detail-summary-value">0005155</p>
                    </div>
                    <div class="sulalat-dashboard__detail-summary-item">
                      <p class="sulalat-dashboard__detail-summary-label">Total Amount</p>
                      <p class="sulalat-dashboard__detail-summary-value">SAR 6,000</p>
                    </div>
                    <div class="sulalat-dashboard__detail-summary-item">
                      <p class="sulalat-dashboard__detail-summary-label">Tracking ID</p>
                      <p class="sulalat-dashboard__detail-summary-value">0005155</p>
                    </div>
                    <div class="sulalat-dashboard__detail-summary-item">
                      <p class="sulalat-dashboard__detail-summary-label">Date</p>
                      <p class="sulalat-dashboard__detail-summary-value">Aug 29, 2025</p>
                    </div>
                    <div class="sulalat-dashboard__detail-summary-item">
                      <p class="sulalat-dashboard__detail-summary-label">Payment Type</p>
                      <p class="sulalat-dashboard__detail-summary-value">Credit Card</p>
                    </div>
                    <div class="sulalat-dashboard__detail-summary-item">
                      <p class="sulalat-dashboard__detail-summary-label">Status</p>
                      <p class="sulalat-dashboard__detail-summary-value">Pending</p>
                    </div>
                  </div>

                  <div class="sulalat-dashboard__detail-body">
                    <h2 class="sulalat-dashboard__detail-section-title">Items</h2>
                    <ul class="sulalat-dashboard__detail-items">
                      {%- for i in (1..3) -%}
                        <li class="sulalat-dashboard__detail-item">
                          <div class="sulalat-dashboard__detail-item-image">
                            {{ 'product-1' | placeholder_svg_tag }}
                          </div>
                          <div>
                            <p class="sulalat-dashboard__detail-item-sku">104-ETH-SHATHLIYYAH-BLD-250G</p>
                            <p class="sulalat-dashboard__detail-item-title">Birbis Kela Natural - Ethiopia</p>
                          </div>
                          <p class="sulalat-dashboard__detail-item-qty">QTY: 3</p>
                        </li>
                      {%- endfor -%}
                    </ul>

                    <div class="sulalat-dashboard__detail-grid">
                      <div class="sulalat-dashboard__detail-box">
                        <h3>Payment</h3>
                        <div class="sulalat-dashboard__detail-payment">
                          <p class="sulalat-dashboard__detail-payment-label">Visa **56</p>
                          <span class="sulalat-dashboard__detail-visa" aria-hidden="true">VISA</span>
                        </div>
                      </div>

                      <div>
                        <div class="sulalat-dashboard__detail-box">
                          <h3>Delivery</h3>
                          <p class="sulalat-dashboard__detail-box-label">Address</p>
                          <p class="sulalat-dashboard__detail-address">
                            8472 King Fahd Road Al Olaya District Riyadh 12213 Kingdom of Saudi Arabia
                          </p>
                        </div>

                        <div class="sulalat-dashboard__detail-box sulalat-dashboard__detail-totals">
                          <div class="sulalat-dashboard__detail-totals-row">
                            <span>Subtotal</span>
                            <strong>SAR 12,000</strong>
                          </div>
                          <div class="sulalat-dashboard__detail-totals-row">
                            <span>Shipping</span>
                            <strong>Free</strong>
                          </div>
                          <div class="sulalat-dashboard__detail-totals-row">
                            <span>Estimated Taxes</span>
                            <strong>SAR 20.10</strong>
                          </div>
                          <div class="sulalat-dashboard__detail-totals-row is-total">
                            <span>Total</span>
                            <strong>SAR 12,020.10</strong>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            {%- endif -%}
          </div>
        </div>

        <div
          class="sulalat-dashboard__panel"
          data-dashboard-panel="subscriptions"
          role="tabpanel"
          hidden
          data-subscriptions-portal-url="{{ section.settings.subscriptions_portal_url | default: 'https://shopify.com/69340233891/account/pages/6971b1a1-27f6-4c27-b8b0-3009fd3b921d' | escape }}"
        >
          <div class="sulalat-dashboard__wishlist-header">
            <h1 class="sulalat-dashboard__title">{{ section.settings.subscriptions_heading | default: 'My Subscriptions' | escape }}</h1>
          </div>

          <div class="sulalat-dashboard__wishlist-empty">
            <p style="margin: 0 0 18px;">
              {{ section.settings.subscriptions_redirect_text | default: 'Opening your subscriptions…' | escape }}
            </p>
            <a
              class="sulalat-dashboard__wishlist-btn sulalat-dashboard__wishlist-btn--solid"
              href="{{ section.settings.subscriptions_portal_url | default: 'https://shopify.com/69340233891/account/pages/6971b1a1-27f6-4c27-b8b0-3009fd3b921d' | escape }}"
              data-subscriptions-portal-link
            >
              {{ section.settings.subscriptions_open_label | default: 'Manage Subscriptions' | escape }}
            </a>
          </div>
        </div>

        <div
          class="sulalat-dashboard__panel"
          data-dashboard-panel="wishlist"
          role="tabpanel"
          hidden
          data-wishlist-suite-url="{{ section.settings.wishlist_suite_url | default: '/pages/wishlist' | escape }}"
        >
          <div class="sulalat-dashboard__wishlist-header">
            <h1 class="sulalat-dashboard__title">{{ section.settings.wishlist_heading | default: 'My Wishlist' | escape }}</h1>
          </div>

          <div class="sulalat-dashboard__wishlist-empty">
            <p style="margin: 0 0 18px;">
              {{ section.settings.wishlist_redirect_text | default: 'Opening your wishlist…' | escape }}
            </p>
            <a
              class="sulalat-dashboard__wishlist-btn sulalat-dashboard__wishlist-btn--solid"
              href="{{ section.settings.wishlist_suite_url | default: '/pages/wishlist' | escape }}"
              data-wishlist-suite-link
            >
              {{ section.settings.wishlist_open_label | default: 'Open My Wishlist' | escape }}
            </a>
          </div>
