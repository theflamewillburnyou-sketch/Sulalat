<section class="solution-page-nav" data-section-id="{{ section.id }}">
  <style>
    .solution-page-nav[data-section-id="{{ section.id }}"] {
      padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
      background: {{ section.settings.background_color }};
      font-family: var(--body-font-family);
    }

    .solution-page-nav[data-section-id="{{ section.id }}"] .container {
      max-width: var(--brand-container-max, 1440px);
      margin: 0 auto;
      padding: 0 var(--brand-container-padding-x, 20px);
    }

    .solution-page-nav[data-section-id="{{ section.id }}"] .solution-breadcrumb {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 10px;
      font-size: 17px;
      line-height: 1.4;
      color: #5D5D5D;
    }

    .solution-page-nav[data-section-id="{{ section.id }}"] .solution-breadcrumb a {
      appearance: none;
      background: none;
      border: none;
      padding: 0;
      margin: 0;
      color: inherit;
      font: inherit;
      cursor: pointer;
      text-decoration: none;
    }

    .solution-page-nav[data-section-id="{{ section.id }}"] .solution-breadcrumb a:hover {
      color: var(--brand-primary, #53c295);
    }

    .solution-page-nav[data-section-id="{{ section.id }}"] .solution-breadcrumb-sep {
      width: 6px;
      height: 6px;
      border-right: 1.5px solid currentColor;
      border-top: 1.5px solid currentColor;
      transform: rotate(45deg);
      flex-shrink: 0;
    }

    [dir="rtl"] .solution-page-nav[data-section-id="{{ section.id }}"] .solution-breadcrumb-sep {
      transform: rotate(-135deg);
    }

    .solution-page-nav[data-section-id="{{ section.id }}"] .solution-breadcrumb-sep:has(+ .solution-breadcrumb-current) {
      color: #53c295;
    }

    .solution-page-nav[data-section-id="{{ section.id }}"] .solution-breadcrumb-current {
      color: var(--brand-primary, #53c295);
      font-weight: 500;
    }

    .solution-page-nav[data-section-id="{{ section.id }}"] .solution-breadcrumb-home svg {
      display: block;
      width: 23px;
      height: 20px;
    }

    .solution-page-nav[data-section-id="{{ section.id }}"] .solution-breadcrumb-home svg path {
      color: #5D5D5D;
    }

    @media screen and (max-width:575px){
      .solution-page-nav[data-section-id="{{ section.id }}"] .solution-breadcrumb {
        font-size: 14px;
      }
    }
  </style>

  <div class="container">
    <nav class="solution-breadcrumb" aria-label="Breadcrumb">
      <a class="solution-breadcrumb-home" href="{{ routes.root_url }}" aria-label="Home">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="20" viewBox="0 0 24 20" fill="none" aria-hidden="true" focusable="false">
          <path d="M12.0095 0.164212C11.873 0.0577932 11.7049 0 11.5318 0C11.3587 0 11.1906 0.0577932 11.0541 0.164212L0 8.78362L0.956173 9.99287L2.30774 8.93901V18.4615C2.30855 18.8693 2.4709 19.2601 2.75925 19.5485C3.0476 19.8368 3.43845 19.9992 3.84623 20H19.2312C19.6389 19.9992 20.0298 19.8368 20.3181 19.5485C20.6065 19.2601 20.7688 18.8693 20.7697 18.4615V8.94593L22.1212 9.9998L23.0774 8.79054L12.0095 0.164212ZM13.0772 18.4615H10.0002V12.3075H13.0772V18.4615ZM14.6157 18.4615V12.3075C14.6157 11.8995 14.4536 11.5082 14.1651 11.2197C13.8765 10.9311 13.4852 10.769 13.0772 10.769H10.0002C9.59217 10.769 9.20085 10.9311 8.91233 11.2197C8.6238 11.5082 8.46171 11.8995 8.46171 12.3075V18.4615H3.84623V7.73975L11.5387 1.74732L19.2312 7.74744V18.4615H14.6157Z" fill="#797979"/>
        </svg>
      </a>

      {% if section.settings.crumb_1_label != blank %}
        <span class="solution-breadcrumb-sep" aria-hidden="true"></span>
        {% if section.settings.crumb_1_link != blank %}
          <a href="{{ section.settings.crumb_1_link }}">{{ section.settings.crumb_1_label | escape }}</a>
        {% else %}
          <span>{{ section.settings.crumb_1_label | escape }}</span>
        {% endif %}
      {% endif %}

      {% if section.settings.crumb_2_label != blank %}
        <span class="solution-breadcrumb-sep" aria-hidden="true"></span>
        {% if section.settings.crumb_2_link != blank %}
          <a href="{{ section.settings.crumb_2_link }}">{{ section.settings.crumb_2_label | escape }}</a>
        {% else %}
          <span>{{ section.settings.crumb_2_label | escape }}</span>
        {% endif %}
      {% endif %}

      {% if section.settings.crumb_3_label != blank %}
        <span class="solution-breadcrumb-sep" aria-hidden="true"></span>
        <span class="solution-breadcrumb-current" aria-current="page">{{ section.settings.crumb_3_label | escape }}</span>
      {% endif %}
    </nav>
  </div>
</section>

{% schema %}
{
  "name": "Solution page nav",
  "tag": "section",
  "class": "solution-page-nav-section",
  "settings": [
    {
      "type": "text",
      "id": "crumb_1_label",
      "label": "Crumb 1 label",
      "default": "Solutions"
    },
    {
      "type": "url",
      "id": "crumb_1_link",
      "label": "Crumb 1 link"
    },
    {
      "type": "text",
      "id": "crumb_2_label",
      "label": "Crumb 2 label",
      "default": "Main Stream"
    },
    {
      "type": "url",
      "id": "crumb_2_link",
      "label": "Crumb 2 link"
    },
    {
      "type": "text",
      "id": "crumb_3_label",
      "label": "Current page label",
      "default": "Services"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Solution page nav"
    }
  ]
}
{% endschema %}
