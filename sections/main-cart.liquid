{%- comment -%}theme-check-disable NestedSnippet{%- endcomment -%}
{{ 'cart-items.css' | asset_url | stylesheet_tag }}

{%- liquid
  if section.settings.continue_shopping_page != blank
    assign shop_url = section.settings.continue_shopping_page
  elsif settings.cart_empty_shop_link != blank
    assign shop_url = settings.cart_empty_shop_link
  else
    assign shop_url = routes.all_products_collection_url
  endif
-%}

{%- if cart != empty -%}
  <link rel="stylesheet" id="cart-summary-css" href="{{ 'cart-summary.css' | asset_url }}">
{%- endif -%}

{%- if section.settings.show_order_note -%}
  <script src="{{ 'cart-note.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

<section
  class="sulalat-cart"
  data-section-id="{{ section.id }}"
  style="
    --sulalat-cart-accent: {{ section.settings.accent_color }};
    --sulalat-cart-accent-soft: {{ section.settings.accent_soft }};
    --sulalat-cart-pad-top: {{ section.settings.padding_top }}px;
    --sulalat-cart-pad-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <style>
    .sulalat-cart[data-section-id="{{ section.id }}"] {
      padding: var(--sulalat-cart-pad-top, 48px) 0 var(--sulalat-cart-pad-bottom, 80px);
      background: #fbf9f9;
      font-family: var(--body-font-family);
      color: #111;
    }

    .sulalat-cart[data-section-id="{{ section.id }}"] .container {
      max-width: var(--brand-container-max, 1440px);
      margin: 0 auto;
      padding: 0 var(--brand-container-padding-x, 20px);
    }

    .sulalat-cart[data-section-id="{{ section.id }}"] .sulalat-cart__title {
      margin: 0 0 28px;
      font-size: clamp(32px, 4vw, 48px);
      line-height: 1.15;
      font-weight: 600;
      letter-spacing: -0.02em;
      color: #111;
    }

    .sulalat-cart[data-section-id="{{ section.id }}"] .sulalat-cart__layout {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(280px, 360px);
      gap: 28px;
      align-items: start;
    }

    .sulalat-cart[data-section-id="{{ section.id }}"] .sulalat-cart__layout--empty {
      grid-template-columns: 1fr;
    }

    .sulalat-cart[data-section-id="{{ section.id }}"] .sulalat-cart__panel {
      background: #fff;
      border: 1px solid #e8e8e8;
      border-radius: 20px;
      padding: 28px 32px;
    }

    .sulalat-cart[data-section-id="{{ section.id }}"] .sulalat-cart__panel--coupon {
      margin-top: 20px;
      display: flex;
      align-items: center;
      gap: 16px;
      flex-wrap: wrap;
      padding: 18px 24px;
    }

    .sulalat-cart[data-section-id="{{ section.id }}"] .sulalat-cart__coupon-label {
      margin: 0;
      font-size: 16px;
      font-weight: 600;
      white-space: nowrap;
    }

    .sulalat-cart[data-section-id="{{ section.id }}"] .sulalat-cart__coupon-form {
      display: flex;
      align-items: center;
      gap: 12px;
      flex: 1;
      min-width: 240px;
    }

    .sulalat-cart[data-section-id="{{ section.id }}"] .sulalat-cart__coupon-input {
      flex: 1;
      min-height: 46px;
      border: 1px solid #e0e0e0;
      border-radius: 999px;
      padding: 10px 20px;
      font: inherit;
      font-size: 14px;
      background: #fff;
      color: #111;
    }

    .sulalat-cart[data-section-id="{{ section.id }}"] .sulalat-cart__coupon-input::placeholder {
      color: #9a9a9a;
    }

    .sulalat-cart[data-section-id="{{ section.id }}"] .sulalat-cart__coupon-input:focus {
      outline: none;
      border-color: var(--sulalat-cart-accent, #53c295);
    }

    .sulalat-cart[data-section-id="{{ section.id }}"] .sulalat-cart__actions {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      flex-wrap: wrap;
      margin-top: 28px;
      padding-top: 8px;
    }

    .sulalat-cart[data-section-id="{{ section.id }}"] .sulalat-cart__btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 48px;
      padding: 12px 28px;
      border-radius: 999px;
      font: inherit;
      font-size: 15px;
      font-weight: 500;
      text-decoration: none;
      cursor: pointer;
      transition: 0.25s ease;
      text-align: center;
    }

    .sulalat-cart[data-section-id="{{ section.id }}"] .sulalat-cart__btn--outline {
      background: #fff;
      border: 1px solid var(--sulalat-cart-accent, #53c295);
      color: var(--sulalat-cart-accent, #53c295);
    }

    .sulalat-cart[data-section-id="{{ section.id }}"] .sulalat-cart__btn--outline:hover {
      background: var(--sulalat-cart-accent-soft, #eaf8f1);
      color: var(--sulalat-cart-accent, #53c295);
    }

    .sulalat-cart[data-section-id="{{ section.id }}"] .sulalat-cart__btn--soft {
      background: var(--sulalat-cart-accent-soft, #eaf8f1);
      border: 1px solid var(--sulalat-cart-accent, #53c295);
      color: var(--sulalat-cart-accent, #53c295);
    }

    .sulalat-cart[data-section-id="{{ section.id }}"] .sulalat-cart__btn--soft:hover {
      background: var(--sulalat-cart-accent, #53c295);
      color: #fff;
    }

    .sulalat-cart[data-section-id="{{ section.id }}"] .sulalat-cart__btn--primary {
      background: var(--sulalat-cart-accent, #53c295);
      border: 1px solid var(--sulalat-cart-accent, #53c295);
      color: #fff;
      width: 100%;
    }

    .sulalat-cart[data-section-id="{{ section.id }}"] .sulalat-cart__btn--primary:hover {
      background: #45ad82;
      border-color: #45ad82;
      color: #fff;
    }

    .sulalat-cart[data-section-id="{{ section.id }}"] .sulalat-cart__summary-title {
      margin: 0 0 24px;
      font-size: 22px;
      line-height: 1.3;
      font-weight: 600;
    }

    .sulalat-cart[data-section-id="{{ section.id }}"] .sulalat-cart__summary-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
      padding: 14px 0;
      font-size: 16px;
    }

    .sulalat-cart[data-section-id="{{ section.id }}"] .sulalat-cart__summary-row + .sulalat-cart__summary-row {
      border-top: 1px solid #ececec;
    }

    .sulalat-cart[data-section-id="{{ section.id }}"] .sulalat-cart__summary-row span:last-child {
      font-weight: 600;
    }

    .sulalat-cart[data-section-id="{{ section.id }}"] .sulalat-cart__checkout {
      margin-top: 24px;
    }

    .sulalat-cart[data-section-id="{{ section.id }}"] .sulalat-cart__discounts {
      margin: 0 0 8px;
      padding: 0;
      list-style: none;
    }

    .sulalat-cart[data-section-id="{{ section.id }}"] .sulalat-cart__discounts li {
      font-size: 14px;
      color: #0f6b4c;
      margin-bottom: 6px;
    }

    /* Neutralize theme cart CSS that breaks this layout */
    .sulalat-cart[data-section-id="{{ section.id }}"] .cart__items {
      max-width: none !important;
      flex: none !important;
      width: 100%;
    }

    .sulalat-cart[data-section-id="{{ section.id }}"] .cart__summary {
      margin-top: 0;
      padding-bottom: 0;
      border: 0;
    }

    .sulalat-cart[data-section-id="{{ section.id }}"] .sulalat-cart-items {
      width: 100%;
    }

    .sulalat-cart[data-section-id="{{ section.id }}"] .sulalat-cart-items__head,
    .sulalat-cart[data-section-id="{{ section.id }}"] .sulalat-cart-item {
      display: grid !important;
      grid-template-columns: minmax(220px, 1.6fr) minmax(100px, 0.7fr) minmax(120px, 0.8fr) minmax(100px, 0.7fr) 44px !important;
      gap: 16px;
      align-items: center;
      width: 100%;
      margin: 0;
      padding: 0;
      border: 0;
    }

    .sulalat-cart[data-section-id="{{ section.id }}"] .sulalat-cart-items__head {
      padding-bottom: 18px;
      border-bottom: 1px solid #ececec;
      margin-bottom: 0;
    }

    .sulalat-cart[data-section-id="{{ section.id }}"] .sulalat-cart-items__th {
      font-size: 14px;
      font-weight: 500;
      color: #9a9a9a;
      text-align: start;
    }

    .sulalat-cart[data-section-id="{{ section.id }}"] .sulalat-cart-items__th--price,
    .sulalat-cart[data-section-id="{{ section.id }}"] .sulalat-cart-items__th--qty,
    .sulalat-cart[data-section-id="{{ section.id }}"] .sulalat-cart-items__th--subtotal {
      text-align: center;
    }

    .sulalat-cart[data-section-id="{{ section.id }}"] .sulalat-cart-item {
      padding: 22px 0 !important;
      border-bottom: 1px solid #ececec !important;
      transition: opacity 0.4s;
    }

    .sulalat-cart[data-section-id="{{ section.id }}"] .sulalat-cart-item:last-child {
      border-bottom: 0 !important;
    }

    .sulalat-cart[data-section-id="{{ section.id }}"] .sulalat-cart-item > * {
      grid-column: auto !important;
      grid-row: auto !important;
      min-width: 0;
      padding: 0 !important;
    }

    .sulalat-cart[data-section-id="{{ section.id }}"] .sulalat-cart-item__product-inner {
      display: flex;
      align-items: center;
      gap: 16px;
      min-width: 0;
      width: 100%;
    }

    .sulalat-cart[data-section-id="{{ section.id }}"] .sulalat-cart-item__image {
      flex: 0 0 72px;
      width: 72px;
      height: 72px;
      border-radius: 12px;
      overflow: hidden;
      background: #f3f3f3;
      display: block;
    }

    .sulalat-cart[data-section-id="{{ section.id }}"] .sulalat-cart-item__image img,
    .sulalat-cart[data-section-id="{{ section.id }}"] .sulalat-cart-item__image svg {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      max-height: none;
    }

    .sulalat-cart[data-section-id="{{ section.id }}"] .sulalat-cart-item__meta {
      flex: 1 1 auto;
      min-width: 0;
    }

    .sulalat-cart[data-section-id="{{ section.id }}"] .sulalat-cart-item__sku {
      font-size: 12px;
      line-height: 1.4;
      color: #9a9a9a;
      margin-bottom: 4px;
      overflow-wrap: anywhere;
      word-break: normal;
    }

    .sulalat-cart[data-section-id="{{ section.id }}"] .sulalat-cart-item__title {
      display: block;
      font-size: 16px;
      line-height: 1.35;
      font-weight: 600;
      color: #111;
      text-decoration: none;
      white-space: normal;
      overflow-wrap: break-word;
      word-break: normal;
    }

    .sulalat-cart[data-section-id="{{ section.id }}"] .sulalat-cart-item__variants {
      margin-top: 4px;
      font-size: 13px;
      color: #8a8a8a;
    }

    .sulalat-cart[data-section-id="{{ section.id }}"] .sulalat-cart-item__variants span {
      display: block;
    }

    .sulalat-cart[data-section-id="{{ section.id }}"] .sulalat-cart-item__amount {
      font-size: 15px;
      white-space: nowrap;
    }

    .sulalat-cart[data-section-id="{{ section.id }}"] .sulalat-cart-item__amount--bold {
      font-weight: 600;
    }

    .sulalat-cart[data-section-id="{{ section.id }}"] .sulalat-cart-item__price,
    .sulalat-cart[data-section-id="{{ section.id }}"] .sulalat-cart-item__qty,
    .sulalat-cart[data-section-id="{{ section.id }}"] .sulalat-cart-item__subtotal {
      text-align: center;
    }

    .sulalat-cart[data-section-id="{{ section.id }}"] .sulalat-cart-item__qty-wrap {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      position: relative;
    }

    .sulalat-cart[data-section-id="{{ section.id }}"] .sulalat-cart-item__qty .qty-input {
      background: #f3f3f3;
      border-radius: 999px;
      padding: 4px 6px;
      border: 0;
      min-width: 110px;
      justify-content: center;
    }

    .sulalat-cart[data-section-id="{{ section.id }}"] .sulalat-cart-item__qty .qty-input__input {
      background: transparent;
      border: 0;
      box-shadow: none;
      width: 40px;
      text-align: center;
      font-weight: 500;
      padding: 6px 0;
      height: auto;
    }

    .sulalat-cart[data-section-id="{{ section.id }}"] .sulalat-cart-item__qty .qty-input__btn {
      width: 32px;
      height: 32px;
      border: 0;
      background: transparent;
      color: #111;
      padding: 0;
      box-shadow: none;
    }

    .sulalat-cart[data-section-id="{{ section.id }}"] .sulalat-cart-item__qty quantity-input {
      margin: 0;
    }

    .sulalat-cart[data-section-id="{{ section.id }}"] .sulalat-cart-item__remove {
      text-align: end;
      display: flex;
      justify-content: flex-end;
    }

    .sulalat-cart[data-section-id="{{ section.id }}"] .sulalat-cart-item__remove-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 32px;
      height: 32px;
      border-radius: 50%;
      border: 1px solid #e0e0e0;
      color: #8a8a8a;
      background: #fff;
      transition: 0.2s ease;
      text-decoration: none;
    }

    .sulalat-cart[data-section-id="{{ section.id }}"] .sulalat-cart-item__remove-btn:hover {
      border-color: #111;
      color: #111;
    }

    .sulalat-cart[data-section-id="{{ section.id }}"] .sulalat-cart-item__remove-btn svg {
      width: 14px;
      height: 14px;
    }

    .sulalat-cart[data-section-id="{{ section.id }}"] .cart-empty {
      min-height: 280px;
      padding: 40px 20px;
    }

    @media (max-width: 991px) {
      .sulalat-cart[data-section-id="{{ section.id }}"] .sulalat-cart__layout {
        grid-template-columns: 1fr;
      }

      .sulalat-cart[data-section-id="{{ section.id }}"] .sulalat-cart__panel--summary {
        order: -1;
      }
    }

    @media (max-width: 749px) {
      .sulalat-cart[data-section-id="{{ section.id }}"] .sulalat-cart__panel {
        padding: 20px;
      }

      .sulalat-cart[data-section-id="{{ section.id }}"] .sulalat-cart-items__head {
        display: none !important;
      }

      .sulalat-cart[data-section-id="{{ section.id }}"] .sulalat-cart-item {
        grid-template-columns: 1fr auto !important;
        gap: 12px 8px;
        padding: 20px 0 !important;
      }

      .sulalat-cart[data-section-id="{{ section.id }}"] .sulalat-cart-item__product {
        grid-column: 1 / -1 !important;
      }

      .sulalat-cart[data-section-id="{{ section.id }}"] .sulalat-cart-item__price,
      .sulalat-cart[data-section-id="{{ section.id }}"] .sulalat-cart-item__qty,
      .sulalat-cart[data-section-id="{{ section.id }}"] .sulalat-cart-item__subtotal {
        text-align: start;
      }

      .sulalat-cart[data-section-id="{{ section.id }}"] .sulalat-cart-item__price::before,
      .sulalat-cart[data-section-id="{{ section.id }}"] .sulalat-cart-item__qty::before,
      .sulalat-cart[data-section-id="{{ section.id }}"] .sulalat-cart-item__subtotal::before {
        content: attr(data-label);
        display: block;
        font-size: 12px;
        color: #9a9a9a;
        margin-bottom: 4px;
      }

      .sulalat-cart[data-section-id="{{ section.id }}"] .sulalat-cart-item__remove {
        grid-column: 2;
        grid-row: 2 / 5;
        align-self: start;
      }

      .sulalat-cart[data-section-id="{{ section.id }}"] .sulalat-cart__actions {
        flex-direction: column;
      }

      .sulalat-cart[data-section-id="{{ section.id }}"] .sulalat-cart__btn {
        width: 100%;
      }

      .sulalat-cart[data-section-id="{{ section.id }}"] .sulalat-cart__panel--coupon {
        flex-direction: column;
        align-items: stretch;
      }

      .sulalat-cart[data-section-id="{{ section.id }}"] .sulalat-cart__coupon-form {
        flex-direction: column;
        min-width: 0;
      }

      .sulalat-cart[data-section-id="{{ section.id }}"] .sulalat-cart__coupon-form .sulalat-cart__btn {
        width: 100%;
      }
    }
  </style>

  <div class="container">
    {%- if section.settings.show_page_title -%}
      <h1 class="sulalat-cart__title js-cart-title">Cart</h1>
    {%- endif -%}

    <div class="alert mb-6 bg-error-bg text-error-text" id="cart-errors" role="alert" hidden></div>

    {%- if settings.show_free_shipping_notice and cart != empty -%}
      <div class="mb-6">
        {% render 'free-shipping-notice' %}
      </div>
    {%- endif -%}

    <form class="cart form" id="cart" action="{{ routes.cart_url }}" method="post">
      <div class="sulalat-cart__layout{% if cart == empty %} sulalat-cart__layout--empty{% endif %}">
        <div class="sulalat-cart__main">
          <div class="sulalat-cart__panel sulalat-cart__panel--items">
            <div class="cart__items">
              {% render 'cart-items', sulalat_layout: true %}
            </div>

            {%- if cart != empty -%}
              <div class="sulalat-cart__actions">
                <a class="sulalat-cart__btn sulalat-cart__btn--outline" href="{{ shop_url }}">
                  Return to shop
                </a>
                <button type="submit" name="update" class="sulalat-cart__btn sulalat-cart__btn--soft">
                  Update Cart
                </button>
              </div>
            {%- endif -%}
          </div>

          {%- if cart != empty and section.settings.show_coupon -%}
            <div class="sulalat-cart__panel sulalat-cart__panel--coupon">
              <p class="sulalat-cart__coupon-label">Coupon Code</p>
              <div class="sulalat-cart__coupon-form" data-sulalat-coupon>
                <input
                  type="text"
                  class="sulalat-cart__coupon-input"
                  name="discount"
                  placeholder="Enter code"
                  autocomplete="off"
                  form="sulalat-coupon-form"
                  data-sulalat-coupon-input
                >
                <button type="button" class="sulalat-cart__btn sulalat-cart__btn--primary" data-sulalat-coupon-apply style="width: auto; min-width: 140px;">
                  Apply Coupon
                </button>
              </div>
            </div>
          {%- endif -%}

          {%- if settings.show_recommendations and cart != empty -%}
            <div class="cart-page-recommendations mt-8">
              {%- liquid
                if settings.recommendations_layout == 'carousel'
                  assign grid_classes = 'grid grid-flow-col auto-cols-1 md:auto-cols-2 gap-x-theme'
                else
                  assign grid_classes = 'grid grid-cols-1 sm:grid-cols-2 md:grid-cols-1 xl:grid-cols-2 gap-x-theme'
                endif
              -%}
              {%- render 'recommendations',
                is_cart: true,
                products_to_show: settings.recommendations_to_show,
                heading: settings.recommendations_heading,
                layout: settings.recommendations_layout,
                grid_classes: grid_classes,
                always_open_quickbuy: true
              -%}
            </div>
          {%- endif -%}

          {%- if section.settings.show_shipping_calculator and cart != empty -%}
            <div class="cart__shipping-calculator panel mt-8">
              {% render 'shipping-calculator',
                id: 'cart',
                default_country: section.settings.shipping_calculator_default_country
              %}
            </div>
          {%- endif -%}
        </div>

        <div id="cart-summary-and-blocks" class="cart-content sulalat-cart__aside"{% if cart == empty %} hidden{% endif %}>
          {%- capture summary_and_checkout -%}
            <div class="cart__summary sulalat-cart__panel sulalat-cart__panel--summary" id="cart-summary" data-section="{{ section.id }}">
              <h2 class="sulalat-cart__summary-title">Cart Total</h2>

              {%- if section.settings.show_order_note -%}
                <details-disclosure class="block mb-4">
                  <details class="cart-note-disclosure disclosure disclosure--row">
                    <summary>
                      <div class="flex justify-between items-center">
                        <span class="js-show-note">
                          {%- if cart.note == blank -%}
                            {{- 'cart.note.add' | t -}}
                          {%- else -%}
                            {{- 'cart.note.edit' | t -}}
                          {%- endif -%}
                        </span>
                        <span class="disclosure__toggle">
                          {%- if settings.disclosure_toggle == 'plus' -%}
                            {% render 'icon-plus' %}
                          {%- else -%}
                            {% render 'icon-chevron-down' %}
                          {%- endif -%}
                        </span>
                      </div>
                    </summary>
                    <div class="disclosure__panel has-motion">
                      <div class="disclosure__content">
                        <cart-note>
                          <label class="visually-hidden" for="cart-note">{{ 'cart.note.label' | t }}</label>
                          <textarea class="input w-full" id="cart-note" name="note" rows="4">{{ cart.note }}</textarea>
                        </cart-note>
                      </div>
                    </div>
                  </details>
                </details-disclosure>
              {%- endif -%}

              {%- if cart.cart_level_discount_applications.size > 0 -%}
                <ul class="sulalat-cart__discounts" aria-label="{{ 'customer.order.discount' | t }}" role="list">
                  {%- for discount in cart.cart_level_discount_applications -%}
                    <li>{{ discount.title | escape_once }} (−{{ discount.total_allocated_amount | money }})</li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}

              <div class="sulalat-cart__summary-row">
                <span>Subtotal:</span>
                <span>{%- render 'price-as-money', price: cart.total_price, show_money_with_currency: true -%}</span>
              </div>

              <div class="sulalat-cart__summary-row">
                <span>Total:</span>
                <span>{%- render 'price-as-money', price: cart.total_price, show_money_with_currency: true -%}</span>
              </div>

              {%- if section.settings.show_tax_and_shipping -%}
                <div class="mt-4 text-sm" style="color: #8a8a8a;">
                  {%- if cart.taxes_included and shop.shipping_policy.body != blank -%}
                    {{- 'cart.general.taxes_included_shipping_at_checkout_html' | t: link: shop.shipping_policy.url -}}
                  {%- elsif cart.taxes_included -%}
                    {{- 'cart.general.taxes_included_shipping_at_checkout' | t -}}
                  {%- elsif shop.shipping_policy.body != blank -%}
                    {{- 'cart.general.taxes_and_shipping_at_checkout_html' | t: link: shop.shipping_policy.url -}}
                  {%- else -%}
                    {{- 'cart.general.taxes_and_shipping_at_checkout' | t -}}
                  {%- endif -%}
                </div>
              {%- endif -%}

              {%- if section.settings.cart_terms_page != blank -%}
                <cart-terms class="block mt-5">
                  <input type="checkbox" class="checkbox js-cart-terms-checkbox" id="cart-terms" form="cart">
                  <label for="cart-terms">
                    <span class="rte">{{ 'cart.terms.agreement_html' | t: terms_url: section.settings.cart_terms_page }}</span>
                  </label>
                </cart-terms>
              {%- endif -%}

              <div class="sulalat-cart__checkout">
                <button class="sulalat-cart__btn sulalat-cart__btn--primary" name="checkout" type="submit">
                  Proceed To Checkout
                </button>
              </div>

              {%- if additional_checkout_buttons and section.settings.cart_terms_page == blank and section.settings.show_additional_checkout_buttons -%}
                <div class="dynamic-cart-btns mt-4">
                  {{ content_for_additional_checkout_buttons }}
                </div>
              {%- endif -%}
            </div>
          {%- endcapture -%}

          {%- if cart != empty -%}
            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when '@app' -%}
                  <div class="inline-block{% unless forloop.first %} mt-4{% endunless %}{% unless forloop.last %} mb-4{% endunless %}" {{ block.shopify_attributes }}>
                    {%- render block -%}
                  </div>
                {%- when 'summary-and-checkout' -%}
                  <div {{ block.shopify_attributes }}>
                    {{- summary_and_checkout -}}
                  </div>
              {%- endcase -%}
            {%- else -%}
              {{- summary_and_checkout -}}
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>
    </form>
  </div>

  {%- if cart != empty and section.settings.show_coupon -%}
    <script>
      (function () {
        var root = document.querySelector('.sulalat-cart[data-section-id="{{ section.id }}"]');
        if (!root) return;
        var input = root.querySelector('[data-sulalat-coupon-input]');
        var button = root.querySelector('[data-sulalat-coupon-apply]');
        if (!input || !button) return;

        function applyCoupon() {
          var code = (input.value || '').trim();
          if (!code) {
            input.focus();
            return;
          }
          window.location.href = '/discount/' + encodeURIComponent(code) + '?redirect={{ routes.cart_url }}';
        }

        button.addEventListener('click', applyCoupon);
        input.addEventListener('keydown', function (event) {
          if (event.key === 'Enter') {
            event.preventDefault();
            applyCoupon();
          }
        });
      })();
    </script>
  {%- endif -%}
</section>

{%- if section.settings.cart_terms_page != blank -%}
  <script src="{{ 'cart-terms.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% schema %}
{
  "name": "Cart",
  "class": "cc-main-cart section section--template",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "checkbox",
      "id": "show_page_title",
      "label": "Show page heading",
      "default": true
    },
    {
      "type": "header",
      "content": "Cart items"
    },
    {
      "type": "checkbox",
      "id": "show_backorder_text",
      "label": "Show backorder text",
      "default": true,
      "info": "Only shows for products which use Shopify inventory tracking and can be purchased when out of stock."
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "header",
      "content": "Coupon"
    },
    {
      "type": "checkbox",
      "id": "show_coupon",
      "label": "Show coupon code field",
      "default": true
    },
    {
      "type": "header",
      "content": "Order summary"
    },
    {
      "type": "checkbox",
      "id": "show_order_note",
      "label": "Show order note",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_tax_and_shipping",
      "label": "Show tax status and shipping policy link",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_additional_checkout_buttons",
      "label": "Show additional checkout options",
      "default": true,
      "info": "Display other gateways and quick checkout buttons. [Learn more](https://help.shopify.com/en/manual/payments/accelerated-checkouts)"
    },
    {
      "type": "url",
      "id": "cart_terms_page",
      "label": "Terms and conditions link",
      "info": "Additional checkout options will be hidden when cart terms are shown."
    },
    {
      "type": "url",
      "id": "continue_shopping_page",
      "label": "Return to shop link"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#53c295"
    },
    {
      "type": "color",
      "id": "accent_soft",
      "label": "Soft accent background",
      "default": "#eaf8f1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "header",
      "content": "Shipping calculator"
    },
    {
      "type": "checkbox",
      "id": "show_shipping_calculator",
      "label": "Show shipping calculator",
      "default": false
    },
    {
      "type": "text",
      "id": "shipping_calculator_default_country",
      "label": "Default country",
      "info": "If the customer is logged-in, their default shipping address details will be selected.",
      "default": "United States"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "summary-and-checkout",
      "limit": 1,
      "name": "Summary and checkout",
      "settings": [
        {
          "type": "paragraph",
          "content": "This will display when there are items in the cart."
        }
      ]
    }
  ]
}
{% endschema %}
