<section
  class="blog-section"
  data-section-id="{{ section.id }}"
  style="
    --blog-padding-top: {{ section.settings.section_padding_top }}px;
    --blog-padding-bottom: {{ section.settings.section_padding_bottom }}px;
    --blog-bg: {{ section.settings.section_bg_color }};
    --blog-heading-color: {{ section.settings.heading_color }};
    --blog-text-color: {{ section.settings.text_color }};
    --blog-meta-color: {{ section.settings.meta_color }};
    --blog-link-color: {{ section.settings.link_color }};
    --blog-link-hover-color: {{ section.settings.link_hover_color }};
    --blog-heading-size: {{ section.settings.heading_size }}px;
    --blog-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --blog-body-size: {{ section.settings.body_size }}px;
    --blog-card-title-size: {{ section.settings.card_title_size }}px;
    --blog-card-title-size-mobile: {{ section.settings.card_title_size_mobile }}px;
  "
>
  <style>
    .blog-section[data-section-id="{{ section.id }}"] {
      padding-top: var(--blog-padding-top);
      padding-bottom: var(--blog-padding-bottom);
      background: var(--blog-bg);
      overflow: hidden;
    }

    .blog-section[data-section-id="{{ section.id }}"] .container {
      max-width: var(--brand-container-max, 1440px);
      margin: 0 auto;
      padding: 0 var(--brand-container-padding-x, 20px);
    }

    .blog-section[data-section-id="{{ section.id }}"] .section-title {
      text-align: center;
      margin-bottom: 60px;
      max-width: 950px;
      margin-inline: auto;
    }

    .blog-section[data-section-id="{{ section.id }}"] .section-title h2 {
      color: var(--blog-heading-color);
      font-size: var(--blog-heading-size);
      font-weight: 400;
      margin-bottom: 30px;
      line-height: 1.2;
    }

    .blog-section[data-section-id="{{ section.id }}"] .section-title p {
      color: var(--blog-text-color);
      font-size: var(--blog-body-size);
      line-height: 1.5;
      letter-spacing: -0.01em;
      margin-top: 14px;
    }

    .blog-section[data-section-id="{{ section.id }}"] .blog-grid {
      display: flex;
      gap: 60px;
      margin: 60px 0;
    }

    .blog-section[data-section-id="{{ section.id }}"] .featured-blog {
      width: calc((100% - 60px) * 0.48);
      display: flex;
    }

    .blog-section[data-section-id="{{ section.id }}"] .featured-blog .blog-image {
      width: 100%;
      min-height: 420px;
      max-height: 523px;
    }

    .blog-section[data-section-id="{{ section.id }}"] .blog-list {
      width: calc((100% - 60px) * 0.52);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .blog-section[data-section-id="{{ section.id }}"] .blog-image {
      position: relative;
      display: block;
      overflow: hidden;
      border-radius: 20px;
    }

    .blog-section[data-section-id="{{ section.id }}"] .blog-image::before {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(
        180deg,
        rgba(0, 27, 16, 1) 0%,
        rgba(0, 0, 0, 0) 100%
      );
      transform: rotate(0deg) scale(1, -1);
      opacity: 0.7;
      z-index: 1;
    }

    .blog-section[data-section-id="{{ section.id }}"] .blog-image img,
    .blog-section[data-section-id="{{ section.id }}"] .blog-image svg.placeholder-svg {
      width: 100%;
      height: 100%;
      display: block;
      object-fit: cover;
      transition: 0.5s;
    }

    .blog-section[data-section-id="{{ section.id }}"] .blog-image:hover img {
      transform: scale(1.08);
    }

    .blog-section[data-section-id="{{ section.id }}"] .blog-overlay {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      padding: 35px;
      color: #fff;
      background: linear-gradient(
        to top,
        rgba(0, 0, 0, 0.75),
        rgba(0, 0, 0, 0.15),
        transparent
      );
      z-index: 3;
    }

    .blog-section[data-section-id="{{ section.id }}"] .blog-overlay h3 {
      margin-bottom: 15px;
      font-size: var(--blog-card-title-size);
      font-weight: 500;
      color: #fff;
      line-height: 1.3;
    }

    .blog-section[data-section-id="{{ section.id }}"] .blog-overlay p {
      margin-bottom: 10px;
      font-size: 17px;
      line-height: 140%;
      font-weight: 400;
      color: #fff;
    }

    .blog-section[data-section-id="{{ section.id }}"] .blog-overlay span {
      color: var(--blog-meta-color);
      font-size: 17px;
      line-height: 35px;
      font-weight: 300;
    }

    .blog-section[data-section-id="{{ section.id }}"] .blog-overlay .blog-read-more {
      display: inline-block;
      color: #ffffff;
      font-size: 15px;
      font-weight: 500;
      text-decoration: underline;
      text-underline-offset: 4px;
    }

    .blog-section[data-section-id="{{ section.id }}"] .blog-card {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 35px;
      padding: 25px 0;
      border-bottom: 1px solid #e8e8e8;
    }

    .blog-section[data-section-id="{{ section.id }}"] .blog-content {
      flex: 1;
    }

    .blog-section[data-section-id="{{ section.id }}"] .blog-content h3 {
      margin-bottom: 5px;
      line-height:1;
    }

    .blog-section[data-section-id="{{ section.id }}"] .blog-content h3 a {
      color: var(--blog-heading-color);
      text-decoration: none;
      font-size: var(--blog-card-title-size);
      font-weight: 500;
      transition: color 0.3s ease;
    }

    .blog-section[data-section-id="{{ section.id }}"] .blog-content h3 a:hover {
      color: var(--blog-link-hover-color);
    }

    .blog-section[data-section-id="{{ section.id }}"] .blog-content p {
      margin-bottom: 18px;
      font-size: 17px;
      line-height: 140%;
      font-weight: 400;
      color: #4b4b4b;
    }

    .blog-section[data-section-id="{{ section.id }}"] .blog-content span {
      color: var(--blog-meta-color);
      font-size: 17px;
      line-height: 35px;
      font-weight: 400;
      font-family: var(--secondary-font);
    }

    .blog-section[data-section-id="{{ section.id }}"] .blog-thumb {
        width: 100%;
        flex-shrink: 0;
        border-radius: 18px;
        overflow: hidden;
        max-width: 225px;
    }

    .blog-section[data-section-id="{{ section.id }}"] .blog-thumb img,
    .blog-section[data-section-id="{{ section.id }}"] .blog-thumb svg.placeholder-svg {
      width: 100%;
      display: block;
      {% comment %} aspect-ratio: 1/1; {% endcomment %}
      object-fit: cover;
      transition: 0.5s;
    }

    .blog-section[data-section-id="{{ section.id }}"] .blog-thumb:hover img {
      transform: scale(1.08);
    }

    .blog-section[data-section-id="{{ section.id }}"] .blog-btn {
      margin-top: 70px;
      text-align: center;
    }

    .blog-section[data-section-id="{{ section.id }}"] .primary-btn {
      background: {{ section.settings.button_bg_color }};
      border-color: {{ section.settings.button_bg_color }};
      color: {{ section.settings.button_text_color }};
    }

    .blog-section[data-section-id="{{ section.id }}"] .primary-btn:hover {
      color: {{ section.settings.button_bg_color }};
    }

    @media (max-width: 1440px){
      .blog-section[data-section-id="{{ section.id }}"] .featured-blog .blog-image {
         max-height: 420px;
      }
      .blog-section[data-section-id="{{ section.id }}"] .blog-thumb {
         max-width: 150px;
      }
      .blog-section[data-section-id="{{ section.id }}"] .blog-content h3 a{
         font-size:20px;
      }
      .blog-section[data-section-id="{{ section.id }}"] .blog-content p {
        font-size: 16px;
        letter-spacing: -1%;
        line-height: 28px;
        color: #000;
      }
      .blog-section[data-section-id="{{ section.id }}"] .blog-grid {
          gap: 40px;
      } 
    }


    @media (max-width: 991px) {
      .blog-section[data-section-id="{{ section.id }}"] .blog-grid {
        flex-direction: column;
        gap: 40px;
      }
      .blog-section[data-section-id="{{ section.id }}"] .featured-blog,
      .blog-section[data-section-id="{{ section.id }}"] .blog-list {
        width: 100%;
      }
    }

    @media (max-width: 767px) {
       .blog-section[data-section-id="{{ section.id }}"]{
        padding-bottom:70px;
      }

      .blog-section[data-section-id="{{ section.id }}"] .section-title h2 {
        font-size: var(--blog-heading-size-mobile);
      }

      {% comment %} .blog-section[data-section-id="{{ section.id }}"] .blog-card {
        flex-direction: column;
        align-items: flex-start;
        gap: 20px;
      } {% endcomment %}

      {% comment %} .blog-section[data-section-id="{{ section.id }}"] .blog-thumb {
        width: 100%;
      } {% endcomment %}

      .blog-section[data-section-id="{{ section.id }}"] .blog-overlay h3 {
        font-size: var(--blog-card-title-size-mobile);
      }
     
    }
    @media (max-width: 575px) {
      .blog-section[data-section-id="{{ section.id }}"] .section-title {
          margin-bottom: 20px;
      }
      .blog-section[data-section-id="{{ section.id }}"] .section-title p {
        line-height:30px;
      }
      .blog-section[data-section-id="{{ section.id }}"] .featured-blog .blog-image {
        width: 100%;
        min-height:0;
        max-height: 200px;
      }
      .blog-section[data-section-id="{{ section.id }}"] .primary-btn{
          width:100%;
      } 
      .blog-section[data-section-id="{{ section.id }}"] .blog-content h3{
         margin-bottom: 12px;
      }
      .blog-section[data-section-id="{{ section.id }}"] .blog-content h3 a{
        font-size:18px;
      }
     
      .blog-section[data-section-id="{{ section.id }}"] .blog-grid {
        gap: 10px;
        margin: 20px 0;
      }
      .blog-section[data-section-id="{{ section.id }}"] .blog-overlay{
        padding: 20px 35px;
        display:none;
      }

      .blog-section[data-section-id="{{ section.id }}"] .blog-thumb {
        max-width: 160px;
        display:none;
      }

      .blog-section[data-section-id="{{ section.id }}"] .blog-card {
        gap: 20px;
      }
      
      .blog-section[data-section-id="{{ section.id }}"] .blog-card:last-child {
          border: 0;
      }
      .blog-section[data-section-id="{{ section.id }}"] .blog-btn {
          margin-top:0;
          text-align:left;
      }
    }

    @media (max-width: 480px){
      .blog-section[data-section-id="{{ section.id }}"] .blog-thumb {
        max-width: 120px;
      }
    }
  </style>

  <div class="container">
    <div class="section-title">
      <h2>{{ section.settings.heading | escape }}</h2>
      {% if section.settings.subheading != blank %}
        <p>{{ section.settings.subheading | escape }}</p>
      {% endif %}
    </div>

    {% assign selected_blog = section.settings.blog %}
    {% assign featured_article = nil %}
    {% if selected_blog != blank and selected_blog.articles_count > 0 %}
      {% assign featured_article = selected_blog.articles.first %}
    {% endif %}

    <div class="blog-grid">
      {% if featured_article %}
        <!-- Featured Blog -->
        <article class="featured-blog">
          <a href="{{ featured_article.url }}" class="blog-image">
            {% if featured_article.image %}
              <img
                src="{{ featured_article.image | image_url: width: 800 }}"
                alt="{{ featured_article.image.alt | escape }}"
                loading="lazy"
              >
            {% else %}
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            {% endif %}
            <div class="blog-overlay">
              <h3>{{ featured_article.title | escape }}</h3>
              <p>{{ featured_article.excerpt_or_content | strip_html | truncate: 100 }}</p>
              <span class="blog-read-more">{{ 'blogs.article.read_more' | t }}</span>
            </div>
          </a>
        </article>
      {% endif %}

      {% if selected_blog != blank and selected_blog.articles_count > 1 %}
        <!-- Blog List: next 2 articles only (skip featured) -->
        <div class="blog-list">
          {% for article in selected_blog.articles offset: 1 limit: 2 %}
            <article class="blog-card">
              <div class="blog-content">
                <h3>
                  <a href="{{ article.url }}">
                    {{ article.title | escape }}
                  </a>
                </h3>
                <p>{{ article.excerpt_or_content | strip_html | truncate: 80 }}</p>
                <span>{{ article.published_at | date: "%d %B %Y" }}</span>
              </div>
              <a href="{{ article.url }}" class="blog-thumb">
                {% if article.image %}
                  <img
                    src="{{ article.image | image_url: width: 400 }}"
                    alt="{{ article.image.alt | escape }}"
                    loading="lazy"
                  >
                {% else %}
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                {% endif %}
              </a>
            </article>
          {% endfor %}
        </div>
      {% endif %}

      {% if selected_blog == blank or selected_blog.articles_count == 0 %}
        <article class="featured-blog">
          <a href="#" class="blog-image">
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
            <div class="blog-overlay">
              <h3>The Art of Specialty Coffee Roasting</h3>
              <p>Discover how Sulalat sources and roasts premium beans for world-class flavor.</p>
              <span class="blog-read-more">{{ 'blogs.article.read_more' | t }}</span>
            </div>
          </a>
        </article>
        <div class="blog-list">
          <article class="blog-card">
            <div class="blog-content">
              <h3><a href="#">From Bean to Cup</a></h3>
              <p>Follow the journey of our specialty beans across the Kingdom.</p>
              <span>{{ 'blogs.article.read_more' | t }}</span>
            </div>
            <a href="#" class="blog-thumb">
              {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
            </a>
          </article>
          <article class="blog-card">
            <div class="blog-content">
              <h3><a href="#">Inside Our Training Academy</a></h3>
              <p>Learn barista skills and brewing techniques with Sulalat experts.</p>
              <span>{{ 'blogs.article.read_more' | t }}</span>
            </div>
            <a href="#" class="blog-thumb">
              {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
            </a>
          </article>
        </div>
      {% endif %}
    </div>

    <div class="blog-btn">
      {% assign blog_url = section.settings.button_link %}
      {% if blog_url == blank and selected_blog != blank %}
        {% assign blog_url = selected_blog.url %}
      {% endif %}
      <a href="{% if blog_url != blank %}{{ blog_url }}{% else %}#{% endif %}" class="primary-btn">
        {{ section.settings.button_text | escape }}
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Blog Section",
  "tag": "section",
  "class": "blog-section-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Explore the World of Coffee"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "From our roastery to your cup, learn about the stories, science, and passion behind every batch."
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Select blog"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "View All News"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link (optional)"
    },
    {
      "type": "header",
      "content": "Styling"
    },
    {
      "type": "color",
      "id": "section_bg_color",
      "label": "Section background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "meta_color",
      "label": "Date/meta color",
      "default": "#61c19a"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "link_hover_color",
      "label": "Link hover color",
      "default": "#61c19a"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button background",
      "default": "#61c19a"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_hover_bg_color",
      "label": "Button hover background",
      "default": "#4eaa84"
    },
    {
      "type": "color",
      "id": "button_hover_text_color",
      "label": "Button hover text",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 100
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading font size",
      "min": 20,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading mobile font size",
      "min": 18,
      "max": 36,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "Body text size",
      "min": 13,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "card_title_size",
      "label": "Card title size",
      "min": 16,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 22
    },
    {
      "type": "range",
      "id": "card_title_size_mobile",
      "label": "Card title mobile size",
      "min": 14,
      "max": 26,
      "step": 1,
      "unit": "px",
      "default": 18
    }
  ],
  "presets": [
    {
      "name": "Blog Section"
    }
  ]
}
{% endschema %}