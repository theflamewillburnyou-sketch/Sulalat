<section class="blog-section" id="shopify-section-{{ section.id }}">
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <div class="section-title">
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}
          <p>{{ section.settings.text }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- assign article_blocks = section.blocks | where: 'type', 'article' -%}
    {%- if article_blocks.size > 0 -%}
      <div class="blog-grid">
        {%- assign featured = article_blocks.first -%}
        <article class="featured-blog" {{ featured.shopify_attributes }}>
          <a href="{{ featured.settings.link | default: '#' }}" class="blog-image">
            {%- if featured.settings.image != blank -%}
              {{ featured.settings.image | image_url: width: 1200 | image_tag: alt: featured.settings.title }}
            {%- endif -%}
            <div class="blog-overlay">
              {%- if featured.settings.title != blank -%}
                <h3>{{ featured.settings.title }}</h3>
              {%- endif -%}
              {%- if featured.settings.text != blank -%}
                <p>{{ featured.settings.text }}</p>
              {%- endif -%}
              {%- if featured.settings.date != blank -%}
                <span>{{ featured.settings.date }}</span>
              {%- endif -%}
            </div>
          </a>
        </article>

        {%- assign list_articles = article_blocks | slice: 1, 10 -%}
        {%- if list_articles.size > 0 -%}
          <div class="blog-list">
            {%- for block in list_articles -%}
              <article class="blog-card" {{ block.shopify_attributes }}>
                <div class="blog-content">
                  {%- if block.settings.title != blank -%}
                    <h3>
                      <a href="{{ block.settings.link | default: '#' }}">{{ block.settings.title }}</a>
                    </h3>
                  {%- endif -%}
                  {%- if block.settings.text != blank -%}
                    <p>{{ block.settings.text }}</p>
                  {%- endif -%}
                  {%- if block.settings.date != blank -%}
                    <span>{{ block.settings.date }}</span>
                  {%- endif -%}
                </div>
                {%- if block.settings.image != blank -%}
                  <a href="{{ block.settings.link | default: '#' }}" class="blog-thumb">
                    {{ block.settings.image | image_url: width: 400 | image_tag: alt: block.settings.title }}
                  </a>
                {%- endif -%}
              </article>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <div class="blog-btn">
        <a href="{{ section.settings.button_link | default: '#' }}" class="primary-btn">
          {{ section.settings.button_label }}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% style %}
  #shopify-section-{{ section.id }} .blog-section {
    padding-bottom: 100px;
  }

  #shopify-section-{{ section.id }} .section-title {
    text-align: center;
    margin-bottom: 0;
    max-width: 950px;
    margin-inline: auto;
  }

  #shopify-section-{{ section.id }} .section-title h2 {
    color: #000;
    font-size: clamp(24px, 3vw, 36px);
    font-weight: 400;
    margin-bottom: 30px;
  }

  #shopify-section-{{ section.id }} .section-title p {
    color: var(--sub-title-clr, #141211);
    font-size: 16px;
    line-height: 24px;
    letter-spacing: -1%;
  }

  #shopify-section-{{ section.id }} .blog-grid {
    display: flex;
    gap: 60px;
    margin: 60px 0;
  }

  #shopify-section-{{ section.id }} .featured-blog {
    width: calc((100% - 60px) * .48);
  }

  #shopify-section-{{ section.id }} .blog-list {
    width: calc((100% - 60px) * .52);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  #shopify-section-{{ section.id }} .blog-image {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 20px;
  }

  #shopify-section-{{ section.id }} .blog-image::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 27, 16, 1) 0%, rgba(0, 0, 0, 0) 100%);
    transform: rotate(0deg) scale(1, -1);
    opacity: 0.7;
    z-index: 1;
  }

  #shopify-section-{{ section.id }} .blog-image img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition: .5s;
  }

  #shopify-section-{{ section.id }} .blog-image:hover img {
    transform: scale(1.08);
  }

  #shopify-section-{{ section.id }} .blog-overlay {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 35px;
    color: #fff;
    background: linear-gradient(to top, rgba(0, 0, 0, .75), rgba(0, 0, 0, .15), transparent);
    z-index: 3;
  }

  #shopify-section-{{ section.id }} .blog-overlay h3 {
    margin-bottom: 15px;
    font-size: 22px;
    font-weight: 500;
    color: #fff;
  }

  #shopify-section-{{ section.id }} .blog-overlay p {
    margin-bottom: 20px;
    font-size: 17px;
    line-height: 140%;
    font-weight: 400;
    color: #fff;
  }

  #shopify-section-{{ section.id }} .blog-overlay span {
    color: var(--theme-clr, #53C295);
    font-size: 17px;
    line-height: 35px;
    font-weight: 300;
  }

  #shopify-section-{{ section.id }} .blog-card {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 35px;
    padding: 25px 0;
    border-bottom: 1px solid #e8e8e8;
  }

  #shopify-section-{{ section.id }} .blog-content {
    flex: 1;
  }

  #shopify-section-{{ section.id }} .blog-content h3 {
    margin-bottom: 15px;
  }

  #shopify-section-{{ section.id }} .blog-content h3 a {
    color: inherit;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .blog-content h3 a:hover {
    color: var(--theme-clr, #53C295);
  }

  #shopify-section-{{ section.id }} .blog-content p {
    margin-bottom: 18px;
    font-size: 17px;
    line-height: 140%;
    font-weight: 400;
    color: #4b4b4b;
  }

  #shopify-section-{{ section.id }} .blog-content span {
    color: var(--theme-clr, #53C295);
    font-size: 17px;
    line-height: 35px;
    font-weight: 400;
  }

  #shopify-section-{{ section.id }} .blog-thumb {
    width: 170px;
    flex-shrink: 0;
    border-radius: 18px;
    overflow: hidden;
    display: block;
  }

  #shopify-section-{{ section.id }} .blog-thumb img {
    width: 100%;
    display: block;
    aspect-ratio: 1/1;
    object-fit: cover;
    transition: .5s;
  }

  #shopify-section-{{ section.id }} .blog-thumb:hover img {
    transform: scale(1.08);
  }

  #shopify-section-{{ section.id }} .blog-btn {
    margin-top: 70px;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .primary-btn {
    background: var(--theme-clr, #53C295);
    display: inline-flex;
    justify-content: center;
    align-items: center;
    border: 1px solid var(--theme-clr, #53C295);
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: 11px 60px;
    border-radius: 80px;
    font-size: 16px;
    font-family: var(--secondary-font);
    color: #fff;
    flex-shrink: 0;
    cursor: pointer;
    transition: all 0.5s ease-in-out;
    font-weight: 500;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .primary-btn:hover {
    color: var(--theme-clr, #53C295);
  }

  #shopify-section-{{ section.id }} .primary-btn::before {
    content: "";
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 0;
    height: 100%;
    background: #fff;
    transition: all 0.5s ease-in-out;
    z-index: -1;
  }

  #shopify-section-{{ section.id }} .primary-btn:hover::before {
    right: auto;
    left: 0;
    width: 100%;
  }

  @media (max-width: 992px) {
    #shopify-section-{{ section.id }} .blog-grid {
      flex-direction: column;
      gap: 40px;
    }
    #shopify-section-{{ section.id }} .featured-blog,
    #shopify-section-{{ section.id }} .blog-list {
      width: 100%;
    }
    #shopify-section-{{ section.id }} .blog-card {
      flex-direction: column-reverse;
      align-items: start;
      gap: 20px;
    }
    #shopify-section-{{ section.id }} .blog-thumb {
      width: 100%;
    }
  }
{% endstyle %}

