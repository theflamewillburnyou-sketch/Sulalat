<section class="shop-categories" data-section-id="{{ section.id }}">
  <style>
    .shop-categories[data-section-id="{{ section.id }}"] {
      padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
      background: {{ section.settings.background_color }};
      font-family: var(--body-font-family);
    }

    .shop-categories[data-section-id="{{ section.id }}"] .container {
      max-width: var(--brand-container-max, 1440px);
      margin: 0 auto;
      padding: 0 var(--brand-container-padding-x, 20px);
    }

    .shop-categories[data-section-id="{{ section.id }}"] .shop-categories__list {
      display: grid;
      grid-template-columns: repeat({{ section.settings.columns }}, minmax(0, 1fr));
      gap: clamp(16px, 2vw, 28px);
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .shop-categories[data-section-id="{{ section.id }}"] .shop-category-card {
      display: block;
      text-align: center;
      text-decoration: none;
      color: inherit;
    }

    .shop-categories[data-section-id="{{ section.id }}"] .shop-category-card__media {
      border-radius: 14px;
      overflow: hidden;
      background: #f3f3f3;
      aspect-ratio: 16 / 11;
      margin-bottom: 14px;
    }

    .shop-categories[data-section-id="{{ section.id }}"] .shop-category-card__media img,
    .shop-categories[data-section-id="{{ section.id }}"] .shop-category-card__media svg.placeholder-svg {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.45s ease;
    }

    .shop-categories[data-section-id="{{ section.id }}"] .shop-category-card:hover .shop-category-card__media img {
      transform: scale(1.04);
    }

    .shop-categories[data-section-id="{{ section.id }}"] .shop-category-card__title {
      margin: 0;
      color: #1a1a1a;
      font-size: clamp(15px, 1.3vw, 18px);
      line-height: 1.3;
      font-weight: 500;
    }

    @media (max-width: 991px) {
      .shop-categories[data-section-id="{{ section.id }}"] .shop-categories__list {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }

    @media (max-width: 749px) {
      .shop-categories[data-section-id="{{ section.id }}"] {
        padding: {{ section.settings.padding_top_mobile }}px 0 {{ section.settings.padding_bottom_mobile }}px;
      }

      .shop-categories[data-section-id="{{ section.id }}"] .shop-categories__list {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px 12px;
      }

      .shop-categories[data-section-id="{{ section.id }}"] .shop-category-card__media {
        border-radius: 12px;
      }
    }
  </style>

  {%- if section.blocks.size > 0 -%}
    <div class="container">
      <ul class="shop-categories__list">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}
              <a class="shop-category-card" href="{{ block.settings.link }}">
            {%- else -%}
              <div class="shop-category-card">
            {%- endif -%}
              <div class="shop-category-card__media">
                {%- if block.settings.image != blank -%}
                  {%- assign cat_alt = block.settings.image.alt | default: block.settings.title -%}
                  {{
                    block.settings.image
                    | image_url: width: 800
                    | image_tag:
                      loading: 'lazy',
                      widths: '280, 400, 560, 800',
                      sizes: '(min-width: 992px) 18vw, (min-width: 750px) 30vw, 45vw',
                      alt: cat_alt
                  }}
                {%- else -%}
                  {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </div>
              {%- if block.settings.title != blank -%}
                <h3 class="shop-category-card__title">{{ block.settings.title | escape }}</h3>
              {%- endif -%}
            {%- if block.settings.link != blank -%}
              </a>
            {%- else -%}
              </div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Shop categories",
  "tag": "section",
  "class": "shop-categories-section",
  "settings": [
    {
      "type": "range",
      "id": "columns",
      "min": 3,
      "max": 6,
      "step": 1,
      "label": "Columns (desktop)",
      "default": 5
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding top (mobile)",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom (mobile)",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Coffee"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop categories",
      "blocks": [
        { "type": "category", "settings": { "title": "Coffee" } },
        { "type": "category", "settings": { "title": "Chocolate" } },
        { "type": "category", "settings": { "title": "Capsules" } },
        { "type": "category", "settings": { "title": "Brewing Gear" } },
        { "type": "category", "settings": { "title": "Spare Parts" } }
      ]
    }
  ]
}
{% endschema %}
