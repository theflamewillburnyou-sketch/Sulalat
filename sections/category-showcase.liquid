<section
  class="categories-sec"
  data-section-id="{{ section.id }}"
  style="
    --categories-padding-bottom: {{ section.settings.section_padding_bottom }}px;
    --categories-padding-top: {{ section.settings.section_padding_top }}px;
    --categories-bg: {{ section.settings.section_bg_color }};
    --categories-heading-color: {{ section.settings.heading_color }};
    --categories-text-color: {{ section.settings.text_color }};
    --categories-card-text-color: {{ section.settings.card_text_color }};
    --categories-card-title-color: {{ section.settings.card_title_color }};
    --categories-link-color: {{ section.settings.link_color }};
    --categories-heading-size: {{ section.settings.heading_size }}px;
    --categories-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --categories-body-size: {{ section.settings.body_size }}px;
    --categories-card-title-size: {{ section.settings.card_title_size }}px;
    --categories-slide-width: {{ section.settings.slide_width }}px;
    --categories-gap: {{ section.settings.space_between }}px;
  "
>
  <style>
    .categories-sec[data-section-id="{{ section.id }}"] {
      overflow: hidden;
      padding-top: var(--categories-padding-top);
      padding-bottom: var(--categories-padding-bottom);
      background: var(--categories-bg);
    }

    .categories-sec[data-section-id="{{ section.id }}"] .container {
      max-width: var(--brand-container-max, 1440px);
      margin: 0 auto;
      padding: 0 var(--brand-container-padding-x, 20px);
    }

    .categories-sec[data-section-id="{{ section.id }}"] .section-title {
      text-align: center;
      margin-bottom: 60px;
      max-width: 950px;
      margin-inline: auto;
    }

    .categories-sec[data-section-id="{{ section.id }}"] .section-title h2 {
      color: var(--categories-heading-color);
      font-size: clamp(24px, 3vw, var(--categories-heading-size));
      font-weight: 400;
      margin-bottom: 30px;
      line-height: 1.2;
    }

    .categories-sec[data-section-id="{{ section.id }}"] .section-title p {
      color: var(--categories-text-color);
      font-size: var(--categories-body-size);
      line-height: 24px;
      letter-spacing: -0.01em;
      margin-top: 14px;
    }

    .categories-sec[data-section-id="{{ section.id }}"] .swiper.categorySlider {
      overflow: visible;
    }

    .categories-sec[data-section-id="{{ section.id }}"] .swiper.categorySlider .swiper-wrapper {
      align-items: start;
    }

    .categories-sec[data-section-id="{{ section.id }}"] .swiper.categorySlider .swiper-slide {
      width: var(--categories-slide-width);
      flex-shrink: 0;
    }

    .categories-sec[data-section-id="{{ section.id }}"] .category-card {
      transition: 0.35s;
    }

    .categories-sec[data-section-id="{{ section.id }}"] .category-card a {
      text-decoration: none;
      display: block;
      color: inherit;
    }

    .categories-sec[data-section-id="{{ section.id }}"] .category-img {
      overflow: hidden;
      border-radius: 12px;
      margin-bottom: 18px;
    }

    .categories-sec[data-section-id="{{ section.id }}"] .category-img img,
    .categories-sec[data-section-id="{{ section.id }}"] .category-img svg.placeholder-svg {
      width: 100%;
      display: block;
      object-fit: cover;
      transition: 0.5s;
      border-radius: inherit;
    }

    .categories-sec[data-section-id="{{ section.id }}"] .category-card h4 {
      font-size: var(--categories-card-title-size);
      margin-bottom: 2px;
      color: var(--categories-card-title-color);
      font-weight: 500;
      line-height: 1.3;
    }

    .categories-sec[data-section-id="{{ section.id }}"] .category-card p {
      color: var(--categories-card-text-color);
      font-size: var(--categories-body-size);
      line-height: 24px;
      letter-spacing: -0.01em;
      margin: 0;
    }

    .categories-sec[data-section-id="{{ section.id }}"] .view-all {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      height: 100%;
      min-height: 275px;
    }

    .categories-sec[data-section-id="{{ section.id }}"] .view-all a {
      text-decoration: none;
      color: #111;
      display: block;
    }

    .categories-sec[data-section-id="{{ section.id }}"] .view-all h4 {
      font-size: var(--categories-card-title-size);
      font-weight: 500;
      color: var(--categories-card-title-color);
      line-height: 1.3;
      margin: 0;
      white-space: pre-line;
    }

    .categories-sec[data-section-id="{{ section.id }}"] .view-all span {
      display: block;
      margin-top: 10px;
      color: var(--categories-link-color);
      font-size: 18px;
      font-weight: 500;
    }

    .categories-sec[data-section-id="{{ section.id }}"] .view-all span i,
    .categories-sec[data-section-id="{{ section.id }}"] .view-all svg {
      display: inline-block;
      vertical-align: middle;
      width: 20px;
      height: 20px;
      margin-left: 4px;
    }


    .category-card {
      position: relative;
    }

    .category-card > a {
      display: block;
      text-decoration: none;
      color: inherit;
    }

    .category-img {
      position: relative;
      overflow: hidden;
      border-radius: 20px;
    }

    .category-img::after {
      content: "";
      position: absolute;
      inset: 0;
      background: rgba(0, 0, 0, 0.12);
      opacity: 0;
      transition: opacity 0.5s ease;
      pointer-events: none;
    }

    .category-img img {
      display: block;
      width: 100%;
      transition: transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
      will-change: transform;
    }

    .category-card h4 {
      transition:
        transform 0.5s cubic-bezier(0.22, 1, 0.36, 1),
        color 0.4s ease;
    }

    .category-card p {
      transition:
        transform 0.5s cubic-bezier(0.22, 1, 0.36, 1),
        opacity 0.4s ease;
    }


    /* Hover */

    .category-card:hover .category-img img {
      transform: scale(1.06);
    }

    .category-card:hover .category-img::after {
      opacity: 1;
    }

    .category-card:hover h4 {
      transform: translateY(-3px);
    }

    .category-card:hover p {
      transform: translateY(-3px);
    }

    .category-img::before {
      content: "↗";
      position: absolute;
      right: 20px;
      bottom: 20px;
      width: 44px;
      height: 44px;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 1px solid rgba(255,255,255,0.8);
      border-radius: 50%;
      color: #fff;
      font-size: 20px;
      z-index: 2;
      opacity: 0;
      transform: translateY(15px) scale(0.8);
      transition:
        opacity 0.4s ease,
        transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .category-card:hover .category-img::before {
      opacity: 1;
      transform: translateY(0) scale(1);
    }

    @media (max-width: 1440px){
      .categories-sec[data-section-id="{{ section.id }}"] .category-card h4 {
        font-size: 18px;
      }
      .categories-sec[data-section-id="{{ section.id }}"] .category-card p {
        font-size: 15px;
      }
    
    }

    @media (max-width: 1200px){
      .categories-sec[data-section-id="{{ section.id }}"] .view-all h4 {
        font-size: 20px;
      }
    }


    @media (max-width: 767px) {
      .categories-sec[data-section-id="{{ section.id }}"]{
        padding-bottom:70px;
      }
      .categories-sec[data-section-id="{{ section.id }}"] .section-title h2 {
        font-size: var(--categories-heading-size-mobile);
      }

      .categories-sec[data-section-id="{{ section.id }}"] .section-title {
        margin-bottom: 40px;
      }

      .categories-sec[data-section-id="{{ section.id }}"] .swiper.categorySlider .swiper-slide {
        width: min(80vw, 300px);
      }
    }

    @media (max-width: 575px) {
      .categories-sec[data-section-id="{{ section.id }}"] .category-card h4 {
        font-size: 18px;
        margin-bottom:10px;
      }
      .categories-sec[data-section-id="{{ section.id }}"] .category-card p{
        font-size: 16px;
      }
      .categories-sec[data-section-id="{{ section.id }}"] .swiper.categorySlider .swiper-slide {
        width: min(45vw, 300px);
      }

      .categories-sec[data-section-id="{{ section.id }}"] .view-all h4 {
        font-size:20px;
      }
    }

    @media (max-width: 480px){
      .categories-sec[data-section-id="{{ section.id }}"] .swiper.categorySlider .swiper-slide {
        width: 185px;
      }
    }
  </style>

  <div class="container">
    <div class="section-title">
      <h2>{{ section.settings.heading | escape }}</h2>
      {% if section.settings.subheading != blank %}
        <p>{{ section.settings.subheading | escape }}</p>
      {% endif %}
    </div>

    <div class="swiper categorySlider" data-category-slider>
      <div class="swiper-wrapper">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'category' %}
              <div class="swiper-slide" {{ block.shopify_attributes }}>
                <div class="category-card">
                  <a href="{% if block.settings.link != blank %}{{ block.settings.link }}{% else %}#{% endif %}">
                    <div class="category-img">
                      {% if block.settings.image != blank %}
                        <img
                          src="{{ block.settings.image | image_url: width: 600 }}"
                          alt="{{ block.settings.image.alt | escape }}"
                          loading="lazy"
                        >
                      {% else %}
                        {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                      {% endif %}
                    </div>
                    <h4>{{ block.settings.title | escape }}</h4>
                    <p>{{ block.settings.text | escape }}</p>
                  </a>
                </div>
              </div>
            {% when 'view_all' %}
              <div class="swiper-slide" {{ block.shopify_attributes }}>
                <div class="view-all">
                  <a href="{% if block.settings.link != blank %}{{ block.settings.link }}{% else %}#{% endif %}">
                    <h4>{{ block.settings.heading | escape }}</h4>
                    <span>
                      {{ block.settings.text | escape }}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M7 17L17 7M17 7H8M17 7V16" />
                      </svg>
                    </span>
                  </a>
                </div>
              </div>
          {% endcase %}
        {% endfor %}
      </div>
    </div>
  </div>

  <script>
    (function () {
      var section = document.querySelector('[data-section-id="{{ section.id }}"]');
      if (!section) return;

      var sliderEl = section.querySelector('[data-category-slider]');
      if (!sliderEl) return;

      function loadSwiper(callback) {
        if (window.Swiper) {
          callback();
          return;
        }

        if (!document.querySelector('link[href*="swiper-bundle.min.css"]')) {
          var link = document.createElement('link');
          link.rel = 'stylesheet';
          link.href = 'https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css';
          document.head.appendChild(link);
        }

        var existing = document.querySelector('script[src*="swiper-bundle.min.js"]');
        if (existing) {
          existing.addEventListener('load', callback);
          if (window.Swiper) callback();
          return;
        }

        var script = document.createElement('script');
        script.src = 'https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js';
        script.onload = callback;
        document.head.appendChild(script);
      }

      function initSlider() {
        if (!window.Swiper) return;
        if (sliderEl.swiper) sliderEl.swiper.destroy(true, true);

        var gap = parseInt('{{ section.settings.space_between }}', 10);
        if (isNaN(gap) || gap <= 0) gap = 20;

        sliderEl.swiper = new window.Swiper(sliderEl, {
          slidesPerView: 'auto',
          spaceBetween: gap,
          freeMode: true,
          grabCursor: true,
          mousewheel: { forceToAxis: true },
          breakpoints: {
            0: { spaceBetween: Math.min(gap, 15) },
            768: { spaceBetween: gap },
            1200: { spaceBetween: gap }
          }
        });
      }

      loadSwiper(initSlider);

      document.addEventListener('shopify:section:load', function (e) {
        if (e.target && e.target.querySelector('[data-section-id="{{ section.id }}"]')) {
          section = document.querySelector('[data-section-id="{{ section.id }}"]');
          sliderEl = section ? section.querySelector('[data-category-slider]') : null;
          if (sliderEl) loadSwiper(initSlider);
        }
      });
    })();
  </script>
</section>

{% schema %}
{
