}

.shopify-section:has(#wls-list-root) .sulalat-dashboard__link:hover:not(#wls-list-root):not(#wls-list-root *),
.shopify-section:has(#wls-list-root) a.sulalat-dashboard__link:hover:not(#wls-list-root):not(#wls-list-root *) {
