{%- liquid
  assign heading = section.settings.heading | default: 'My Wishlist'
-%}

<section
  class="sulalat-wishlist-page"
  data-section-id="{{ section.id }}"
  style="
    --wl-pad-top: {{ section.settings.padding_top }}px;
    --wl-pad-bottom: {{ section.settings.padding_bottom }}px;
    --wl-pad-top-m: {{ section.settings.padding_top_mobile }}px;
    --wl-pad-bottom-m: {{ section.settings.padding_bottom_mobile }}px;
  "
>
  <div class="sulalat-wishlist-page__inner">
    {%- comment -%}
      When WishlistSuite (or another app block) is present it already renders its own
      page title — skip our duplicate heading so content sits cleanly under the header.
    {%- endcomment -%}
    {%- if section.blocks.size == 0 -%}
      <div class="sulalat-wishlist-page__header">
        <h1 class="sulalat-wishlist-page__title">{{ heading | escape }}</h1>
        {%- if section.settings.subtitle != blank -%}
          <p class="sulalat-wishlist-page__subtitle">{{ section.settings.subtitle | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}
    <div class="cst-wishlist-header">
      <div class="container">
        <div class="wishlist-header-wrap">
          <div class="section-title">
            <h2>My Wishlist</h2>
          </div>
          <div class="sulalat-wishlist-page__wishlist-actions">
            <button
              type="button"
              class="sulalat-wishlist-page__remove-all sulalat-btn--outline"
              data-wishlist-remove-all
            >
              Remove All
            </button>
      
            <button
              type="button"
              class="sulalat-wishlist-page__add-all primary-btn"
              data-wishlist-add-all
            >
              Add All To Cart
            </button>
          </div>
        </div>
      </div>
    </div>

    </div>

    <div class="sulalat-wishlist-page__app">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {% render block %}
        {%- endfor -%}
      {%- else -%}
        <div class="sulalat-wishlist-page__empty">
          <p>{{ section.settings.setup_text | escape }}</p>
        </div>
      {%- endif -%}
    </div>
  </div>

  <style>
/* =========================
   WishlistSuite - Figma Card
   ========================= */


#main-content 
.sulalat-wishlist-page[data-section-id="template--23011036102819__wishlist_page"].sulalat-wishlist-page-section
.sulalat-wishlist-page__inner {
    padding-top: 100px !important;
    padding-bottom: 100px !important;
    padding-block-start: 100px !important;
    padding-block-end: 100px !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
}

.sulalat-wishlist-page[data-section-id="template--23011036102819__wishlist_page"]{
  position:relative;
}

.sulalat-wishlist-page[data-section-id="template--23011036102819__wishlist_page"]::before {
    content: "";
    width: 100%;
    display: block;
    height: 100px;
}

.sulalat-wishlist-page[data-section-id="template--23011036102819__wishlist_page"]::after {
    content: "";
    width: 100%;
    display: block;
    height: 100px;
}

.sulalat-wishlist-page[data-section-id="{{ section.id }}"] .sulalat-wishlist-page__inner{
  margin-bottom:40px !important;
}
.sulalat-wishlist-page[data-section-id="{{ section.id }}"] .wishlist-header-wrap {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
}

.sulalat-wishlist-page[data-section-id="{{ section.id }}"] .wishlist-header-wrap .section-title{
  margin-right:20px;
}

.sulalat-wishlist-page__remove-all {
    margin-right: 10px;
}
.sulalat-wishlist-page__wishlist-actions button::before {
    border-radius: inherit;
}

.sulalat-wishlist-page[data-section-id="{{ section.id }}"] .sulalat-wishlist-page__wishlist-actions button {
    padding: 13px 20px !important;
    height: 40px;
    font-size: 16px;
    font-family: var(--secondary-font);
    line-height: 1.5;
}

.sulalat-wishlist-page[data-section-id="{{ section.id }}"] .wls-card-variant .wls-variant-select {
    max-width: 100%;
    padding: 7px 10px;
    font-size: 16px;
    border-color: var(--brand-primary);
    border-radius: 10px;
    background: var(--brand-primary);
    color: #fff;
    appearance: none;
    text-align: center;
    font-family: 'Roboto';
    font-weight: 400;
}
.sulalat-wishlist-page[data-section-id="{{ section.id }}"] .wls-item-menu-btn {
    position: absolute;
    top: 20px;
    right: 20px;
}

.sulalat-wishlist-page[data-section-id="{{ section.id }}"] .wls-header-container {
    display: none;
}
.sulalat-wishlist-page[data-section-id="{{ section.id }}"] .wls-action-bar {
  display: none !important;
}

.sulalat-wishlist-page[data-section-id="{{ section.id }}"] .wls-grid {
  display: grid !important;
  grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
  gap: 28px !important;
  padding: 0 !important;
  margin: 0 !important;
  list-style: none !important;
}

.sulalat-wishlist-page[data-section-id="{{ section.id }}"] .wls-grid-item {
  width: 100% !important;
  max-width: none !important;
  margin: 0 !important;
  padding: 0 !important;
}

.sulalat-wishlist-page[data-section-id="{{ section.id }}"] .wls-card-wrapper{
    max-width: 326px;
    margin: 0 auto;
}

.sulalat-wishlist-page[data-section-id="{{ section.id }}"] .wls-card-variant {
    position: absolute;
    top: 20px;
    left: 20px;
}

.sulalat-wishlist-page[data-section-id="{{ section.id }}"] .wls-card-wrapper,
.sulalat-wishlist-page[data-section-id="{{ section.id }}"] .wls-card {
  width: 100% !important;
  height: 100%;
}

.sulalat-wishlist-page[data-section-id="{{ section.id }}"] .wls-card {
  display: flex !important;
  flex-direction: column;
  background: transparent !important;
  border: 0 !important;
  border-radius: 0 !important;
  box-shadow: none !important;
  overflow: visible !important;
  position:relative;
}

/* Product image box */
.sulalat-wishlist-page[data-section-id="{{ section.id }}"] .wls-card-inner {
  position: relative;
  width: 100%;
}

.sulalat-wishlist-page[data-section-id="{{ section.id }}"] .wls-card-link {
  display: block;
  width: 100%;
  text-decoration: none;
}

.sulalat-wishlist-page[data-section-id="{{ section.id }}"] .wls-card-media {
  position: relative;
  width: 100%;
  aspect-ratio: 4 / 5.2;
  overflow: hidden;
  border: 1px solid #e2e2e2;
  border-radius: 10px;
  background: #f7f7f7;
}

.sulalat-wishlist-page[data-section-id="{{ section.id }}"] #wls-list-root .wls-card-img {
  display: block;
  width: 100% !important;
  height: 100% !important;
  object-fit: cover !important;
  transition: transform 0.45s ease;
}

.sulalat-wishlist-page[data-section-id="{{ section.id }}"]
.wls-card:hover .wls-card-img {
  transform: scale(1.025);
}

/* Price pill - top left */
.sulalat-wishlist-page[data-section-id="{{ section.id }}"] .wls-sale-badge {
  position: absolute !important;
  top: 16px !important;
  left: 16px !important;
  right: auto !important;
  z-index: 2;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  min-height: 32px;
  padding: 6px 14px;

  border: 0 !important;
  border-radius: 10px !important;
  background: #53c295 !important;
  color: #fff !important;

  font-size: 13px !important;
  font-weight: 600 !important;
  line-height: 1;
}

/* Remove button */
.sulalat-wishlist-page[data-section-id="{{ section.id }}"]
.wls-card-inner button:not(.wls-atc-btn),
.sulalat-wishlist-page[data-section-id="{{ section.id }}"]
.wls-card-inner .wls-remove-btn {
  border: 0;
}

/* Content */
.sulalat-wishlist-page[data-section-id="{{ section.id }}"] .wls-card-content {
  display: flex !important;
  flex-direction: column;
  flex: 1;
  padding: 18px 0 0 !important;
  background: transparent !important;
}

.sulalat-wishlist-page[data-section-id="{{ section.id }}"] .wls-card-info {
  flex: 1;
}

/* Vendor / small text */
.sulalat-wishlist-page[data-section-id="{{ section.id }}"] .wls-card-vendor {
  margin: 0 0 8px;
  color: #151515;
  font-size: 14px;
  font-weight: 400;
  line-height: 1.4;
}

/* Product title */
.sulalat-wishlist-page[data-section-id="{{ section.id }}"] .wls-card-title {
  margin: 0 0 10px !important;
  color: #111 !important;
  font-size: 20px !important;
  font-weight: 400 !important;
  line-height: 1.3 !important;
}

.sulalat-wishlist-page[data-section-id="{{ section.id }}"] .wls-card-title a {
  color: inherit !important;
  text-decoration: none !important;
}

/* Existing app price/variant text */
.sulalat-wishlist-page[data-section-id="{{ section.id }}"] .wls-card-price,
.sulalat-wishlist-page[data-section-id="{{ section.id }}"] .wls-card-variant {
  margin: 0 0 8px !important;
  color: #5f5f5f !important;
  font-size: 14px !important;
  line-height: 1.55 !important;
}

/* Actions */
.sulalat-wishlist-page[data-section-id="{{ section.id }}"] .wls-card-actions {
  margin-top: 20px !important;
}

/* Add to cart */
.sulalat-wishlist-page[data-section-id="{{ section.id }}"]
.wls-atc-btn.sulalat-btn--outline {
    display: inline-flex !important;
    align-items: center;
    justify-content: center;
    width: 100% !important;
    max-width:135px;
    margin: 0 !important;
    padding: 12px 20px !important;
    border: 1px solid #53c295 !important;
    border-radius: 999px !important;
    background: rgb(83 194 149 / 10%) !important;
    color: #36ad7d !important;
    font-size: 16px !important;
    font-weight: 400 !important;
    line-height: 1;
    cursor: pointer;
    transition: all 0.2s linear;
    font-family: var(--secondary-font);
    box-shadow: none;
    transform: none;
}

.sulalat-wishlist-page[data-section-id="{{ section.id }}"]
.wls-atc-btn.sulalat-btn--outline:hover {
  color: var(--brand-primary, #53c295);
}
.sulalat-wishlist-page[data-section-id="{{ section.id }}"] .wls-card-wrapper:hover {
    transform: translateY(0);
    box-shadow: none;
}

/* Tablet */
@media (max-width: 991px) {
  .sulalat-wishlist-page[data-section-id="{{ section.id }}"] .wls-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    gap: 24px 18px !important;
  }
}


@media (max-width: 767px){
  .sulalat-wishlist-page[data-section-id="template--23011036102819__wishlist_page"]::before,
  .sulalat-wishlist-page[data-section-id="template--23011036102819__wishlist_page"]::after {
      height: 70px;
  }
  
}

/* Mobile */
@media (max-width: 749px) {
  .sulalat-wishlist-page[data-section-id="{{ section.id }}"] .wls-card-title {
    font-size: 18px !important;
  }

  .sulalat-wishlist-page[data-section-id="{{ section.id }}"] .wls-sale-badge {
    top: 12px !important;
    left: 12px !important;
  }
}

@media (max-width: 575px){
  .sulalat-wishlist-page[data-section-id="{{ section.id }}"] .wls-grid {
    grid-template-columns: 1fr !important;
    gap: 28px !important;
  }
  .sulalat-wishlist-page[data-section-id="{{ section.id }}"] .wishlist-header-wrap .section-title{
    height: 50px;
  }

}
  </style>

  <script>
  document.addEventListener('DOMContentLoaded', function () {
    const wishlistApp = document.querySelector(
      '.sulalat-wishlist-page[data-section-id="{{ section.id }}"]'
    );

    if (!wishlistApp) return;

    function addPrimaryBtnClass() {
      wishlistApp.querySelectorAll('.wls-atc-btn').forEach(function (btn) {
        btn.classList.add('sulalat-btn--outline');
      });
    }

    // If wishlist cards are already rendered
    addPrimaryBtnClass();

    // Wishlist app may render/re-render cards dynamically
    const observer = new MutationObserver(function () {
      addPrimaryBtnClass();
    });

    observer.observe(wishlistApp, {
      childList: true,
      subtree: true
    });
  });
</script>
</section>

{% schema %}
{
  "name": "Wishlist page",
  "tag": "section",
  "class": "sulalat-wishlist-page-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "My Wishlist"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Save your favorite products for later"
    },
    {
      "type": "textarea",
      "id": "setup_text",
      "label": "Setup message",
      "default": "Add the WishlistSuite wishlist block here in the theme editor (Add block → Apps → WishlistSuite).",
      "info": "Shown only until an app block is added."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding top (mobile)",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom (mobile)",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Wishlist page"
    }
  ]
}
{% endschema %}
