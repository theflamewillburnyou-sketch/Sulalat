{%- liquid
  assign heading = section.settings.heading | default: 'My Wishlist'
  assign customer_level = customer.metafields.custom.level.value | default: customer.metafields.custom.level | default: section.settings.default_level

  assign dashboard_url = section.settings.dashboard_url | default: '/pages/dashboard'
  if pages.dashboard != blank and section.settings.dashboard_url == blank
    assign dashboard_url = pages.dashboard.url
  endif

  assign wishlist_url = request.path | default: '/pages/wishlist'
  if pages.wishlist != blank
    assign wishlist_url = pages.wishlist.url
  endif

  assign subscriptions_url = section.settings.subscriptions_portal_url | default: 'https://shopify.com/69340233891/account/pages/6971b1a1-27f6-4c27-b8b0-3009fd3b921d'
-%}

<section
  class="sulalat-wishlist-page"
  data-section-id="{{ section.id }}"
  data-wishlist-account-page
  style="
    --wl-pad-top: {{ section.settings.padding_top }}px;
    --wl-pad-bottom: {{ section.settings.padding_bottom }}px;
    --wl-pad-top-m: {{ section.settings.padding_top_mobile }}px;
    --wl-pad-bottom-m: {{ section.settings.padding_bottom_mobile }}px;
  "
>
  <div class="container sulalat-wishlist-page__container">
    <div class="sulalat-wishlist-page__layout" data-wishlist-layout>
      <div class="sulalat-wishlist-page__sidebar-slot" data-wishlist-sidebar-slot>
        {% render 'account-sidebar',
          active: 'wishlist',
          mode: 'links',
          customer_level: customer_level,
          dashboard_url: dashboard_url,
          wishlist_url: wishlist_url,
          subscriptions_url: subscriptions_url
        %}
      </div>

      <div class="sulalat-wishlist-page__main" data-wishlist-main>
        <div class="sulalat-wishlist-page__inner">
          {%- if section.blocks.size == 0 -%}
            <div class="sulalat-wishlist-page__header">
              <h1 class="sulalat-wishlist-page__title">{{ heading | escape }}</h1>
              {%- if section.settings.subtitle != blank -%}
                <p class="sulalat-wishlist-page__subtitle">{{ section.settings.subtitle | escape }}</p>
              {%- endif -%}
            </div>
          {%- endif -%}

          <div class="cst-wishlist-header">
            <div class="wishlist-header-wrap">
              <div class="section-title">
                <h2>My Wishlist</h2>
              </div>
              <div class="sulalat-wishlist-page__wishlist-actions">
                <button
                  type="button"
                  class="sulalat-wishlist-page__remove-all sulalat-btn--outline"
                  data-wishlist-remove-all
                >
                  Remove All
                </button>

                <button
                  type="button"
                  class="sulalat-wishlist-page__add-all primary-btn"
                  data-wishlist-add-all
                >
                  Add All To Cart
                </button>
              </div>
            </div>
          </div>

          <div class="sulalat-wishlist-page__app">
            {%- if section.blocks.size > 0 -%}
              {%- for block in section.blocks -%}
                {% render block %}
              {%- endfor -%}
            {%- else -%}
              <div class="sulalat-wishlist-page__empty">
                <p>{{ section.settings.setup_text | escape }}</p>
              </div>
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>
  </div>

  <style>
/* =========================================================
   Wishlist account shell
   Sidebar is moved OUTSIDE .shopify-section:has(#wls-list-root)
   so WishlistSuite's section-wide reset cannot break the layout.
   ========================================================= */

.sulalat-wishlist-account {
  padding: var(--wl-pad-top, 48px) 0 var(--wl-pad-bottom, 80px);
  background: #fff;
}

.sulalat-wishlist-account > .container {
  width: 100%;
  max-width: 1600px;
  margin: 0 auto;
  padding: 0 100px;
  box-sizing: border-box;
}

.sulalat-wishlist-account__layout {
  display: grid;
  grid-template-columns: 313px minmax(0, 1fr);
  gap: 50px;
  align-items: start;
  width: 100%;
}

.sulalat-wishlist-account__layout > .sulalat-dashboard__sidebar {
  width: 313px;
  max-width: 313px;
  background: #fff;
  border: 1px solid #e6e6e6;
  border-radius: 0 12px 12px 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
}

.sulalat-wishlist-account__layout > .sulalat-dashboard__sidebar .sulalat-dashboard__nav {
  display: flex;
  flex-direction: column;
  gap: 2px;
  margin: 0;
  padding: 0;
  list-style: none;
  flex: 1 1 auto;
}

.sulalat-wishlist-account__layout > .sulalat-dashboard__sidebar .sulalat-dashboard__nav > li {
  margin: 0;
  padding: 0;
  list-style: none;
}

.sulalat-wishlist-account__layout > .sulalat-dashboard__sidebar .sulalat-dashboard__link {
  position: relative;
  display: flex;
  align-items: center;
  gap: 12px;
  width: 100%;
  min-height: 48px;
  padding: 16px 15px;
  border: 0;
  background: transparent;
  color: #808080;
  text-decoration: none;
  font-size: 17px;
  font-weight: 400;
  line-height: 1.3;
  font-family: inherit;
  text-align: start;
  cursor: pointer;
  letter-spacing: 0.03em;
  box-sizing: border-box;
  transition: background 0.2s ease, color 0.2s ease;
}

.sulalat-wishlist-account__layout > .sulalat-dashboard__sidebar .sulalat-dashboard__link svg {
  width: 20px;
  height: 20px;
  flex-shrink: 0;
}

.sulalat-wishlist-account__layout > .sulalat-dashboard__sidebar .sulalat-dashboard__link.is-active {
  background: #e8f6ef;
  color: var(--brand-primary, #53c295);
}

.sulalat-wishlist-account__layout > .sulalat-dashboard__sidebar .sulalat-dashboard__link.is-active::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 2.5px;
  border-radius: 0 3px 3px 0;
  background: var(--brand-primary, #53c295);
}

.sulalat-wishlist-account__layout > .sulalat-dashboard__sidebar .sulalat-dashboard__link:hover {
  color: var(--brand-primary, #53c295);
}

.sulalat-wishlist-account__layout > .sulalat-dashboard__sidebar .sulalat-dashboard__level {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin: 20px 10px 10px;
  padding: 14px 20px;
  border: 1px solid #e6e6e6;
  border-radius: 12px;
  background: #fff;
  box-shadow: 0px 1px 4px 0px rgba(25, 33, 61, 0.08);
  box-sizing: border-box;
}

.sulalat-wishlist-account__layout > .sulalat-dashboard__sidebar .sulalat-dashboard__level-label {
  margin: 0;
  color: #000;
  font-size: 17px;
  font-weight: 500;
  letter-spacing: 0.03em;
}

.sulalat-wishlist-account__layout > .sulalat-dashboard__sidebar .sulalat-dashboard__level-value {
  margin: 0;
  color: #1a1a1a;
  font-size: 25px;
  font-weight: 700;
  line-height: 1;
  letter-spacing: 0.03em;
}

.sulalat-wishlist-account__layout > .shopify-section {
  min-width: 0;
  width: 100%;
  max-width: 100%;
}

.sulalat-wishlist-account__layout > .shopify-section .sulalat-wishlist-page {
  padding: 0 !important;
}

.sulalat-wishlist-account__layout > .shopify-section .sulalat-wishlist-page__container {
  width: 100% !important;
  max-width: none !important;
  margin: 0 !important;
  padding: 0 !important;
}

.sulalat-wishlist-account__layout > .shopify-section .sulalat-wishlist-page__layout {
  display: block !important;
}

.sulalat-wishlist-account__layout > .shopify-section .sulalat-wishlist-page__sidebar-slot {
  display: none !important;
}

.sulalat-wishlist-account__layout > .shopify-section .sulalat-wishlist-page__main {
  width: 100% !important;
  min-width: 0 !important;
  max-width: 100% !important;
  overflow: hidden !important;
}

/* Fallback before JS runs */
.sulalat-wishlist-page[data-section-id="{{ section.id }}"] {
  position: relative;
  padding: var(--wl-pad-top) 0 var(--wl-pad-bottom);
  background: #fff;
  font-family: var(--body-font-family);
  color: #1a1a1a;
}

.sulalat-wishlist-page[data-section-id="{{ section.id }}"] > .sulalat-wishlist-page__container {
  width: 100%;
  max-width: 1600px;
  margin: 0 auto;
  padding: 0 100px;
  box-sizing: border-box;
}

.sulalat-wishlist-page[data-section-id="{{ section.id }}"] .sulalat-wishlist-page__layout {
  display: grid;
  grid-template-columns: 313px minmax(0, 1fr);
  gap: 50px;
  align-items: start;
}

.sulalat-wishlist-page[data-section-id="{{ section.id }}"] .sulalat-wishlist-page__main {
  min-width: 0;
  overflow: hidden;
}

/* Undo WishlistSuite reset on header chrome still inside the section */
.shopify-section:has(#wls-list-root) .cst-wishlist-header:not(#wls-list-root):not(#wls-list-root *),
.shopify-section:has(#wls-list-root) .cst-wishlist-header *:not(#wls-list-root):not(#wls-list-root *),
.shopify-section:has(#wls-list-root) .wishlist-header-wrap:not(#wls-list-root):not(#wls-list-root *),
.shopify-section:has(#wls-list-root) .wishlist-header-wrap *:not(#wls-list-root):not(#wls-list-root *),
.shopify-section:has(#wls-list-root) .sulalat-wishlist-page__wishlist-actions:not(#wls-list-root):not(#wls-list-root *),
.shopify-section:has(#wls-list-root) .sulalat-wishlist-page__wishlist-actions *:not(#wls-list-root):not(#wls-list-root *),
.shopify-section:has(#wls-list-root) .sulalat-wishlist-page__app:not(#wls-list-root):not(#wls-list-root *),
.shopify-section:has(#wls-list-root) .sulalat-wishlist-page__inner:not(#wls-list-root):not(#wls-list-root *),
.shopify-section:has(#wls-list-root) .sulalat-wishlist-page__main:not(#wls-list-root):not(#wls-list-root *) {
  all: revert !important;
}

.shopify-section:has(#wls-list-root) .sulalat-wishlist-page__main:not(#wls-list-root):not(#wls-list-root *),
.shopify-section:has(#wls-list-root) .sulalat-wishlist-page__app:not(#wls-list-root):not(#wls-list-root *),
.shopify-section:has(#wls-list-root) .sulalat-wishlist-page__inner:not(#wls-list-root):not(#wls-list-root *) {
  display: block !important;
  width: 100% !important;
  max-width: 100% !important;
  min-width: 0 !important;
  overflow: hidden !important;
  box-sizing: border-box !important;
  position: relative !important;
}

.shopify-section:has(#wls-list-root) #wls-list-root {
  position: relative !important;
  left: auto !important;
  right: auto !important;
  width: 100% !important;
  max-width: 100% !important;
  margin: 0 !important;
  box-sizing: border-box !important;
}

/* Header row: title left, actions right */
.shopify-section:has(#wls-list-root) .wishlist-header-wrap:not(#wls-list-root):not(#wls-list-root *) {
  display: flex !important;
  flex-wrap: wrap !important;
  justify-content: space-between !important;
  align-items: center !important;
  gap: 24px !important;
  margin: 0 0 32px !important;
  width: 100% !important;
  box-sizing: border-box !important;
}

.shopify-section:has(#wls-list-root) .wishlist-header-wrap .section-title:not(#wls-list-root):not(#wls-list-root *),
.shopify-section:has(#wls-list-root) .wishlist-header-wrap .section-title h2:not(#wls-list-root):not(#wls-list-root *) {
  margin: 0 !important;
  font-size: clamp(22px, 3vw, 30px) !important;
  font-weight: 400 !important;
  line-height: 1.1 !important;
  color: #000 !important;
  letter-spacing: -0.02em !important;
}

.shopify-section:has(#wls-list-root) .sulalat-wishlist-page__wishlist-actions:not(#wls-list-root):not(#wls-list-root *) {
  display: flex !important;
  flex-wrap: wrap !important;
  align-items: center !important;
  gap: 12px !important;
}

.shopify-section:has(#wls-list-root) .sulalat-wishlist-page__remove-all:not(#wls-list-root):not(#wls-list-root *) {
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  min-height: 40px !important;
  padding: 10px 22px !important;
  border: 1px solid #53c295 !important;
  border-radius: 999px !important;
  background: rgb(83 194 149 / 10%) !important;
  color: #36ad7d !important;
  font-size: 16px !important;
  font-family: var(--secondary-font) !important;
  font-weight: 400 !important;
  line-height: 1.2 !important;
  cursor: pointer !important;
  box-shadow: none !important;
  position:relative !important;
  isolation: isolate !important;
  transition: all 0.2s linear !important;
}

.shopify-section:has(#wls-list-root) .sulalat-wishlist-page__remove-all:not(#wls-list-root):not(#wls-list-root *)::before{
  border-radius: inherit;
}

.shopify-section:has(#wls-list-root) .sulalat-wishlist-page__add-all:not(#wls-list-root):not(#wls-list-root *) {
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  min-height: 40px !important;
  padding: 10px 22px !important;
  border: 1px solid #53c295 !important;
  border-radius: 999px !important;
  background: #53c295 !important;
  color: #fff !important;
  font-size: 16px !important;
  font-family: var(--secondary-font) !important;
  font-weight: 400 !important;
  line-height: 1.2 !important;
  cursor: pointer !important;
  box-shadow: none !important;
  position:relative !important;
  isolation: isolate !important;
  transition: all 0.2s linear !important;
}


.shopify-section:has(#wls-list-root) .sulalat-wishlist-page__add-all:not(#wls-list-root):not(#wls-list-root *)::before{
  border-radius: inherit;
}

.shopify-section:has(#wls-list-root) .sulalat-wishlist-page__add-all:not(#wls-list-root):not(#wls-list-root *):hover{
  color:#53c295 !important;
}
/* =========================
   WishlistSuite - Figma Card
   ========================= */

.sulalat-wishlist-page[data-section-id="{{ section.id }}"] .wls-header-container,
.sulalat-wishlist-page[data-section-id="{{ section.id }}"] .wls-action-bar {
  display: none !important;
}

.sulalat-wishlist-page[data-section-id="{{ section.id }}"] .wls-grid {
  display: grid !important;
  grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
  gap: 28px !important;
  padding: 0 !important;
  margin: 0 !important;
  list-style: none !important;
  width: 100% !important;
  max-width: 100% !important;
  box-sizing: border-box !important;
}

.sulalat-wishlist-page[data-section-id="{{ section.id }}"] .wls-grid-item {
  width: 100% !important;
  max-width: none !important;
  margin: 0 !important;
  padding: 0 !important;
}

.sulalat-wishlist-page[data-section-id="{{ section.id }}"] .wls-card-wrapper {
  max-width: 326px;
  margin: 0 auto;
}

.sulalat-wishlist-page[data-section-id="{{ section.id }}"] .wls-card-variant {
  position: absolute;
  top: 20px;
  left: 20px;
}

.sulalat-wishlist-page[data-section-id="{{ section.id }}"] .wls-card-wrapper,
.sulalat-wishlist-page[data-section-id="{{ section.id }}"] .wls-card {
  width: 100% !important;
  height: 100%;
}

.sulalat-wishlist-page[data-section-id="{{ section.id }}"] .wls-card {
  display: flex !important;
  flex-direction: column;
  background: transparent !important;
  border: 0 !important;
  border-radius: 0 !important;
  box-shadow: none !important;
  overflow: visible !important;
  position: relative;
}

.sulalat-wishlist-page[data-section-id="{{ section.id }}"] .wls-card-inner {
  position: relative;
  width: 100%;
}

.sulalat-wishlist-page[data-section-id="{{ section.id }}"] .wls-card-link {
