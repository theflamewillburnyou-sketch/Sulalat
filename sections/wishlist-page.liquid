{%- liquid
  assign heading = section.settings.heading | default: 'My Wishlist'
  assign customer_level = customer.metafields.custom.level.value | default: customer.metafields.custom.level | default: section.settings.default_level

  assign dashboard_url = section.settings.dashboard_url | default: '/pages/dashboard'
  if pages.dashboard != blank and section.settings.dashboard_url == blank
    assign dashboard_url = pages.dashboard.url
  endif

  assign wishlist_url = request.path | default: '/pages/wishlist'
  if pages.wishlist != blank
    assign wishlist_url = pages.wishlist.url
  endif

  assign subscriptions_url = section.settings.subscriptions_portal_url | default: 'https://shopify.com/69340233891/account/pages/6971b1a1-27f6-4c27-b8b0-3009fd3b921d'
-%}

<section
  class="sulalat-wishlist-page"
  data-section-id="{{ section.id }}"
  style="
    --wl-pad-top: {{ section.settings.padding_top }}px;
    --wl-pad-bottom: {{ section.settings.padding_bottom }}px;
    --wl-pad-top-m: {{ section.settings.padding_top_mobile }}px;
    --wl-pad-bottom-m: {{ section.settings.padding_bottom_mobile }}px;
  "
>
  {{ 'account-sidebar.css' | asset_url | stylesheet_tag }}
  <div class="container">
    <div class="sulalat-dashboard__layout">
      {% render 'account-sidebar',
        active: 'wishlist',
        mode: 'links',
        customer_level: customer_level,
        dashboard_url: dashboard_url,
        wishlist_url: wishlist_url,
        subscriptions_url: subscriptions_url
      %}

      <div class="sulalat-dashboard__main">
        <div class="sulalat-wishlist-page__inner">
          {%- comment -%}
            When WishlistSuite (or another app block) is present it already renders its own
            page title — skip our duplicate heading so content sits cleanly under the header.
          {%- endcomment -%}
          {%- if section.blocks.size == 0 -%}
            <div class="sulalat-wishlist-page__header">
              <h1 class="sulalat-wishlist-page__title">{{ heading | escape }}</h1>
              {%- if section.settings.subtitle != blank -%}
                <p class="sulalat-wishlist-page__subtitle">{{ section.settings.subtitle | escape }}</p>
              {%- endif -%}
            </div>
          {%- endif -%}

          <div class="cst-wishlist-header">
            <div class="wishlist-header-wrap">
              <div class="section-title">
                <h2>My Wishlist</h2>
              </div>
              <div class="sulalat-wishlist-page__wishlist-actions">
                <button
                  type="button"
                  class="sulalat-wishlist-page__remove-all sulalat-btn--outline"
                  data-wishlist-remove-all
                >
                  Remove All
                </button>

                <button
                  type="button"
                  class="sulalat-wishlist-page__add-all primary-btn"
                  data-wishlist-add-all
                >
                  Add All To Cart
                </button>
              </div>
            </div>
          </div>

          <div class="sulalat-wishlist-page__app">
            {%- if section.blocks.size > 0 -%}
              {%- for block in section.blocks -%}
                {% render block %}
              {%- endfor -%}
            {%- else -%}
              <div class="sulalat-wishlist-page__empty">
                <p>{{ section.settings.setup_text | escape }}</p>
              </div>
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>
  </div>

  <style>
/* =========================
   Undo WishlistSuite reset:
   .shopify-section:has(#wls-list-root) *:not(#wls-list-root):not(#wls-list-root *)
   Match that ID-level specificity so sidebar chrome can style again.
   ========================= */

.shopify-section:has(#wls-list-root) .sulalat-dashboard__layout:not(#wls-list-root):not(#wls-list-root *),
.shopify-section:has(#wls-list-root) .sulalat-dashboard__sidebar:not(#wls-list-root):not(#wls-list-root *),
.shopify-section:has(#wls-list-root) .sulalat-dashboard__sidebar *:not(#wls-list-root):not(#wls-list-root *),
.shopify-section:has(#wls-list-root) .sulalat-dashboard__main:not(#wls-list-root):not(#wls-list-root *),
.shopify-section:has(#wls-list-root) .sulalat-wishlist-page__inner:not(#wls-list-root):not(#wls-list-root *),
.shopify-section:has(#wls-list-root) .cst-wishlist-header:not(#wls-list-root):not(#wls-list-root *),
.shopify-section:has(#wls-list-root) .cst-wishlist-header *:not(#wls-list-root):not(#wls-list-root *),
.shopify-section:has(#wls-list-root) .wishlist-header-wrap:not(#wls-list-root):not(#wls-list-root *),
.shopify-section:has(#wls-list-root) .wishlist-header-wrap *:not(#wls-list-root):not(#wls-list-root *),
.shopify-section:has(#wls-list-root) .sulalat-wishlist-page__wishlist-actions:not(#wls-list-root):not(#wls-list-root *),
.shopify-section:has(#wls-list-root) .sulalat-wishlist-page__wishlist-actions *:not(#wls-list-root):not(#wls-list-root *),
.shopify-section:has(#wls-list-root) .sulalat-wishlist-page__app:not(#wls-list-root):not(#wls-list-root *),
.shopify-section:has(#wls-list-root) .sulalat-wishlist-page:not(#wls-list-root):not(#wls-list-root *) {
  all: revert !important;
}

.sulalat-wishlist-page[data-section-id="{{ section.id }}"] {
  position: relative;
  padding: var(--wl-pad-top) 0 var(--wl-pad-bottom);
  background: #fff;
  font-family: var(--body-font-family);
  color: #1a1a1a;
}

/* Keep page inside the site container (do not revert .container) */
.shopify-section:has(#wls-list-root) .sulalat-wishlist-page > .container:not(#wls-list-root):not(#wls-list-root *) {
  width: 100% !important;
  max-width: 1600px !important;
  margin-left: auto !important;
  margin-right: auto !important;
  padding-left: 100px !important;
  padding-right: 100px !important;
  box-sizing: border-box !important;
}

.shopify-section:has(#wls-list-root) .sulalat-dashboard__layout:not(#wls-list-root):not(#wls-list-root *) {
  display: grid !important;
  grid-template-columns: 313px minmax(0, 1fr) !important;
  grid-template-rows: auto !important;
  gap: 50px !important;
  align-items: start !important;
  width: 100% !important;
  box-sizing: border-box !important;
}

.shopify-section:has(#wls-list-root) .sulalat-dashboard__sidebar:not(#wls-list-root):not(#wls-list-root *) {
  width: 313px !important;
  min-width: 313px !important;
  max-width: 313px !important;
  flex: 0 0 313px !important;
  background: #fff !important;
  border: 1px solid #e6e6e6 !important;
  border-radius: 0 12px 12px 0 !important;
  display: flex !important;
  flex-direction: column !important;
  overflow: hidden !important;
  box-sizing: border-box !important;
}

.shopify-section:has(#wls-list-root) .sulalat-dashboard__nav:not(#wls-list-root):not(#wls-list-root *) {
  display: flex !important;
  flex-direction: column !important;
  gap: 2px !important;
  margin: 0 !important;
  padding: 0 !important;
  list-style: none !important;
  flex: 1 1 auto !important;
}

.shopify-section:has(#wls-list-root) .sulalat-dashboard__nav > li:not(#wls-list-root):not(#wls-list-root *) {
  margin: 0 !important;
  padding: 0 !important;
  list-style: none !important;
}

.shopify-section:has(#wls-list-root) .sulalat-dashboard__link:not(#wls-list-root):not(#wls-list-root *),
.shopify-section:has(#wls-list-root) a.sulalat-dashboard__link:not(#wls-list-root):not(#wls-list-root *) {
  position: relative !important;
  display: flex !important;
  align-items: center !important;
  gap: 12px !important;
  width: 100% !important;
  min-height: 48px !important;
  padding: 16px 15px !important;
  border: 0 !important;
  background: transparent !important;
  color: #808080 !important;
