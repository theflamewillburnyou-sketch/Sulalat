}

.sulalat-wishlist-page[data-section-id="{{ section.id }}"] .wls-card-title a {
  color: inherit !important;
  text-decoration: none !important;
}

.sulalat-wishlist-page[data-section-id="{{ section.id }}"] .wls-card-price,
.sulalat-wishlist-page[data-section-id="{{ section.id }}"] .wls-card-variant {
  margin: 0 0 8px !important;
  color: #5f5f5f !important;
  font-size: 14px !important;
  line-height: 1.55 !important;
}

.sulalat-wishlist-page[data-section-id="{{ section.id }}"] .wls-card-variant .wls-variant-select {
  max-width: 100%;
  padding: 7px 10px;
  font-size: 16px;
  border-color: var(--brand-primary);
  border-radius: 10px;
  background: var(--brand-primary);
  color: #fff;
  appearance: none;
  text-align: center;
  font-family: 'Roboto';
  font-weight: 400;
}

.sulalat-wishlist-page[data-section-id="{{ section.id }}"] .wls-card-actions {
  margin-top: 20px !important;
}

.sulalat-wishlist-page[data-section-id="{{ section.id }}"]
.wls-atc-btn.sulalat-btn--outline {
  display: inline-flex !important;
  align-items: center;
  justify-content: center;
  width: 100% !important;
  max-width: 135px;
  margin: 0 !important;
  padding: 12px 20px !important;
  border: 1px solid #53c295 !important;
  border-radius: 999px !important;
  background: rgb(83 194 149 / 10%) !important;
  color: #36ad7d !important;
  font-size: 16px !important;
  font-weight: 400 !important;
  line-height: 1;
  cursor: pointer;
  transition: all 0.2s linear;
  font-family: var(--secondary-font);
  box-shadow: none;
  transform: none;
}

.sulalat-wishlist-page[data-section-id="{{ section.id }}"]
.wls-atc-btn.sulalat-btn--outline:hover {
  color: var(--brand-primary, #53c295);
}

.sulalat-wishlist-page[data-section-id="{{ section.id }}"] .wls-card-wrapper:hover {
  transform: translateY(0);
  box-shadow: none;
}

@media (max-width: 1199px) {
  .sulalat-wishlist-account > .container,
  .sulalat-wishlist-page[data-section-id="{{ section.id }}"] > .sulalat-wishlist-page__container {
    padding: 0 30px;
  }
}

@media (max-width: 991px) {
  .sulalat-wishlist-account {
    padding: var(--wl-pad-top-m, 28px) 0 var(--wl-pad-bottom-m, 48px);
  }

  .sulalat-wishlist-account > .container,
  .sulalat-wishlist-page[data-section-id="{{ section.id }}"] > .sulalat-wishlist-page__container {
    padding: 0 20px;
  }

  .sulalat-wishlist-account__layout,
  .sulalat-wishlist-page[data-section-id="{{ section.id }}"] .sulalat-wishlist-page__layout {
    grid-template-columns: 1fr;
    gap: 28px;
  }

  .sulalat-wishlist-account__layout > .sulalat-dashboard__sidebar {
    width: 100%;
    max-width: none;
  }

  .sulalat-wishlist-page[data-section-id="{{ section.id }}"] .wls-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    gap: 24px 18px !important;
  }
}

@media (max-width: 749px) {
  .sulalat-wishlist-page[data-section-id="{{ section.id }}"] {
    padding: var(--wl-pad-top-m) 0 var(--wl-pad-bottom-m);
  }

  .sulalat-wishlist-page[data-section-id="{{ section.id }}"] .wls-card-title {
    font-size: 18px !important;
  }

  .sulalat-wishlist-page[data-section-id="{{ section.id }}"] .wls-sale-badge {
    top: 12px !important;
    left: 12px !important;
  }
}

@media (max-width: 575px) {
  .sulalat-wishlist-page[data-section-id="{{ section.id }}"] .wls-grid {
    grid-template-columns: 1fr !important;
    gap: 28px !important;
  }
}
  </style>

  <script>
  document.addEventListener('DOMContentLoaded', function () {
    var page = document.querySelector(
      '.sulalat-wishlist-page[data-section-id="{{ section.id }}"]'
    );
    if (!page) return;

    var sectionEl = page.closest('.shopify-section');
    var sidebar = page.querySelector('[data-wishlist-sidebar-slot] .sulalat-dashboard__sidebar');

    // Lift sidebar outside the WishlistSuite section so its reset cannot break layout.
    if (sectionEl && sidebar && !document.querySelector('.sulalat-wishlist-account')) {
      var padTop = getComputedStyle(page).getPropertyValue('--wl-pad-top').trim() || '48px';
      var padBottom = getComputedStyle(page).getPropertyValue('--wl-pad-bottom').trim() || '80px';
      var padTopM = getComputedStyle(page).getPropertyValue('--wl-pad-top-m').trim() || '28px';
      var padBottomM = getComputedStyle(page).getPropertyValue('--wl-pad-bottom-m').trim() || '48px';

      var shell = document.createElement('div');
      shell.className = 'sulalat-wishlist-account';
      shell.style.setProperty('--wl-pad-top', padTop);
      shell.style.setProperty('--wl-pad-bottom', padBottom);
      shell.style.setProperty('--wl-pad-top-m', padTopM);
      shell.style.setProperty('--wl-pad-bottom-m', padBottomM);

      var container = document.createElement('div');
      container.className = 'container';

      var layout = document.createElement('div');
      layout.className = 'sulalat-wishlist-account__layout';

      sectionEl.parentNode.insertBefore(shell, sectionEl);
      shell.appendChild(container);
      container.appendChild(layout);
      layout.appendChild(sidebar);
      layout.appendChild(sectionEl);

      var slot = page.querySelector('[data-wishlist-sidebar-slot]');
      if (slot) slot.remove();
    }

    function addPrimaryBtnClass() {
      page.querySelectorAll('.wls-atc-btn').forEach(function (btn) {
        btn.classList.add('sulalat-btn--outline');
      });
    }

    addPrimaryBtnClass();

    var observer = new MutationObserver(function () {
      addPrimaryBtnClass();
    });

    observer.observe(page, {
      childList: true,
      subtree: true
    });
  });
</script>
</section>

{% schema %}
{
  "name": "Wishlist page",
