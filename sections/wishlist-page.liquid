}

.shopify-section:has(#wls-list-root) .sulalat-dashboard__main:not(#wls-list-root):not(#wls-list-root *) {
  padding-top: 4px !important;
  min-width: 0 !important;
}

.sulalat-wishlist-page[data-section-id="{{ section.id }}"] .sulalat-wishlist-page__inner {
  margin-bottom: 0 !important;
  padding: 0 !important;
}

/* =========================
