}

.shopify-section:has(#wls-list-root) .sulalat-dashboard__level:not(#wls-list-root):not(#wls-list-root *) {
  display: flex !important;
  align-items: center !important;
  justify-content: space-between !important;
  gap: 12px !important;
  margin: 20px 10px 10px !important;
  padding: 14px 20px !important;
  border: 1px solid #e6e6e6 !important;
  border-radius: 12px !important;
  background: #fff !important;
  box-shadow: 0px 1px 4px 0px rgba(25, 33, 61, 0.08) !important;
  box-sizing: border-box !important;
}

.shopify-section:has(#wls-list-root) .sulalat-dashboard__level-label:not(#wls-list-root):not(#wls-list-root *) {
  margin: 0 !important;
  color: #000 !important;
  font-size: 17px !important;
  font-weight: 500 !important;
  letter-spacing: 0.03em !important;
  line-height: 1.3 !important;
}

.shopify-section:has(#wls-list-root) .sulalat-dashboard__level-value:not(#wls-list-root):not(#wls-list-root *) {
  margin: 0 !important;
  color: #1a1a1a !important;
  font-size: 25px !important;
