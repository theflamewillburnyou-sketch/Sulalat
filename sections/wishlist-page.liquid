    padding-left: 20px !important;
    padding-right: 20px !important;
  }

  .shopify-section:has(#wls-list-root) .sulalat-dashboard__layout:not(#wls-list-root):not(#wls-list-root *) {
    grid-template-columns: 1fr !important;
    gap: 28px !important;
  }

  .shopify-section:has(#wls-list-root) .sulalat-dashboard__sidebar:not(#wls-list-root):not(#wls-list-root *) {
