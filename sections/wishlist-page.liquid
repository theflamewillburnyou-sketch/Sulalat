{%- liquid
  assign heading = section.settings.heading | default: 'My Wishlist'
-%}

<section
  class="sulalat-wishlist-page"
  data-section-id="{{ section.id }}"
  style="
    --wl-pad-top: {{ section.settings.padding_top }}px;
    --wl-pad-bottom: {{ section.settings.padding_bottom }}px;
    --wl-pad-top-m: {{ section.settings.padding_top_mobile }}px;
    --wl-pad-bottom-m: {{ section.settings.padding_bottom_mobile }}px;
  "
>
  <div class="sulalat-wishlist-page__inner">
    {%- comment -%}
      When WishlistSuite (or another app block) is present it already renders its own
      page title — skip our duplicate heading so content sits cleanly under the header.
    {%- endcomment -%}
    {%- if section.blocks.size == 0 -%}
      <div class="sulalat-wishlist-page__header">
        <h1 class="sulalat-wishlist-page__title">{{ heading | escape }}</h1>
        {%- if section.settings.subtitle != blank -%}
          <p class="sulalat-wishlist-page__subtitle">{{ section.settings.subtitle | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="sulalat-wishlist-page__app">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {% render block %}
        {%- endfor -%}
      {%- else -%}
        <div class="sulalat-wishlist-page__empty">
          <p>{{ section.settings.setup_text | escape }}</p>
        </div>
      {%- endif -%}
    </div>
  </div>

  <style>
    .sulalat-wishlist-page[data-section-id="{{ section.id }}"] {
      padding: var(--wl-pad-top) 0 var(--wl-pad-bottom);
      background: #fff;
      position: relative;
      z-index: 0;
    }

    .sulalat-wishlist-page[data-section-id="{{ section.id }}"] .sulalat-wishlist-page__inner {
      width: min(1200px, calc(100% - 40px));
      margin: 0 auto;
    }

    .sulalat-wishlist-page[data-section-id="{{ section.id }}"] .sulalat-wishlist-page__header {
      margin-bottom: 28px;
    }

    .sulalat-wishlist-page[data-section-id="{{ section.id }}"] .sulalat-wishlist-page__title {
      margin: 0 0 8px;
      color: #1a1a1a;
      font-size: clamp(28px, 3vw, 36px);
      font-weight: 700;
      line-height: 1.2;
    }

    .sulalat-wishlist-page[data-section-id="{{ section.id }}"] .sulalat-wishlist-page__subtitle {
      margin: 0;
      color: #666;
      font-size: 15px;
      line-height: 1.5;
    }

    .sulalat-wishlist-page[data-section-id="{{ section.id }}"] .sulalat-wishlist-page__app {
      min-height: 200px;
    }

    /* Keep app-injected wishlist UI in normal document flow under the sticky header */
    .sulalat-wishlist-page[data-section-id="{{ section.id }}"] .sulalat-wishlist-page__app > * {
      position: relative !important;
      top: auto !important;
      margin-top: 0 !important;
    }

    .sulalat-wishlist-page[data-section-id="{{ section.id }}"] .sulalat-wishlist-page__empty {
      padding: 40px 24px;
      border: 1px solid #ececec;
      border-radius: 16px;
      color: #666;
      font-size: 14px;
      line-height: 1.55;
      text-align: center;
    }

    @media (max-width: 749px) {
      .sulalat-wishlist-page[data-section-id="{{ section.id }}"] {
        padding: var(--wl-pad-top-m) 0 var(--wl-pad-bottom-m);
      }
    }
  </style>
</section>

{% schema %}
{
  "name": "Wishlist page",
  "tag": "section",
  "class": "sulalat-wishlist-page-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "My Wishlist"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Save your favorite products for later"
    },
    {
      "type": "textarea",
      "id": "setup_text",
      "label": "Setup message",
      "default": "Add the WishlistSuite wishlist block here in the theme editor (Add block → Apps → WishlistSuite).",
      "info": "Shown only until an app block is added."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding top (mobile)",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom (mobile)",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Wishlist page"
    }
  ]
}
{% endschema %}
