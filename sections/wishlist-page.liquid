  font-size: 17px !important;
  font-weight: 400 !important;
  line-height: 1.3 !important;
  font-family: inherit !important;
  text-align: start !important;
  cursor: pointer !important;
  letter-spacing: 0.03em !important;
  box-sizing: border-box !important;
  box-shadow: none !important;
  opacity: 1 !important;
  transition: background 0.2s ease, color 0.2s ease !important;
}

.shopify-section:has(#wls-list-root) .sulalat-dashboard__link svg:not(#wls-list-root):not(#wls-list-root *) {
  width: 20px !important;
  height: 20px !important;
  flex-shrink: 0 !important;
  display: block !important;
}

.shopify-section:has(#wls-list-root) .sulalat-dashboard__link.is-active:not(#wls-list-root):not(#wls-list-root *),
.shopify-section:has(#wls-list-root) a.sulalat-dashboard__link.is-active:not(#wls-list-root):not(#wls-list-root *) {
  background: #e8f6ef !important;
  color: var(--brand-primary, #53c295) !important;
}

.shopify-section:has(#wls-list-root) .sulalat-dashboard__link.is-active:not(#wls-list-root):not(#wls-list-root *)::before,
.shopify-section:has(#wls-list-root) a.sulalat-dashboard__link.is-active:not(#wls-list-root):not(#wls-list-root *)::before {
  content: '' !important;
  position: absolute !important;
  left: 0 !important;
  top: 0 !important;
  bottom: 0 !important;
