{%- liquid
  assign collection = section.settings.collection
  assign products_limit = section.settings.products_to_show | default: 6
  assign heading = section.settings.heading | default: collection.title | default: 'Specialty Coffee'
  assign banner_heading = section.settings.banner_heading | default: heading
-%}

<section class="shop-category-products" data-section-id="{{ section.id }}">
  <style>
    .shop-category-products[data-section-id="{{ section.id }}"] {
      padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
      background: {{ section.settings.background_color }};
      font-family: var(--body-font-family);
      color: #1a1a1a;
    }

    .shop-category-products[data-section-id="{{ section.id }}"] .container {
      max-width: var(--brand-container-max, 1440px);
      margin: 0 auto;
      padding: 0 var(--brand-container-padding-x, 20px);
    }

    .shop-category-products[data-section-id="{{ section.id }}"] .shop-category-products__banner {
      position: relative;
      overflow: hidden;
      border-radius: 16px;
      min-height: {{ section.settings.banner_height }}px;
      display: flex;
      align-items: center;
      margin-bottom: clamp(36px, 4vw, 56px);
      background: #1a1a1a;
    }

    .shop-category-products[data-section-id="{{ section.id }}"] .shop-category-products__banner-media {
      position: absolute;
      inset: 0;
    }

    .shop-category-products[data-section-id="{{ section.id }}"] .shop-category-products__banner-media img,
    .shop-category-products[data-section-id="{{ section.id }}"] .shop-category-products__banner-media svg.placeholder-svg {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .shop-category-products[data-section-id="{{ section.id }}"] .shop-category-products__banner-shade {
      position: absolute;
      inset: 0;
      background: {{ section.settings.banner_overlay }};
      pointer-events: none;
    }

    .shop-category-products[data-section-id="{{ section.id }}"] .shop-category-products__banner-content {
      position: relative;
      z-index: 2;
      padding: clamp(28px, 5vw, 56px);
      max-width: 560px;
      color: #fff;
    }

    .shop-category-products[data-section-id="{{ section.id }}"] .shop-category-products__banner-content h2 {
      margin: 0 0 18px;
      color: #fff;
      font-size: clamp(32px, 4vw, 52px);
      line-height: 1.15;
      font-weight: 600;
    }

    .shop-category-products[data-section-id="{{ section.id }}"] .shop-category-products__banner-btn,
    .shop-category-products[data-section-id="{{ section.id }}"] .shop-category-products__view-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 44px;
      padding: 10px 24px;
      border-radius: 999px;
      background: var(--brand-primary, #53c295);
      border: 1px solid var(--brand-primary, #53c295);
      color: #fff;
      font-size: 15px;
      font-weight: 500;
      font-family: inherit;
      text-decoration: none;
      transition: 0.25s ease;
    }

    .shop-category-products[data-section-id="{{ section.id }}"] .shop-category-products__banner-btn:hover,
    .shop-category-products[data-section-id="{{ section.id }}"] .shop-category-products__view-btn:hover {
      background: var(--brand-primary-hover, #45ad82);
      border-color: var(--brand-primary-hover, #45ad82);
    }

    .shop-category-products[data-section-id="{{ section.id }}"] .shop-category-products__header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 28px;
    }

    .shop-category-products[data-section-id="{{ section.id }}"] .shop-category-products__header h2 {
      margin: 0;
      color: #1a1a1a;
      font-size: clamp(28px, 3vw, 40px);
      line-height: 1.2;
      font-weight: 600;
    }

    .shop-category-products[data-section-id="{{ section.id }}"] .shop-category-products__grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 36px 28px;
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .shop-category-products[data-section-id="{{ section.id }}"] .sulalat-product-card {
      display: flex;
      flex-direction: column;
      height: 100%;
    }

    .shop-category-products[data-section-id="{{ section.id }}"] .sulalat-product-card__media {
      position: relative;
      display: block;
      border-radius: 20px;
      overflow: hidden;
      aspect-ratio: 4 / 5;
      text-decoration: none;
      background: #53c295;
    }

    .shop-category-products[data-section-id="{{ section.id }}"] .sulalat-product-card--magenta .sulalat-product-card__media {
      background: #c44d8a;
    }

    .shop-category-products[data-section-id="{{ section.id }}"] .sulalat-product-card--beige .sulalat-product-card__media {
      background: #cbb79a;
    }

    .shop-category-products[data-section-id="{{ section.id }}"] .sulalat-product-card__image {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .shop-category-products[data-section-id="{{ section.id }}"] .sulalat-product-card__icon {
      position: absolute;
      inset: 0 0 56px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: rgba(255, 255, 255, 0.92);
    }

    .shop-category-products[data-section-id="{{ section.id }}"] .sulalat-product-card__icon svg {
      width: 72px;
      height: 72px;
    }

    .shop-category-products[data-section-id="{{ section.id }}"] .sulalat-product-card__band {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      min-height: 48px;
      padding: 10px 16px;
      background: rgba(255, 255, 255, 0.92);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 2px;
      text-align: center;
    }

    .shop-category-products[data-section-id="{{ section.id }}"] .sulalat-product-card__band-ar,
    .shop-category-products[data-section-id="{{ section.id }}"] .sulalat-product-card__band-en {
      font-size: 13px;
      line-height: 1.3;
      color: #111;
    }

    .shop-category-products[data-section-id="{{ section.id }}"] .sulalat-product-card__body {
      padding-top: 18px;
      text-align: center;
      display: flex;
      flex-direction: column;
      flex: 1;
    }

    .shop-category-products[data-section-id="{{ section.id }}"] .sulalat-product-card__title {
      margin: 0 0 8px;
      font-size: 20px;
      line-height: 1.3;
      font-weight: 600;
    }

    .shop-category-products[data-section-id="{{ section.id }}"] .sulalat-product-card__title a {
      color: #000;
      text-decoration: none;
    }

    .shop-category-products[data-section-id="{{ section.id }}"] .sulalat-product-card__desc {
      margin: 0 0 12px;
      font-size: 14px;
      line-height: 1.45;
      color: #8a8a8a;
    }

    .shop-category-products[data-section-id="{{ section.id }}"] .sulalat-product-card__price {
      margin: 0 0 18px;
      font-size: 18px;
      line-height: 1.3;
      font-weight: 600;
      color: #000;
    }

    .shop-category-products[data-section-id="{{ section.id }}"] .sulalat-product-card__price s {
      margin-right: 8px;
      color: #9a9a9a;
      font-weight: 400;
    }

    .shop-category-products[data-section-id="{{ section.id }}"] .sulalat-product-card__actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      margin-top: auto;
    }

    .shop-category-products[data-section-id="{{ section.id }}"] .sulalat-product-card__form {
      display: contents;
    }

    .shop-category-products[data-section-id="{{ section.id }}"] .sulalat-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 44px;
      padding: 10px 14px;
      border-radius: 999px;
      font-size: 14px;
      font-weight: 500;
      font-family: inherit;
      text-decoration: none;
      cursor: pointer;
      transition: 0.25s ease;
      text-align: center;
    }

    .shop-category-products[data-section-id="{{ section.id }}"] .sulalat-btn--primary {
      background: var(--brand-primary, #53c295);
      border: 1px solid var(--brand-primary, #53c295);
      color: #fff;
    }

    .shop-category-products[data-section-id="{{ section.id }}"] .sulalat-btn--primary:hover {
      background: var(--brand-primary-hover, #45ad82);
      border-color: var(--brand-primary-hover, #45ad82);
    }

    .shop-category-products[data-section-id="{{ section.id }}"] .sulalat-btn--outline {
      background: #fff;
      border: 1px solid var(--brand-primary, #53c295);
      color: var(--brand-primary, #53c295);
    }

    .shop-category-products[data-section-id="{{ section.id }}"] .sulalat-btn--outline:hover {
      background: var(--brand-primary, #53c295);
      color: #fff;
    }

    .shop-category-products[data-section-id="{{ section.id }}"] .sulalat-btn.is-disabled {
      opacity: 0.5;
      cursor: not-allowed;
      pointer-events: none;
    }

    .shop-category-products[data-section-id="{{ section.id }}"] .shop-category-products__empty {
      text-align: center;
      padding: 40px 20px;
      color: #666;
      font-size: 15px;
    }

    @media (max-width: 991px) {
      .shop-category-products[data-section-id="{{ section.id }}"] .shop-category-products__grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 28px 18px;
      }
    }

    @media (max-width: 749px) {
      .shop-category-products[data-section-id="{{ section.id }}"] {
        padding: {{ section.settings.padding_top_mobile }}px 0 {{ section.settings.padding_bottom_mobile }}px;
      }

      .shop-category-products[data-section-id="{{ section.id }}"] .shop-category-products__banner {
        min-height: {{ section.settings.banner_height_mobile }}px;
        border-radius: 12px;
        margin-bottom: 28px;
      }

      .shop-category-products[data-section-id="{{ section.id }}"] .shop-category-products__header {
        flex-direction: column;
        align-items: flex-start;
      }

      .shop-category-products[data-section-id="{{ section.id }}"] .shop-category-products__grid {
        grid-template-columns: 1fr;
      }

      .shop-category-products[data-section-id="{{ section.id }}"] .sulalat-product-card__actions {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <div class="container">
    <div class="shop-category-products__banner">
      <div class="shop-category-products__banner-media" aria-hidden="true">
        {%- if section.settings.banner_image != blank -%}
          {{
            section.settings.banner_image
            | image_url: width: 2000
            | image_tag:
              loading: 'lazy',
              widths: '800, 1200, 1600, 2000',
              sizes: '100vw',
              alt: ''
          }}
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
      <div class="shop-category-products__banner-shade" aria-hidden="true"></div>
      <div class="shop-category-products__banner-content">
        {%- if banner_heading != blank -%}
          <h2>{{ banner_heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.banner_button_label != blank -%}
          <a
            class="shop-category-products__banner-btn"
            href="{{ section.settings.banner_button_link | default: collection.url | default: '#' }}"
          >
            {{ section.settings.banner_button_label | escape }}
          </a>
        {%- endif -%}
      </div>
    </div>

    <div class="shop-category-products__header">
      {%- if heading != blank -%}
        <h2>{{ heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.view_products_label != blank -%}
        <a
          class="shop-category-products__view-btn"
          href="{{ section.settings.view_products_link | default: collection.url | default: '#' }}"
        >
          {{ section.settings.view_products_label | escape }}
        </a>
      {%- endif -%}
    </div>

    {%- if collection != blank and collection.products_count > 0 -%}
      <ul class="shop-category-products__grid">
        {%- for product in collection.products limit: products_limit -%}
          <li>
            {% render 'sulalat-product-card',
              product: product,
              collection: collection,
              color_index: forloop.index0,
              section_id: section.id,
              details_label: 'View Product'
            %}
          </li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <p class="shop-category-products__empty">
        {{ section.settings.empty_text | default: 'Select a collection to show products here.' | escape }}
      </p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Shop category products",
  "tag": "section",
  "class": "shop-category-products-section",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 3,
      "max": 12,
      "step": 1,
      "label": "Products to show",
      "default": 6
    },
    {
      "type": "header",
      "content": "Banner"
    },
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Banner image"
    },
    {
      "type": "text",
      "id": "banner_heading",
      "label": "Banner heading",
      "default": "Specialty Coffee"
    },
    {
      "type": "text",
      "id": "banner_button_label",
      "label": "Banner button label",
      "default": "Discover More"
    },
    {
      "type": "url",
      "id": "banner_button_link",
      "label": "Banner button link",
      "info": "Defaults to the selected collection."
    },
    {
      "type": "color",
      "id": "banner_overlay",
      "label": "Banner overlay",
      "default": "#00000066"
    },
    {
      "type": "range",
      "id": "banner_height",
      "min": 220,
      "max": 520,
      "step": 10,
      "unit": "px",
      "label": "Banner height",
      "default": 340
    },
    {
      "type": "range",
      "id": "banner_height_mobile",
      "min": 180,
      "max": 420,
      "step": 10,
      "unit": "px",
      "label": "Banner height (mobile)",
      "default": 240
    },
    {
      "type": "header",
      "content": "Products header"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Specialty Coffee"
    },
    {
      "type": "text",
      "id": "view_products_label",
      "label": "View products label",
      "default": "View Products"
    },
    {
      "type": "url",
      "id": "view_products_link",
      "label": "View products link",
      "info": "Defaults to the selected collection."
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Empty message",
      "default": "Select a collection to show products here."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding top (mobile)",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom (mobile)",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Shop category products"
    }
  ]
}
{% endschema %}
