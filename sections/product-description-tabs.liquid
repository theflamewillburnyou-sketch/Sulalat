{%- liquid
  assign rating_count = product.metafields.reviews.rating_count.value | default: product.metafields.reviews.rating_count | plus: 0
  assign review_blocks = section.blocks | where: 'type', 'review'
  assign review_rating_sum = 0
  if review_blocks.size > 0
    assign rating_count = review_blocks.size
    for review_block in review_blocks
      assign review_rating_sum = review_rating_sum | plus: review_block.settings.rating
    endfor
  endif

  assign brand_value = product.vendor
  assign sku_value = product.selected_or_first_available_variant.sku
  assign category_value = product.type
  if category_value == blank and product.collections.size > 0
    assign category_value = product.collections.first.title
  endif

  assign show_meta = false
  if section.settings.show_brand and brand_value != blank
    assign show_meta = true
  endif
  if section.settings.show_sku and sku_value != blank
    assign show_meta = true
  endif
  if section.settings.show_category and category_value != blank
    assign show_meta = true
  endif

  assign has_spr_reviews = false
  if product.metafields.spr.reviews != blank
    assign has_spr_reviews = true
  endif
-%}

{%- if product.description != blank or section.settings.show_reviews or request.design_mode -%}
<script src="{{ 'tabs.js' | asset_url }}" defer="defer"></script>

{%- if section.settings.show_reviews and section.settings.custom_reviews == blank and has_spr_reviews -%}
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      if (document.getElementById('shopify-product-reviews')) {
        const link = document.createElement('link');
        link.rel = 'stylesheet';
        link.href = "{{ 'reviews.css' | asset_url }}";
        document.body.appendChild(link);
      }
    }, { once: true });
  </script>
{%- endif -%}

<section
  class="sulalat-desc-tabs"
  data-section-id="{{ section.id }}"
  style="
    --sdt-pad-top: {{ section.settings.padding_top }}px;
    --sdt-pad-bottom: {{ section.settings.padding_bottom }}px;
    --sdt-bg: {{ section.settings.background_color }};
    --sdt-accent: {{ section.settings.accent_color }};
    --sdt-tab-bg: {{ section.settings.tab_bar_background }};
  "
>
  <style>
    .sulalat-desc-tabs[data-section-id="{{ section.id }}"] {
      padding: var(--sdt-pad-top) 0 var(--sdt-pad-bottom);
      background: var(--sdt-bg);
      font-family: var(--body-font-family);
      color: #1a1a1a;
    }

    .sulalat-desc-tabs[data-section-id="{{ section.id }}"] .container {
      max-width: var(--brand-container-max, 1440px);
      margin: 0 auto;
      padding: 0 var(--brand-container-padding-x, 20px);
    }

    .sulalat-desc-tabs[data-section-id="{{ section.id }}"] .sulalat-desc-tabs__inner {
      max-width: 920px;
    }

    .sulalat-desc-tabs[data-section-id="{{ section.id }}"] .tablist {
      margin-bottom: 60px;
    }

    .sulalat-desc-tabs[data-section-id="{{ section.id }}"] .tablist::after {
      display: none;
    }

    .sulalat-desc-tabs[data-section-id="{{ section.id }}"] .tablist__scroller {
      gap: 0;
      border-bottom: 1px solid #e8e8e8;
      max-width: 530px;
    }

    .sulalat-desc-tabs[data-section-id="{{ section.id }}"] .tablist__tab {
      appearance: none;
      background: none;
      border: none;
      border-bottom: 2px solid transparent;
      padding: 30px 15px;
      margin: 0;
      cursor: pointer;
      font-family: var(--body-font-family);
      font-size: 17px;
      line-height: 1;
      font-weight: 400;
      color: #000;
      transition: color 0.25s ease, border-color 0.25s ease;
      position: relative;
      width: 100%;
      max-width: 266px;
      isolation: isolate;
      text-decoration: none;
    }

    .sulalat-desc-tabs[data-section-id="{{ section.id }}"] .tablist__tab::before {
      content: "";
      position: absolute;
      background: linear-gradient(
          180deg,
          rgba(238, 249, 244, 0) 0%,
          rgba(238, 249, 244, 1) 100%
        );
      inset: 0;
      z-index: -1;
      transition: all 0.2s linear;
      opacity: 0;
    }

    .sulalat-desc-tabs[data-section-id="{{ section.id }}"] .tablist__tab[aria-selected='true']::before {
      opacity: 1;
    }

    .sulalat-desc-tabs[data-section-id="{{ section.id }}"] .tablist__tab[aria-selected='true'] {
      color: #53C295;
      border-bottom-color: var(--brand-primary, #53c295);
    } 

    .sulalat-desc-tabs[data-section-id="{{ section.id }}"] .sulalat-desc-tabs__copy {
      margin: 0 0 45px;
      color: #141211;
      font-size: 16px;
      line-height: 1.7;
    }

    .sulalat-desc-tabs[data-section-id="{{ section.id }}"] .sulalat-desc-tabs__copy p {
      margin: 0 0 1em;
    }

    .sulalat-desc-tabs[data-section-id="{{ section.id }}"] .sulalat-desc-tabs__copy p:last-child {
      margin-bottom: 0;
    }

    .sulalat-desc-tabs[data-section-id="{{ section.id }}"] .sulalat-desc-tabs__meta {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      gap: 12px;
    }

    .sulalat-desc-tabs[data-section-id="{{ section.id }}"] .sulalat-desc-tabs__meta-row {
      display: grid;
      grid-template-columns: 120px minmax(0, 1fr);
      gap: 25px 50px;
      align-items: baseline;
    }

    .sulalat-desc-tabs[data-section-id="{{ section.id }}"] .sulalat-desc-tabs__meta-label {
      margin: 0;
      font-size: 18px;
      font-weight: 700;
      color: #141211;
      letter-spacing: 0.01em;
    }

    .sulalat-desc-tabs[data-section-id="{{ section.id }}"] .sulalat-desc-tabs__meta-value {
      margin: 0;
      font-size: 16px;
      font-weight: 400;
      color: #141211;
      word-break: break-word;
    }

    .sulalat-desc-tabs[data-section-id="{{ section.id }}"] .sulalat-desc-tabs__reviews {
      min-height: 40px;
    }

    .sulalat-desc-tabs[data-section-id="{{ section.id }}"] .sulalat-reviews-list {
      display: grid;
      gap: 20px;
    }

    .sulalat-desc-tabs[data-section-id="{{ section.id }}"] .sulalat-reviews-list__item {
      padding: 20px 0;
      border-bottom: 1px solid #ebebeb;
    }

    .sulalat-desc-tabs[data-section-id="{{ section.id }}"] .sulalat-reviews-list__item:first-child {
      padding-top: 0;
    }

    .sulalat-desc-tabs[data-section-id="{{ section.id }}"] .sulalat-reviews-list__item:last-child {
      border-bottom: 0;
      padding-bottom: 0;
    }

    .sulalat-desc-tabs[data-section-id="{{ section.id }}"] .sulalat-reviews-list__stars {
      display: inline-flex;
      gap: 2px;
      margin-bottom: 8px;
      color: var(--sdt-accent, #53c295);
    }

    .sulalat-desc-tabs[data-section-id="{{ section.id }}"] .sulalat-reviews-list__stars svg.is-empty {
      color: #d9d9d9;
    }

    .sulalat-desc-tabs[data-section-id="{{ section.id }}"] .sulalat-reviews-list__title {
      margin: 0 0 6px;
      font-size: 16px;
      font-weight: 600;
      color: #141211;
    }

    .sulalat-desc-tabs[data-section-id="{{ section.id }}"] .sulalat-reviews-list__meta {
      margin: 0 0 10px;
      font-size: 13px;
      color: #828282;
    }

    .sulalat-desc-tabs[data-section-id="{{ section.id }}"] .sulalat-reviews-list__body {
      margin: 0;
      font-size: 15px;
      line-height: 1.6;
      color: #141211;
    }

    .sulalat-desc-tabs[data-section-id="{{ section.id }}"] .sulalat-reviews-list__empty {
      margin: 0;
      font-size: 15px;
      color: #828282;
    }

    @media screen and (max-width: 749px) {
      .sulalat-desc-tabs[data-section-id="{{ section.id }}"] {
        padding-top: {{ section.settings.padding_top_mobile }}px;
        padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
      }

      .sulalat-desc-tabs[data-section-id="{{ section.id }}"] .tablist__tab {
        padding: 12px 18px;
        font-size: 14px;
      }

      .sulalat-desc-tabs[data-section-id="{{ section.id }}"] .sulalat-desc-tabs__meta-row {
        grid-template-columns: 100px minmax(0, 1fr);
        gap: 8px 16px;
      }
    }

     @media (max-width: 575px){
       .sulalat-desc-tabs[data-section-id="{{ section.id }}"] .sulalat-desc-tabs__copy {
        font-size: 15px;
      }
      .sulalat-desc-tabs[data-section-id="{{ section.id }}"] .tablist {
        margin-bottom: 30px;
      }

    }
  </style>

  <div class="container">
    <div class="sulalat-desc-tabs__inner">
      <tabbed-content>
        <div class="tablist overflow-hidden relative no-js-hidden">
          <div class="tablist__scroller flex" role="tablist">
            {%- if product.description != blank or request.design_mode -%}
              <button
                type="button"
                class="tablist__tab"
                id="sulalat-desc-tab-{{ section.id }}"
                role="tab"
                aria-controls="sulalat-desc-panel-{{ section.id }}"
                aria-selected="true"
              >
                {{ section.settings.description_label | escape }}
              </button>
            {%- endif -%}

            {%- if section.settings.show_reviews -%}
              <button
                type="button"
                class="tablist__tab"
                id="sulalat-reviews-tab-{{ section.id }}"
                role="tab"
                aria-controls="sulalat-reviews-panel-{{ section.id }}"
                aria-selected="{% if product.description == blank and request.design_mode == false %}true{% else %}false{% endif %}"
              >
                {{ section.settings.reviews_label | escape }}{% if rating_count > 0 %} ({{ rating_count }}){% endif %}
              </button>
            {%- endif -%}
          </div>
        </div>

        {%- if product.description != blank or request.design_mode -%}
          <div
            id="sulalat-desc-panel-{{ section.id }}"
            role="tabpanel"
            tabindex="0"
            aria-labelledby="sulalat-desc-tab-{{ section.id }}"
          >
            <div class="sulalat-desc-tabs__copy rte">
              {%- if product.description != blank -%}
                {{ product.description }}
              {%- elsif request.design_mode -%}
                <p>Add a product description in the Shopify admin to show it here.</p>
              {%- endif -%}
            </div>

            {%- if show_meta -%}
              <ul class="sulalat-desc-tabs__meta">
                {%- if section.settings.show_brand and brand_value != blank -%}
                  <li class="sulalat-desc-tabs__meta-row">
                    <span class="sulalat-desc-tabs__meta-label">{{ section.settings.brand_label | escape }}</span>
                    <span class="sulalat-desc-tabs__meta-value">{{ brand_value | escape }}</span>
                  </li>
                {%- endif -%}
                {%- if section.settings.show_sku and sku_value != blank -%}
                  <li class="sulalat-desc-tabs__meta-row">
                    <span class="sulalat-desc-tabs__meta-label">{{ section.settings.sku_label | escape }}</span>
                    <span class="sulalat-desc-tabs__meta-value">{{ sku_value | escape }}</span>
                  </li>
                {%- endif -%}
                {%- if section.settings.show_category and category_value != blank -%}
                  <li class="sulalat-desc-tabs__meta-row">
                    <span class="sulalat-desc-tabs__meta-label">{{ section.settings.category_label | escape }}</span>
                    <span class="sulalat-desc-tabs__meta-value">{{ category_value | escape }}</span>
                  </li>
                {%- endif -%}
              </ul>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.settings.show_reviews -%}
          <div
            id="sulalat-reviews-panel-{{ section.id }}"
            role="tabpanel"
            tabindex="0"
            aria-labelledby="sulalat-reviews-tab-{{ section.id }}"
            {% if product.description != blank or request.design_mode %}hidden{% endif %}
          >
            <div class="sulalat-desc-tabs__reviews">
              {%- if section.settings.custom_reviews != blank -%}
                {{ section.settings.custom_reviews }}
              {%- elsif has_spr_reviews -%}
                <div class="spr-reviews" id="shopify-product-reviews" data-id="{{ product.id }}">
                  {{ product.metafields.spr.reviews }}
                </div>
              {%- elsif review_blocks.size > 0 -%}
                <div
                  class="sulalat-reviews-list"
                  data-sulalat-reviews-source
                  data-count="{{ review_blocks.size }}"
                  data-rating-sum="{{ review_rating_sum }}"
                >
                  {%- for block in review_blocks -%}
                    {%- liquid
                      assign review_rating = block.settings.rating | default: 5
                      if review_rating < 1
                        assign review_rating = 1
                      endif
                      if review_rating > 5
                        assign review_rating = 5
                      endif
                    -%}
                    <article class="sulalat-reviews-list__item" data-rating="{{ review_rating }}" {{ block.shopify_attributes }}>
                      <div class="sulalat-reviews-list__stars" aria-label="{{ review_rating }} out of 5 stars">
                        {%- for i in (1..5) -%}
                          <svg width="16" height="16" viewBox="0 0 24 24" class="{% if i > review_rating %}is-empty{% endif %}" fill="currentColor" aria-hidden="true">
                            <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
                          </svg>
                        {%- endfor -%}
                      </div>
                      {%- if block.settings.title != blank -%}
                        <h3 class="sulalat-reviews-list__title">{{ block.settings.title | escape }}</h3>
                      {%- endif -%}
                      {%- if block.settings.author != blank or block.settings.date != blank -%}
                        <p class="sulalat-reviews-list__meta">
                          {%- if block.settings.author != blank -%}{{ block.settings.author | escape }}{%- endif -%}
                          {%- if block.settings.author != blank and block.settings.date != blank %} · {% endif -%}
                          {%- if block.settings.date != blank -%}{{ block.settings.date | escape }}{%- endif -%}
                        </p>
                      {%- endif -%}
                      {%- if block.settings.body != blank -%}
                        <p class="sulalat-reviews-list__body">{{ block.settings.body | escape | newline_to_br }}</p>
                      {%- endif -%}
                    </article>
                  {%- endfor -%}
                </div>
                <script>
                  (function () {
                    var source = document.querySelector('[data-sulalat-reviews-source]');
                    if (!source) return;

                    var count = parseInt(source.getAttribute('data-count'), 10) || 0;
                    var sum = parseFloat(source.getAttribute('data-rating-sum')) || 0;
                    var avg = count > 0 ? sum / count : 0;

                    document.querySelectorAll('[data-sulalat-reviews-count]').forEach(function (el) {
                      var label = el.getAttribute('data-reviews-label') || 'reviews';
                      if (count > 0) {
                        el.hidden = false;
                        el.textContent = '(' + count + ' ' + label + ')';
                      } else {
                        el.hidden = true;
                        el.textContent = '';
                      }
                    });

                    if (avg > 0) {
                      var rounded = Math.round(avg);
                      document.querySelectorAll('[data-sulalat-reviews-stars]').forEach(function (stars) {
                        var scale = parseInt(stars.getAttribute('data-rating-scale'), 10) || 5;
                        stars.querySelectorAll('svg').forEach(function (svg, index) {
                          svg.classList.toggle('is-empty', index + 1 > rounded);
                        });
                        stars.setAttribute('aria-label', avg.toFixed(1) + ' out of ' + scale + ' stars');
                      });
                    }
                  })();
                </script>
              {%- else -%}
                <p class="sulalat-reviews-list__empty">No reviews yet for this product.</p>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      </tabbed-content>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('p').forEach((p) => {
  if (p.innerHTML.trim() === '&nbsp;') {
    p.remove();
  }
});
</script>
{%- endif -%}

{% schema %}
{
  "name": "Product description tabs",
  "tag": "section",
  "class": "section-product-description-tabs",
  "settings": [
    {
      "type": "text",
      "id": "description_label",
      "label": "Description tab label",
      "default": "Description"
    },
    {
      "type": "checkbox",
      "id": "show_reviews",
      "label": "Show reviews tab",
      "default": true
    },
    {
      "type": "text",
      "id": "reviews_label",
      "label": "Reviews tab label",
      "default": "Reviews"
    },
    {
      "type": "number",
      "id": "reviews_count_fallback",
      "label": "Reviews count fallback",
      "default": 0,
      "info": "Used when no review app count is available."
    },
    {
      "type": "liquid",
      "id": "custom_reviews",
      "label": "Custom reviews app code",
      "info": "Paste your reviews app embed code here if not using Shopify Product Reviews."
    },
    {
      "type": "header",
      "content": "Description meta"
    },
    {
      "type": "checkbox",
      "id": "show_brand",
      "label": "Show brand (vendor)",
      "default": true
    },
    {
      "type": "text",
      "id": "brand_label",
      "label": "Brand label",
      "default": "Brand"
    },
    {
      "type": "checkbox",
      "id": "show_sku",
      "label": "Show SKU",
      "default": true
    },
    {
      "type": "text",
      "id": "sku_label",
      "label": "SKU label",
      "default": "SKU"
    },
    {
      "type": "checkbox",
      "id": "show_category",
      "label": "Show category (product type)",
      "default": true
    },
    {
      "type": "text",
      "id": "category_label",
      "label": "Category label",
      "default": "CATEGORY"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "tab_bar_background",
      "label": "Tab bar background",
      "default": "#f7f7f7"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Active tab color",
      "default": "#53c295"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding top (mobile)",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom (mobile)",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Rating",
          "default": 5
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Great coffee"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Sara"
        },
        {
          "type": "text",
          "id": "date",
          "label": "Date",
          "default": "March 2026"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Review",
          "default": "Excellent quality and beautiful flavor profile. Will order again."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product description tabs"
    }
  ]
}
{% endschema %}
