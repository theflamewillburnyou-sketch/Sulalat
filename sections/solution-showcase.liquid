{%- liquid
  assign slide_blocks = section.blocks | where: 'type', 'slide'
  assign media_position = section.settings.media_position | default: 'right'
  assign layout_style = section.settings.layout_style | default: 'split'
-%}

<section
  class="solution-showcase solution-showcase--{{ layout_style }} solution-showcase--media-{{ media_position }}"
  data-section-id="{{ section.id }}"
  data-solution-showcase
>
  <style>
    .solution-showcase[data-section-id="{{ section.id }}"] {
      padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
      font-family: var(--body-font-family);
      background: {{ section.settings.background_color }};
    }

    .solution-showcase[data-section-id="{{ section.id }}"] .container {
      max-width: var(--brand-container-max, 1440px);
      margin: 0 auto;
      padding: 0 var(--brand-container-padding-x, 20px);
    }

    .solution-showcase[data-section-id="{{ section.id }}"] .solution-intro {
      text-align: center;
      max-width: 820px;
      margin: 0 auto 48px;
    }

    .solution-showcase[data-section-id="{{ section.id }}"] .solution-intro h2 {
      margin: 0 0 16px;
      color: #000;
      font-size: clamp(36px, 4vw, 56px);
      line-height: 1.15;
      font-weight: 600;
    }

    .solution-showcase[data-section-id="{{ section.id }}"] .solution-intro p {
      margin: 0;
      font-size: 16px;
      line-height: 26px;
      letter-spacing: -0.01em;
      color: var(--brand-body-text, #535353);
    }

    .solution-showcase[data-section-id="{{ section.id }}"] .solution-slider {
      overflow: hidden;
    }

    .solution-showcase[data-section-id="{{ section.id }}"] .solution-slide-grid {
      display: grid;
      grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
      gap: 24px;
      align-items: stretch;
    }

    .solution-showcase[data-section-id="{{ section.id }}"].solution-showcase--media-left .solution-slide-grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    }

    .solution-showcase[data-section-id="{{ section.id }}"].solution-showcase--media-left .solution-slide-media {
      order: 1;
    }

    .solution-showcase[data-section-id="{{ section.id }}"].solution-showcase--media-left .solution-slide-content {
      order: 2;
    }

    .solution-showcase[data-section-id="{{ section.id }}"].solution-showcase--joined .solution-slide-grid {
      gap: 0;
      overflow: hidden;
      border-radius: 24px;
      grid-template-columns: 1fr 1fr;
    }

    .solution-showcase[data-section-id="{{ section.id }}"] .solution-slide-content {
      background: {{ section.settings.card_background }};
      border-radius: 24px;
      padding: 48px 44px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      min-height: 420px;
    }

    .solution-showcase[data-section-id="{{ section.id }}"].solution-showcase--joined .solution-slide-content {
      border-radius: 0;
      min-height: 460px;
    }

    .solution-showcase[data-section-id="{{ section.id }}"] .solution-slide-tag {
      display: inline-block;
      margin-bottom: 14px;
      color: var(--brand-primary, #53c295);
      font-size: 15px;
      line-height: 1.3;
      font-weight: 500;
    }

    .solution-showcase[data-section-id="{{ section.id }}"] .solution-slide-rule {
      width: 100%;
      height: 1px;
      background: rgba(0, 0, 0, 0.08);
      margin: 0 0 22px;
      border: 0;
    }

    .solution-showcase[data-section-id="{{ section.id }}"] .solution-slide-content h3 {
      margin: 0 0 18px;
      color: #000;
      font-size: clamp(28px, 2.8vw, 42px);
      line-height: 1.2;
      font-weight: 600;
    }

    .solution-showcase[data-section-id="{{ section.id }}"] .solution-slide-content p {
      margin: 0 0 28px;
      font-size: 16px;
      line-height: 26px;
      letter-spacing: -0.01em;
      color: var(--brand-body-text, #535353);
      max-width: 520px;
    }

    .solution-showcase[data-section-id="{{ section.id }}"] .solution-slide-content .primary-btn {
      align-self: flex-start;
    }

    .solution-showcase[data-section-id="{{ section.id }}"] .solution-slide-media {
      border-radius: 24px;
      overflow: hidden;
      background: #f3f3f3;
      min-height: 420px;
    }

    .solution-showcase[data-section-id="{{ section.id }}"].solution-showcase--joined .solution-slide-media {
      border-radius: 0;
      min-height: 460px;
    }

    .solution-showcase[data-section-id="{{ section.id }}"] .solution-slide-media img,
    .solution-showcase[data-section-id="{{ section.id }}"] .solution-slide-media svg.placeholder-svg {
      width: 100%;
      height: 100%;
      min-height: inherit;
      object-fit: cover;
      display: block;
    }

    .solution-showcase[data-section-id="{{ section.id }}"] .solution-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      margin-top: 36px;
    }

    .solution-showcase[data-section-id="{{ section.id }}"] .solution-progress {
      position: relative;
      flex: 1;
      max-width: 520px;
      height: 3px;
      background: #e5e5e5;
      border-radius: 999px;
      overflow: hidden;
    }

    .solution-showcase[data-section-id="{{ section.id }}"] .solution-progress-bar {
      position: absolute;
      left: 0;
      top: 0;
      bottom: 0;
      width: 0;
      background: var(--brand-primary, #53c295);
      border-radius: inherit;
      transition: width 0.45s ease;
    }

    .solution-showcase[data-section-id="{{ section.id }}"] .solution-nav {
      display: flex;
      gap: 12px;
      flex-shrink: 0;
    }

    .solution-showcase[data-section-id="{{ section.id }}"] .solution-nav button {
      width: 52px;
      height: 52px;
      border-radius: 50%;
      border: 1px solid var(--brand-primary, #53c295);
      background: transparent;
      color: var(--brand-primary, #53c295);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      padding: 0;
      transition: 0.3s;
    }

    .solution-showcase[data-section-id="{{ section.id }}"] .solution-nav button:hover {
      background: var(--brand-primary, #53c295);
      color: #fff;
    }

    .solution-showcase[data-section-id="{{ section.id }}"] .solution-nav button svg {
      display: block;
    }

    .solution-showcase[data-section-id="{{ section.id }}"] .solution-nav.is-hidden,
    .solution-showcase[data-section-id="{{ section.id }}"] .solution-progress.is-hidden {
      display: none;
    }

    @media (max-width: 991px) {
      .solution-showcase[data-section-id="{{ section.id }}"] .solution-slide-grid,
      .solution-showcase[data-section-id="{{ section.id }}"].solution-showcase--media-left .solution-slide-grid,
      .solution-showcase[data-section-id="{{ section.id }}"].solution-showcase--joined .solution-slide-grid {
        grid-template-columns: 1fr;
        gap: 16px;
      }

      .solution-showcase[data-section-id="{{ section.id }}"].solution-showcase--media-left .solution-slide-media,
      .solution-showcase[data-section-id="{{ section.id }}"].solution-showcase--media-left .solution-slide-content {
        order: unset;
      }

      .solution-showcase[data-section-id="{{ section.id }}"].solution-showcase--joined .solution-slide-grid {
        border-radius: 20px;
      }

      .solution-showcase[data-section-id="{{ section.id }}"].solution-showcase--joined .solution-slide-content,
      .solution-showcase[data-section-id="{{ section.id }}"].solution-showcase--joined .solution-slide-media {
        border-radius: 0;
        min-height: 320px;
      }

      .solution-showcase[data-section-id="{{ section.id }}"] .solution-slide-content {
        padding: 32px 28px;
        min-height: 0;
      }

      .solution-showcase[data-section-id="{{ section.id }}"] .solution-slide-media {
        min-height: 280px;
      }
    }

    @media (max-width: 767px) {
      .solution-showcase[data-section-id="{{ section.id }}"] {
        padding: {{ section.settings.padding_top_mobile }}px 0 {{ section.settings.padding_bottom_mobile }}px;
      }

      .solution-showcase[data-section-id="{{ section.id }}"] .solution-intro {
        margin-bottom: 32px;
      }

      .solution-showcase[data-section-id="{{ section.id }}"] .solution-footer {
        flex-wrap: wrap;
        margin-top: 24px;
      }

      .solution-showcase[data-section-id="{{ section.id }}"] .solution-progress {
        order: 2;
        flex: 1 1 100%;
        max-width: none;
      }

      .solution-showcase[data-section-id="{{ section.id }}"] .solution-nav button {
        width: 44px;
        height: 44px;
      }
    }
  </style>

  <div class="container">
    {% if section.settings.heading != blank or section.settings.subheading != blank %}
      <div class="solution-intro">
        {% if section.settings.heading != blank %}
          <h2>{{ section.settings.heading | escape }}</h2>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <p>{{ section.settings.subheading | escape | newline_to_br }}</p>
        {% endif %}
      </div>
    {% endif %}

    {% if slide_blocks.size > 0 %}
      <div class="swiper solution-slider" data-solution-slider>
        <div class="swiper-wrapper">
          {% for block in slide_blocks %}
            <div class="swiper-slide" {{ block.shopify_attributes }}>
              <div class="solution-slide-grid">
                <div class="solution-slide-content">
                  {% if block.settings.tag != blank %}
                    <span class="solution-slide-tag">{{ block.settings.tag | escape }}</span>
                    <hr class="solution-slide-rule">
                  {% endif %}
                  {% if block.settings.heading != blank %}
                    <h3>{{ block.settings.heading | escape }}</h3>
                  {% endif %}
                  {% if block.settings.text != blank %}
                    <p>{{ block.settings.text | escape | newline_to_br }}</p>
                  {% endif %}
                  {% if block.settings.button_label != blank %}
                    <a
                      class="primary-btn"
                      href="{{ block.settings.button_link | default: '#' }}"
                      {% if block.settings.button_link == blank %}aria-disabled="true"{% endif %}
                    >
                      {{ block.settings.button_label | escape }}
                    </a>
                  {% endif %}
                </div>
                <div class="solution-slide-media">
                  {% if block.settings.image != blank %}
                    {{
                      block.settings.image
                      | image_url: width: 1400
                      | image_tag:
                        loading: 'lazy',
                        widths: '400, 600, 800, 1000, 1200, 1400',
                        sizes: '(min-width: 992px) 50vw, 100vw',
                        alt: block.settings.heading
                    }}
                  {% else %}
                    {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  {% endif %}
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>

      <div class="solution-footer">
        <div class="solution-progress{% if slide_blocks.size < 2 %} is-hidden{% endif %}" aria-hidden="true">
          <span class="solution-progress-bar" data-solution-progress></span>
        </div>
        <div class="solution-nav{% if slide_blocks.size < 2 %} is-hidden{% endif %}">
          <button type="button" class="solution-prev" aria-label="Previous slide">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
              <path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <button type="button" class="solution-next" aria-label="Next slide">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
              <path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>
      </div>
    {% endif %}
  </div>

  <script>
    (function () {
      var section = document.querySelector('.solution-showcase[data-section-id="{{ section.id }}"]');
      if (!section) return;

      var sliderEl = section.querySelector('[data-solution-slider]');
      var progressBar = section.querySelector('[data-solution-progress]');
      var prevBtn = section.querySelector('.solution-prev');
      var nextBtn = section.querySelector('.solution-next');
      var slider = null;

      function setProgress(index, total) {
        if (!progressBar || !total) return;
        progressBar.style.width = (((index + 1) / total) * 100) + '%';
      }

      function loadSwiper(callback) {
        if (window.Swiper) {
          callback();
          return;
        }

        if (!document.querySelector('link[href*="swiper-bundle.min.css"]')) {
          var link = document.createElement('link');
          link.rel = 'stylesheet';
          link.href = 'https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css';
          document.head.appendChild(link);
        }

        var script = document.createElement('script');
        script.src = 'https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js';
        script.onload = callback;
        document.head.appendChild(script);
      }

      function initSlider() {
        if (!sliderEl || !window.Swiper) return;

        if (sliderEl.swiper) {
          sliderEl.swiper.destroy(true, true);
        }

        slider = new window.Swiper(sliderEl, {
          slidesPerView: 1,
          spaceBetween: 0,
          speed: 700,
          grabCursor: true,
          on: {
            init: function () {
              setProgress(this.activeIndex, this.slides.length);
            },
            slideChange: function () {
              setProgress(this.activeIndex, this.slides.length);
            }
          }
        });

        if (prevBtn) {
          prevBtn.onclick = function () {
            slider.slidePrev();
          };
        }
        if (nextBtn) {
          nextBtn.onclick = function () {
            slider.slideNext();
          };
        }
      }

      loadSwiper(initSlider);

      document.addEventListener('shopify:section:load', function (e) {
        if (e.target && e.target.querySelector('.solution-showcase[data-section-id="{{ section.id }}"]')) {
          section = document.querySelector('.solution-showcase[data-section-id="{{ section.id }}"]');
          sliderEl = section.querySelector('[data-solution-slider]');
          progressBar = section.querySelector('[data-solution-progress]');
          prevBtn = section.querySelector('.solution-prev');
          nextBtn = section.querySelector('.solution-next');
          loadSwiper(initSlider);
        }
      });

      document.addEventListener('shopify:section:unload', function (e) {
        if (e.target && e.target.querySelector('.solution-showcase[data-section-id="{{ section.id }}"]')) {
          if (slider) {
            slider.destroy(true, true);
            slider = null;
          }
        }
      });
    })();
  </script>
</section>

{% schema %}
{
  "name": "Solution showcase",
  "tag": "section",
  "class": "solution-showcase-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Coffee"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "From bean to blend, Sulalat curates exceptional coffees for every style and setting — combining heritage with innovation."
    },
    {
      "type": "select",
      "id": "layout_style",
      "label": "Card layout",
      "options": [
        { "value": "split", "label": "Split cards (gap)" },
        { "value": "joined", "label": "Joined panel" }
      ],
      "default": "split"
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "Image position",
      "options": [
        { "value": "right", "label": "Image right" },
        { "value": "left", "label": "Image left" }
      ],
      "default": "right"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Content card background",
      "default": "#eaf8f1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding top (mobile)",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom (mobile)",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "text",
          "id": "tag",
          "label": "Tag",
          "default": "Coffee"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Whole Beans"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Our Main Stream represents Sulalat's complete ecosystem — connecting coffee, chocolate, gelato, bakery, and equipment into one seamless value chain."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Solution showcase",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "tag": "Coffee",
            "heading": "Whole Beans",
            "text": "Our Main Stream represents Sulalat's complete ecosystem — connecting coffee, chocolate, gelato, bakery, and equipment into one seamless value chain. Whether you're building a café, expanding a franchise, or perfecting your own craft, Sulalat provides the expertise and infrastructure to make it happen.",
            "button_label": "Shop Now"
          }
        },
        {
          "type": "slide",
          "settings": {
            "tag": "Coffee",
            "heading": "Ground Coffee",
            "text": "Freshly roasted and ground for convenience — crafted for cafés and home brewers who want consistency in every cup.",
            "button_label": "Shop Now"
          }
        },
        {
          "type": "slide",
          "settings": {
            "tag": "Coffee",
            "heading": "Specialty Blends",
            "text": "Signature blends that balance heritage and innovation — curated for every style and setting.",
            "button_label": "Shop Now"
          }
        }
      ]
    }
  ]
}
{% endschema %}
