<section
  class="experience-sulalat-offering"
  data-section-id="{{ section.id }}"
  style="
    --exp-offering-bg: {{ section.settings.background_color }};
    --exp-offering-padding-top: {{ section.settings.padding_top }}px;
    --exp-offering-padding-bottom: {{ section.settings.padding_bottom }}px;
    --exp-offering-gap: {{ section.settings.card_gap }}px;
  "
>
  <style>
    .experience-sulalat-offering[data-section-id="{{ section.id }}"] {
      padding: var(--exp-offering-padding-top, 80px) 0 var(--exp-offering-padding-bottom, 100px);
      background: var(--exp-offering-bg, #ffffff);
      font-family: var(--body-font-family);
    }

    .experience-sulalat-offering[data-section-id="{{ section.id }}"] .container {
      max-width: var(--brand-container-max, 1440px);
      margin: 0 auto;
      padding: 0 var(--brand-container-padding-x, 20px);
    }

    .experience-sulalat-offering[data-section-id="{{ section.id }}"] .experience-sulalat-offering__heading {
      margin: 0 0 48px;
      text-align: center;
      color: #000;
      font-size: clamp(36px, 4vw, 56px);
      line-height: 1.15;
      font-weight: 400;
      letter-spacing: -0.02em;
    }

    .experience-sulalat-offering[data-section-id="{{ section.id }}"] .experience-sulalat-offering__grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--exp-offering-gap, 24px);
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .experience-sulalat-offering[data-section-id="{{ section.id }}"] .experience-sulalat-offering__card {
      display: flex;
      flex-direction: column;
      min-width: 0;
    }

    .experience-sulalat-offering[data-section-id="{{ section.id }}"] .experience-sulalat-offering__media {
      display: block;
      border-radius: var(--brand-radius-lg, 20px);
      overflow: hidden;
      aspect-ratio: 4 / 3;
      margin-bottom: 18px;
      background: #f3f3f3;
    }

    .experience-sulalat-offering[data-section-id="{{ section.id }}"] .experience-sulalat-offering__media img,
    .experience-sulalat-offering[data-section-id="{{ section.id }}"] .experience-sulalat-offering__media svg.placeholder-svg {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .experience-sulalat-offering[data-section-id="{{ section.id }}"] .experience-sulalat-offering__title {
      margin: 0 0 16px;
      font-size: 20px;
      line-height: 1.3;
      font-weight: 600;
      color: #000;
    }

    .experience-sulalat-offering[data-section-id="{{ section.id }}"] .experience-sulalat-offering__btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      align-self: flex-start;
      min-height: 44px;
      padding: 10px 28px;
      border-radius: var(--brand-radius-pill, 80px);
      background: var(--brand-primary, #53c295);
      border: 1px solid var(--brand-primary, #53c295);
      color: #fff;
      font-size: 14px;
      font-weight: 500;
      font-family: inherit;
      text-decoration: none;
      transition: 0.25s ease;
      margin-top: auto;
    }

    .experience-sulalat-offering[data-section-id="{{ section.id }}"] .experience-sulalat-offering__btn:hover {
      background: var(--brand-primary-hover, #45ad82);
      border-color: var(--brand-primary-hover, #45ad82);
      color: #fff;
    }

    @media (max-width: 1199px) {
      .experience-sulalat-offering[data-section-id="{{ section.id }}"] .experience-sulalat-offering__grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 575px) {
      .experience-sulalat-offering[data-section-id="{{ section.id }}"] .experience-sulalat-offering__grid {
        grid-template-columns: 1fr;
      }

      .experience-sulalat-offering[data-section-id="{{ section.id }}"] .experience-sulalat-offering__heading {
        margin-bottom: 32px;
      }
    }
  </style>

  <div class="container">
    {% if section.settings.heading != blank %}
      <h2 class="experience-sulalat-offering__heading">{{ section.settings.heading | escape }}</h2>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <ul class="experience-sulalat-offering__grid" role="list">
        {% for block in section.blocks %}
          <li class="experience-sulalat-offering__card" {{ block.shopify_attributes }}>
            {% if block.settings.image != blank %}
              <div class="experience-sulalat-offering__media">
                {{
                  block.settings.image
                  | image_url: width: 800
                  | image_tag:
                    loading: 'lazy',
                    widths: '320, 480, 640, 800',
                    sizes: '(min-width: 1200px) 25vw, (min-width: 576px) 50vw, 100vw',
                    alt: block.settings.image.alt | default: block.settings.title | escape
                }}
              </div>
            {% else %}
              <div class="experience-sulalat-offering__media">
                {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
              </div>
            {% endif %}

            {% if block.settings.title != blank %}
              <h3 class="experience-sulalat-offering__title">{{ block.settings.title | escape }}</h3>
            {% endif %}

            {% if block.settings.button_label != blank %}
              <a
                class="experience-sulalat-offering__btn"
                href="{{ block.settings.button_link | default: '#' }}"
                {% if block.settings.button_link != blank %}download{% endif %}
              >
                {{ block.settings.button_label | escape }}
              </a>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Experience offerings",
  "tag": "section",
  "class": "experience-sulalat-offering-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What We Are Offering"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Card gap",
      "min": 12,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "offering",
      "name": "Offering",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Coffee"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Download Menu"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Menu file or link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Experience offerings",
      "blocks": [
        {
          "type": "offering",
          "settings": {
            "title": "Coffee",
            "button_label": "Download Menu"
          }
        },
        {
          "type": "offering",
          "settings": {
            "title": "Bakery",
            "button_label": "Download Menu"
          }
        },
        {
          "type": "offering",
          "settings": {
            "title": "Gelato",
            "button_label": "Download Menu"
          }
        },
        {
          "type": "offering",
          "settings": {
            "title": "Chocolate",
            "button_label": "Download Menu"
          }
        }
      ]
    }
  ]
}
{% endschema %}
