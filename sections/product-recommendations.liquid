{%- liquid
  assign product_id = product.id
  assign limit = section.settings.products_to_show | default: 8
  if limit > 10
    assign limit = 10
  endif
  assign slides_desktop = section.settings.slides_desktop | default: 3
  assign slides_tablet = section.settings.slides_tablet | default: 2
  assign slides_mobile = section.settings.slides_mobile | default: 1.1
  assign slide_gap = section.settings.slide_gap | default: 28
-%}

<style>
  .sulalat-related[data-section-id="{{ section.id }}"] {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.background_color }};
    font-family: var(--body-font-family);
    overflow: hidden;
  }

  .sulalat-related[data-section-id="{{ section.id }}"] .container {
    max-width: var(--brand-container-max, 1440px);
    margin: 0 auto;
    padding: 0 var(--brand-container-padding-x, 20px);
  }

  .sulalat-related[data-section-id="{{ section.id }}"] .sulalat-related__heading {
    margin: 0 0 36px;
    font-size: clamp(28px, 3vw, 40px);
    line-height: 1.2;
    font-weight: 600;
    color: #000;
    letter-spacing: -0.02em;
  }

  .sulalat-related[data-section-id="{{ section.id }}"] .sulalat-related__heading.text-center {
    text-align: center;
  }

  .sulalat-related[data-section-id="{{ section.id }}"] .sulalat-related__heading.text-end {
    text-align: end;
  }

  .sulalat-related[data-section-id="{{ section.id }}"] .sulalat-related__slider-wrap {
    position: relative;
  }

  .sulalat-related[data-section-id="{{ section.id }}"] .sulalat-related__slider.swiper {
    overflow: hidden;
  }

  .sulalat-related[data-section-id="{{ section.id }}"] .sulalat-related__slider .swiper-wrapper {
    align-items: stretch;
  }

  .sulalat-related[data-section-id="{{ section.id }}"] .sulalat-related__slider .swiper-slide {
    height: auto;
    box-sizing: border-box;
  }

  .sulalat-related[data-section-id="{{ section.id }}"] .sulalat-related__nav {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    margin-top: 28px;
  }

  .sulalat-related[data-section-id="{{ section.id }}"] .sulalat-related__nav-btn {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid rgba(0, 0, 0, 0.12);
    background: #fff;
    color: #000;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: 0.25s ease;
    padding: 0;
  }

  .sulalat-related[data-section-id="{{ section.id }}"] .sulalat-related__nav-btn:hover:not(:disabled) {
    border-color: var(--brand-primary, #53c295);
    color: var(--brand-primary, #53c295);
  }

  .sulalat-related[data-section-id="{{ section.id }}"] .sulalat-related__nav-btn:disabled,
  .sulalat-related[data-section-id="{{ section.id }}"] .sulalat-related__nav-btn.swiper-button-disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  .sulalat-related[data-section-id="{{ section.id }}"] .sulalat-related__nav-btn svg {
    width: 18px;
    height: 18px;
    display: block;
  }

  .sulalat-related[data-section-id="{{ section.id }}"] .sulalat-product-card {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .sulalat-related[data-section-id="{{ section.id }}"] .sulalat-product-card__media {
    position: relative;
    display: block;
    border-radius: 20px;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    text-decoration: none;
    background: #53c295;
  }

  .sulalat-related[data-section-id="{{ section.id }}"] .sulalat-product-card--magenta .sulalat-product-card__media {
    background: #c44d8a;
  }

  .sulalat-related[data-section-id="{{ section.id }}"] .sulalat-product-card--beige .sulalat-product-card__media {
    background: #cbb79a;
  }

  .sulalat-related[data-section-id="{{ section.id }}"] .sulalat-product-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .sulalat-related[data-section-id="{{ section.id }}"] .sulalat-product-card__icon {
    position: absolute;
    inset: 0 0 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255, 255, 255, 0.92);
  }

  .sulalat-related[data-section-id="{{ section.id }}"] .sulalat-product-card__icon svg {
    width: 72px;
    height: 72px;
  }

  .sulalat-related[data-section-id="{{ section.id }}"] .sulalat-product-card__band {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    min-height: 48px;
    padding: 10px 16px;
    background: rgba(255, 255, 255, 0.92);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    text-align: center;
  }

  .sulalat-related[data-section-id="{{ section.id }}"] .sulalat-product-card__band-ar,
  .sulalat-related[data-section-id="{{ section.id }}"] .sulalat-product-card__band-en {
    font-size: 13px;
    line-height: 1.3;
    color: #111;
  }

  .sulalat-related[data-section-id="{{ section.id }}"] .sulalat-product-card__body {
    padding-top: 18px;
    text-align: center;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .sulalat-related[data-section-id="{{ section.id }}"] .sulalat-product-card__title {
    margin: 0 0 8px;
    font-size: 20px;
    line-height: 1.3;
    font-weight: 600;
  }

  .sulalat-related[data-section-id="{{ section.id }}"] .sulalat-product-card__title a {
    color: #000;
    text-decoration: none;
  }

  .sulalat-related[data-section-id="{{ section.id }}"] .sulalat-product-card__desc {
    margin: 0 0 12px;
    font-size: 14px;
    line-height: 1.45;
    color: #8a8a8a;
  }

  .sulalat-related[data-section-id="{{ section.id }}"] .sulalat-product-card__price {
    margin: 0 0 18px;
    font-size: 18px;
    line-height: 1.3;
    font-weight: 600;
    color: #000;
  }

  .sulalat-related[data-section-id="{{ section.id }}"] .sulalat-product-card__price s {
    margin-inline-end: 8px;
    color: #9a9a9a;
    font-weight: 400;
  }

  .sulalat-related[data-section-id="{{ section.id }}"] .sulalat-product-card__actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-top: auto;
  }

  .sulalat-related[data-section-id="{{ section.id }}"] .sulalat-product-card__form {
    display: contents;
  }

  .sulalat-related[data-section-id="{{ section.id }}"] .sulalat-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 10px 16px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 500;
    font-family: inherit;
    text-decoration: none;
    cursor: pointer;
    transition: 0.25s ease;
    text-align: center;
  }

  .sulalat-related[data-section-id="{{ section.id }}"] .sulalat-btn--primary {
    background: var(--brand-primary, #53c295);
    border: 1px solid var(--brand-primary, #53c295);
    color: #fff;
  }

  .sulalat-related[data-section-id="{{ section.id }}"] .sulalat-btn--primary:hover {
    background: var(--brand-primary-hover, #45ad82);
    border-color: var(--brand-primary-hover, #45ad82);
    color: #fff;
  }

  .sulalat-related[data-section-id="{{ section.id }}"] .sulalat-btn--outline {
    background: #fff;
    border: 1px solid var(--brand-primary, #53c295);
    color: var(--brand-primary, #53c295);
  }

  .sulalat-related[data-section-id="{{ section.id }}"] .sulalat-btn--outline:hover {
    background: var(--brand-primary, #53c295);
    color: #fff;
  }

  .sulalat-related[data-section-id="{{ section.id }}"] .sulalat-btn.is-disabled {
    opacity: 0.5;
    cursor: not-allowed;
    pointer-events: none;
  }

  @media (max-width: 749px) {
    .sulalat-related[data-section-id="{{ section.id }}"] .sulalat-product-card__actions {
      grid-template-columns: 1fr;
    }

    .sulalat-related[data-section-id="{{ section.id }}"] .sulalat-related__heading {
      margin-bottom: 28px;
    }
  }
</style>

<product-recommendations
  class="sulalat-related"
  data-section-id="{{ section.id }}"
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product_id }}&limit={{ limit }}&intent=related"
  data-product-id="{{ product_id }}"
  data-slides-desktop="{{ slides_desktop }}"
  data-slides-tablet="{{ slides_tablet }}"
  data-slides-mobile="{{ slides_mobile }}"
  data-slide-gap="{{ slide_gap }}"
  data-autoplay="{{ section.settings.enable_autoplay }}"
  data-autoplay-delay="{{ section.settings.autoplay_delay | default: 4 }}"
  data-pause-on-hover="{{ section.settings.pause_on_hover }}"
  data-loop="{{ section.settings.enable_loop }}"
  data-speed="{{ section.settings.transition_speed | default: 600 }}"
>
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <div class="container">
      {% if section.settings.heading != blank %}
        <h2 class="sulalat-related__heading {{ section.settings.heading_align }}">
          {{ section.settings.heading | escape }}
        </h2>
      {% endif %}

      <div class="sulalat-related__slider-wrap">
        <div class="swiper sulalat-related__slider" data-related-slider>
          <div class="swiper-wrapper">
            {% for product in recommendations.products %}
              <div class="swiper-slide">
                {% render 'sulalat-product-card',
                  product: product,
                  color_index: forloop.index0,
                  section_id: section.id
                %}
              </div>
            {% endfor %}
          </div>
        </div>

        {% if section.settings.show_navigation %}
          <div class="sulalat-related__nav" data-related-nav>
            <button type="button" class="sulalat-related__nav-btn" data-related-prev aria-label="Previous products">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
            <button type="button" class="sulalat-related__nav-btn" data-related-next aria-label="Next products">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
          </div>
        {% endif %}
      </div>
    </div>
  {%- endif -%}
</product-recommendations>

<script>
  (function () {
    var sectionId = {{ section.id | json }};
    var root = document.querySelector('product-recommendations.sulalat-related[data-section-id="' + sectionId + '"]');
    if (!root || root.dataset.relatedBound === 'true') return;
    root.dataset.relatedBound = 'true';

    var observer = null;
    var initQueued = false;

    function parseBool(value) {
      return String(value) === 'true';
    }

    function loadSwiper(callback) {
      if (window.Swiper) {
        callback();
        return;
      }

      if (!document.querySelector('link[data-sulalat-related-swiper-css]')) {
        var link = document.createElement('link');
        link.rel = 'stylesheet';
        link.href = 'https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css';
        link.dataset.sulalatRelatedSwiperCss = 'true';
        document.head.appendChild(link);
      }

      var existing = document.querySelector('script[data-sulalat-related-swiper]');
      if (existing) {
        if (existing.dataset.loaded === 'true') {
          callback();
        } else {
          existing.addEventListener('load', callback, { once: true });
        }
        return;
      }

      var script = document.createElement('script');
      script.src = 'https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js';
      script.dataset.sulalatRelatedSwiper = 'true';
      script.onload = function () {
        script.dataset.loaded = 'true';
        callback();
      };
      document.head.appendChild(script);
    }

    function initSlider() {
      var sliderEl = root.querySelector('[data-related-slider]');
      if (!sliderEl || !window.Swiper) return;
      if (sliderEl.dataset.swiperReady === 'true' && sliderEl.swiper) return;

      if (sliderEl.swiper) {
        sliderEl.swiper.destroy(true, true);
      }

      var slidesDesktop = parseFloat(root.dataset.slidesDesktop) || 3;
      var slidesTablet = parseFloat(root.dataset.slidesTablet) || 2;
      var slidesMobile = parseFloat(root.dataset.slidesMobile) || 1.1;
      var gap = parseInt(root.dataset.slideGap, 10) || 28;
      var enableAutoplay = parseBool(root.dataset.autoplay);
      var autoplayDelay = (parseFloat(root.dataset.autoplayDelay) || 4) * 1000;
      var pauseOnHover = parseBool(root.dataset.pauseOnHover);
      var enableLoop = parseBool(root.dataset.loop);
      var speed = parseInt(root.dataset.speed, 10) || 600;
      var slideCount = sliderEl.querySelectorAll('.swiper-slide').length;
      var prevBtn = root.querySelector('[data-related-prev]');
      var nextBtn = root.querySelector('[data-related-next]');

      new window.Swiper(sliderEl, {
        slidesPerView: slidesMobile,
        spaceBetween: gap,
        speed: speed,
        grabCursor: true,
        watchOverflow: true,
        loop: enableLoop && slideCount > Math.ceil(slidesDesktop),
        autoplay: enableAutoplay && slideCount > Math.ceil(slidesDesktop) ? {
          delay: autoplayDelay,
          disableOnInteraction: false,
          pauseOnMouseEnter: pauseOnHover
        } : false,
        navigation: prevBtn && nextBtn ? {
          nextEl: nextBtn,
          prevEl: prevBtn
        } : undefined,
        breakpoints: {
          768: {
            slidesPerView: slidesTablet,
            spaceBetween: gap
          },
          1200: {
            slidesPerView: slidesDesktop,
            spaceBetween: gap
          }
        }
      });

      sliderEl.dataset.swiperReady = 'true';

      if (observer) {
        observer.disconnect();
        observer = null;
      }
    }

    function tryInit() {
      if (!root.querySelector('[data-related-slider]')) return;
      if (initQueued) return;
      initQueued = true;
      loadSwiper(function () {
        initQueued = false;
        initSlider();
      });
    }

    tryInit();

    if (!root.querySelector('[data-related-slider]')) {
      observer = new MutationObserver(function () {
        if (root.querySelector('[data-related-slider]')) {
          tryInit();
        }
      });
      observer.observe(root, { childList: true });
    }

    document.addEventListener('shopify:section:load', function (event) {
      if (String(event.detail.sectionId) !== String(sectionId)) return;
      root = document.querySelector('product-recommendations.sulalat-related[data-section-id="' + sectionId + '"]');
      if (!root) return;
      delete root.dataset.relatedBound;
      root.dataset.relatedBound = 'true';
      initQueued = false;
      var readySlider = root.querySelector('[data-related-slider]');
      if (readySlider) delete readySlider.dataset.swiperReady;
      tryInit();
    });
  })();
</script>

{% schema %}
{
  "name": "Related products",
  "tag": "section",
  "class": "cc-product-recommendations sulalat-related-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Dynamic recommendations use order and product information to change and improve over time. [Learn more](https://help.shopify.com/en/themes/development/recommended-products)"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Related Products"
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Heading alignment",
      "options": [
        {
          "value": "text-start",
          "label": "Left"
        },
        {
          "value": "text-center",
          "label": "Center"
        },
        {
          "value": "text-end",
          "label": "Right"
        }
      ],
      "default": "text-start"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Maximum products to show",
      "min": 3,
      "max": 10,
      "step": 1,
      "default": 8
    },
    {
      "type": "header",
      "content": "Slider"
    },
    {
      "type": "range",
      "id": "slides_desktop",
      "label": "Products visible on desktop",
      "min": 2,
      "max": 4,
      "step": 0.1,
      "default": 3,
      "info": "3 shows three full cards. Use 3.2 for a peek of the next card."
    },
    {
      "type": "range",
      "id": "slides_tablet",
      "label": "Products visible on tablet",
      "min": 1,
      "max": 3,
      "step": 0.1,
      "default": 2
    },
    {
      "type": "range",
      "id": "slides_mobile",
      "label": "Products visible on mobile",
      "min": 1,
      "max": 2,
      "step": 0.1,
      "default": 1.1
    },
    {
      "type": "range",
      "id": "slide_gap",
      "label": "Gap between products",
      "min": 12,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "transition_speed",
      "label": "Transition speed",
      "min": 300,
      "max": 1200,
      "step": 50,
      "unit": "ms",
      "default": 600
    },
    {
      "type": "checkbox",
      "id": "enable_loop",
      "label": "Enable loop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_navigation",
      "label": "Show navigation arrows",
      "default": true
    },
    {
      "type": "header",
      "content": "Autoplay"
    },
    {
      "type": "checkbox",
      "id": "enable_autoplay",
      "label": "Enable autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_delay",
      "label": "Autoplay delay",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause autoplay on hover",
      "default": true
    },
    {
      "type": "header",
      "content": "Section style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#fbf9f9"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ]
}
{% endschema %}
