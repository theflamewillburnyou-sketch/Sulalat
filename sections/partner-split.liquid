<section class="partner-section" id="shopify-section-{{ section.id }}">
  <div class="container">
    <div class="partner-wrapper">
      <div class="partner-content">
        {%- if section.settings.heading != blank -%}
          <div class="section-title">
            <h2>{{ section.settings.heading }}</h2>
          </div>
        {%- endif -%}

        {%- if section.settings.text_1 != blank -%}
          <p>{{ section.settings.text_1 }}</p>
        {%- endif -%}

        {%- if section.settings.text_2 != blank -%}
          <p>{{ section.settings.text_2 }}</p>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link | default: '#' }}" class="primary-btn">{{ section.settings.button_label }}</a>
        {%- endif -%}
      </div>

      <div class="partner-image">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1400 | image_tag: alt: section.settings.image.alt | default: section.settings.heading }}
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% style %}
  #shopify-section-{{ section.id }} .partner-section {
    padding: 100px 0;
  }

  #shopify-section-{{ section.id }} .partner-wrapper {
    display: flex;
    flex-wrap: wrap;
    overflow: hidden;
    border-radius: 20px;
    background: var(--light-theme, #E7F5EF);
    {%- if section.settings.image_position == 'left' -%}
    flex-direction: row-reverse;
    {%- endif -%}
  }

  #shopify-section-{{ section.id }} .partner-content {
    width: 40%;
    padding: 76px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: start;
  }

  #shopify-section-{{ section.id }} .partner-image {
    width: 60%;
  }

  #shopify-section-{{ section.id }} .partner-section .section-title {
    margin-bottom: 40px;
    margin-inline: 0;
    text-align: left;
    max-width: none;
  }

  #shopify-section-{{ section.id }} .section-title h2 {
    color: #000;
    font-size: clamp(24px, 3vw, 36px);
    font-weight: 400;
  }

  #shopify-section-{{ section.id }} .partner-image img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .partner-content p {
    color: var(--sub-title-clr, #141211);
    line-height: 24px;
    font-size: 16px;
  }

  #shopify-section-{{ section.id }} .partner-content p + p {
    margin-top: 25px;
  }

  #shopify-section-{{ section.id }} .partner-content .primary-btn {
    margin-top: 40px;
  }

  #shopify-section-{{ section.id }} .primary-btn {
    background: var(--theme-clr, #53C295);
    display: inline-flex;
    justify-content: center;
    align-items: center;
    border: 1px solid var(--theme-clr, #53C295);
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: 11px 60px;
    border-radius: 80px;
    font-size: 16px;
    font-family: var(--secondary-font);
    color: #fff;
    flex-shrink: 0;
    cursor: pointer;
    transition: all 0.5s ease-in-out;
    font-weight: 500;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .primary-btn:hover {
    color: var(--theme-clr, #53C295);
  }

  #shopify-section-{{ section.id }} .primary-btn::before {
    content: "";
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 0;
    height: 100%;
    background: #fff;
    transition: all 0.5s ease-in-out;
    z-index: -1;
  }

  #shopify-section-{{ section.id }} .primary-btn:hover::before {
    right: auto;
    left: 0;
    width: 100%;
  }

  @media (max-width: 992px) {
    #shopify-section-{{ section.id }} .partner-section {
      padding: 60px 0;
    }
    #shopify-section-{{ section.id }} .partner-wrapper {
      flex-direction: column-reverse;
    }
    #shopify-section-{{ section.id }} .partner-content,
    #shopify-section-{{ section.id }} .partner-image {
      width: 100%;
    }
    #shopify-section-{{ section.id }} .partner-content {
      padding: 40px 30px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Partner split",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Partner with a Pioneer"
    },
    {
      "type": "textarea",
      "id": "text_1",
      "label": "Paragraph 1",
      "default": "Looking to scale your coffee business? Partner with Sulalat for consistent quality, reliable supply, and end-to-end support."
    },
    {
      "type": "textarea",
      "id": "text_2",
      "label": "Paragraph 2",
      "default": "Instead, you'll work with a partner invested in your growth."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button text",
      "default": "Explore Partnership Options"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "right", "label": "Right" },
        { "value": "left", "label": "Left" }
      ],
      "default": "right"
    }
  ],
  "presets": [
    {
      "name": "Partner split"
    }
  ]
}
{% endschema %}
