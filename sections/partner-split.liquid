<section
  class="partner-section"
  data-section-id="{{ section.id }}"
  style="
    --partner-padding-top: {{ section.settings.section_padding_top }}px;
    --partner-padding-bottom: {{ section.settings.section_padding_bottom }}px;
    --partner-bg: {{ section.settings.section_bg_color }};
    --partner-heading-color: {{ section.settings.heading_color }};
    --partner-text-color: {{ section.settings.text_color }};
    --partner-button-bg: {{ section.settings.button_bg_color }};
    --partner-button-text: {{ section.settings.button_text_color }};
    --partner-button-hover-bg: {{ section.settings.button_hover_bg_color }};
    --partner-heading-size: {{ section.settings.heading_size }}px;
    --partner-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --partner-body-size: {{ section.settings.body_size }}px;
    --partner-button-size: {{ section.settings.button_size }}px;
    --partner-content-padding: {{ section.settings.content_padding }}px;
  "
>
  <style>
    .partner-section[data-section-id="{{ section.id }}"] {
      padding-top: var(--partner-padding-top);
      padding-bottom: var(--partner-padding-bottom);
      background: transparent;
    }

    .partner-section[data-section-id="{{ section.id }}"] .container {
      max-width: var(--brand-container-max, 1440px);
      margin: 0 auto;
      padding: 0 var(--brand-container-padding-x, 20px);
    }

    .partner-section[data-section-id="{{ section.id }}"] .partner-wrapper {
      display: flex;
      flex-wrap: wrap;
      overflow: hidden;
      border-radius: 20px;
      background: var(--partner-bg);
    }

    .partner-section[data-section-id="{{ section.id }}"] .partner-content {
      width: 40%;
      padding: var(--partner-content-padding);
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: flex-start;
    }

    .partner-section[data-section-id="{{ section.id }}"] .partner-image {
      width: 60%;
    }

    .partner-section[data-section-id="{{ section.id }}"] .section-title {
      margin-bottom: 40px;
      margin-inline: 0;
      text-align: left;
    }

    .partner-section[data-section-id="{{ section.id }}"] .section-title h2 {
      color: var(--partner-heading-color);
      font-size: var(--partner-heading-size);
      font-weight: 400;
      line-height: 1.2;
      margin: 0;
    }

    .partner-section[data-section-id="{{ section.id }}"] .partner-content p {
      color: var(--partner-text-color);
      line-height: 24px;
      font-size: var(--partner-body-size);
      margin: 0;
    }

    .partner-section[data-section-id="{{ section.id }}"] .partner-content p + p {
      margin-top: 25px;
    }

    .partner-section[data-section-id="{{ section.id }}"] .partner-image img {
      width: 100%;
      height: 100%;
      display: block;
      object-fit: cover;
    }

    .partner-section[data-section-id="{{ section.id }}"] .partner-image svg.placeholder-svg {
      width: 100%;
      height: 100%;
      display: block;
    }

    .partner-section[data-section-id="{{ section.id }}"] .primary-btn {
      margin-top: 40px;
      background: var(--partner-button-bg);
      border-color: var(--partner-button-bg);
      color: var(--partner-button-text);
      font-size: var(--partner-button-size);
    }

    .partner-section[data-section-id="{{ section.id }}"] .primary-btn:hover {
      color: var(--partner-button-bg);
    }

    .partner-section[data-section-id="{{ section.id }}"] .primary-btn::before {
      background: #fff;
    }

    @media (max-width: 991px) {
      .partner-section[data-section-id="{{ section.id }}"] .partner-content {
        width: 100%;
        padding: 40px 30px;
      }
      .partner-section[data-section-id="{{ section.id }}"] .partner-image {
        width: 100%;
      }
    }

    @media (max-width: 767px) {
      .partner-section[data-section-id="{{ section.id }}"] .section-title h2 {
        font-size: var(--partner-heading-size-mobile);
      }
      .partner-section[data-section-id="{{ section.id }}"] .partner-content {
        padding: 30px 20px;
      }
    }
  </style>

  <div class="container">
    <div class="partner-wrapper">
      <!-- Content -->
      <div class="partner-content">
        <div class="section-title">
          <h2>{{ section.settings.heading | escape }}</h2>
        </div>
        <p>{{ section.settings.paragraph_1 | escape }}</p>
        <p>{{ section.settings.paragraph_2 | escape }}</p>
        <a href="{% if section.settings.button_link != blank %}{{ section.settings.button_link }}{% else %}#{% endif %}" class="primary-btn">
          {{ section.settings.button_text | escape }}
        </a>
      </div>
      <!-- Image -->
      <div class="partner-image">
        {% if section.settings.image != blank %}
          <img
            src="{{ section.settings.image | image_url: width: 1200 }}"
            alt="{{ section.settings.image.alt | escape }}"
            loading="lazy"
          >
        {% else %}
          {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Partner Section",
  "tag": "section",
  "class": "partner-section-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Partner with a Pioneer"
    },
    {
      "type": "textarea",
      "id": "paragraph_1",
      "label": "First paragraph",
      "default": "Running a café, hotel, or distribution business? Partner with Sulalat for scalable wholesale solutions and trusted supply."
    },
    {
      "type": "textarea",
      "id": "paragraph_2",
      "label": "Second paragraph",
      "default": "Unlock growth with Saudi Arabia's trusted B2B coffee solutions provider."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Explore Business Solutions"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "header",
      "content": "Styling"
    },
    {
      "type": "color",
      "id": "section_bg_color",
      "label": "Partner background color",
      "default": "#f5f3f3"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#555555"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button background",
      "default": "#61c19a"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_hover_bg_color",
      "label": "Button hover background",
      "default": "#4eaa84"
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "label": "Section top padding",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "label": "Section bottom padding",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "content_padding",
      "label": "Content padding",
      "min": 20,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 75
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading font size",
      "min": 20,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading mobile font size",
      "min": 18,
      "max": 36,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "Body text size",
      "min": 13,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "button_size",
      "label": "Button font size",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "Partner Section"
    }
  ]
}
{% endschema %}