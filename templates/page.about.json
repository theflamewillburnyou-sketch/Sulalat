        "timeline_2013": {
          "type": "timeline_item",
          "settings": {
            "year": "2014",
            "heading": "Sulalat’s Journey Begins ",
            "text": "<p>Founded in Saudi Arabia, marking the start of our journey as a leading specialty coffee supplier in Saudi Arabia</p>",
            "image": "shopify://shop_images/timeline-slide-1.png"
          }
        },
        "timeline_2025": {
          "type": "timeline_item",
          "settings": {
            "year": "2015",
            "heading": "A Historic First",
            "text": "<ul><li>Became the first Arab company to win the La Esmeralda Auction</li><li>Joined the Cup of Excellence</li><li>Partnered with La Marzocco, Compak, and Profitec to support emerging specialty cafés</li><li>Introduced semi-professional espresso machines through Profitec, bringing specialty-grade quality to home baristas</li></ul>",
            "image": "shopify://shop_images/timeline-slide-3.png"
          }
        },
        "timeline_item_khc7y6": {
          "type": "timeline_item",
          "settings": {
            "year": "2016",
            "heading": "Setting the Foundations",
            "text": "<ul><li>Established our first direct trade relationship with the Lamastus family farms in Panama</li><li>Organized Saudi Arabia's first AeroPress Championship</li><li>Expanded into new roasting, warehousing, and logistics facilities</li><li>Introduced the first Loring roaster in the Middle East</li></ul>",
            "image": "shopify://shop_images/Frame_1948756672.png"
          }
        },
        "timeline_item_LbYmyt": {
          "type": "timeline_item",
          "settings": {
            "year": "2018",
            "heading": "Investing in the People ",
            "text": "<ul><li>Hosted Saudi Arabia's first WCEP program to empower local baristas and sensory professionals</li><li>Contracted a state-of-the-art automated roasting facility near Riyadh</li><li>Organized the first Saudi Barista Championship</li></ul>",
            "image": "shopify://shop_images/Frame_1948756672.png"
          }
        },
        "timeline_item_j3Dnwq": {
          "type": "timeline_item",
          "settings": {
            "year": "2020",
            "heading": "A Shift Toward Home",
            "text": "<ul><li>Experienced a rise in retail demand from home baristas, as more people began asking how to bring specialty-grade quality into their own kitchens</li><li>Inaugurated our first-ever showroom and a coffee bar serving specialty coffee </li></ul>",
            "image": "shopify://shop_images/Frame_1948756672.png"
          }
        },
        "timeline_item_3r7EXp": {
          "type": "timeline_item",
          "settings": {
            "year": "2021",
            "heading": "A Network Worth Noting",
            "text": "<p>Surpassed 500 client cafés, a milestone reflecting industry recovery and renewed growth</p>",
            "image": "shopify://shop_images/Frame_1948756672.png"
          }
        },
        "timeline_item_Ajtcjn": {
          "type": "timeline_item",
          "settings": {
            "year": "2023",
            "heading": "Beyond the Bean",
            "text": "<p>Expanded into new categories with the acquisition of Senmar and Salve, growing our ecosystem to include craft chocolate and artisan gelato</p>",
            "image": "shopify://shop_images/Frame_1948756672.png"
          }
        },
        "timeline_item_ftChRf": {
          "type": "timeline_item",
          "settings": {
            "year": "2025",
            "heading": "Making Quality More Accessible",
            "text": "<ul><li>Strengthened our retail presence through distribution agreements with Lulu Hypermarket, Spinneys, and Al Hatab Bakery</li><li>Made our products available for delivery through Ninja, Keeta, and Hunger Station</li><li>Began sponsoring podcast programs, including Mics</li><li>Expanded the showroom to include a craft chocolate factory and artisan gelato production lab, complementing the existing coffee bar and roastery under one roof</li></ul>",
            "image": "shopify://shop_images/Frame_1948756672.png"
          }
        },
